{
  "_doc": "Inventory of model-derived stages and artifacts. The ordinary verify/page build does not make live model calls; it reads committed artifacts and deterministic code paths. Some scripts can call models when manually invoked, especially on cache misses or explicit Codex execution.",
  "stages": [
    {
      "name": "embedding_candidate_generation",
      "where": "harness/embed.py:embed; harness/embed.py:rank; scripts/dual_screen.py:main; scripts/deficit.py:_classify; scripts/rob2_build.py:_match",
      "provider": "Hugging Face sentence-transformers local runtime",
      "model_identifier": "sentence-transformers/all-MiniLM-L6-v2",
      "live_at_build_time": false,
      "live_call_path": "Only manual scripts using harness.embed with allow_model=True can load the model on cache miss.",
      "snapshot_pinning": {
        "pinned": false,
        "reason": "MODEL_ID has no Hugging Face revision or weights digest; cache misses load the current resolved model."
      },
      "parameters": {
        "dimension": 384,
        "normalize": true,
        "dual_screen_threshold": 0.3,
        "deficit_and_rob_match_threshold": 0.45
      },
      "tool_config": {
        "cache": "cache/embeddings.json",
        "cache_key": "sha1(MODEL_ID + '|' + text)"
      },
      "prompt_in_tree": false,
      "prompt_digest": null,
      "archive": {
        "archived": true,
        "location": "cache/embeddings.json",
        "request_archive": false,
        "response_archive": "committed embedding vectors"
      }
    },
    {
      "name": "screening_model_adjudication",
      "where": "harness/pipeline.py:_with_model_adjudication; scripts/screen_adjudicate.py:main",
      "provider": "external/manual adjudicator record",
      "model_identifier": "adjudicator",
      "live_at_build_time": false,
      "live_call_path": "scripts/screen_adjudicate.py writes supplied judgments; it does not call a model itself.",
      "snapshot_pinning": {
        "pinned": false,
        "reason": "Committed records identify only 'adjudicator' and do not include provider snapshot or immutable version."
      },
      "parameters": {
        "eligible_if_judgment": "include",
        "conflict_review": true
      },
      "tool_config": {
        "cache_pattern": "cache/<topic>/screen_adjudication.json",
        "consumed_by": "harness.pipeline._with_model_adjudication"
      },
      "prompt_in_tree": false,
      "prompt_digest": null,
      "archive": {
        "archived": true,
