{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mahmood726-cyber/meta-harness/blob/main/benchmarks/cross_repo/v0.1/manifest.schema.json",
  "title": "Reproducible integration benchmark manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_version",
    "purpose",
    "repositories",
    "cases",
    "coverage"
  ],
  "properties": {
    "benchmark_version": {
      "const": "0.1.0"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "repositories": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "meta-harness",
        "rapidmeta-kit",
        "e156-ecosystem-starter",
        "e156"
      ],
      "properties": {
        "meta-harness": {
          "$ref": "#/$defs/repository"
        },
        "rapidmeta-kit": {
          "$ref": "#/$defs/repository"
        },
        "e156-ecosystem-starter": {
          "$ref": "#/$defs/repository"
        },
        "e156": {
          "$ref": "#/$defs/repository"
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "coverage": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "status",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "NOT_RUN",
              "BLOCKED"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "dependency_identity"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "dependency_identity": {
          "type": "string",
          "minLength": 1
        },
        "dependency_lock_git_blob": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "input",
        "input_sha256",
        "input_type",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CROSS-[A-Z]+-[0-9]{3}$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "string",
          "minLength": 1
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "input_type": {
          "const": "SYNTHETIC_FIXTURE_ONLY"
        },
        "status": {
          "enum": [
            "NOT_RUN",
            "PASS",
            "FAIL",
            "BLOCKED"
          ]
        },
        "run_evidence": {
          "type": "object"
        }
      }
    }
  }
}
