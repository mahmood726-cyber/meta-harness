 "topics": {
  "statins-primary-prevention-elderly": {
   "record": "mc-d9ca6a9b2b4ce6623d858521f1f156cf.json",
   "proposal": {
    "pubmed_query": "((\"Aged\"[Mesh] OR \"Aged, 80 and over\"[Mesh] OR aged[tiab] OR elderly[tiab] OR elder*[tiab] OR \"older adult\"[tiab] OR \"older adults\"[tiab] OR \"older person\"[tiab] OR \"older persons\"[tiab] OR \"older people\"[tiab] OR septuagenarian*[tiab] OR octogenarian*[tiab] OR nonagenarian*[tiab] OR \"70 years\"[tiab] OR \"70 year\"[tiab] OR \"75 years\"[tiab] OR \"75 year\"[tiab] OR \"80 years\"[tiab] OR \"80 year\"[tiab]) AND (\"Primary Prevention\"[Mesh] OR \"primary prevention\"[tiab] OR \"without cardiovascular disease\"[tiab] OR \"without prior cardiovascular disease\"[tiab] OR \"no cardiovascular disease\"[tiab] OR \"free of cardiovascular disease\"[tiab] OR \"without clinical cardiovascular disease\"[tiab] OR \"no clinical cardiovascular disease\"[tiab] OR \"apparently healthy\"[tiab] OR asymptomatic[tiab] OR \"low risk\"[tiab] OR \"moderate risk\"[tiab] OR \"intermediate risk\"[tiab])) AND (\"Hydroxymethylglutaryl-CoA Reductase Inhibitors\"[Mesh] OR statin*[tiab] OR \"HMG-CoA reductase inhibitor\"[tiab] OR \"HMG CoA reductase inhibitor\"[tiab] OR \"HMG-CoA reductase inhibitors\"[tiab] OR \"HMG CoA reductase inhibitors\"[tiab] OR atorvastatin[tiab] OR Lipitor[tiab] OR rosuvastatin[tiab] OR Crestor[tiab] OR pravastatin[tiab] OR Pravachol[tiab] OR Selektine[tiab] OR simvastatin[tiab] OR Zocor[tiab] OR lovastatin[tiab] OR Mevacor[tiab] OR Altoprev[tiab] OR fluvastatin[tiab] OR Lescol[tiab] OR pitavastatin[tiab] OR Livalo[tiab] OR Livazo[tiab] OR Zypitamag[tiab] OR cerivastatin[tiab] OR Baycol[tiab] OR Lipobay[tiab]) AND (randomized controlled trial[pt] OR controlled clinical trial[pt] OR randomized[tiab] OR randomised[tiab] OR placebo[tiab] OR drug therapy[sh] OR randomly[tiab] OR trial[tiab] OR groups[tiab]) NOT (animals[mh] NOT humans[mh])",
    "ctgov_cond": "older adults OR elderly OR aged OR 70 years OR 75 years OR primary prevention OR without cardiovascular disease OR no cardiovascular disease OR apparently healthy",
    "ctgov_intr": "statin OR HMG-CoA reductase inhibitor OR atorvastatin OR Lipitor OR rosuvastatin OR Crestor OR pravastatin OR Pravachol OR Selektine OR simvastatin OR Zocor OR lovastatin OR Mevacor OR Altoprev OR fluvastatin OR Lescol OR pitavastatin OR Livalo OR Livazo OR Zypitamag OR cerivastatin OR Baycol OR Lipobay",
    "rationale": "The search uses a three-concept structure: older-adult/primary-prevention population terms, comprehensive statin class and individual drug/brand terms, and the Cochrane sensitivity-maximising randomized-trial filter. It avoids outcome, date, language, and named-trial restrictions while adding a primary-prevention/no-established-CVD population facet to keep retrieval within the stated screening budget.",
    "concepts": [
     "Older adults: MeSH and text words for aged, elderly, older adults/persons/people, and age-threshold phrases relevant to >=70 or >=75 years.",
     "Primary prevention / no established cardiovascular disease: MeSH and text words for primary prevention, absence of cardiovascular disease, apparently healthy, asymptomatic, and low/moderate/intermediate risk populations.",
     "Statins: MeSH for hydroxymethylglutaryl-CoA reductase inhibitors plus class terms, spelling variants, generic statin names, and major brand names.",
     "Randomised trials: Cochrane Highly Sensitive Search Strategy sensitivity-maximising PubMed filter, including publication types, randomized/randomised/placebo/trial/groups terms, and animal-only exclusion."
    ],
    "weaknesses_of_current": [
     "They target specific drugs and highly specific title phrases, so they will miss eligible trials or subgroup reports using other statins, generic class wording, different titles, or abstracts without those exact phrases.",
     "They do not use MeSH terms for statins, aged populations, primary prevention, or randomized trials.",
     "They lack a randomized-trial filter and therefore are not a reproducible systematic review RCT search strategy.",
     "They over-rely on Title fields, which makes retrieval fragile and explains the very low record counts.",
     "They do not cover statin class names, spelling variants, or most individual statins and brand names.",
     "They do not adequately represent the older-adult population concept, including age-threshold variants such as 70+, 75+, or MeSH aged terms.",
     "They do not adequately represent the primary-prevention/no-established-CVD population concept beyond a single phrase.",
     "The ClinicalTrials.gov query searches only elderly plus atorvastatin, so it misses studies using other statins or statin class wording and is not aligned with the review intervention concept.",
     "The current searches appear trial-report-targeted rather than concept-based, risking selection bias and non-reproducibility."
    ]
   },
