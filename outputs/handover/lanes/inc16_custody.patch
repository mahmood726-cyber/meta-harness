new file mode 100644
index 00000000..fcf7f3c8
--- /dev/null
+++ b/harness/record_custody.py
@@ -0,0 +1,227 @@
+"""Record custody: the evidence chain begins BEFORE the normalised cache.
+
+A cache record's `abstract` is a deterministic transform of a PubMed efetch response (fetch.parse_efetch: labelled
+AbstractText concatenation, literal characters). Until this layer the caches held only the transformed text, so a
+record whose abstract was shortened by hand before it entered the cache was indistinguishable from a fetched one,
+and "verified against the cache" verified an extraction against the shortened text (external re-audit of
+6d6bacad, finding 1: SOUL, PMID 40162642, entered at ef0d0e6b with 1180 of the abstract's 2240 characters -- the
+randomisation clause joined to the event sentence, the follow-up sentence, the incidence qualifiers, the
+glycated-haemoglobin range, the confirmatory secondary outcomes and the serious-adverse-event sentence omitted).
+
+cache/<slug>/record_custody.json
+  {"version": 1, "records": {"<pmid>": {
+      "url", "params", "fetched_utc", "status", "body_sha256", "body_path" (in-tree raw response bytes),
+      "adapter": "harness.fetch.parse_efetch", "adapter_blob_sha", "mechanism": "deterministic_transform",
+      "transformation": <what parse_efetch does>, "derived_abstract_sha256",
+      "cache": {"abstract_sha256", "state": "IDENTICAL" | "REPLACED_STITCHED",
+                "previous": {"abstract_sha256", "chars", "omitted_chars", "omitted_segments": [...], "replaced_utc"}}}}}
+
+verify(slug, records): every custody row's held bytes must hash to body_sha256, and the cache abstract must be
+byte-identical to parse_efetch(held bytes) -- otherwise CACHE_ABSTRACT_NOT_DERIVED_FROM_HELD_BYTES and the review
+is REFUSED (pipeline.build_review_core). A record with no custody row is LEGACY_UNRECORDED: the page says so; it is
+not a refusal, because 31 caches predate this layer, but it is never displayed as verified against held bytes.
+"""
+from __future__ import annotations
+
+import difflib
+import hashlib
+import json
+import os
+import subprocess
+
+from . import fetch
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+FILENAME = "record_custody.json"
+RAW_DIRNAME = os.path.join("raw", "record_custody")
+ADAPTER = "harness.fetch.parse_efetch"
+TRANSFORMATION = ("PubMed efetch XML -> for each Abstract/AbstractText: ('LABEL: ' if Label) + itertext; "
+                  "space-joined; strip. Literal characters kept (thin spaces, middle-dot decimals); no normalisation.")
+HELD_RAW = "HELD_RAW"
+LEGACY_UNRECORDED = "LEGACY_UNRECORDED"
+
+
+def _sha(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()
+
+
+def _adapter_blob_sha() -> str | None:
+    try:
+        out = subprocess.run(["git", "hash-object", os.path.join("harness", "fetch.py")], cwd=ROOT,
+                             capture_output=True, text=True, check=True)
+        return out.stdout.strip() or None
+    except (OSError, subprocess.CalledProcessError):
+        return None
+
+
+def custody_path(slug: str, cache_root: str | None = None) -> str:
+    return os.path.join(cache_root or os.path.join(ROOT, "cache"), slug, FILENAME)
+
+
+def load(slug: str, cache_root: str | None = None) -> dict:
+    path = custody_path(slug, cache_root)
+    if not os.path.exists(path):
+        return {"version": 1, "records": {}}
+    with open(path, encoding="utf-8") as f:
+        return json.load(f)
+
+
+def derive(body: bytes, pmid: str) -> dict:
+    """parse_efetch over held bytes; the record for `pmid` or a ValueError naming what the response held."""
+    parsed = fetch.parse_efetch(body)
+    ids = [str(r.get("id")) for r in parsed]
+    for rec in parsed:
+        if str(rec.get("id")) == str(pmid):
+            return rec
+    raise ValueError(f"held efetch response does not contain PMID {pmid} (holds {ids})")
+
+
+def state_for(custody: dict, pmid: str) -> dict:
+    row = (custody.get("records") or {}).get(str(pmid))
+    if not row:
+        return {"state": LEGACY_UNRECORDED,
+                "detail": "no retrieval record holds this record's response bytes; the cache abstract is the only custody"}
+    return {"state": HELD_RAW, "body_sha256": row.get("body_sha256"), "body_path": row.get("body_path"),
+            "fetched_utc": row.get("fetched_utc"), "url": row.get("url"), "adapter": row.get("adapter"),
+            "mechanism": row.get("mechanism"), "cache_state": (row.get("cache") or {}).get("state")}
+
+
+def verify(slug: str, records: list[dict], cache_root: str | None = None, root: str | None = None) -> list[dict]:
+    """Violations (empty = every custody row proves its cache abstract). Checked for the records in `records`."""
+    root = root or ROOT
+    custody = load(slug, cache_root)
+    by_id = {str(r.get("id")): r for r in records}
+    out: list[dict] = []
+    for pmid, row in sorted((custody.get("records") or {}).items()):
+        rec = by_id.get(pmid)
+        if rec is None:
+            out.append({"pmid": pmid, "code": "CUSTODY_ORPHAN", "detail": "custody row for a record not in the cache"})
+            continue
+        path = os.path.join(root, row.get("body_path") or "")
+        if not row.get("body_path") or not os.path.isfile(path):
+            out.append({"pmid": pmid, "code": "CUSTODY_BODY_MISSING", "detail": f"held bytes not at {row.get('body_path')}"})
+            continue
+        with open(path, "rb") as f:
+            body = f.read()
+        if _sha(body) != row.get("body_sha256"):
+            out.append({"pmid": pmid, "code": "CUSTODY_BODY_DIGEST_MISMATCH",
+                        "detail": f"held bytes sha256 {_sha(body)[:16]} != recorded {str(row.get('body_sha256'))[:16]}"})
+            continue
+        try:
+            derived = derive(body, pmid)
+        except (ValueError, SyntaxError) as exc:  # ET.ParseError is a SyntaxError
+            out.append({"pmid": pmid, "code": "CUSTODY_BODY_UNPARSEABLE", "detail": str(exc)})
+            continue
+        cache_abstract = rec.get("abstract") or ""
+        if cache_abstract != derived.get("abstract", ""):
+            out.append({"pmid": pmid, "code": "CACHE_ABSTRACT_NOT_DERIVED_FROM_HELD_BYTES",
+                        "detail": (f"cache abstract sha256 {_sha(cache_abstract.encode('utf-8'))[:16]} ({len(cache_abstract)} chars)"
+                                   f" != parse_efetch(held bytes) {_sha(derived['abstract'].encode('utf-8'))[:16]}"
+                                   f" ({len(derived['abstract'])} chars)")})
+    return out
+
+
+def omitted_segments(previous: str, derived: str) -> list[dict]:
+    """The segments of the derived (held) abstract absent from the previous cache text, with their offsets."""
+    sm = difflib.SequenceMatcher(None, previous, derived, autojunk=False)
+    segs = []
+    for op, i1, i2, j1, j2 in sm.get_opcodes():
+        if op == "equal":
+            continue
+        segs.append({"op": op, "previous": previous[i1:i2], "held_offset": [j1, j2], "held": derived[j1:j2]})
+    return segs
+
+
+def admit(slug: str, pmid: str, body: bytes, url: str, params: dict | None, fetched_utc: str, status: int,
+          records_doc: dict, cache_root: str | None = None, root: str | None = None) -> dict:
+    """Hold `body` in tree, derive the record, replace the cache abstract by the derivation when it differs (the
+    previous text and every omitted segment recorded), and return the custody row. Mutates records_doc in place."""
+    root = root or ROOT
+    cache_root = cache_root or os.path.join(root, "cache")
+    derived = derive(body, pmid)
+    rel = "/".join(["cache", slug, "raw", "record_custody", f"pubmed_{pmid}_efetch.xml"])
+    abs_path = os.path.join(root, *rel.split("/"))
+    os.makedirs(os.path.dirname(abs_path), exist_ok=True)
+    with open(abs_path, "wb") as f:
+        f.write(body)
+    rec = next((r for r in records_doc.get("records", []) if str(r.get("id")) == str(pmid)), None)
+    if rec is None:
+        raise ValueError(f"{slug}: PMID {pmid} is not in the cache; custody admits held bytes for cache records only")
+    previous = rec.get("abstract") or ""
+    cache_block: dict = {"abstract_sha256": _sha(derived["abstract"].encode("utf-8"))}
+    if previous == derived["abstract"]:
+        cache_block["state"] = "IDENTICAL"
+    else:
+        segs = omitted_segments(previous, derived["abstract"])
+        cache_block["state"] = "REPLACED_STITCHED"
+        cache_block["previous"] = {
+            "abstract_sha256": _sha(previous.encode("utf-8")), "chars": len(previous),
+            "omitted_chars": len(derived["abstract"]) - len(previous),
+            "omitted_segments": segs, "replaced_utc": fetched_utc,
+            "reason": "cache abstract was not the derivation of the held response (shortened/stitched); replaced by the derivation",
+        }
+        rec["abstract"] = derived["abstract"]
+    row = {"url": url, "params": params or {}, "fetched_utc": fetched_utc, "status": status,
+           "body_sha256": _sha(body), "body_bytes": len(body), "body_path": rel,
+           "adapter": ADAPTER, "adapter_blob_sha": _adapter_blob_sha(), "mechanism": "deterministic_transform",
+           "transformation": TRANSFORMATION, "derived_abstract_sha256": cache_block["abstract_sha256"],
+           "cache": cache_block}
+    custody = load(slug, cache_root)
+    custody.setdefault("records", {})[str(pmid)] = row
+    with open(custody_path(slug, cache_root), "w", encoding="utf-8", newline="") as f:
+        f.write(json.dumps(custody, ensure_ascii=False, indent=1))
+    return row
+
+
+def repin_dependents(slug: str, root: str | None = None) -> list[dict]:
+    """Pins of cache/<slug>/records.json by WHOLE-FILE digest (comparator aliases, verified_* document_sha256) are
+    re-derived after a custody repair, each keeping its previous digest under `document_sha256_previous`. The pin
+    scope is the defect (a file digest cannot survive a legitimate repair of one record); per-record custody rows
+    are the durable unit. Spans are re-validated at their recorded offsets and never moved silently."""
+    root = root or ROOT
+    rel = f"cache/{slug}/records.json"
+    path = os.path.join(root, "cache", slug, "records.json")
+    raw = open(path, "rb").read()
+    digest = _sha(raw)
+    text = raw.decode("utf-8")
+    changed: list[dict] = []
+
+    def _repin(obj: dict, where: str, span: dict | None) -> None:
+        if obj.get("document_sha256") == digest:
+            return
+        if span is not None and text[span["start"]:span["end"]] != span.get("quote"):
+            raise ValueError(f"{where}: span no longer locates at its recorded offsets after the custody repair")
+        obj["document_sha256_previous"] = obj.get("document_sha256")
+        obj["document_sha256"] = digest
+        changed.append({"where": where, "previous": obj["document_sha256_previous"], "digest": digest})
+
+    cpath = os.path.join(root, "cache", slug, "comparators.json")
+    if os.path.exists(cpath):
+        comps = json.load(open(cpath, encoding="utf-8"))
+        for c in comps if isinstance(comps, list) else [comps]:
+            for t in c.get("trial_set") or []:
+                for a in t.get("aliases") or []:
+                    if a.get("document_ref") == rel:
+                        _repin(a, f"comparators.json alias {a.get('id')}", a.get("span"))
+        if changed:
+            with open(cpath, "w", encoding="utf-8", newline="") as f:
+                f.write(json.dumps(comps, ensure_ascii=False, indent=2))
+    n_before = len(changed)
+    for name in ("verified_effects.json", "verified_arms.json"):
+        vpath = os.path.join(root, "cache", slug, name)
+        if not os.path.exists(vpath):
+            continue
+        doc = json.load(open(vpath, encoding="utf-8"))
+        touched = 0
+        for pid, value in doc.items():
+            for e in value if isinstance(value, list) else [value]:
+                if str(e.get("document_ref") or "").split("#")[0] == rel and e.get("document_sha256"):
+                    if e.get("source_span") and e["source_span"] not in text:
+                        raise ValueError(f"{name}/{pid}: source_span absent from the repaired records.json")
+                    before = len(changed)
+                    _repin(e, f"{name} {pid}", None)
+                    touched += len(changed) - before
+        if touched:
+            with open(vpath, "w", encoding="utf-8", newline="") as f:
+                f.write(json.dumps(doc, ensure_ascii=False, indent=2))
+    return changed
