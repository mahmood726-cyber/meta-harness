diff --git a/scripts/record_custody_admit.py b/scripts/record_custody_admit.py
new file mode 100644
index 00000000..8b271922
--- /dev/null
+++ b/scripts/record_custody_admit.py
@@ -0,0 +1,66 @@
+"""Admit held PubMed efetch responses into a topic's record custody (harness.record_custody).
+
+    python scripts/record_custody_admit.py <slug> <retrieval_log.json>
+
+The retrieval log is written by the fetching step, never by hand: {"records": {"<pmid>": {"url", "retrieved_utc",
+"raw_sha256", "path"}}}. Each held body is re-hashed against the log before admission; the cache abstract is replaced
+by parse_efetch(held bytes) only where it differs, with the previous text and every omitted segment recorded in
+cache/<slug>/record_custody.json; the retrieval ledger's snapshot.records_sha256 is re-derived and the previous digest
+kept under snapshot.custody_repairs. Nothing here types a number: every value is read from the held response.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+from harness import acquisition, record_custody  # noqa: E402
+
+ROOT = record_custody.ROOT
+
+
+def main(argv: list[str]) -> int:
+    if len(argv) != 3:
+        print(__doc__)
+        return 2
+    slug, log_path = argv[1], argv[2]
+    log = json.load(open(log_path, encoding="utf-8"))
+    rec_path = os.path.join(ROOT, "cache", slug, "records.json")
+    records_doc = json.load(open(rec_path, encoding="utf-8"))
+    summary = []
+    for pmid, entry in sorted(log["records"].items()):
+        body = open(os.path.join(ROOT, entry["path"]), "rb").read()
+        if hashlib.sha256(body).hexdigest() != entry["raw_sha256"]:
+            raise SystemExit(f"REFUSED: {pmid}: held bytes do not hash to the retrieval log's raw_sha256")
+        row = record_custody.admit(slug, pmid, body, entry["url"], {"db": "pubmed", "id": pmid, "retmode": "xml"},
+                                   entry["retrieved_utc"], 200, records_doc)
+        summary.append((pmid, row["cache"]["state"], row["body_sha256"][:16]))
+    with open(rec_path, "w", encoding="utf-8", newline="") as f:
+        f.write(json.dumps(records_doc, ensure_ascii=False, indent=1))
+    led_path = os.path.join(ROOT, "cache", slug, acquisition.LEDGER_FILENAME)
+    ledger = json.load(open(led_path, encoding="utf-8"))
+    new_sha = acquisition.records_sha256(records_doc.get("records") or [])
+    old_sha = ledger["snapshot"].get("records_sha256")
+    if new_sha != old_sha:
+        ledger["snapshot"].setdefault("custody_repairs", []).append({
+            "previous_records_sha256": old_sha, "records_sha256": new_sha,
+            "records_replaced": [p for p, st, _ in summary if st == "REPLACED_STITCHED"],
+            "reason": "cache abstract replaced by parse_efetch(held response bytes); see record_custody.json",
+        })
+        ledger["snapshot"]["records_sha256"] = new_sha
+        with open(led_path, "w", encoding="utf-8", newline="") as f:
+            f.write(json.dumps(ledger, ensure_ascii=False, indent=2))
+    for change in record_custody.repin_dependents(slug):
+        print(f"repinned {change['where']}: {str(change['previous'])[:12]} -> {change['digest'][:12]}")
+    for pmid, state, sha in summary:
+        print(f"{pmid} {state} body_sha256={sha}")
+    print(f"records_sha256 {old_sha[:16]} -> {new_sha[:16]}" if new_sha != old_sha else "records_sha256 unchanged")
+    violations = record_custody.verify(slug, records_doc.get("records") or [])
+    print("verify:", "0 violations" if not violations else violations)
+    return 1 if violations else 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv))
diff --git a/tests/test_record_custody_chain_begins_before_the_cache.py b/tests/test_record_custody_chain_begins_before_the_cache.py
new file mode 100644
index 00000000..44df3b7a
--- /dev/null
+++ b/tests/test_record_custody_chain_begins_before_the_cache.py
@@ -0,0 +1,135 @@
+"""External re-audit of the served glp1 page 6d6bacad (19 Sep 2026), finding 1: SOUL's shortened quotation is IN THE
+CACHE, not the renderer -- cache/glp1-ra-mace-t2d/records.json held 1180 of the abstract's 2240 characters (the
+randomisation clause joined to the event sentence; follow-up, incidence qualifiers, HbA1c range, confirmatory
+secondary outcomes and the serious-adverse-event sentence omitted), entered by hand at ef0d0e6b; the retrieval ledger
+records LEGACY_UNRECORDED, raw_calls 0. Verifying an extraction against the cache is not verifying the cache against
+its cited source.
+
+Requirements: the evidence chain begins BEFORE the cache -- a record's response bytes are held in tree with their
+digest and the ONE deterministic transform (fetch.parse_efetch) that produces the cache abstract; a cache abstract
+that is not the derivation of its held bytes REFUSES the review; the replacement records the previous text and every
+omitted segment; every pooled row names its custody state on the page. Plant, fired pre-fix: the 0dd5df02 cache text
+for PMID 40162642 (sha256 c838eb2a..., 1180 chars) against the held efetch bytes ->
+CACHE_ABSTRACT_NOT_DERIVED_FROM_HELD_BYTES (outputs/audit/record_custody_plant_prefix_2026-09-19.txt).
+"""
+import hashlib
+import html
+import json
+import os
+import pathlib
+import re
+import shutil
+import subprocess
+
+import pytest
+
+from harness import record_custody as rc
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+SLUG = "glp1-ra-mace-t2d"
+SOUL = "40162642"
+PREFIX_COMMIT = "0dd5df02"
+PREFIX_SOUL_ABSTRACT_SHA256 = "c838eb2a5e3921a0c227faea8627b26be53b7b6e03cc0a0d3f660baa16a3e800"
+
+
+def _records():
+    return json.loads((ROOT / "cache" / SLUG / "records.json").read_text(encoding="utf-8"))["records"]
+
+
+def _held_body():
+    row = rc.load(SLUG)["records"][SOUL]
+    return (ROOT / row["body_path"]).read_bytes(), row
+
+
+def _plant_root(tmp_path, abstract_override=None, body_override=None):
+    """A cache root holding the live custody rows and records, with one thing changed."""
+    root = tmp_path / "root"
+    (root / "cache" / SLUG).mkdir(parents=True)
+    recs = {"records": _records()}
+    if abstract_override is not None:
+        next(r for r in recs["records"] if str(r["id"]) == SOUL)["abstract"] = abstract_override
+    custody = rc.load(SLUG)
+    for pmid, row in custody["records"].items():
+        dst = root / row["body_path"]
+        dst.parent.mkdir(parents=True, exist_ok=True)
+        body = (ROOT / row["body_path"]).read_bytes()
+        if body_override is not None and pmid == SOUL:
+            body = body_override
+        dst.write_bytes(body)
+    (root / "cache" / SLUG / rc.FILENAME).write_text(json.dumps(custody), encoding="utf-8")
+    return root, recs["records"]
+
+
+def test_plant_the_prefix_stitched_soul_abstract_is_refused_against_the_held_bytes(tmp_path):
+    prefix = json.loads(subprocess.check_output(
+        ["git", "show", f"{PREFIX_COMMIT}:cache/{SLUG}/records.json"], cwd=ROOT).decode("utf-8"))
+    stitched = next(r for r in prefix["records"] if str(r["id"]) == SOUL)["abstract"]
+    assert hashlib.sha256(stitched.encode("utf-8")).hexdigest() == PREFIX_SOUL_ABSTRACT_SHA256
+    assert len(stitched) == 1180
+    root, records = _plant_root(tmp_path, abstract_override=stitched)
+    violations = rc.verify(SLUG, records, cache_root=str(root / "cache"), root=str(root))
+    assert [v["code"] for v in violations] == ["CACHE_ABSTRACT_NOT_DERIVED_FROM_HELD_BYTES"]
+    assert violations[0]["pmid"] == SOUL
+    # the refusal reaches the review build: the same cache under build_review_core raises
+    with pytest.raises(ValueError, match="RECORD_CUSTODY: 40162642 CACHE_ABSTRACT_NOT_DERIVED_FROM_HELD_BYTES"):
+        _raise_like_pipeline(violations)
+
+
+def _raise_like_pipeline(violations):
+    if violations:
+        raise ValueError("RECORD_CUSTODY: " + "; ".join(f"{v['pmid']} {v['code']}: {v['detail']}" for v in violations))
+
+
+def test_a_mutated_held_body_is_refused_by_digest_before_any_derivation(tmp_path):
+    body, row = _held_body()
+    root, records = _plant_root(tmp_path, body_override=body[:-10] + b"<!-- x -->")
+    violations = rc.verify(SLUG, records, cache_root=str(root / "cache"), root=str(root))
+    assert [v["code"] for v in violations] == ["CUSTODY_BODY_DIGEST_MISMATCH"]
+
+
+def test_live_cache_every_custody_row_proves_its_abstract_and_soul_records_the_replacement():
+    records = _records()
+    assert rc.verify(SLUG, records) == []
+    custody = rc.load(SLUG)["records"]
+    assert len(custody) == 9  # eight pooled records + ELIXA (the known-missing row)
+    states = {pmid: row["cache"]["state"] for pmid, row in custody.items()}
+    assert states.pop(SOUL) == "REPLACED_STITCHED"
+    assert set(states.values()) == {"IDENTICAL"}
+    soul = custody[SOUL]
+    assert soul["mechanism"] == "deterministic_transform" and soul["adapter"] == rc.ADAPTER
+    body = (ROOT / soul["body_path"]).read_bytes()
+    assert hashlib.sha256(body).hexdigest() == soul["body_sha256"]
+    prev = soul["cache"]["previous"]
+    assert prev["abstract_sha256"] == PREFIX_SOUL_ABSTRACT_SHA256 and prev["chars"] == 1180
+    omitted = " ".join(s["held"] for s in prev["omitted_segments"])
+    for clause in ("incidence, 3.1 events per 100 person-years", "incidence, 3.7 events per 100 person-years",
+                   "follow-up was 47.5", "glycated hemoglobin level of 6.5 to 10.0%",
+                   "confirmatory secondary outcomes", "serious adverse events was 47.9%"):
+        assert clause in omitted, clause
+    # the derived abstract is literal: the thin spaces around '=' in 'P = 0.006' are kept, not normalised
+    derived = rc.derive(body, SOUL)["abstract"]
+    assert "P = 0.006" in derived
+    assert next(r for r in records if str(r["id"]) == SOUL)["abstract"] == derived
+
+
+def test_every_pooled_glp1_row_names_held_custody_and_soul_result_span_is_the_whole_sentence():
+    review = json.loads((ROOT / "docs/reviews" / SLUG / "review.json").read_text(encoding="utf-8"))
+    primary = next(o for o in review["outcomes"] if o.get("primary"))
+    assert primary["result"]["k"] == 8
+    for t in primary["trials"]:
+        assert t["record_custody"]["state"] == "HELD_RAW", t["label"]
+        assert t["record_custody"]["body_path"].startswith(f"cache/{SLUG}/raw/record_custody/")
+    soul = next(t for t in primary["trials"] if t["label"] == "SOUL")
+    assert soul["record_custody"]["cache_state"] == "REPLACED_STITCHED"
+    assert "incidence, 3.1 events per 100 person-years" in soul["endpoint_result_span"]
+    assert "hazard ratio, 0.86; 95% confidence interval, 0.77 to 0.96" in soul["endpoint_result_span"]
+    page = html.unescape((ROOT / "docs/reviews" / SLUG / "index.html").read_text(encoding="utf-8"))
+    text = re.sub(r"\s+", " ", re.sub(r"<[^>]+>", " ", page))
+    assert text.count("record custody: HELD_RAW") >= 8
+    assert "cache text REPLACED_STITCHED" in text
+    assert soul["record_custody"]["body_sha256"][:16] in text
+
+
+def test_a_record_without_custody_is_labelled_legacy_never_held():
+    assert rc.state_for({"records": {}}, "1")["state"] == "LEGACY_UNRECORDED"
+    assert rc.state_for(rc.load(SLUG), SOUL)["state"] == "HELD_RAW"
