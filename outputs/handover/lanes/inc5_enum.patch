+def unrecognised_enumerated_components(text: str | None) -> list[str]:
+    """Items a definition span ENUMERATES after a definition cue ('comprised', 'composite of', 'defined as', ...)
+    that the component vocabulary cannot read.  An enumeration in the span governs: a component the vocabulary
+    does not recognise is an unrecognised EXTRA component, never nothing -- Alpha Omega's 'major cardiovascular
+    events, which comprised fatal and nonfatal cardiovascular events and cardiac interventions' was expanded to
+    the 3-point set because none of its enumerated items was recognised (served omega3 at 237e9094, found by an
+    independent read of the bound spans)."""
+    s = _fold(text)
+    m = _ENUM_CUE_RX.search(s)
+    if not m:
+        return []
+    tail = _ENUM_STOP_RX.split(s[m.end():], 1)[0]
+    if s[:m.start()].count("(") > s[:m.start()].count(")"):
+        # the enumeration sits inside a parenthesis ('MACE (a composite of MI, stroke, or CV death) and invasive
+        # cancer'): it ends where the parenthesis closes; what follows is not part of the composite
+        tail = tail.split(")", 1)[0]
+    out: list[str] = []
+    for raw in re.split(r",|/|\bor\b|\band\b|\bplus\b", tail):
+        item = _ENUM_ITEM_PREFIX_RX.sub("", raw.strip(" ,()[]")).strip()
+        if not item or len(item) < 4 or item in _ENUM_NOISE:
+            continue
+        if _MACE_RX.search(item) or re.search(r"composite|component|randomi[sz]ation|follow-?up", item):
+            # a family name ('major adverse cardiovascular events') or a reference to the composite itself
+            # ('any component of the composite endpoint') is not an enumerated component
+            continue
+        if re.fullmatch(r"(?:undetermined|unknown|unexplained) causes?", item):
+            # the CVOT definition of cardiovascular death ('death from cardiovascular or undetermined causes',
+            # AMPLITUDE-O) splits on 'or' into a qualifier of the death item, not a component of its own
+            continue
+        if _components_from_text(item, expand_named_composites=False):
+            continue
+        if re.fullmatch(r"(?:cardiovascular|cv|vascular) events?", item):
+            # 'fatal and nonfatal cardiovascular events' names a family, not a component the vocabulary reads
+            out.append(raw.strip(" ,()"))
+            continue
+        out.append(item)
+    return out
+
