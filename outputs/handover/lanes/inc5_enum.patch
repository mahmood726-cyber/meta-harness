+    r"hospital admission for |admission for |time to |occurrence of |component of |components of |of )+", re.I)
+_ENUM_NOISE = {"composite", "the composite", "first occurrence", "first event", "either", "both", "fatal", "nonfatal",
+               "non-fatal", "any", "events", "event", "outcome", "outcomes", "end point", "endpoint", "end points",
+               "endpoints", "the following", "following"}
