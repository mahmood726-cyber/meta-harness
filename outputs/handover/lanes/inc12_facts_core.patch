                       "verbatim_located": offset >= 0})
     proposals = [a for a in adjudications if a.get("nct") == decision.get("nct")]
     adj = proposals[-1] if proposals else {}
+    value = value_extraction(decision.get("effect") or {}, spans)
     return {"trial": decision["trial"], "trial_key": _norm_id(decision.get("trial_key")),
             "nct": decision.get("nct"), "document_path": path, "document_sha256": digest,
             "extracted_text_path": text_path, "extracted_text_sha256": source["extracted_text_sha256"],
             "decision": decision, "spans": spans,
+            "value_extraction": value,
+            "effect_verified_against_span": value["verified"],
+            "strand": decision.get("strand"),
             "adjudication": {"id": adj.get("id"), "state": "PROPOSED", "countersigned": False},
             "admissible": False}
 
 
+_SPAN_EFFECT_RX = re.compile(
+    r"(?<![\d.])(\d\.\d{1,3})\s*\(\s*(\d\.\d{1,3})\s*[,–\-]\s*(?:to\s*)?(\d\.\d{1,3})\s*\)"
+    r"|(?<![\d.])(\d\.\d{1,3})\s*;\s*(\d\.\d{1,3})\s*to\s*(\d\.\d{1,3})"
+    r"|(?<![\d.])(\d\.\d{1,3})\s*\(95%\s*CI:?\s*(\d\.\d{1,3})\s*,\s*(\d\.\d{1,3})\)")
+
+
+_SPAN_CI_FIRST_RX = re.compile(
+    r"\(\s*(\d\.\d{1,3})\s*,\s*(\d\.\d{1,3})\s*\)\s*with a point estimate of\s*(\d\.\d{1,3})")
+
+
+def value_extraction(effect, spans):
+    """The harness's OWN reading of a regulatory number: a regex over the spans located verbatim in the held text
+    (transcriptions are never read). Every candidate (estimate, lower, upper, span kind) is kept; the manifest's
+    effect is `verified` only when one candidate equals it to the precision printed. Mechanism is recorded per
+    value so a reader knows a number came from a regex on held bytes, not from a hand -- and a manifest effect with
+    no located span is never verified, whatever typed it (Mahmood, 19 Sep 2026: the review notes are not a source)."""
+    candidates = []
+    for sp in spans:
+        if sp.get("verbatim_located") is False:
+            continue
+        flat = re.sub(r"\s+", " ", sp.get("span") or "")
+        for m in _SPAN_EFFECT_RX.finditer(flat):
+            g = [x for x in m.groups() if x is not None]
+            if len(g) == 3:
+                candidates.append({"estimate": float(g[0]), "ci_low": float(g[1]), "ci_high": float(g[2]),
+                                   "span_kind": sp.get("kind"), "pdf_page": sp.get("pdf_page")})
+        for m in _SPAN_CI_FIRST_RX.finditer(flat):
+            # "The 95% confidence interval for the hazard ratio is (0.887, 1.172) with a point estimate of 1.02."
+            candidates.append({"estimate": float(m.group(3)), "ci_low": float(m.group(1)), "ci_high": float(m.group(2)),
+                               "span_kind": sp.get("kind"), "pdf_page": sp.get("pdf_page")})
+    est, lo, hi = effect.get("estimate"), effect.get("ci_low"), effect.get("ci_high")
+    match = None
+    if est is not None and lo is not None and hi is not None:
+        for c in candidates:
+            if all(abs(a - b) < 1e-9 for a, b in ((c["estimate"], float(est)), (c["ci_low"], float(lo)), (c["ci_high"], float(hi)))):
+                match = c
+                break
+    return {"mechanism": "regex", "instrument": "harness.claimgraph.value_extraction",
+            "candidates": candidates, "verified": match is not None, "matched": match,
+            "manifest_effect": {"estimate": est, "ci_low": lo, "ci_high": hi} if est is not None else None}
+
+
 def regulatory_facts(root, slug):
     """Read topic-matched manifests only; do not infer custody from trial names."""
     from pathlib import Path
@@ -241,6 +287,7 @@ def regulatory_facts(root, slug):
             for decision in source.get("decisions", []):
                 fact = regulatory_fact(root, source, decision, adjudications)
                 if fact:
+                    fact["primary_strand"] = manifest.get("primary_strand")
                     facts.append(fact)
     return facts
 
