+++ b/tests/test_served_bundle_verifies_from_fetched_bytes.py
@@ -0,0 +1,68 @@
+"""External audit of a2df6624 / 6d6bacad (19 Sep 2026), findings 6-8: the certificate's self-hash proves nothing about
+the files it references (the auditor zeroed a held digest and the root stayed consistent), review_sha256 excludes the
+reproduction block, and nothing the page cites is externally retrievable. Acceptance milestone named by the auditor: an
+externally pinned source bundle plus a passing-control -> single-mutation -> restored-control test.
+
+Requirements: every served review directory carries EVIDENCE_BUNDLE.json and the cited bytes under evidence/<repo path>;
+scripts/verify_served_bundle.verify re-derives every digest -- and every cache abstract from its held PubMed response --
+from the served bytes alone and PASSES on every review dir; the enforcement experiment (scripts/enforcement_experiment.py)
+rejects each single mutation by the check it targets and passes again after restore, on glp1. Plant, fired pre-fix: the
+served 6d6bacad page has no EVIDENCE_BUNDLE.json (verify_served_bundle on the URL: FAIL bundle_listing 404), and on
+0dd5df02 a zeroed held digest in CERTIFICATE.json is detectable by nothing a reader can fetch.
+"""
+import glob
+import json
+import os
+import pathlib
+
+from scripts import enforcement_experiment, verify_served_bundle
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+
+
+def _review_dirs():
+    return sorted(os.path.dirname(p) for p in glob.glob(str(ROOT / "docs/reviews/*/review.json")))
+
+
+def test_every_served_review_carries_a_bundle_that_verifies_from_its_own_bytes():
+    failing = {}
+    for d in _review_dirs():
+        assert os.path.exists(os.path.join(d, "EVIDENCE_BUNDLE.json")), d
+        results, meta = verify_served_bundle.verify(d)
+        bad = [name for name, ok, _ in results if not ok]
+        if bad:
+            failing[os.path.basename(d)] = bad
+        bundle = json.load(open(os.path.join(d, "EVIDENCE_BUNDLE.json"), encoding="utf-8"))
+        assert bundle["review_sha256"] == meta["review_sha256"]
+        assert any(f["ref"].endswith("record_custody.json") for f in bundle["files"]), d
+    assert failing == {}, failing
+
+
+def test_glp1_bundle_serves_the_held_pubmed_bodies_and_the_regulatory_documents():
+    d = ROOT / "docs/reviews/glp1-ra-mace-t2d"
+    bundle = json.load(open(d / "EVIDENCE_BUNDLE.json", encoding="utf-8"))
+    served = {f["served"] for f in bundle["files"]}
+    assert "evidence/cache/glp1-ra-mace-t2d/raw/record_custody/pubmed_40162642_efetch.xml" in served
+    assert "evidence/outputs/handover/glp1_regulatory/held/208471Orig1s000StatR.pdf" in served
+    assert "evidence/cache/glp1-ra-mace-t2d/records.json" in served
+    for f in bundle["files"]:
+        assert (d / f["served"]).is_file(), f["served"]
+        assert (d / f["served"]).stat().st_size == f["bytes"]
+    rep = json.load(open(d / "REPRODUCTION.json", encoding="utf-8"))
+    assert rep["evidence_bundle"]["bundle_sha256"] == bundle["bundle_sha256"]
+    assert rep["evidence_bundle"]["n_files"] == bundle["n_files"] >= 30
+
+
+def test_enforcement_experiment_rejects_each_single_mutation_and_passes_after_restore():
+    record = enforcement_experiment.run(str(ROOT / "docs/reviews/glp1-ra-mace-t2d"))
+    assert record["control"]["pass"], record["control"]
+    names = [m["mutation"] for m in record["mutations"]]
+    assert names == ["custody_body", "cache_abstract", "certificate_digest", "review_number", "endpoint_binding"]
+    for m in record["mutations"]:
+        assert m["verdict"] == "ENFORCED", m
+        assert m["restored_pass"] is True
+    by = {m["mutation"]: m for m in record["mutations"]}
+    assert any(f.startswith("certificate_held[") for f in by["certificate_digest"]["failing"])
+    assert "review_sha256" in by["review_number"]["failing"] and "review_sha256" in by["endpoint_binding"]["failing"]
+    assert any(f.startswith("custody[") for f in by["custody_body"]["failing"])
+    assert record["verdict"] == "ENFORCED"
