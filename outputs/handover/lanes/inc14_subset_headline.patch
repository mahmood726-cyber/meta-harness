+def subset_headline(r: dict) -> dict | None:
+    """When the primary pool's membership is known incomplete, the headline is a SUBSET estimate: its label carries
+    the denominator from the trial-family ledger and the heterogeneity numerals are withheld from the headline (they
+    remain in the outcome audit block as descriptive values). None when membership is complete."""
+    if not _grade_mod.membership_incomplete(r):
+        return None
+    prim = next((o for o in (r.get("outcomes") or []) if o.get("primary")), None) or {}
+    k = (prim.get("result") or {}).get("k")
+    counts = (r.get("trial_family_ledger") or {}).get("counts") or {}
+    pooled = counts.get("pooled_primary", k)
+    missing = counts.get("eligible_not_pooled_primary")
+    denom = (pooled or 0) + (missing or 0) if pooled is not None and missing is not None else None
+    of = f" of {denom} eligible families" if denom else ""
+    return {
+        "label": f"Subset estimate (k={k}{of}; not the current systematic-review estimate)",
+        "withheld": ("withheld from the headline: the pool's membership is known incomplete, so tau^2, I^2 and the "
+                     "prediction interval are descriptive only (values in the outcome audit block)"),
+    }
+
