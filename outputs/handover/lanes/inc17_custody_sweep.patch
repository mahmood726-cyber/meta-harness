diff --git a/tests/test_record_custody_sweep_every_pooled_record.py b/tests/test_record_custody_sweep_every_pooled_record.py
new file mode 100644
index 00000000..0582d84f
--- /dev/null
+++ b/tests/test_record_custody_sweep_every_pooled_record.py
@@ -0,0 +1,102 @@
+"""External re-audit of 6d6bacad (19 Sep 2026), finding 1, second half: "sweep every other row". Every pooled record of
+every served topic (107 pooled rows + ELIXA's known-missing record, 32 topics) now has its PubMed response bytes held in tree and its cache abstract proven
+to be fetch.parse_efetch(held bytes). The sweep found: 101 identical; 3 whitespace-flattened (thin/em/no-break spaces
+-> ASCII); 2 with section labels dropped (pcsk9-mace); 2 STITCHED -- SOUL (glp1) and the omarigliptin CV safety study
+(dpp4-mace-t2d, PMID 28893244, 1138 of 2167 chars, entered by hand at 2355a306 "RECOVERY (source-verified)"). No pooled
+result or per-trial number moved on repair.
+
+Requirements: every pooled PMID row of every served topic has a custody row whose held bytes verify; the state counts
+are pinned; the omarigliptin pre-fix cache text is refused against its held bytes (plant); a topic's rows carry
+record_custody HELD_RAW in the served object once rebuilt.
+"""
+import glob
+import hashlib
+import json
+import os
+import pathlib
+import subprocess
+
+from harness import record_custody as rc
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+OMARIGLIPTIN_PREFIX_SHA256 = "efe2977f783361f16b9ab885343a5c55f4aa6804427f621be5575a7a74461ce4"
+
+
+def _served_slugs():
+    return sorted(os.path.basename(os.path.dirname(p)) for p in glob.glob(str(ROOT / "docs/reviews/*/review.json")))
+
+
+def _pooled_pmids(slug):
+    review = json.loads((ROOT / "docs/reviews" / slug / "review.json").read_text(encoding="utf-8"))
+    return sorted({str(t["id"]).replace("PMID ", "") for o in review["outcomes"] for t in (o.get("trials") or [])
+                   if str(t.get("id", "")).startswith("PMID")})
+
+
+def test_every_pooled_record_of_every_served_topic_has_verified_custody():
+    missing, violations, states = [], [], {}
+    for slug in _served_slugs():
+        custody = rc.load(slug)["records"]
+        records = json.loads((ROOT / "cache" / slug / "records.json").read_text(encoding="utf-8"))["records"]
+        for pmid in _pooled_pmids(slug):
+            if pmid not in custody:
+                missing.append((slug, pmid))
+            else:
+                states[custody[pmid]["cache"]["state"]] = states.get(custody[pmid]["cache"]["state"], 0) + 1
+        violations.extend((slug, v) for v in rc.verify(slug, records))
+    assert missing == [], missing
+    assert violations == [], violations
+    # 107 pooled rows; the 108th custody row is ELIXA (glp1's known-missing record, held but not pooled), IDENTICAL
+    assert states == {"IDENTICAL": 100, "REPLACED_WHITESPACE_NORMALISED": 3, "REPLACED_LABELS_DROPPED": 2, "REPLACED_STITCHED": 2}
+    assert rc.load("glp1-ra-mace-t2d")["records"]["26630143"]["cache"]["state"] == "IDENTICAL"
+
+
+def test_the_two_stitched_records_are_the_hand_inserted_recoveries():
+    stitched = {}
+    for slug in _served_slugs():
+        for pmid, row in rc.load(slug)["records"].items():
+            if row["cache"]["state"] == "REPLACED_STITCHED":
+                stitched[(slug, pmid)] = row["cache"]["previous"]
+    assert set(stitched) == {("glp1-ra-mace-t2d", "40162642"), ("dpp4-mace-t2d", "28893244")}
+    assert stitched[("dpp4-mace-t2d", "28893244")]["abstract_sha256"] == OMARIGLIPTIN_PREFIX_SHA256
+    assert stitched[("dpp4-mace-t2d", "28893244")]["chars"] == 1138
+    omitted = " ".join(s["held"] for s in stitched[("dpp4-mace-t2d", "28893244")]["omitted_segments"])
+    assert "business decision was made not to submit a marketing application" in omitted
+    assert "2.96/100 patient-years" in omitted and "hospitalization for heart failure" in omitted
+
+
+def test_plant_prefix_omarigliptin_cache_text_is_refused_against_held_bytes(tmp_path):
+    slug, pmid = "dpp4-mace-t2d", "28893244"
+    prefix = json.loads(subprocess.check_output(["git", "show", f"0dd5df02:cache/{slug}/records.json"], cwd=ROOT).decode("utf-8"))
+    stitched = next(r for r in prefix["records"] if str(r["id"]) == pmid)["abstract"]
+    assert hashlib.sha256(stitched.encode("utf-8")).hexdigest() == OMARIGLIPTIN_PREFIX_SHA256
+    root = tmp_path / "root"
+    (root / "cache" / slug).mkdir(parents=True)
+    records = json.loads((ROOT / "cache" / slug / "records.json").read_text(encoding="utf-8"))["records"]
+    next(r for r in records if str(r["id"]) == pmid)["abstract"] = stitched
+    custody = rc.load(slug)
+    for row in custody["records"].values():
+        dst = root / row["body_path"]
+        dst.parent.mkdir(parents=True, exist_ok=True)
+        dst.write_bytes((ROOT / row["body_path"]).read_bytes())
+    (root / "cache" / slug / rc.FILENAME).write_text(json.dumps(custody), encoding="utf-8")
+    violations = rc.verify(slug, records, cache_root=str(root / "cache"), root=str(root))
+    assert [(v["pmid"], v["code"]) for v in violations] == [(pmid, "CACHE_ABSTRACT_NOT_DERIVED_FROM_HELD_BYTES")]
+
+
+def test_replacement_states_name_what_the_cache_text_was():
+    assert rc.replacement_state("a b c", "a b c") == "REPLACED_WHITESPACE_NORMALISED"
+    assert rc.replacement_state("Alpha.\n\nBeta.", "BACKGROUND: Alpha. METHODS: Beta.") == "REPLACED_LABELS_DROPPED"
+    assert rc.replacement_state("Alpha. Beta.", "BACKGROUND: Alpha. Gamma. METHODS: Beta.") == "REPLACED_STITCHED"
+
+
+def test_whole_abstract_source_spans_were_rederived_from_held_bytes_not_retyped():
+    for slug, pmid in (("colchicine-secondary-cv-prevention", "39555823"), ("pcsk9-mace", "25773378")):
+        ve = json.loads((ROOT / "cache" / slug / "verified_effects.json").read_text(encoding="utf-8"))[pmid]
+        entries = ve if isinstance(ve, list) else [ve]
+        records = {str(r["id"]): r for r in json.loads((ROOT / "cache" / slug / "records.json").read_text(encoding="utf-8"))["records"]}
+        rederived = [e for e in entries if e.get("source_span_previous_sha256")]
+        assert rederived, (slug, pmid)
+        for e in rederived:
+            assert e["source_span"] == records[pmid]["abstract"]
+            assert e["source_span_previous_sha256"] == rc.load(slug)["records"][pmid]["cache"]["previous"]["abstract_sha256"]
+            assert "record_custody" in e["source_span_transformation"]
