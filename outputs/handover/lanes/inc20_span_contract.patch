diff --git a/tests/test_literal_and_normalised_quotation_are_separate_contracts.py b/tests/test_literal_and_normalised_quotation_are_separate_contracts.py
new file mode 100644
index 00000000..fc7a7606
--- /dev/null
+++ b/tests/test_literal_and_normalised_quotation_are_separate_contracts.py
@@ -0,0 +1,95 @@
+"""External re-audit of the served glp1 page 6d6bacad (19 Sep 2026), finding 2: literal and normalised quotation are
+different contracts. REWIND's cached abstract (PMID 31189511) uses middle-dot decimals ("5·4 years (IQR 5·1-5·9)
+... HR 0·88"); the row's endpoint_result_span read "5.4 years (IQR 5.1-5.9) ... 0.88" and was presented as the span --
+a text that is not in the document it cites. The same holds for HARMONY Outcomes (30291013).
+
+Requirements: every span a pooled row carries is recorded under two named fields -- the display-normalised text and,
+where it differs, the literal slice of the held abstract at the shared offset -- with the transformation named
+(extract._norm, same-length so offsets are shared); the page labels the shown text display-normalised and shows the
+literal beside it; an abstract-provenance span that is not in the held abstract even after normalisation REFUSES the
+build (SPAN_NOT_IN_HELD_ABSTRACT). Plant, fired pre-fix: on 0dd5df02 REWIND's endpoint_result_span is not a substring
+of its cached abstract and no field on the row says so.
+"""
+import html
+import json
+import pathlib
+import re
+import subprocess
+
+import pytest
+
+from harness import extract, target_endpoint as te
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+SLUG = "glp1-ra-mace-t2d"
+
+
+def _review():
+    return json.loads((ROOT / "docs/reviews" / SLUG / "review.json").read_text(encoding="utf-8"))
+
+
+def _records():
+    return {str(r["id"]): r for r in json.loads((ROOT / "cache" / SLUG / "records.json").read_text(encoding="utf-8"))["records"]}
+
+
+def _primary(review):
+    return next(o for o in review["outcomes"] if o.get("primary"))
+
+
+def test_plant_prefix_rewind_span_was_not_in_its_abstract_and_nothing_said_so():
+    prefix = json.loads(subprocess.check_output(["git", "show", f"0dd5df02:docs/reviews/{SLUG}/review.json"], cwd=ROOT))
+    rewind = next(t for t in _primary(prefix)["trials"] if t["id"] == "PMID 31189511")
+    abstract = _records()["31189511"]["abstract"]
+    assert "5·4 years (IQR 5·1-5·9)" in abstract  # the held literal
+    assert rewind["endpoint_result_span"] not in abstract
+    assert "span_contract" not in rewind and "endpoint_result_span_literal" not in rewind
+
+
+def test_every_pooled_row_carries_both_contracts_and_the_literal_where_it_differs():
+    recs = _records()
+    rows = _primary(_review())["trials"]
+    assert len(rows) == 8
+    differing = set()
+    for t in rows:
+        abstract = recs[t["id"].replace("PMID ", "")]["abstract"]
+        sc = t["span_contract"]
+        assert sc["display_normalisation"] == te.SPAN_NORMALISATION
+        for key in ("endpoint_result_span", "endpoint_definition_span"):
+            c = sc["spans"][key]
+            assert c["literal_located_in_held_abstract"] is True
+            literal = abstract[c["offset"]:c["offset"] + len(t[key])]
+            assert extract._norm(literal) == t[key]          # the display text is the normalisation of the literal
+            if c["differs_from_display"]:
+                assert t[key + "_literal"] == literal and literal != t[key]
+                differing.add(t["label"])
+            else:
+                assert key + "_literal" not in t and literal == t[key]
+    assert differing == {"31189511", "30291013"}  # REWIND, HARMONY Outcomes (Lancet middle-dot decimals)
+    rewind = next(t for t in rows if t["id"] == "PMID 31189511")
+    assert "5·4 years (IQR 5·1-5·9)" in rewind["endpoint_result_span_literal"] and "0·88" in rewind["endpoint_result_span_literal"]
+    assert "5.4 years (IQR 5.1-5.9)" in rewind["endpoint_result_span"]
+
+
+def test_an_abstract_span_not_in_the_held_abstract_is_refused():
+    abstract = _records()["31189511"]["abstract"]
+    row = {"id": "PMID 31189511", "provenance": "abstract",
+           "endpoint_result_span": "hazard ratio [HR] 0.88, 95% CI 0.79-0.99", "endpoint_definition_span": "a sentence the abstract never says"}
+    with pytest.raises(ValueError, match="SPAN_NOT_IN_HELD_ABSTRACT.*endpoint_definition_span"):
+        te.attach_span_contract(row, abstract)
+    # a full-text-provenance row is not an abstract quotation: recorded as such, not refused
+    ft = {"id": "PMID 1", "provenance": "fulltext_verified", "endpoint_result_span": "from the full text"}
+    assert te.attach_span_contract(ft, abstract)["span_contract"]["spans"]["endpoint_result_span"]["literal_located_in_held_abstract"] is False
+
+
+def test_literal_span_refuses_to_guess_when_the_normaliser_is_not_same_length():
+    assert te.literal_span("a·b", "a.b") == {"offset": 0, "literal": "a·b", "count_in_normalised": 1, "differs_from_display": True}
+    assert te.literal_span("abc", "zzz") is None
+
+
+def test_page_labels_the_shown_span_normalised_and_shows_the_literal_beside_it():
+    page = html.unescape((ROOT / "docs/reviews" / SLUG / "index.html").read_text(encoding="utf-8"))
+    text = re.sub(r"\s+", " ", re.sub(r"<[^>]+>", " ", page))
+    assert text.count("result span (display-normalised):") >= 8
+    assert "literal in the held abstract: During a median follow-up of 5·4 years (IQR 5·1-5·9)" in text
+    assert "(offset 1704; extract._norm: middle-dot decimal separators" in text
+    assert "identical to the literal held abstract at offset" in text
