diff --git a/harness/target_endpoint.py b/harness/target_endpoint.py
index 554df973..a459ae34 100644
--- a/harness/target_endpoint.py
+++ b/harness/target_endpoint.py
@@ -913,3 +913,55 @@ def select_target_endpoint(
         "selected_candidate": _public_candidate(selected),
         "near_match_while_exact_exists": bool(exact and selected.get("target_endpoint_class") == NEAR_MATCH),
     }
+
+
+# LITERAL vs DISPLAY-NORMALISED QUOTATION (external re-audit of 6d6bacad, finding 2): the spans a row carries are
+# cut from extract._norm(abstract) -- middle-dot decimals rewritten to '.', a same-length substitution -- so a
+# "span" such as REWIND's "5.4 years (IQR 5.1-5.9)" is NOT a literal quotation of the held abstract ("5·4 years
+# (IQR 5·1-5·9)"). Two contracts, two fields: the literal slice at the shared offsets, and the normalised text
+# with the transformation named. An abstract-provenance span that does not locate in the normalised abstract
+# is a refusal (a quotation that is not in the document it cites), never a footnote.
+SPAN_NORMALISATION = "extract._norm: middle-dot decimal separators (U+00B7, U+2027, U+2219) -> '.'; same length, offsets shared"
+SPAN_NOT_IN_HELD_ABSTRACT = "SPAN_NOT_IN_HELD_ABSTRACT"
+_ABSTRACT_PROVENANCE = {"abstract", "abstract_verified"}
+
+
+def literal_span(abstract: str, normalised_span: str) -> dict[str, Any] | None:
+    """Locate a normalised span in extract._norm(abstract) and return the literal slice at the same offsets."""
+    if not normalised_span or not abstract:
+        return None
+    norm = extract._norm(abstract)
+    if len(norm) != len(abstract):  # the normaliser is same-length by construction; refuse to guess otherwise
+        return None
+    offset = norm.find(normalised_span)
+    if offset < 0:
+        return None
+    literal = abstract[offset:offset + len(normalised_span)]
+    return {"offset": offset, "literal": literal, "count_in_normalised": norm.count(normalised_span),
+            "differs_from_display": literal != normalised_span}
+
+
+def attach_span_contract(trial: dict[str, Any], abstract: str) -> dict[str, Any]:
+    """Record, per span the row carries, the literal quotation and the display-normalised text as separate fields.
+    Refuses (ValueError) an abstract-provenance row whose span is not in the held abstract even after normalisation."""
+    contract: dict[str, Any] = {"display_normalisation": SPAN_NORMALISATION, "spans": {}}
+    prov = trial.get("provenance")
+    for key in ("endpoint_result_span", "endpoint_definition_span"):
+        span = trial.get(key)
+        if not span:
+            continue
+        located = literal_span(abstract or "", span)
+        if located is None:
+            if prov in _ABSTRACT_PROVENANCE:
+                raise ValueError(f"{SPAN_NOT_IN_HELD_ABSTRACT}: {trial.get('id')} {key} is not in the held abstract "
+                                 f"even after display normalisation: {span[:80]!r}")
+            contract["spans"][key] = {"literal_located_in_held_abstract": False,
+                                      "detail": "not an abstract span (provenance %s); literal custody follows the row's held document" % prov}
+            continue
+        contract["spans"][key] = {"literal_located_in_held_abstract": True, "offset": located["offset"],
+                                  "differs_from_display": located["differs_from_display"],
+                                  **({"literal": located["literal"]} if located["differs_from_display"] else {})}
+        if located["differs_from_display"]:
+            trial[key + "_literal"] = located["literal"]
+    trial["span_contract"] = contract
+    return trial
