diff --git a/tests/test_elixa_span_roles_resolve_and_offsets_replay.py b/tests/test_elixa_span_roles_resolve_and_offsets_replay.py
new file mode 100644
index 00000000..f4620428
--- /dev/null
+++ b/tests/test_elixa_span_roles_resolve_and_offsets_replay.py
@@ -0,0 +1,106 @@
+"""External re-audit of the served glp1 page 6d6bacad (19 Sep 2026), ELIXA: the auditor independently confirmed the
+three renderings of the FDA 3-point MACE result share events 400/392 (one analysis printed three ways) and that
+1.172 rounds to 1.17, so Table 8's 1.18 is the outlier; asked that the finding feed ADJ-GLP1-005 (kept PROPOSED,
+uncountersigned), that the declared offsets be replayed against the held bytes with the result recorded, and that the
+selected / conflicting span ids be machine-resolvable rather than prose.
+
+Requirements: source_conflict names definition_span_id, selected_result_span_id, conflicting_span_ids and
+excluded_endpoint_span_ids that RESOLVE to spans_preserved keys (an unresolvable id refuses the build:
+SPAN_ID_UNRESOLVED); the fact object carries span_roles with a span_location_check stating how many preserved spans
+replayed at their declared offsets; the page prints the roles and the replay; ADJ-GLP1-005's state is unchanged.
+Plant, fired pre-fix: on 0dd5df02 the fact has no span_roles and a conflict whose ids point nowhere builds silently.
+"""
+import copy
+import html
+import json
+import pathlib
+import re
+
+import pytest
+
+from harness import claimgraph
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+SLUG = "glp1-ra-mace-t2d"
+MANIFEST = ROOT / "outputs/handover/glp1_regulatory/regulatory_sources_glp1.json"
+ADJ = ROOT / "outputs/handover/glp1_regulatory/ADJUDICATIONS.json"
+
+
+def _elixa_source_and_decision():
+    manifest = json.loads(MANIFEST.read_text(encoding="utf-8"))
+    for source in manifest["sources"]:
+        for decision in source.get("decisions", []):
+            if decision.get("trial") == "ELIXA" and decision.get("source_conflict"):
+                return source, decision
+    raise AssertionError("ELIXA source_conflict decision not in the manifest")
+
+
+def _adjudications():
+    return json.loads(ADJ.read_text(encoding="utf-8"))["decisions"]
+
+
+def test_span_ids_resolve_and_the_offset_replay_is_recorded():
+    source, decision = _elixa_source_and_decision()
+    fact = claimgraph.regulatory_fact(str(ROOT), source, decision, _adjudications())
+    roles = fact["span_roles"]
+    preserved = set(decision["source_conflict"]["spans_preserved"])
+    assert roles["definition"] == "definition_3p" and roles["selected_result"] == "text_unrounded_3p"
+    assert set(roles["conflicting"]) == {"table8_onstudy_3p", "executive_summary_3p"}
+    assert set(roles["excluded_endpoint"]) == {"primary_4p_table6", "primary_4p_text", "primary_4p_unrounded_text"}
+    assert {roles["definition"], roles["selected_result"], *roles["conflicting"], *roles["excluded_endpoint"]} <= preserved
+    slc = roles["span_location_check"]
+    assert slc == {"replayed_at_build": True, "spans_checked": 8, "all_at_declared_offsets": True,
+                   "against": "extracted text (universal newlines)", "extracted_text_sha256": source["extracted_text_sha256"]}
+    # the selected span carries the unrounded interval and the same events as the conflicting Table 8 rendering
+    # (the preserved spans are LITERAL, line breaks included; the comparison here is on a whitespace-collapsed
+    # reading, which is a different contract from the quotation itself and is named as such)
+    by_kind = {s["kind"]: " ".join(s["span"].split()) for s in fact["spans"]}
+    assert "(0.887, 1.172)" in by_kind["text_unrounded_3p"] and "392 and 400" in by_kind["text_unrounded_3p"]
+    assert "1.02 (0.89, 1.18)" in by_kind["table8_onstudy_3p"] and "392 (12.9%)" in by_kind["table8_onstudy_3p"] and "400 (13.2%)" in by_kind["table8_onstudy_3p"]
+
+
+def test_plant_an_unresolvable_span_id_refuses_the_fact():
+    source, decision = _elixa_source_and_decision()
+    bad = copy.deepcopy(decision)
+    bad["source_conflict"]["conflicting_span_ids"] = ["table8_onstudy_3p", "table_9_does_not_exist"]
+    with pytest.raises(ValueError, match="SPAN_ID_UNRESOLVED.*table_9_does_not_exist"):
+        claimgraph.regulatory_fact(str(ROOT), source, bad, _adjudications())
+    incomplete = copy.deepcopy(decision)
+    incomplete["source_conflict"].pop("selected_result_span_id")
+    with pytest.raises(ValueError, match="SPAN_ROLES_INCOMPLETE"):
+        claimgraph.regulatory_fact(str(ROOT), source, incomplete, _adjudications())
+
+
+def test_a_moved_offset_is_still_a_refusal_not_a_relocation():
+    source, decision = _elixa_source_and_decision()
+    moved = copy.deepcopy(decision)
+    moved["source_conflict"]["spans_preserved"]["definition_3p"]["offset"] += 1
+    with pytest.raises(ValueError, match="source span mismatch"):
+        claimgraph.regulatory_fact(str(ROOT), source, moved, _adjudications())
+
+
+def test_adj_005_records_the_concurrence_and_stays_proposed():
+    a5 = next(a for a in _adjudications() if a["id"] == "ADJ-GLP1-005")
+    assert a5["state"].startswith("PROPOSED")
+    assert "countersignature OWED" in a5["state"]
+    conc = a5["external_audit_concurrence_2026-09-19"]
+    assert "400/392" in conc["confirmed"] and "1.18 is the outlier" in conc["confirmed"]
+    assert conc["state_after"].startswith("PROPOSED")
+    _, decision = _elixa_source_and_decision()
+    assert "1.172 rounds to 1.17" in decision["source_conflict"]["same_analysis_evidence"]
+
+
+def test_glp1_page_prints_the_roles_and_the_replay():
+    review = json.loads((ROOT / "docs/reviews" / SLUG / "review.json").read_text(encoding="utf-8"))
+    primary = next(o for o in review["outcomes"] if o.get("primary"))
+    row = next(r for r in primary["known_missing_sensitivity"]["rows"] if r["trial_key"] == "26630143")
+    assert row["value_status"] == "EXTRACTED_SOURCE_CONFLICT"
+    assert row["held_fact"]["span_roles"]["span_location_check"]["spans_checked"] == 8
+    assert row["held_fact"]["adjudication"] == {"id": "ADJ-GLP1-005", "state": "PROPOSED", "countersigned": False}
+    page = html.unescape((ROOT / "docs/reviews" / SLUG / "index.html").read_text(encoding="utf-8"))
+    text = re.sub(r"\s+", " ", re.sub(r"<[^>]+>", " ", page))
+    assert "selected result text_unrounded_3p" in text
+    assert "conflicting table8_onstudy_3p, executive_summary_3p" in text
+    assert "Offsets replayed at build against the held extracted text: 8 of 8 at their declared offsets" in text
+    assert "table8_onstudy_3p -- conflicting rendering (same analysis, not selected)" in text
+    assert "ADJ-GLP1-005 PROPOSED (not countersigned)" in text
