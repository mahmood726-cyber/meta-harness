+    else:
+        covered = {str(c) for c in covered}
+        row["coverage"] = {"state": "PARTIAL" if any(t["pmid"] not in covered for t in pooled) else "FULL",
+                           "pooled_k": len(pooled), "covered_n": sum(t["pmid"] in covered for t in pooled),
+                           "not_covered": [t for t in pooled if t["pmid"] not in covered],
+                           "covered_not_pooled": sorted(covered - {t["pmid"] for t in pooled})}
