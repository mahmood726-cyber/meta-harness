diff --git a/tests/test_dual_tally_names_the_rows_it_covers.py b/tests/test_dual_tally_names_the_rows_it_covers.py
new file mode 100644
index 00000000..274f755d
--- /dev/null
+++ b/tests/test_dual_tally_names_the_rows_it_covers.py
@@ -0,0 +1,72 @@
+"""External re-audit of the served glp1 page 6d6bacad (19 Sep 2026), finding 3: the second-extraction accounting
+covers seven of eight pooled results (agree 0, reconcile 5, not_checkable 2 = 7) while the page pools eight. The tally
+in docs/dual_extract.json was taken on 2026-09-11 (5852379a) over the k=7 input set; SOUL entered the pool on
+2026-09-13; the extractor's per-trial rows lived in a scratchpad and were never committed.
+
+Requirements: the tally names the input-set version and the PMIDs it covers; the build compares that set with the
+CURRENT primary pool and names every pooled row the tally does not cover (never "5 of 5 checkable" over an unnamed
+denominator); a tally with no covered set renders coverage NOT ESTABLISHED; "reconcile" is stated as the same result
+via a different statistic, not identical digits; per-trial rows not held is said. Plant, fired pre-fix: on 0dd5df02 the
+glp1 page reads "agreed or reconciled on 5 of 5 that are checkable from the abstract" with SOUL outside the tally and
+no surface saying so.
+"""
+import html
+import json
+import pathlib
+import re
+import subprocess
+
+from harness import census
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+SLUG = "glp1-ra-mace-t2d"
+
+
+def _review():
+    return json.loads((ROOT / "docs/reviews" / SLUG / "review.json").read_text(encoding="utf-8"))
+
+
+def test_plant_the_prefix_page_stated_the_tally_over_an_unnamed_denominator():
+    page = subprocess.check_output(["git", "show", f"0dd5df02:docs/reviews/{SLUG}/index.html"], cwd=ROOT).decode("utf-8")
+    text = re.sub(r"\s+", " ", re.sub(r"<[^>]+>", " ", html.unescape(page)))
+    assert "agreed or reconciled on 5 of 5 that are checkable" in text
+    assert "NOT COVERED by the tally" not in text
+    tally = json.loads(subprocess.check_output(["git", "show", "0dd5df02:docs/dual_extract.json"], cwd=ROOT))[SLUG]
+    assert "covered_pmids" not in tally and tally == {"agree": 0, "reconcile": 5, "not_checkable": 2, "conflict": 0}
+
+
+def test_coverage_is_computed_against_the_current_primary_pool():
+    row = census._dual_row(str(ROOT), SLUG, _review())
+    cov = row["coverage"]
+    assert cov["state"] == "PARTIAL" and cov["pooled_k"] == 8 and cov["covered_n"] == 7
+    assert cov["not_covered"] == [{"pmid": "40162642", "label": "SOUL"}]
+    assert cov["covered_not_pooled"] == []
+    assert row["input_set_at_tally"] == {"k": 7, "review_sha256": "8363d847197a525a"} and row["tally_commit"] == "5852379a"
+    assert row["agree"] + row["reconcile"] + row["not_checkable"] == 7 == len(row["covered_pmids"])
+    assert "not identical digits" in row["reconcile_means"]
+    assert row["per_trial_rows"].startswith("NOT HELD")
+
+
+def test_a_tally_without_a_covered_set_is_not_established(tmp_path):
+    root = tmp_path / "root"
+    (root / "docs").mkdir(parents=True)
+    (root / "docs" / "dual_extract.json").write_text(json.dumps({"x": {"agree": 3, "reconcile": 0, "not_checkable": 0, "conflict": 0}}), encoding="utf-8")
+    review = {"outcomes": [{"primary": True, "trials": [{"id": "PMID 1", "label": "A"}, {"id": "PMID 2", "label": "B"}]}]}
+    row = census._dual_row(str(root), "x", review)
+    assert row["coverage"]["state"] == "NOT_ESTABLISHED" and row["coverage"]["pooled_k"] == 2
+    # the same tally naming its rows: full coverage, and a covered row that left the pool is named
+    (root / "docs" / "dual_extract.json").write_text(json.dumps({"x": {"agree": 3, "reconcile": 0, "not_checkable": 0, "conflict": 0,
+                                                                        "covered_pmids": ["1", "2", "9"]}}), encoding="utf-8")
+    row = census._dual_row(str(root), "x", review)
+    assert row["coverage"]["state"] == "FULL" and row["coverage"]["covered_not_pooled"] == ["9"]
+
+
+def test_glp1_page_and_reproduction_name_soul_as_not_covered():
+    rep = json.loads((ROOT / "docs/reviews" / SLUG / "REPRODUCTION.json").read_text(encoding="utf-8"))
+    assert rep["dual"]["coverage"]["not_covered"] == [{"pmid": "40162642", "label": "SOUL"}]
+    page = html.unescape((ROOT / "docs/reviews" / SLUG / "index.html").read_text(encoding="utf-8"))
+    text = re.sub(r"\s+", " ", re.sub(r"<[^>]+>", " ", page))
+    assert "Of this page's 8 pooled numbers, the blind second extraction (tally of 2026-09-11, input set k=7) covers 7" in text
+    assert "NOT COVERED by the tally: SOUL (PMID 40162642)" in text
+    assert "not identical digits" in text and "Per-trial rows: NOT HELD" in text
+    assert "5 of 5 that are checkable" not in text
