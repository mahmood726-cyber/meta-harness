+        check=True,
+        capture_output=True,
+    )
+    return json.loads(proc.stdout.decode("utf-8"))
+
+
+def _live_review() -> dict:
+    return _load_json(ROOT / "docs" / "reviews" / SLUG / "review.json")
+
+
+def _primary(review: dict) -> dict:
+    return next(o for o in review["outcomes"] if o.get("primary"))
+
+
+def _trial(outcome: dict, pmid: str) -> dict:
+    return next(t for t in outcome["trials"] if str(t.get("id", "")).endswith(pmid))
+
+
+def test_base_object_had_staree_pooled_but_no_recovery_semantics():
+    """Plant against the committed pre-fix object.
+
+    The lane prompt said STAREE was absent pre-fix, but the actual base object already pooled PMID
+    42670961. The missing contract was not membership; it was population-basis and endpoint semantics.
+    """
+    base = _git_json(f"docs/reviews/{SLUG}/review.json")
+    base_primary = _primary(base)
+    base_staree = _trial(base_primary, "42670961")
+    assert base_staree["effect"] == 0.7
+    assert base_staree["scale"] == "HR"
+    assert "population_basis" not in base_staree
+    assert "endpoint_change" not in base_staree
+    assert "population_basis" not in (base_primary.get("compat_key") or {})
+    assert "strands" not in base
+
+    base_ledger = _git_json(f"cache/{SLUG}/retrieval_ledger.json")
+    assert "EXTRA_PMIDS" not in {s["kind"] for s in base_ledger["sources"]}
+    assert base_ledger["records"]["42670961"]["found_by"] == ["legacy_unrecorded#1"]
+
+
+def test_live_staree_recovery_contract_and_legacy_ledger_truth():
+    live = _live_review()
+    primary = _primary(live)
+    staree = _trial(primary, "42670961")
+    jupiter = _trial(primary, "20404379")
+
+    assert staree["population_basis"] == "DIRECT"
+    assert jupiter["population_basis"] == "SUBGROUP_OF_BROADER_TRIAL"
+    assert jupiter["subgroup_basis"]["variable"] == "age"
+    assert jupiter["subgroup_basis"]["randomisation_preserved"] is True
+    assert staree["endpoint_change"]["code"] == "ENDPOINT_CHANGED_PRE_ANALYSIS"
+    assert staree["endpoint_change"]["canonical_endpoint"] == "3-point hard cardiovascular events"
+
+    # STAREE stays as the source-reported HR. The verified arm counts are audit metadata, not a crude
+    # reconstructed input that replaces the published effect.
+    assert staree["effect"] == 0.7
+    assert staree["scale"] == "HR"
+    assert staree["derivation"] == "reported"
+    assert "ai" not in staree and "n1i" not in staree
+
+    ck = primary["compat_key"]
+    assert ck["population_basis"]["matched"] is False
+    assert any(
+        item["code"] == "COMPAT_DIMENSION_HETEROGENEOUS"
+        and item["dimension"] == "population_basis"
+        for item in ck.get("limitations", [])
+    )
+
+    screening = {r["id"]: r for r in live["screening"]["records"]}
+    assert screening["42670961"]["found_by"] == ["legacy_unrecorded#1"]
+
+    ledger = _load_json(ROOT / "cache" / SLUG / "retrieval_ledger.json")
+    records_doc = _load_json(ROOT / "cache" / SLUG / "records.json")
+    assert "EXTRA_PMIDS" not in {s["kind"] for s in ledger["sources"]}
+    assert ledger["records"]["42670961"]["found_by"] == ["legacy_unrecorded#1"]
+    assert acq.validate(ledger, records_doc["records"]) == []
+
+    verified_arms = _load_json(ROOT / "cache" / SLUG / "verified_arms.json")
+    assert verified_arms["42670961"]["ai"] == 297
+    assert verified_arms["42670961"]["ci"] == 412
+    assert verified_arms["42670961"]["use_in_pool"] is False
+
+
+def test_statins_strands_and_named_trial_dispositions_are_machine_readable():
+    live = _live_review()
+
+    dispositions = {d["trial"]: d for d in live["trial_dispositions"]}
+    assert dispositions["HOPE-3 older-age subgroup"]["status"] == "REACH_MISS(named)"
+    assert dispositions["HOPE-3 older-age subgroup"]["subgroup_basis"]["randomisation_preserved"] is True
+    assert dispositions["PROSPER primary-prevention subgroup"]["status"] == "IN_SOURCE_NOT_HELD"
+    assert dispositions["PROSPER primary-prevention subgroup"]["effect_text"] == "RR 0.94 (0.78-1.14)"
+    assert "X-COMPARATOR" in dispositions["ALLHAT-LLT"]["codes"]
+    assert dispositions["observational comparator"]["status"] == "CONTEXTUAL_ONLY"
+    assert live["age_threshold"]["status"] == "EXECUTABLE"
+    assert live["age_threshold"]["protocol_minimum_years"] == 70
+
+    strands = live["strands"]
+    by_id = {s["strand"]: s for s in strands["strands"]}
+    assert by_id["DIRECT_BROADER_COMPOSITE"]["population_basis"] == "DIRECT"
+    assert by_id["SUBGROUP_OF_BROADER_TRIAL"]["population_basis"] == "SUBGROUP_OF_BROADER_TRIAL"
+    assert by_id["COMBINED_BROADER_COMPOSITE"]["pool"]["ci_refused"] == "K2_SINGLE_DF"
+    hard = by_id["DIRECT_3_POINT_HARD_CV_EVENTS"]
+    assert hard["typed_absence"]["code"] == "IN_SOURCE_NOT_HELD"
+    assert hard["typed_absence"]["owed_source"] == "STAREE full text"
+
+    html = (ROOT / "docs" / "reviews" / SLUG / "index.html").read_text(encoding="utf-8")
+    assert "Known named age-subgroup evidence not yet consumed" in html
+    assert "HOPE-3 older-age subgroup" in html
+    assert "Population-basis and endpoint strands" in html
+    assert "ENDPOINT_CHANGED_PRE_ANALYSIS" in html
+    assert "IN_SOURCE_NOT_HELD" in html
+
+
+def test_population_basis_sweep_counts_statins_page():
+    sweep_path = ROOT / "docs" / "population_basis_sweep.json"
+    assert sweep_path.exists()
+    sweep = _load_json(sweep_path)
+    pages = {p["slug"]: p for p in sweep["pages"]}
+    statins = pages[SLUG]
+    assert statins["pooled_rows"] == 2
+    assert statins["direct_rows"] == 1
+    assert statins["subgroup_of_broader_trial_rows"] == 1
+    assert statins["subgroup_only"] is False
