new file mode 100644
index 00000000..b7c23d84
--- /dev/null
+++ b/scripts/population_basis_sweep.py
@@ -0,0 +1,89 @@
+"""Summarize pooled-row population basis across generated review pages.
+
+The sweep is intentionally read-only over review cores and writes one deterministic JSON artifact:
+
+    python scripts/population_basis_sweep.py
+"""
+from __future__ import annotations
+
+import json
+from pathlib import Path
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parents[1]
+REVIEWS = ROOT / "docs" / "reviews"
+OUT = ROOT / "docs" / "population_basis_sweep.json"
+GENERATED_UTC = "2026-09-16"
+
+SUBGROUP_UNITS = {"prespecified_subgroup", "post_hoc_subgroup"}
+
+
+def _primary(review: dict[str, Any]) -> dict[str, Any] | None:
+    outcomes = review.get("outcomes") or []
+    return next((o for o in outcomes if o.get("primary")), outcomes[0] if outcomes else None)
+
+
+def _basis(row: dict[str, Any]) -> str:
+    declared = row.get("population_basis")
+    if declared:
+        return str(declared)
+    unit = row.get("evidence_unit")
+    if unit in SUBGROUP_UNITS:
+        return "SUBGROUP_OF_BROADER_TRIAL"
+    if unit == "trial":
+        return "DIRECT"
+    return "UNSPECIFIED"
+
+
+def _page(path: Path) -> dict[str, Any]:
+    review = json.loads(path.read_text(encoding="utf-8"))
+    primary = _primary(review) or {}
+    trials = primary.get("trials") or []
+    rows = []
+    for trial in trials:
+        rows.append({
+            "trial": trial.get("label"),
+            "id": trial.get("id"),
+            "population_basis": _basis(trial),
+            "evidence_unit": trial.get("evidence_unit"),
+        })
+    subgroup = sum(1 for row in rows if row["population_basis"] == "SUBGROUP_OF_BROADER_TRIAL")
+    direct = sum(1 for row in rows if row["population_basis"] == "DIRECT")
+    unspecified = sum(1 for row in rows if row["population_basis"] == "UNSPECIFIED")
+    pooled = len(rows)
+    return {
+        "slug": review.get("slug") or path.parent.name,
+        "primary_outcome": primary.get("name"),
+        "pooled_rows": pooled,
+        "direct_rows": direct,
+        "subgroup_of_broader_trial_rows": subgroup,
+        "unspecified_rows": unspecified,
+        "subgroup_only": bool(pooled and subgroup == pooled),
+        "trials": rows,
+    }
+
+
+def build() -> dict[str, Any]:
+    pages = sorted(
+        (_page(path) for path in REVIEWS.glob("*/review.json")),
+        key=lambda row: row["slug"],
+    )
+    return {
+        "generated_utc": GENERATED_UTC,
+        "n_pages": len(pages),
+        "n_pages_with_subgroup_rows": sum(1 for row in pages if row["subgroup_of_broader_trial_rows"]),
+        "n_pages_subgroup_only": sum(1 for row in pages if row["subgroup_only"]),
+        "pooled_rows_total": sum(row["pooled_rows"] for row in pages),
+        "subgroup_of_broader_trial_rows_total": sum(row["subgroup_of_broader_trial_rows"] for row in pages),
+        "pages": pages,
+    }
+
+
+def main() -> None:
+    OUT.write_text(json.dumps(build(), indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    print(f"wrote {OUT.relative_to(ROOT)}")
+
+
+if __name__ == "__main__":
+    main()
