rientation=&quot;portrait&quot; xlink:href=&quot;NEJMoa2028836_t3.jpg&quot;/&gt;&lt;table frame=&quot;hsides&quot; rules=&quot;groups&quot; content-type=&quot;tgroup&quot;&gt;&lt;colgroup span=&quot;1&quot;&gt;&lt;col id=&quot;t3col1&quot; width=&quot;1.90%&quot; span=&quot;1&quot;/&gt;&lt;col id=&quot;t3col2&quot; width=&quot;0.70%&quot; span=&quot;1&quot;/&gt;&lt;col id=&quot;t3col3&quot; width=&quot;0.74%&quot; span=&quot;1&quot;/&gt;&lt;col id=&quot;t3col4&quot; width=&quot;0.66%&quot; span=&quot;1&quot;/&gt;&lt;/colgroup&gt;&lt;thead content-type=&quot;thead sticky&quot;&gt;&lt;tr content-type=&quot;row head1&quot;&gt;&lt;th align=&quot;left&quot; content-type=&quot;entry xxxx-borders&quot; rowspan=&quot;1&quot; colspan=&quot;1&quot;&gt;Outcome&lt;/th&gt;&lt;th align=&quot;center&quot; content-type=&quot;entry xxxx-borders&quot; rowspan=&quot;1&quot; colspan=&quot;1&quot;&gt;Tocilizumab&lt;break/&gt;(N=161)&lt;/th&gt;&lt;th align=&quot;center&quot; content-type=&quot;entry xxxx-borders&quot; rowspan=&quot;1&quot; colspan=&quot;1&quot;&gt;Placebo&lt;break/&gt;(N=81)&lt;/th&gt;&lt;th align=&quot;center&quot; content-type=&quot;entry xxxx-borders&quot; rowspan=&quot;1&quot; colspan=&quot;1&quot;&gt;Relative Risk&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody content-type=&quot;tbody&quot;&gt;&lt;tr content-type=&quot;row&quot;&gt;&lt;td align=&quot;left&quot; content-type=&quot;entry xxxx-borders hanging01 shading&quot; rowspan=&quot;1&quot; colspan=&quot;1&quot;&gt;Median duration of receipt of supplemental oxygen (IQR) — days&lt;xref rid=&quot;t3fn1&quot; ref-type=&quot;table-fn&quot;&gt;*&lt;/xref&gt;&lt;/td&gt;&lt;td align=&quot;center&quot; content-type=&quot;entry xxxx-borders shading&quot; rowspan=&quot;1&quot; colspan=&quot;1&quot;&gt;4.0 (1.8–11.6)&lt;/td&gt;&lt;td align=&quot;center&quot; content-type=&quot;entry xxxx-borders shading&quot; rowspan=&quot;1&quot; colspan=&quot;1&quot;&gt;3.9 (1.1–9.2)&lt;/td&gt;&lt;td align=&quot;center&quot; content-type=&q