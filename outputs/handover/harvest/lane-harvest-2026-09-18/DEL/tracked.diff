@@ -155,6 +155,27 @@ def build_review_dir(
     certify: bool = False,
 ) -> dict:
     """Assemble a publishable review directory. Returns the manifest dict."""
+    # A cached verdict is not a substitute for the support that earned it.
+    for outcome in review_core_obj.get("outcomes") or []:
+        for trial in outcome.get("trials") or []:
+            if trial.get("target_endpoint_class") in ("EXACT_TARGET", "NEAR_MATCH"):
+                for field in ("endpoint_definition_span", "endpoint_result_span"):
+                    if not trial.get(field):
+                        raise ValueError(f"MISSING_ENDPOINT_SUPPORT: {field}: {trial.get('id')}")
+    domains = (review_core_obj.get("grade") or {}).get("domains")
+    if domains is not None:
+        for domain in ("risk_of_bias", "inconsistency", "imprecision", "publication_bias", "indirectness"):
+            if domain not in domains:
+                raise ValueError(f"MISSING_GRADE_DOMAIN: {domain}")
+    # This standing withdrawal is generated by policy, not optional evidence.
+    # Restore its source object before hashing as well as before rendering.
+    if "limitations" in review_core_obj:
+        from .limitations import build_limitations
+        current = review_core_obj["limitations"]
+        if not any(x.get("kind") == "REPRODUCTION_RETRACTION" for x in current):
+            required = [x for x in build_limitations(review_core_obj)
+                        if x.get("kind") == "REPRODUCTION_RETRACTION"]
+            review_core_obj = dict(review_core_obj, limitations=[*current, *required])
     os.makedirs(out_dir, exist_ok=True)
     review_core_obj = propositions.attach(review_core_obj)
     core_sha = review_sha256(review_core_obj)  # excludes 'reproduction' by construction
