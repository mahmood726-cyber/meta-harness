+def _check_effect_snapshot(slug, data):
+    # HEAD is the fixed committed evidence snapshot for an offline replay. A
+    # removed transcription must not silently reactivate a lower-priority route.
+    # Untracked new topics have no earlier snapshot; tracked inputs must be readable.
+    rel = f"cache/{slug}/verified_effects.json"
+    tracked = subprocess.run(["git", "-C", str(ROOT), "ls-files", "--error-unmatch", "--", rel],
+                             capture_output=True)
+    if tracked.returncode not in (0, 1):
+        raise ValueError(f"VERIFIED_SNAPSHOT_UNAVAILABLE: {rel}")
+    if tracked.returncode == 0:
+        saved = subprocess.run(["git", "-C", str(ROOT), "show", f"HEAD:{rel}"],
+                               capture_output=True, text=True, encoding="utf-8")
+        if saved.returncode:
+            raise ValueError(f"VERIFIED_SNAPSHOT_UNAVAILABLE: {rel}")
+        for pid, value in json.loads(saved.stdout).items():
+            present = {e['outcome'] for e in entries(data.get(pid))}
+            if any(e['outcome'] not in present for e in entries(value)):
+                raise ValueError(f"MISSING_VERIFIED_EFFECT: {slug}/{pid}")
+
+
