.\outputs\search_v2\verification\iv-iron-hfref-hosp\lane.log:5689:allowed = {'ELIGIBLE_RCT','ELIGIBLE_RCT_NO_PRIMARY','NOT_RCT','WRONG_POPULATION','WRONG_INTERVENTION','WRONG_COMPARATOR','WRONG_OUTCOME_ONLY','DUPLICATE_OF_ACCOUNTED','UNDECIDABLE_FROM_RECORD','NOT_VERIFIED_CAP'}
.\outputs\search_v2\verification\iv-iron-hfref-hosp\lane.log:5725:wrong_count = sum(counts[v] for v in ('WRONG_POPULATION','WRONG_INTERVENTION','WRONG_COMPARATOR','WRONG_OUTCOME_ONLY'))
.\outputs\search_v2\verification\iv-iron-hfref-hosp\lane.log:5726:eligible_rct = counts['ELIGIBLE_RCT']
