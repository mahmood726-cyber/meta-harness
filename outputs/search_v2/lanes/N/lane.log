.2","dispersionType":"STANDARD_ERROR_OF_MEAN","dispersionValue":"0.3"}]},{"type":"OTHER_PRE_SPECIFIED","title":"Study 1 Weight-related Self Stigmatization","description":"Exploratory outcome (Study 1): Weight-related self stigmatization by the Weight Bias Internalization Scale. Mean of 11 items; score range 1-7; higher scores indicate greater weight-related self-stigmatization.","populationDescription":"Data are adjusted estimated mean changes ± SE (95% CI) after controlling for baseline values for the intention-to-treat population (N = 120). Missing data were estimated using jump-to-reference multiple imputation, which assumes that missing scores from semaglutide-treated individuals approximate the mean of the placebo group.","reportingStatus":"POSTED","paramType":"MEAN","dispersionType":"Standard Error","unitOfMeasure":"Units on a scale","timeFrame":"S1: Change from baseline to weeks 20, 40, and 60","groups":[{"id":"OG000","title":"Behavioral Treatment + Placebo (Weeks 0-60)","description":"Behavioral treatment (lifestyle modification counseling for weight loss) plus placebo from weeks 0 - 60."},{"id":"OG001","title":"Behavioral Treatment + Medication (Weeks 0-60)","description":"Behavioral treatment (lifestyle modification counseling for weight loss) plus semaglutide from weeks 0 to week 60."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"48"},{"groupId":"OG001","value":"72"}]}],"classes":[{"title":"Week 20","categories":[{"measurements":[{"groupId":"OG000","value":"-0.4","spread":"0.1"},{"groupId":"OG001","value":"-0.4","spread":"0.1"}]}]},{"title":"Week 40","categories":[{"measurements":[{"groupId":"OG000","value":"-0.3","spread":"0.2"},{"groupId":"OG001","value":"-0.7","spread":"0.1"}]}]},{"title":"Week 60","categories":[{"measurements":[{"groupId":"OG000","value":"-0.5","spread":"0.2"},{"groupId":"OG001","value":"-0.9","spread":"0.1"}]}]}],"analyses":[{"groupIds":["OG000","OG001"],"groupDescription":"Analyses compared mean change at week 20 controlling for baseline values.","nonInferiorityType":"SUPERIORITY","pValue":"0.879","statisticalMethod":"ANCOVA","paramType":"Mean Difference (Net)","paramValue":"0.02","ciPctValue":"95","ciNumSides":"TWO_SIDED","ciLowerLimit":"-0.3","ciUpperLimit":"0.3","dispersionType":"STANDARD_ERROR_OF_MEAN","dispersionValue":"0.2"},{"groupIds":["OG000","OG001"],"groupDescription":"Analyses compared mean change at week 40 controlling for baseline values.","nonInferiorityType":"SUPERIORITY","pValue":"0.022","statisticalMethod":"ANCOVA","paramType":"Mean Difference (Net)","paramValue":"0.5","ciPctValue":"95","ciNumSides":"TWO_SIDED","ciLowerLimit":"0.1","ciUpperLimit":"0.9","dispersionType":"STANDARD_ERROR_OF_MEAN","dispersionValue":"0.2"},{"groupIds":["OG000","OG001"],"groupDescription":"Analyses compared mean change at week 60 controlling for baseline values.","nonInferiorityType":"SUPERIORITY","pValue":"0.087","statisticalMethod":"ANCOVA","paramType":"Mean Difference (Net)","paramValue":"0.4","ciPctValue":"95","ciNumSides":"TWO_SIDED","ciLowerLimit":"-0.1","ciUpperLimit":"0.9","dispersionType":"STANDARD_ERROR_OF_MEAN","dispersionValue":"0.3"}]},{"type":"OTHER_PRE_SPECIFIED","title":"Study 2 Body Weight (kg)","description":"Supportive secondary outcome (Study 2): Body weight (kg) at week 72","populationDescription":"Data are adjusted estimated means ± SE (95% CI) after controlling for baseline values for the Study 2 intention-to-treat population (N = 73). Missing data were estimated using multiple imputation.\n\nThe goal of Study 2 was to compare Switched to Placebo to Continuous Placebo at week 72. A small number of subjects were re-randomized to Continued Medication in order to maintain blinding. Number of Continued Medication subjects was not sufficient for statistical comparison.","reportingStatus":"POSTED","paramType":"MEAN","dispersionType":"Standard Error","unitOfMeasure":"kg","timeFrame":"S2: Week 72 endpoint controlling for S1 baseline","groups":[{"id":"OG000","title":"Continuous Placebo (Weeks 60-72)","description":"Behavioral treatment (lifestyle modification counseling for weight loss) plus placebo from weeks 0 - 60.\n\nAt week 60, all placebo-treated participants were (sham) re-randomized to continue placebo for an additional 12 weeks (i.e., continuous placebo group)."},{"id":"OG001","title":"Medication (Semaglutide) Switched to Placebo (Weeks 60-72)","description":"Behavioral treatment (lifestyle modification counseling for weight loss) plus semaglutide from weeks 0 to week 60.\n\nAt week 60, semaglutide-treated participants were re-randomized 4:1 to either switch to placebo or continue semaglutide for an additional 12 weeks (weeks 60 - 72). Participants in this group are those assigned to be switched to placebo at week 60. The primary goal of the 12-week withdrawal trial (Study 2) was to compare individuals who had discontinued semaglutide at week 60 (by being randomly assigned to switch to placebo at that time) to those who had never taken active medication (Continuous Placebo group), in order to evaluate whether those who discontinued medication were significantly worse off, in terms of appetite, than those who had never been exposed to the medication at week 72. By re-allocating a small number of subjects to Continued Medication at week 60, both researchers and subjects remain blinded to medication condition during the re-randomized treatment period. However, the Continued Medication group was included only to maintain blinding and was not intended to be subject to statistical analysis."},{"id":"OG002","title":"Continued Medication (Semaglutide) (Weeks 60-72)","description":"Behavioral treatment (lifestyle modification counseling for weight loss) plus semaglutide from weeks 0 to week 60.\n\nAt week 60, semaglutide-treated participants were re-randomized 4:1 to either switch to placebo or continue semaglutide for an additional 12 weeks (weeks 60 - 72). Participants in this group are those assigned to continue semaglutide. By re-allocating a small number of subjects to Continued Medication at week 60, both researchers and subjects remain blinded to medication condition during the re-randomized treatment period. However, the Continued Medication group was included only to maintain blinding and was not intended to be subject to statistical analysis. Because this group was very small, its characteristics are more likely have differed from other groups due to chance."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"20"},{"groupId":"OG001","value":"43"},{"groupId":"OG002","value":"10"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"98.3","spread":"2.1"},{"groupId":"OG001","value":"88.9","spread":"1.3"},{"groupId":"OG002","value":"85.3","spread":"3.4"}]}]}],"analyses":[{"groupIds":["OG000","OG001"],"groupDescription":"Analyses compared the week 72 endpoint controlling for baseline values (week 0 of study 1) between the Switched to Placebo and Continuous Placebo groups.\n\nThe Continued Medication group was used for blinding and not intended for statistical comparison. Continued Medication participants may appear different by chance due to small sample size.","nonInferiorityType":"SUPERIORITY","pValue":"<0.001","statisticalMethod":"ANCOVA","paramType":"Mean Difference (Final Values)","paramValue":"9.4","ciPctValue":"95","ciNumSides":"TWO_SIDED","ciLowerLimit":"4.5","ciUpperLimit":"14.3","dispersionType":"STANDARD_ERROR_OF_MEAN","dispersionValue":"2.4"}]}]},"adverseEventsModule":{"frequencyThreshold":"5","timeFrame":"From enrollment until end of treatment, up to 72 weeks","eventGroups":[{"id":"EG000","title":"Behavioral Treatment + Placebo (Weeks 0-60)","description":"Behavioral treatment (lifestyle modification counseling for weight loss) plus placebo from weeks 0 - 60.","deathsNumAffected":0,"deathsNumAtRisk":48,"seriousNumAffected":0,"seriousNumAtRisk":48,"otherNumAffected":42,"otherNumAtRisk":48},{"id":"EG001","title":"Behavi