.\outputs\search_v2\verification\iv-iron-hfref-hosp\lane.log:5655:    'NCT01837082': ('ELIGIBLE_RCT_NO_PRIMARY', 'Iron in Congestive Heart Failure', 'Structured registry fields show randomized ferric carboxymaltose versus placebo in heart failure with iron deficiency, but the snapshot has no abstract/result for the protocol primary outcome.'),
