I’m using the served review outcome objects, not broad whole-file text, for “accounted” status. That avoids false matches from screening/search metadata while still catching pooled and declared-absent trial records.
exec
"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command '$env:PYTHONIOENCODING='"'utf-8'; @'
import json,re
from pathlib import Path
om=json.loads(Path(r'C:/meta-harness/outputs/search_v2/verification/omitted_rows.json').read_text(encoding='utf-8'))
def collect_accounted(slug):
    p=Path(f'docs/reviews/{slug}/review.json')
    if not p.exists(): return []
    d=json.loads(p.read_text(encoding='utf-8'))
    acc=[]
    for oi,o in enumerate(d.get('outcomes') or []):
        oname=o.get('name') or f'outcome[{oi}]'
        for key in ('trials','declared_absent_trials'):
            for j,t in enumerate(o.get(key) or []):
                s=json.dumps(t, ensure_ascii=False)
                ncts=sorted(set(re.findall(r'NCT\\d{8}', s, flags=re.I)))
                pmids=sorted(set(re.findall(r'PMID\\s*(\\d+)|\"pmid\"\\s*:\\s*\"?(\\d+)', s, flags=re.I)))
                pmids=sorted(set(a or b for a,b in pmids if (a or b)))
                ident=t.get('id') or t.get('label') or t.get('trial') or f'{key}[{j}]'
                label=t.get('label') or ident
                acc.append({'outcome':oname,'bucket':key,'ident':ident,'label':label,'ncts':ncts,'text':s[:500]})
    return acc
rows=[]
for slug, items in om.items():
    acc=collect_accounted(slug)
    for it in items:
        matches=[a for a in acc if it['nct'].upper() in [x.upper() for x in a['ncts']]]
        rows.append((slug,it['nct'],it['title'],matches))
print('rows', len(rows))
for slug,nct,title,matches in rows:
    print('\\n',slug, nct, '-', title)
    if matches:
        for m in matches:
            print('  MATCH', m['bucket'], m['ident'], 'label', m['label'], 'outcome', m['outcome'], 'ncts', m['ncts'])
    else:
        print('  no outcome-accounted NCT match')
