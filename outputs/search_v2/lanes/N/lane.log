                matches.append({
                    'bucket': bucket,
                    'label': t.get('label') or t.get('id') or nct,
                    'id': t.get('id') or t.get('label') or nct,
                    'outcome': primary.get('name') or 'primary outcome',
                })
    return matches

def ctgov_fetch(nct):
    out = RAW / f'{nct}.ctgov.json'
    if out.exists() and out.stat().st_size > 0:
        return json.loads(out.read_text(encoding='utf-8'))
    url = f'https://clinicaltrials.gov/api/v2/studies/{nct}'
    req = urllib.request.Request(url, headers={'User-Agent': 'lane-n-verification/1.0'})
    last_exc = None
    for attempt in range(3):
        try:
            with urllib.request.urlopen(req, timeout=30) as resp:
                body = resp.read()
            out.write_bytes(body)
            return json.loads(body.decode('utf-8'))
        except (urllib.error.URLError, TimeoutError, json.JSONDecodeError) as exc:
            last_exc = exc
            time.sleep(1 + attempt)
    raise RuntimeError(f'could not fetch {nct}: {last_exc}')

def list_names(seq, max_items=5):
    names = []
    for obj in seq or []:
        if isinstance(obj, str):
            name = obj
        elif isinstance(obj, dict):
            name = obj.get('name') or obj.get('title') or obj.get('label') or obj.get('interventionName') or ''
        else:
            name = str(obj)
        name = ' '.join(str(name).split())
        if name and name not in names:
            names.append(name)
    if len(names) > max_items:
        names = names[:max_items] + [f'+{len(names)-max_items} more']
    return names

def ctgov_quote(study):
    ps = study.get('protocolSection', {}) if isinstance(study, dict) else {}
    status = ((ps.get('statusModule') or {}).get('overallStatus') or '').strip()
    conditions = list_names((ps.get('conditionsModule') or {}).get('conditions') or [], max_items=4)
    interventions = list_names((ps.get('armsInterventionsModule') or {}).get('interventions') or [], max_items=5)
    parts = []
    if status:
        parts.append(f'overallStatus={status}')
    if conditions:
        parts.append('conditions=' + ', '.join(conditions))
    if interventions:
        parts.append('interventions=' + ', '.join(interventions))
    quote = '; '.join(parts)
    if not quote:
        ident = (ps.get('identificationModule') or {}).get('briefTitle') or ''
        quote = 'briefTitle=' + ' '.join(ident.split()) if ident else ''
    if len(quote) > 295:
        quote = quote[:292].rstrip() + '...'
    return quote

def ctgov_title(study):
    ps = study.get('protocolSection', {}) if isinstance(study, dict) else {}
    ident = ps.get('identificationModule') or {}
    return ident.get('briefTitle') or ''

