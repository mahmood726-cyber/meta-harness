def primary_accounted_match(slug, nct):
    review_path = ROOT / 'docs' / 'reviews' / slug / 'review.json'
    review = json.loads(review_path.read_text(encoding='utf-8'))
    primary = next((o for o in review.get('outcomes', []) if o.get('primary')), None) or {}
    matches = []
    for bucket in ('trials', 'declared_absent_trials'):
