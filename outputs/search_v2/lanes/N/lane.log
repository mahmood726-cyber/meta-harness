gned to continue semaglutide.\n\nBy re-allocating a small number of subjects to Continued Medication at week 60, both researchers and subjects remain blinded to medication condition during the re-randomized treatment period. However, the Continued Medication group was included only to maintain blinding and was not intended to be subject to statistical analysis. Because this group was very small, its characteristics are more likely have differed from other groups due to chance.","deathsNumAffected":0,"deathsNumAtRisk":10,"seriousNumAffected":0,"seriousNumAtRisk":10,"otherNumAffected":3,"otherNumAtRisk":10}],"seriousEvents":[{"term":"Bronchitis","organSystem":"Respiratory, thoracic and mediastinal disorders","sourceVocabulary":"MedDRA 29.0","assessmentType":"SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAffected":0,"numAtRisk":48},{"groupId":"EG001","numEvents":1,"numAffected":1,"numAtRisk":72},{"groupId":"EG002","numAffected":0,"numAtRisk":20},{"groupId":"EG003","numAffected":0,"numAtRisk":43},{"groupId":"EG004","numAffected":0,"numAtRisk":10}]},{"term":"Appendicitis","organSystem":"Gastrointestinal disorders","sourceVocabulary":"MedDRA 29.0","assessmentType":"SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAtRisk":48},{"groupId":"EG001","numEvents":1,"numAffected":1,"numAtRisk":72},{"groupId":"EG002","numAffected":0,"numAtRisk":20},{"groupId":"EG003","numAffected":0,"numAtRisk":43},{"groupId":"EG004","numAffected":0,"numAtRisk":10}]},{"term":"Cholelithiasis","organSystem":"Hepatobiliary disorders","sourceVocabulary":"MedDRA 29.0","assessmentType":"SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAtRisk":48},{"groupId":"EG001","numEvents":1,"numAffected":1,"numAtRisk":72},{"groupId":"EG002","numAffected":0,"numAtRisk":20},{"groupId":"EG003","numAffected":0,"numAtRisk":43},{"groupId":"EG004","numAffected":0,"numAtRisk":10}]}],"otherEvents":[{"term":"Nausea","organSystem":"Gastrointestinal disorders","sourceVocabulary":"MedDRA 29.0","assessmentTyp