.\outputs\search_v2\verification\iv-iron-hfref-hosp\lane.log:5769:report_lines.append(f\"V-iv-iron-hfref-hosp VERDICTS: NEW {len(objects)}; ELIGIBLE_RCT {eligible_rct}; ELIGIBLE_RCT_NO_PRIMARY {eligible_no_primary}; NOT_RCT {not_rct}; WRONG_* {wrong_count}; DUPLICATE_OF_ACCOUNTED {dup}; UNDECIDABLE {undecidable}; NOT_VERIFIED_CAP {cap}\")
