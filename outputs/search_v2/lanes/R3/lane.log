            p, recs = epmc_search(full_label, q)
            summary.append({'slug':slug,'source':source,'label':label,'query':q,'file':str(p).replace('\\\\','/'),'records':recs[:5]})
        elif source=='ctgov':
            p, recs = ctgov_search(full_label, q)
            summary.append({'slug':slug,'source':source,'label':label,'query':q,'file':str(p).replace('\\\\','/'),'records':recs[:5]})

print(json.dumps({'raw_calls':manifest,'summary':summary}, indent=2, ensure_ascii=False))
