    ('cap-sabry-bibliographic.json', {'query.bibliographic':'Sabry corticosteroids community acquired pneumonia randomized'}),
    ('helps-author-title.json', {'query.author':'Helps', 'query.title':'probiotic antibiotic associated diarrhoea'}),
    ('iamharit-author-title.json', {'query.author':'Iamharit', 'query.title':'probiotic antibiotic associated diarrhoea'}),
    ('khanal-author-title.json', {'query.author':'Khanal', 'query.title':'probiotic antibiotic associated diarrhoea'}),
]
for name, params in crossref_queries:
    calls.append(('crossref', name, crossref(params)))

def openalex(params):
    base = 'https://api.openalex.org/works'
    params = dict(params)
    params.setdefault('per-page', '10')
    return base + '?' + urllib.parse.urlencode(params)

openalex_queries = [
    ('cap-el-ghamrawy-openalex.json', {'search':'El-Ghamrawy corticosteroids community acquired pneumonia'}),
