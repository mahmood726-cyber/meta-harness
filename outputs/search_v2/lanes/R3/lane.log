codex
The DOI resolver’s CSL JSON still escapes slashes, so I’m switching to Crossref/DOI XML content negotiation. That should preserve the DOI text as normal XML content.
exec
"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "@'
import json, time, urllib.parse, urllib.request, urllib.error
from pathlib import Path
raw=Path('lane_r3/raw')
idx=max(int(p.name.split('-',1)[0]) for p in raw.glob('*-*'))+1
items=[
    ('nafae-unixref.xml','10.1016/j.ejcdt.2013.03.009'),
    ('sabry-unixref.xml','10.4236/pp.2011.22009'),
    ('horosheva-unixref.xml','10.1099/jmmcr.0.004036'),
    ('pirker-unixref.xml','10.1080/09540105.2012.689816'),
]
for name, doi in items:
    url='https://doi.org/' + urllib.parse.quote(doi, safe='')
    out=raw / f'{idx:03d}-doi-{name}'
    req=urllib.request.Request(url, headers={
        'User-Agent':'codex-lane-r3/1.0 (identifier proposal audit)',
        'Accept':'application/vnd.crossref.unixref+xml'
    })
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            body=resp.read()
            ctype=resp.headers.get('content-type','')
    except urllib.error.HTTPError as e:
        body=e.read() or json.dumps({'error':'HTTPError','code':e.code,'reason':str(e),'url':url}).encode('utf-8')
        ctype='HTTPError'
    out.write_bytes(body)
    print(f'{idx:03d} {out.name} {len(body)} content_type={ctype} contains_doi={doi.encode() in body}')
    idx += 1
    time.sleep(0.3)
'@ | python -" in C:\mh-r-R3
