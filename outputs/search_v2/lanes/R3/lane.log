olume":"371","author":"Musher","year":"2014","journal-title":"N Engl J Med"},{"issue":"3","key":"10.1016\/j.chest.2023.03.051_bib2","doi-asserted-by":"crossref","first-page":"484","DOI":"10.1016\/j.chest.2022.08.2229","article-title":"Effect of corticosteroids on mortality and clinical cure in community-acquired pneumonia: a systematic review, meta-analysis, and meta-regression of randomized control trials","volume":"163","author":"Saleem","year":"2023","journal-title":"Chest"},{"issue":"21","key":"10.1016\/j.chest.2023.03.051_bib3","doi-asserted-by":"crossref","first-page":"1931","DOI":"10.1056\/NEJMoa2215145","article-title":"Hydrocortisone in severe community-acquired pneumonia","volume":"388","author":"Dequin","year":"2023","journal-title":"N\u00a0Engl J Med"},{"issue":"1","key":"10.1016\/j.chest.2023.03.051_bib4","doi-asserted-by":"crossref","first-page":"209","DOI":"10.1378\/chest.15-1733","article-title":"Efficacy and safety of corticosteroids for community-acquired pneumonia: a systematic review and meta-analysis","volume":"149","author":"Wan","year":"2016","journal-title":"Chest"},{"issue":"3","key":"10.1016\/j.chest.2023.03.051_bib5","doi-asserted-by":"crossref","first-page":"346","DOI":"10.1093\/cid\/cix801","article-title":"Corticosteroids in patients hospitalized with community-acquired pneumonia: systematic review and individual patient data metaanalysis","volume":"66","author":"Briel","year":"2018","journal-title":"Clin Infect Dis"}],"container-title":["CHEST"],"language":"en","link":[{"URL":"https:\/\/api.elsevier.com\/content\/article\/PII:S0012369223007845?httpAccept=text\/xml","content-type":"text\/xml","content-version":"vor","intended-application":"text-mining"},{"URL":"https:\/\/api.elsevier.com\/content\/article\/PII:S0012369223007845?httpAccept=text\/plain","content-type":"text\/plain","content-version":"vor","intended-application":"text-mining"}],"deposited":{"date-parts":[[2025,9,15]],"date-time":"2025-09-15T08:50:49Z","timestamp":175792624