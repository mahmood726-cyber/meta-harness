    ('iamharit-openalex.json', {'search':'Iamharit probiotic antibiotic associated diarrhoea'}),
    ('khanal-openalex.json', {'search':'Khanal probiotic antibiotic associated diarrhoea'}),
]
for name, params in openalex_queries:
    calls.append(('openalex', name, openalex(params)))

for source, what, url in calls:
    out = raw / f'{idx:03d}-{source}-{what}'
    req = urllib.request.Request(url, headers={'User-Agent': UA})
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            body = resp.read()
        out.write_bytes(body)
        print(f'{idx:03d} {source} {what} {len(body)}')
    except Exception as e:
        out.write_text(json.dumps({'error': type(e).__name__, 'message': str(e), 'url': url}, indent=2), encoding='utf-8')
        print(f'{idx:03d} {source} {what} ERROR {type(e).__name__}: {e}')
    idx += 1
    time.sleep(0.35)
