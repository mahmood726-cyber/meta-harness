import json, re, xml.etree.ElementTree as ET
from pathlib import Path
raw=Path('lane_r3/raw')
for p in sorted(raw.glob('[1][3-6][0-9]-*')):
    print('\\n##', p.name)
    text=p.read_text(encoding='utf-8', errors='replace')
    if p.suffix=='.xml':
        root=ET.fromstring(text)
        for art in root.findall('.//PubmedArticle')[:5]:
            pmid=''.join(art.findtext('.//PMID') or '')
            title=''.join(art.findtext('.//ArticleTitle') or '')
            journal=''.join(art.findtext('.//Journal/Title') or '')
            year=art.findtext('.//PubDate/Year') or art.findtext('.//PubDate/MedlineDate') or ''
            doi=''
            nct=''
            for aid in art.findall('.//ArticleId'):
                typ=(aid.attrib.get('IdType') or '').lower()
                if typ=='doi': doi=aid.text or ''
                if typ=='clinicaltrials.gov': nct=aid.text or ''
            print('PMID', pmid, 'NCT', nct, 'DOI', doi, 'YEAR', year, 'JOURNAL', journal)
            print('TITLE', title)
        continue
    try:
        data=json.loads(text)
    except Exception as e:
        print('JSON ERR', e, text[:200])
        continue
    if 'esearchresult' in data:
        es=data['esearchresult']; print('count', es.get('count'), 'ids', es.get('idlist'))
    elif data.get('resultList'):
        res=data.get('resultList',{}).get('result', [])
        print('hitCount', data.get('hitCount'), 'len', len(res))
        for it in res[:5]:
            print(it.get('pmid'), it.get('doi'), it.get('pubYear'), it.get('journalTitle'))
            print(it.get('title'))
    elif data.get('message',{}).get('items') is not None:
        items=data['message']['items']
        print('items', len(items))
        for it in items[:5]:
            print(it.get('DOI'), (it.get('published-print') or it.get('published-online') or {}).get('date-parts'), it.get('container-title'))
            print(' | '.join(it.get('title') or []))
            print('authors', ', '.join([(' '.join(filter(None,[a.get('given'),a.get('family')]))).strip() for a in it.get('author',[])[:4]]))
    elif data.get('results') is not None:
        print('meta count', data.get('meta',{}).get('count'), 'results', len(data.get('results') or []))
        for it in (data.get('results') or [])[:5]:
            print(it.get('doi'), it.get('publication_year'), (it.get('primary_location') or {}).get('source',{}).get('display_name'))
            print(it.get('display_name'))
    else:
        print(str(data)[:1000])
