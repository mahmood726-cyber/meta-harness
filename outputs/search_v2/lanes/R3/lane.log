import json, os, time, urllib.parse, urllib.request
from pathlib import Path
raw=Path('lane_r3/raw')
start=max([int(p.name[:3]) for p in raw.iterdir() if p.name[:3].isdigit()] or [0])+1
counter=start

def slugify(s, n=70):
    out=[]
    for ch in s.lower():
        if ch.isalnum(): out.append(ch)
        elif ch in ' -_:.[]\"/': out.append('-')
    r=''.join(out).strip('-')
    while '--' in r: r=r.replace('--','-')
    return (r or 'query')[:n]

def fetch(source, what, url, ext):
    global counter
    fname=f'{counter:03d}-{source}-{slugify(what)}.{ext}'; counter+=1
    path=raw/fname
    req=urllib.request.Request(url, headers={'User-Agent':'meta-harness-lane-r3/1.0 (identifier verification)'})
    try:
        with urllib.request.urlopen(req, timeout=40) as resp:
            body=resp.read()
    except Exception as e:
        body=json.dumps({'error':str(e),'url':url}, indent=2).encode('utf-8')
    path.write_bytes(body)
    time.sleep(0.35)
    print(fname)

def pubmed_esearch(label, term, retmax=20):
    url='https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esearch.fcgi?'+urllib.parse.urlencode({'db':'pubmed','term':term,'retmode':'json','retmax':str(retmax),'sort':'relevance'})
    fetch('pubmed', label+'-esearch', url, 'json')

def pubmed_efetch(label, ids):
    url='https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi?'+urllib.parse.urlencode({'db':'pubmed','id':','.join(ids),'retmode':'xml'})
    fetch('pubmed', label+'-efetch', url, 'xml')

def epmc(label, query, rows=10):
    url='https://www.ebi.ac.uk/europepmc/webservices/rest/search?'+urllib.parse.urlencode({'query':query,'format':'json','pageSize':str(rows)})
    fetch('europepmc', label, url, 'json')

def ct(label, term, rows=25):
    url='https://clinicaltrials.gov/api/v2/studies?'+urllib.parse.urlencode({'query.term':term,'format':'json','pageSize':str(rows)})
    fetch('ctgov', label, url, 'json')

def crossref(label, query, rows=5):
    url='https://api.crossref.org/works?'+urllib.parse.urlencode({'query.bibliographic':query,'rows':str(rows)})
    fetch('crossref', label, url, 'json')

