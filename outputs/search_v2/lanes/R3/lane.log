import json, xml.etree.ElementTree as ET
from pathlib import Path

def safe(x):
    return str(x).encode('ascii','backslashreplace').decode('ascii')
raw=Path('lane_r3/raw')
for p in sorted([x for x in raw.iterdir() if x.name[:3].isdigit() and 139 <= int(x.name[:3]) <= 169]):
    print('\\n##', p.name)
    text=p.read_text(encoding='utf-8', errors='replace')
    if p.suffix=='.xml':
        root=ET.fromstring(text)
        for art in root.findall('.//PubmedArticle')[:5]:
            pmid=art.findtext('.//PMID') or ''
            title=''.join(art.findtext('.//ArticleTitle') or '')
            journal=''.join(art.findtext('.//Journal/Title') or '')
            year=art.findtext('.//PubDate/Year') or art.findtext('.//PubDate/MedlineDate') or ''
            doi=''; nct=''
            for aid in art.findall('.//ArticleId'):
                typ=(aid.attrib.get('IdType') or '').lower()
                if typ=='doi': doi=aid.text or ''
                if typ=='clinicaltrials.gov': nct=aid.text or ''
            print(safe(f'PMID {pmid} NCT {nct} DOI {doi} YEAR {year} JOURNAL {journal}'))
            print(safe('TITLE '+title))
        continue
    try:
        data=json.loads(text)
    except Exception as e:
        print('JSON ERR', e, safe(text[:200])); continue
    if 'esearchresult' in data:
        es=data['esearchresult']; print(safe(f\"count {es.get('count')} ids {es.get('idlist')}\"))
    elif data.get('resultList'):
        res=data.get('resultList',{}).get('result', [])
        print(safe(f\"hitCount {data.get('hitCount')} len {len(res)}\"))
        for it in res[:5]:
            print(safe(f\"{it.get('pmid')} {it.get('doi')} {it.get('pubYear')} {it.get('journalTitle')}\"))
            print(safe(it.get('title')))
    elif data.get('message',{}).get('items') is not None:
        items=data['message']['items']
        print(safe(f'items {len(items)}'))
        for it in items[:5]:
            print(safe(f\"{it.get('DOI')} {(it.get('published-print') or it.get('published-online') or {}).get('date-parts')} {it.get('container-title')}\"))
            print(safe(' | '.join(it.get('title') or [])))
            print(safe('authors '+', '.join([(' '.join(filter(None,[a.get('given'),a.get('family')]))).strip() for a in it.get('author',[])[:4]])))
    elif data.get('results') is not None:
        print(safe(f\"meta count {data.get('meta',{}).get('count')} results {len(data.get('results') or [])}\"))
        for it in (data.get('results') or [])[:5]:
            source=(it.get('primary_location') or {}).get('source') or {}
            print(safe(f\"{it.get('doi')} {it.get('publication_year')} {source.get('display_name')}\"))
            print(safe(it.get('display_name')))
    else:
        print(safe(str(data)[:1000]))
