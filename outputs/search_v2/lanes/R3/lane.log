codex
The first parse also exposed why the raw body matters: a loose XML XPath can accidentally read a DOI from a reference list instead of the article itself. I’m tightening the local parser to `PubmedData/ArticleIdList` before making any proposal decisions.
exec
"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command '$env:PYTHONIOENCODING='"'utf-8'; @'
import json, xml.etree.ElementTree as ET
from pathlib import Path
raw=Path('lane_r3/raw')

def pubrecs(path):
    root=ET.parse(path).getroot(); out=[]
    for art in root.findall('.//PubmedArticle'):
        med=art.find('MedlineCitation')
        article=med.find('Article') if med is not None else None
        pmid=med.findtext('PMID') if med is not None else ''
        title=''.join(article.find('ArticleTitle').itertext()) if article is not None and article.find('ArticleTitle') is not None else ''
        journal=''
        year=''
        if article is not None:
            journal=article.findtext('Journal/Title') or article.findtext('Journal/ISOAbbreviation') or ''
            year=article.findtext('Journal/JournalIssue/PubDate/Year') or article.findtext('ArticleDate/Year') or ''
        doi=''
        for aid in art.findall('PubmedData/ArticleIdList/ArticleId'):
            if (aid.attrib.get('IdType') or '').lower()=='doi': doi=aid.text or ''
        ncts=[]
        for db in article.findall('DataBankList/DataBank') if article is not None else []:
            dbname=db.findtext('DataBankName') or ''
            for acc in db.findall('AccessionNumberList/AccessionNumber'):
                if acc.text and acc.text.startswith('NCT'): ncts.append(acc.text)
        out.append({'pmid':pmid,'nct':ncts,'doi':doi,'year':year,'journal':journal,'title':title})
    return out

def ids(path):
    d=json.load(open(path,encoding='utf-8')); return d.get('esearchresult',{}).get('count'), d.get('esearchresult',{}).get('idlist',[])

def epmc(path):
    d=json.load(open(path,encoding='utf-8')); return [{'pmid':r.get('pmid',''),'pmcid':r.get('pmcid',''),'doi':r.get('doi',''),'year':r.get('pubYear',''),'journal':r.get('journalTitle',''),'title':r.get('title','')} for r in d.get('resultList',{}).get('result',[])[:8]]

def ct(path):
    d=json.load(open(path,encoding='utf-8')); out=[]
    for st in d.get('studies',[])[:8]:
        p=st.get('protocolSection',{}); i=p.get('identificationModule',{}); c=p.get('conditionsModule',{}); a=p.get('armsInterventionsModule',{}); refs=p.get('referencesModule',{})
