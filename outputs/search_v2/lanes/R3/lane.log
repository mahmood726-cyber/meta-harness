import json, xml.etree.ElementTree as ET
from pathlib import Path
raw=Path('lane_r3/raw')

def pubrecs(path):
    root=ET.parse(path).getroot(); out=[]
    for art in root.findall('.//PubmedArticle'):
        med=art.find('MedlineCitation'); article=med.find('Article') if med is not None else None
        pmid=med.findtext('PMID') if med is not None else ''
        title=''.join(article.find('ArticleTitle').itertext()) if article is not None and article.find('ArticleTitle') is not None else ''
        journal=article.findtext('Journal/Title') if article is not None else ''
        year=article.findtext('Journal/JournalIssue/PubDate/Year') if article is not None else ''
        doi=''; ncts=[]
        for aid in art.findall('PubmedData/ArticleIdList/ArticleId'):
            if (aid.attrib.get('IdType') or '').lower()=='doi': doi=aid.text or ''
        if article is not None:
            for acc in article.findall('DataBankList/DataBank/AccessionNumberList/AccessionNumber'):
                if acc.text and acc.text.startswith('NCT'): ncts.append(acc.text)
        out.append({'pmid':pmid,'nct':ncts,'doi':doi,'year':year,'journal':journal,'title':title})
    return out

def epmc(path):
    d=json.load(open(path,encoding='utf-8'))
    return [{'pmid':r.get('pmid',''),'pmcid':r.get('pmcid',''),'doi':r.get('doi',''),'year':r.get('pubYear',''),'journal':r.get('journalTitle',''),'title':r.get('title','')} for r in d.get('resultList',{}).get('result',[])[:10]]

def ct(path):
    d=json.load(open(path,encoding='utf-8'))
    out=[]
    for st in d.get('studies',[])[:10]:
        p=st.get('protocolSection',{}); i=p.get('identificationModule',{}); c=p.get('conditionsModule',{}); a=p.get('armsInterventionsModule',{}); refs=p.get('referencesModule',{})
        out.append({'nct':i.get('nctId',''),'acronym':i.get('acronym',''),'briefTitle':i.get('briefTitle',''),'officialTitle':i.get('officialTitle',''),'conditions':c.get('conditions',[])[:4],'interventions':[x.get('name','') for x in a.get('interventions',[])[:4]],'refs':refs.get('references',[])[:4]})
    return out
for idx in list(range(47,69)):
    files=list(raw.glob(f'{idx:03d}-*'))
    for p in files:
        print('\\n## '+p.name)
        if p.name.endswith('esearch.json'):
            d=json.load(open(p,encoding='utf-8')); print(json.dumps({'count':d.get('esearchresult',{}).get('count'),'ids':d.get('esearchresult',{}).get('idlist',[])[:10]}, ensure_ascii=True))
        elif p.suffix=='.xml':
            for r in pubrecs(p)[:10]: print(json.dumps(r, ensure_ascii=True))
        elif 'europepmc' in p.name:
            for r in epmc(p)[:10]: print(json.dumps(r, ensure_ascii=True))
        elif 'ctgov' in p.name:
            for r in ct(p)[:10]: print(json.dumps(r, ensure_ascii=True))
