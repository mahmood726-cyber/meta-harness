idx = start

UA = 'codex-lane-r3/1.0 (identifier proposal audit)'

calls = []

# PubMed exact/primary checks
def ncbi_url(db, endpoint, params):
    base = f'https://eutils.ncbi.nlm.nih.gov/entrez/eutils/{endpoint}.fcgi'
    params = dict(params)
    params.setdefault('tool', 'codex_lane_r3')
    params.setdefault('retmode', 'json' if endpoint == 'esearch' else 'xml')
    return base + '?' + urllib.parse.urlencode(params)

calls.append(('pubmed', 'freedom-cvo-primary-34873344-efetch.xml', ncbi_url('pubmed', 'efetch', {'db':'pubmed','id':'34873344','retmode':'xml'})))
exact_titles = [
    ('mchardy-exact-title-esearch.json', '\"Ampicillin Dosage and Use of Prednisolone in Treatment of Pneumonia\"'),
    ('nafae-exact-title-esearch.json', '\"Adjuvant role of corticosteroids in the treatment of community-acquired pneumonia\"'),
    ('horosheva-exact-title-esearch.json', '\"Efficacy of Bacillus probiotics in prevention of antibiotic-associated diarrhoea\"'),
    ('pirker-exact-title-esearch.json', '\"Effects of antibiotic therapy on the gastrointestinal microbiota and the influence of Lactobacillus casei\"'),
    ('el-ghamrawy-pneumonia-esearch.json', 'El-Ghamrawy Ghamrawy corticosteroids community acquired pneumonia'),
    ('sabry-pneumonia-esearch.json', 'Sabry corticosteroids community acquired pneumonia'),
    ('helps-probiotic-aad-esearch.json', 'Helps probiotic antibiotic associated diarrhoea'),
    ('iamharit-probiotic-aad-esearch.json', 'Iamharit probiotic antibiotic associated diarrhoea'),
    ('khanal-probiotic-aad-esearch.json', 'Khanal probiotic antibiotic associated diarrhoea'),
]
for name, term in exact_titles:
    calls.append(('pubmed', name, ncbi_url('pubmed', 'esearch', {'db':'pubmed','term':term,'retmax':'20'})))

# Europe PMC exact-title/name checks
def epmc(params):
    base = 'https://www.ebi.ac.uk/europepmc/webservices/rest/search'
    params = dict(params)
    params.setdefault('format', 'json')
    params.setdefault('pageSize', '10')
    return base + '?' + urllib.parse.urlencode(params)

epmc_queries = [
    ('mchardy-exact-title.json', 'TITLE:\"Ampicillin Dosage and Use of Prednisolone in Treatment of Pneumonia\"'),
    ('nafae-exact-title.json', 'TITLE:\"Adjuvant role of corticosteroids in the treatment of community-acquired pneumonia\"'),
    ('horosheva-exact-title.json', 'TITLE:\"Efficacy of Bacillus probiotics in prevention of antibiotic-associated diarrhoea\"'),
    ('pirker-exact-title.json', 'TITLE:\"Effects of antibiotic therapy on the gastrointestinal microbiota and the influence of Lactobacillus casei\"'),
    ('el-ghamrawy-pneumonia.json', 'El-Ghamrawy OR Ghamrawy AND corticosteroids AND pneumonia'),
    ('sabry-pneumonia.json', 'Sabry AND corticosteroids AND pneumonia'),
    ('helps-probiotic-aad.json', 'Helps AND probiotic AND antibiotic-associated diarrhoea'),
    ('iamharit-probiotic-aad.json', 'Iamharit AND probiotic AND antibiotic-associated diarrhoea'),
    ('khanal-probiotic-aad.json', 'Khanal AND probiotic AND antibiotic-associated diarrhoea'),
]
for name, query in epmc_queries:
    calls.append(('europepmc', name, epmc({'query': query})))

# Crossref/OpenAlex targeted unresolved-name checks
def crossref(params):
    base = 'https://api.crossref.org/works'
    params = dict(params)
    params.setdefault('rows', '10')
    return base + '?' + urllib.parse.urlencode(params)

crossref_queries = [
    ('cap-el-ghamrawy-author-title.json', {'query.author':'El-Ghamrawy', 'query.title':'pneumonia corticosteroids'}),
    ('cap-ghamrawy-bibliographic.json', {'query.bibliographic':'Ghamrawy corticosteroids community-acquired pneumonia'}),
