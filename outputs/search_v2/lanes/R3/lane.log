import json, re, xml.etree.ElementTree as ET
from pathlib import Path
raw=Path('lane_r3/raw')

def parse_xml(path):
    try: root=ET.parse(path).getroot()
    except Exception as e: return [{'parse_error':str(e)}]
    out=[]
    for art in root.findall('.//PubmedArticle'):
        pmid=art.findtext('.//PMID') or ''
        title=''.join(art.find('.//ArticleTitle').itertext()) if art.find('.//ArticleTitle') is not None else ''
        journal=art.findtext('.//Journal/Title') or art.findtext('.//ISOAbbreviation') or ''
        year=art.findtext('.//JournalIssue/PubDate/Year') or art.findtext('.//PubDate/Year') or ''
        doi=''
        for aid in art.findall('.//ArticleId'):
            if (aid.attrib.get('IdType') or '').lower()=='doi': doi=aid.text or ''
        ncts=[]
        for acc in art.findall('.//DataBank/AccessionNumberList/AccessionNumber'):
            if acc.text and acc.text.startswith('NCT'): ncts.append(acc.text)
        pubtypes=[pt.text for pt in art.findall('.//PublicationType') if pt.text]
        out.append({'pmid':pmid,'nct':ncts,'doi':doi,'year':year,'journal':journal,'title':title,'pubtypes':pubtypes[:4]})
    return out

def parse_epmc(path):
    try: d=json.load(open(path,encoding='utf-8'))
    except Exception as e: return [{'parse_error':str(e)}]
    out=[]
    for r in d.get('resultList',{}).get('result',[])[:10]:
        out.append({'pmid':r.get('pmid',''),'pmcid':r.get('pmcid',''),'doi':r.get('doi',''),'year':r.get('pubYear',''),'journal':r.get('journalTitle',''),'title':r.get('title','')})
    return out

def parse_ct(path):
    try: d=json.load(open(path,encoding='utf-8'))
    except Exception as e: return [{'parse_error':str(e)}]
    out=[]
    for st in d.get('studies',[])[:10]:
        p=st.get('protocolSection',{})
        ident=p.get('identificationModule',{})
        cond=p.get('conditionsModule',{})
        arms=p.get('armsInterventionsModule',{})
        refs=p.get('referencesModule',{})
        out.append({'nct':ident.get('nctId',''),'acronym':ident.get('acronym',''),'briefTitle':ident.get('briefTitle',''),'officialTitle':ident.get('officialTitle',''),'conditions':cond.get('conditions',[])[:4],'interventions':[i.get('name','') for i in arms.get('interventions',[])[:4]],'refs':refs.get('references',[])[:3]})
    return out

for p in sorted(raw.iterdir()):
    name=p.name
    if name.endswith('efetch.xml'):
        recs=parse_xml(p)
        print('\\n##', name)
        for r in recs[:8]: print(json.dumps(r, ensure_ascii=True))
    elif name.endswith('.json') and 'europepmc' in name:
        recs=parse_epmc(p)
        print('\\n##', name)
        for r in recs[:8]: print(json.dumps(r, ensure_ascii=True))
    elif name.endswith('.json') and 'ctgov' in name:
        recs=parse_ct(p)
        print('\\n##', name)
        for r in recs[:8]: print(json.dumps(r, ensure_ascii=True))
    elif name.endswith('esearch.json'):
        try: d=json.load(open(p,encoding='utf-8')); ids=d.get('esearchresult',{}).get('idlist',[]); count=d.get('esearchresult',{}).get('count')
        except Exception as e: ids=[]; count='ERR '+str(e)
        print('\\n##', name, 'count', count, 'ids', ids[:10])
