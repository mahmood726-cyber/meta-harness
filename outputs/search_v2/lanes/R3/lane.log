ining"},{"URL":"https:\/\/www.scirp.org\/journal\/paperinformation?paperid=4454","content-type":"application\/pdf","content-version":"vor","intended-application":"text-mining"},{"URL":"https:\/\/www.scirp.org\/journal\/paperinformation?paperid=4454","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"deposited":{"date-parts":[[2026,2,27]],"date-time":"2026-02-27T02:16:29Z","timestamp":1772158589000},"score":40.662994,"resource":{"primary":{"URL":"https:\/\/www.scirp.org\/journal\/paperinformation?paperid=4454"}},"issued":{"date-parts":[[2011]]},"references-count":50,"journal-issue":{"issue":"02","published-print":{"date-parts":[[2011]]}},"URL":"https:\/\/doi.org\/10.4236\/pp.2011.22009","ISSN":["2157-9423","2157-9431"],"issn-type":[{"value":"2157-9423","type":"print"},{"value":"2157-9431","type":"electronic"}],"published":{"date-parts":[[2011]]}},{"indexed":{"date-parts":[[2026,8,26]],"date-time":"2026-08-26T15:28:18Z","timestamp":1787758098433,"version":"build-2784847793"},"reference-count":14,"publisher":"Ovid Technologies (Wolters Kluwer Health)","issue":"1","content-domain":{"domain":["lww.com","ovid.com"],"crossmark-restriction":true},"published-print":{"date-parts":[[2022,1]]},"abstract":"<jats:sec>\n                    <jats:title>Background<\/jats:title>\n                    <jats:p>Community-acquired pneumonia (CAP) is one of the most common infections of infants and children in developing and developed countries, given the clinical, social, and economic importance of CAP for this specific age group.<\/jats:p>\n                  <\/jats:sec>\n                  <jats:sec>\n                    <jats:title>Aim<\/jats:title>\n                    <jats:p>To highlight the most important factors affecting the outcome of CAP either clinical, laboratory, or radiological.<\/jats:p>\n                  <\/jats:sec>\n                  <jats:sec>\n                    <jats:title>Patients and methods<\/jats:title>\n                    <jats:p>This prospective cohort study included 120 patients, aged 2\u201359 months admitted with CAP in the Pediatric Department, Children\u2019s Hospital, Cairo University from November 2016 till February 2017. History, demographic, clinical, laboratory [complete blood count, C-reactive protein (CRP), urea, creatinine, sodium, random blood sugar, sputum and blood culture], and radiological data were assessed.<\/jats:p>\n                  <\/jats:sec>\n                  <jats:sec>\n                    <jats:title>Results<\/jats:title>\n                    <jats:p>\n                      A statistically significant relationship was detected between each of the history of exclusive breastfeeding, patient\u2019s age, and weight as well as lower pO\n                      <jats:sub>2<\/jats:sub>\n                      on admission and between the need for ICU admission. Also, significant correlation was noted between patients\u2019 height, temperature, respiratory rate, hemoglobin, total leukocyte count and CRP, blood culture and chest radiographic finding, and between the duration of hospital admission.\n                    <\/jats:p>\n                  <\/jats:sec>\n                  <jats:sec>\n                    <jats:title>Conclusion<\/jats:title>\n                    <jats:p>\n                      Weight, height, temperature, respiratory rate, conscious level, initial O\n                      <jats:sub>2<\/jats:sub>\n                      saturation, capillary filling time, and presence of crepitation were closely related to the CAP outcome as well as, some laboratory findings such as hemoglobin level, total leukocyte count, CRP, blood culture, arterial blood gas parameters, and the chest radiographic finding.\n                    <\/jats:p>\n                  <\/jats:sec>","DOI":"10.4103\/ajop.ajop_8_22","type":"journal-article","created":{"date-parts":[[2022,7,14]],"date-time":"2022-07-14T04:34:14Z","timestamp":1657773254000},"page":"19-25","update-policy":"https:\/\/doi.org\/10.1097\/lww.0000000000001000","source":"Crossref","is-referenced-by-count":1,"title":["Outcome predictors of community-acquired pneumonia in children"],"prefix":"10.4103","volume":"35","author":[{"given":"Amira M.","family":"Sabry","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Dina H.","family":"Hamed","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Neama","family":"Al-Amir","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Iman A.","family":"Abdelaziz","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"member":"276","reference":[{"key":"R1-3-20240901","doi-asserted-by":"crossref","first-page":"616","DOI":"10.1093\/pch\/8.10.616","article-title":"Community-acquired pneumonia in children","volume":"8","author":"Dele Davies","year":"2003","journal-title":"Paediatr Child Health"},{"key":"R2-3-20240901","doi-asserted-by":"crossref","first-page":"1392","DOI":"10.1007\/s00247-017-3827-8","article-title":"Community-acquired pneumonia in children \u2013 a changing spectrum of disease","volume":"47","author":"le Roux","year":"2017","journal-title":"Pediatr Radiol"},{"key":"R3-3-20240901","doi-asserted-by":"crossref","first-page":"15","DOI":"10.1186\/1471-2431-9-15","article-title":"Factors determining the outcome of children hospitalized with severe pneumonia","volume":"9","author":"Tiewsoh","year":"2009","journal-title":"BMC Pediatrics"},{"key":"R4-3-20240901","doi-asserted-by":"crossref","first-page":"164","DOI":"10.1016\/j.ijid.2014.07.027","article-title":"Risk factors for a poor outcome among children admitted with clinically severe pneumonia to a university hospital in Rabat, Morocco","volume":"28","author":"Jroundi","year":"2014","journal-title":"Int J Infect Dis"},{"key":"R5-3-20240901","first-page":"1361","article-title":"Risk factors for severe acute lower respiratory tract infection in under five children","volume":"38","author":"Broor","year":"2001","journal-title":"Indian Pediatr"},{"key":"R6-3-20240901","doi-asserted-by":"crossref","first-page":"578","DOI":"10.5114\/aoms.2010.14471","article-title":"Hyponatraemia in cases of children with pneumonia","volume":"4","author":"Sakellaropoulou","year":"2010","journal-title":"Arch Med Sci"},{"key":"R7-3-20240901","doi-asserted-by":"crossref","first-page":"140","DOI":"10.4172\/2165-7548.1000140","article-title":"Presenting signs and symptoms of rapidly progressing severe pneumonia in the pediatric emergency department","volume":"3","author":"Porter Moore","year":"2013","journal-title":"Emerg Med"},{"key":"R8-3-20240901","doi-asserted-by":"crossref","first-page":"424","DOI":"10.1097\/00006454-200005000-00007","article-title":"Risk factors for mortality among children hospitalized because of acute respiratory infections in Bangui, Central African Republic","volume":"19","author":"Demers","year":"2000","journal-title":"Pediatr Infect Dis J"},{"key":"R9-3-20240901","doi-asserted-by":"crossref","first-page":"327","DOI":"10.1093\/tropej\/49.6.327","article-title":"Case fatality proportions and predictive factors for mortality among children hospitalized with severe pneumonia in a rural developing country setting","volume":"49","author":"Djelantik","year":"2003","journal-title":"J Trop Pediatr"},{"key":"R10-3-20240901","doi-asserted-by":"crossref","first-page":"792","DOI":"10.1097\/INF.0000000000000724","article-title":"Association of white blood cell count and C-reactive protein with outcomes in children hospitalized with community-acquired pneumonia","volume":"34","author":"Williams","year":"2015","journal-title":"Pediatr Infect Dis J"},{"key":"R11-3-20240901","first-page":"2278","article-title":"Correlation of hyponatraemia in children with lower respiratory tract infection\u2013 an institutional observational study","volume":"5","author":"Channawar","year":"2016","journal-title":"J Evol Med Dent Sci"},{"key":"R12-3-20240901","doi-asserted-by":"crossref","first-page":"46","DOI":"10.9790\/0853-1603044650","article-title":"Prevalence of hyponatremia in children with pneumonia \u2013 cross sectional study","volume":"16","author":"Rahul","year":"2017","journal-title":"IOSR J Dent Med Sci"},{"key":"R13-3-20240901","doi-asserted-by":"crossref","first-page":"239","DOI":"10.1097\/MAJ.0b013e3181ca43fe","article-title":"Association of hypoglycaemia with mortality for subjects hospitalized with pneumonia","volume":"339","author":"Mortensen","year":"2010","journal-title":"Am J Med Sci"},{"key":"R14-3-20240901","doi-asserted-by":"crossref","first-page":"792","DOI":"10.26719\/2009.15.4.792","article-title":"Does sputum culture affect the management and\/or outcome of community-acquired pneumonia?","volume":"15","author":"Shariatzadeh","year":"2009","journal-title":"East Mediterr Health J"}],"container-title":["Alexandria Journal of Pediatrics"],"language":"en","link":[{"URL":"https:\/\/www.ovid.com\/10.4103\/ajop.ajop_8_22","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"deposited":{"date-parts":[[2026,8,26]],"date-time":"2026-08-26T15:05:28Z","timestamp":1787756728000},"score":32.092636,"resource":{"primary":{"URL":"https:\/\/www.ovid.com\/10.4103\/ajop.ajop_8_22"}},"issued":{"date-parts":[[2022,1]]},"references-count":14,"journal-issue":{"issue":"1","published-print":{"date-parts":[[2022]]}},"URL":"https:\/\/doi.org\/10.4103\/ajop.ajop_8_22","ISSN":["1687-9945"],"issn-type":[{"value":"1687-9945","type":"print"}],"published":{"date-parts":[[2022,1]]}},{"indexed":{"date-parts":[[2026,5,20]],"date-time":"2026-05-20T10:08:42Z","timestamp":1779271722344,"version":"3.51.4"},"reference-count":26,"publisher":"Walter de Gruyter GmbH","issue":"1","license":[{"start":{"date-parts":[[2025,1,1]],"date-time":"2025-01-01T00:00:00Z","timestamp":1735689600000},"content-version":"unspecified","delay-in-days":0,"URL":"http:\/\/creativecommons.org\/licenses\/by-nc-nd\/4.0"}],"content-domain":{"domain":[],"crossmark-restriction":false},"published-print":{"date-parts":[[2025,1,1]]},"abstract":"<jats:title>Abstract<\/jats:title>\n                  <jats:p>\n                    <jats:bold>English:<\/jats:bold>\n                  <\/jats:p>\n                  <jats:sec>\n                    <jats:title>Background<\/jats:title>\n                    <jats:p>Severe community-acquired pneumonia (sCAP) is a growing burden on public health, associated with high morbidity and mortality. The diversity of aetiological agents requires that current guidelines consider the potential benefit of using rapid molecular techniques for microbial diagnosis as part of sCAP management.<\/jats:p>\n                  <\/jats:sec>\n                  <jats:sec>\n                    <jats:title>Objective<\/jats:title>\n                    <jats:p>This study aimed to assess the diagnostic performance of BioFire\u00ae FilmArray\u00ae Pneumonia Panel (BFPP) versus standard-of-care (SOC) culture for rapidly detecting respiratory pathogens and genetic markers among patients with sCAP.<\/jats:p>\n                  <\/jats:sec>\n                  <jats:sec>\n                    <jats:title>Methods<\/jats:title>\n                    <jats:p>The study was conducted on 236 patients with sCAP; lower respiratory tract (LRT) specimens were investigated by both BFPP and SOC, and the results were compared regarding the diagnostic performance, their related resistance genes and their effect on patient outcomes.<\/jats:p>\n                  <\/jats:sec>\n                  <jats:sec>\n                    <jats:title>Results<\/jats:title>\n                    <jats:p>BFPP showed an overall sensitivity of 81.97% (95% confidence interval [CI]: 73.98\u201388.34) and an overall specificity of 94.44% (95% CI: 93.59\u201395.21) over SOC. The 214 resistance genes detected by BFPP enabled rapid initiation of targeted antimicrobial therapy.<\/jats:p>\n                  <\/jats:sec>\n                  <jats:sec>\n                    <jats:title>Conclusion<\/jats:title>\n                    <jats:p>BFPP can enhance rapid microbiological diagnosis of patients with sCAP for early implementation of precision antimicrobial therapy, improving both morbidity and mortality. However, BFPP does not detect fungal pathogens, which is an important limitation in some clinical situations.<\/jats:p>\n                  <\/jats:sec>","DOI":"10.2478\/pneum-2025-0027","type":"journal-article","created":{"date-parts":[[2025,10,31]],"date-time":"2025-10-31T12:01:00Z","timestamp":1761912060000},"page":"48-60","source":"Crossref","is-referenced-by-count":0,"title":["BioFire\u00ae FilmArray\u00ae Pneumonia Panel versus bacterial culture in adult community acquired pneumonia: treatment implications"],"prefix":"10.2478","volume":"74","author":[{"given":"Samir Mohamed Mahmoud","family":"Fahyim","sequence":"first","affiliation":[{"name":"Chest Department, Faculty of Medicine, Port Said University , Port Said , Egypt"}],"role":[{"role":"author","vocabulary":"crossref"}]},{"ORCID":"https:\/\/orcid.org\/0000-0003-3986-4757","authenticated-orcid":false,"given":"Hesham Atef","family":"AbdelHalim","sequence":"additional","affiliation":[{"name":"Chest Department, Faculty of Medicine, Ain Shams University , Cairo , Egypt"}],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Heba Helmy","family":"AboElNaga","sequence":"additional","affiliation":[{"name":"Chest Department, Faculty of Medicine, October 6 University , Giza , Egypt"}],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Rania Talaat Abdel","family":"Haleem","sequence":"additional","affiliation":[{"name":"Microbiology Department, Faculty of Medicine, Helwan University , Helwan , Egypt ."}],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"El Shaimaa Sabry Mohammed","family":"Hassan","sequence":"additional","affiliation":[{"name":"Chest Department, Faculty of Medicine, Port Said University , Port Said , Egypt"}],"role":[{"role":"author","vocabulary":"crossref"}]}],"member":"374","published-online":{"date-parts":[[2025,10,31]]},"reference":[{"key":"2026052009414877334_j_pneum-2025-0027_ref_001","doi-asserted-by":"crossref","unstructured":"Martin-Loeches I, Torres A, Nagavci B, Aliberti S, Antonelli M, Bassetti M, et al. ERS\/ESICM\/ESCMID\/ALAT guidelines for the management of severe community-acquired pneumonia. Intensive Care Medicine. 2023;49(6): 615\u2013632. doi:10.1007\/S00134-023-07033-8","DOI":"10.1007\/s00134-023-07033-8"},{"key":"2026052009414877334_j_pneum-2025-0027_ref_002","doi-asserted-by":"crossref","unstructured":"Yatera K, Mukae H. Corynebacterium species as one of the major causative pathogens of bacterial pneumonia. Respiratory Investigation. 2020;58: 131\u2013133. doi:10.1016\/J. RESINV.2020.01.008","DOI":"10.1016\/j.resinv.2020.01.008"},{"key":"2026052009414877334_j_pneum-2025-0027_ref_003","doi-asserted-by":"crossref","unstructured":"Foschi C, Zignoli A, Gaibani P, Vocale C, Rossini G, Lafratta S, et al. Respiratory bacterial co-infections in intensive care unit-hospitalized COVID-19 patients: conventional culture vs Biofire FilmArray Pneumonia Plus Panel. Journal of Microbiological Methods. 2021;186: 106259. doi:10.1016\/J.MIMET.2021.106259","DOI":"10.1016\/j.mimet.2021.106259"},{"key":"2026052009414877334_j_pneum-2025-0027_ref_004","doi-asserted-by":"crossref","unstructured":"Kamel NA, Alshahrani MY, Aboshanab KM, El Borhamy MI. Evaluation of the BioFire FilmArray Pneumonia Panel Plus to the conventional diagnostic methods in determining the microbiological etiology of hospital-acquired pneumonia. Biology (Basel). 2022;11: 377. doi:10.3390\/BIOLOGY11030377\/S1","DOI":"10.3390\/biology11030377"},{"key":"2026052009414877334_j_pneum-2025-0027_ref_005","doi-asserted-by":"crossref","unstructured":"Musher DM, Roig IL, Cazares G, Stager CE, Logan N, Safar H. Can an e