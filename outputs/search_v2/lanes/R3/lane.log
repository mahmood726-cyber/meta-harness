The broader local audit text explains the placeholder better: the named set overlaps with trials that are excluded or not cleanly poolable under the current protocol. I’ll preserve that nuance in the ambiguous entry instead of flattening it into a false “resolved” result.
exec
"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "@'
import json, xml.etree.ElementTree as ET
from pathlib import Path
for n in [6,8,11,14,15,17]:
    p=next(Path('lane_r3/raw').glob(f'{n:03d}-*'))
    print('\\n##',p.name)
    text=p.read_text(encoding='utf-8',errors='replace')
    if p.suffix=='.xml':
        root=ET.fromstring(text)
        for art in root.findall('.//PubmedArticle')[:5]:
            pmid=art.findtext('./MedlineCitation/PMID') or ''
            title=art.findtext('./MedlineCitation/Article/ArticleTitle') or ''
            year=art.findtext('./MedlineCitation/Article/Journal/JournalIssue/PubDate/Year') or art.findtext('./MedlineCitation/Article/Journal/JournalIssue/PubDate/MedlineDate') or ''
            ids=[(a.attrib.get('IdType'), a.text) for a in art.findall('./PubmedData/ArticleIdList/ArticleId')]
            print(pmid, year, ids, title.encode('ascii','backslashreplace').decode('ascii'))
    else:
        try: data=json.loads(text)
        except: continue
        if 'esearchresult' in data: print(data['esearchresult'].get('count'), data['esearchresult'].get('idlist'))
        elif 'resultList' in data:
            for it in data['resultList'].get('result',[])[:5]: print(it.get('pmid'), it.get('doi'), it.get('pubYear'), str(it.get('title')).encode('ascii','backslashreplace').decode('ascii'))
        elif 'studies' in data:
            for st in data.get('studies',[])[:5]:
                im=st.get('protocolSection',{}).get('identificationModule',{})
                print(im.get('nctId'), im.get('acronym'), im.get('briefTitle'))
