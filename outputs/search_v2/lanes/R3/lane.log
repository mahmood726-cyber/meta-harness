,[2755],{"#text":1582},{"@_valign":1382,"@_align":1383},{"#text":1376},{"td":2759,":@":2761},[2760],{"#text":2466},{"@_valign":1382,"@_align":1383},{"#text":1376},{"td":2764,":@":2766},[2765],{"#text":2570},{"@_valign":1382,"@_align":1383},{"#text":1376},{"td":2769,":@":2772},[2770],{"#text":2771},"2,762",{"@_valign":1382,"@_align":1383},{"#text":1376},{"td":2775,":@":2778},[2776],{"#text":2777},"2,760",{"@_valign":1382,"@_align":1383},{"#text":1376},{"td":2781,":@":2784},[2782],{"#text":2783},"65.8 ± 8.4",{"@_valign":1382,"@_align":1383},{"#text":1376},{"td":2787,":@":2790},[2788],{"#text":2789},"65.9 ± 8.7",{"@_valign":1382,"@_align":1383},{"#text":1376},{"td":2793,":@":2796},[2794],{"#text":2795},"2,305 (83.5%)",{"@_valign":1382,"@_align":1383},{"#text":1376},{"td":2799,":@":2802},[2800],{"#text":2801},"2,371 (85.9%)",{"@_valign":1382,"@_align":1383},{"#text":1376},{"td":2805,":@":2808},[2806],{"#text":2807},"492 (17.8%)",{"@_valign":1382,"@_align":1383},{"#text":1376},{"td":2811,":@":2814},[2812],{"#text":2813},"515 (18.7%)",{"@_valign":1382,"@_align":1383},{"#text":1376},{"td":2817,":@":2820},[2818],{"#text":2819},"0.5mg per day",{"@_valign":1382,"@_align":1383},{"#text":1376},{"td":2823,":@":2826},[2824],{"#text":2825},"Compliance with study medications; 6. death and",{"@_valign":1382,"@_align":1383},{"#text":1376},{"td":2829,":@":2832},[2830],{"#text":2831},"28.6",{"@_valign":1382,"@_align":1383},{"#text":1372},{"#text":1372},{"tr":2836},[2837,2838,2848,2849,2853,2854,2858,2859,2864,2865,2870,2871,2876,2877,2882,2883,2888,2889,2894,2895,2900,2901,2906,2907,2912,2913,2917,2918,2923,2924,2928],{"#text":1376},{"td":2839,":@":2847},[2840,2842,2846],{"#text":2841},"Akrami et al. (",{"xref":2843,":@":2845},[2844],{"#text":1210},{"@_ref-type":976,"@_rid":1212},{"#text":1478},{"@_valign":1382,"@_align":1383},{"#text":1376},{"td":2850,":@":2852},[2851],{"#text":2370},{"@_valign":1382,"@_align":1383},{"#text":1376},{"td":2855,":@":2857},[2856],{"#text":1684},{"@_valign":1382,"@_align":1383},{"#text":1376},{"td":2860,":@":2863},[2861],{"#text":2862},"ACS patients undergoing PCI or medical treatment",{"@_valign":1382,"@_align":1383},{"#text":1376},{"td":2866,":@":2869},[2867],{"#text":2868},"120",{"@_valign":1382,"@_align":1383},{"#text":1376},{"td":2872,":@":2875},[2873],{"#text":2874},"129",{"@_valign":1382,"@_align":1383},{"#text":1376},{"td":2878,":@":2881},[2879],{"#text":2880},"56.9 ± 7.56",{"@_valign":1382,"@_align":1383},{"#text":1376},{"td":2884,":@":2887},[2885],{"#text":2886},"56.89 ± 7.45",{"@_valign":1382,"@_align":1383},{"#text":1376},{"td":2890,":@":2893},[2891],{"#text":2892},"86 (71.7%)",{"@_valign":1382,"@_align":1383},{"#text":1376},{"td":2896,":@":2899},[2897],{"#text":2898},"87 (67.4%)",{"@_valign":1382,"@_align":1383},{"#text":1376},{"td":2902,":@":2905},[2903],{"#text":2904},"27 (22.5%)",{"@_valign":1382,"@_align":1383},{"#text":1376},{"td":2908,":@":2911},[2909],{"#text":2910},"32 (24.8%)",{"@_valign":1382,"@_align":1383},{"#text":1376},{"td":2914,":@":2916},[2915],{"#text":1744},{"@_valign":1382,"@_align":1383},{"#text":1376},{"td":2919,":@":2922},[2920],{"#text":2921},"Major cardiovascular events",{"@_valign":1382,"@_align":1383},{"#text":1376},{"td":2925,":@":2927},[2926],{"#text":1007},{"@_valign":1382,"@_align":1383},{"#text":1372},{"#text":787},{"#text":793},{"@_cellspacing":2932,"@_cellpadding":2932,"@_frame":2933,"@_rules":2934},5,"hsides","groups",{"#text":955},{"@_position":1347,"@_id":1313},{"#text":955},{"p":2939},[2940,2942,2948,2950,2954],{"#text":2941},"According to the design of each RCT, we used the Cochrane tool to score 15 RCTs for risk of bias. ",{"xref":2943,":@":2946},[2944],{"#text":2945},"Figure 2",{"@_ref-type":1297,"@_rid":2947},"F2",{"#text":2949}," demonstrates the methodological quality for each RCT and showed the risk of bias of RCTs included in our meta-analysis was low (",{"xref":2951,":@":2953},[2952],{"#text":2945},{"@_ref-type":1297,"@_rid":2947},{"#text":1321},{"#text":955},{"fig":2957,":@":2990},[2958,2959,2963,2964,2984,2985,2989],{"#text":793},{"label":2960},[2961],{"#text":2962},"FIGURE 2",{"#text":793},{"caption":2965},[2966,2967,2983],{"#text":787},{"p":2968},[2969,2971,2975,2977,2981],{"#text":2970},"Risk of bias plot. ",{"bold":2972},[2973],{"#text":2974},"(A)",{"#text":2976}," Risk of bias summary; ",{"bold":2978},[2979],{"#text":2980},"(B)",{"#text":2982}," risks of bias of each included study.",{"#text":793},{"#text":793},{"graphic":2986,":@":2987},[],{"@_mimetype":394,"@_mime-subtype":1343,"@_xlink:href":2988},"fcvm-09-947959-g002.tif",{"#text":955},{"@_id":2947,"@_position":1347},{"#text":955},{"sec":2993,":@":3345},[2994,2995,2999,3000,3104,3105,3185,3186,3344],{"#text":793},{"title":2996},[2997],{"#text":2998},"Endpoints",{"#text":793},{"sec":3001,":@":3102},[3002,3003,3007,3008,3049,3050,3101],{"#text":787},{"title":3004},[3005],{"#text":3006},"Cardiovascular outcomes",{"#text":787},{"p":3009},[3010,3012,3015,3017,3020,3022,3025,3027,3030,3032,3035,3037,3040,3042,3048],{"#text":3011},"Among the included RCTs, a total of seven studies reported MACE, defined as a composite of cardiovascular death, non-fatal ischemic stroke, and non-fatal MI), with nine RCTs reporting cardiovascular death, six RCTs reporting stroke, and nine RCTs reporting MI, and five RCTs reporting revascularization, respectively. Compared with controls, treatment with colchicine reduced the risk of MACE by 46% (RR: 0.65; 95% CI: 0.38–0.77, ",{"italic":3013},[3014],{"#text":899},{"#text":3016}," for heterogeneity \u003C 0.01; I2 = 70%; ",{"italic":3018},[3019],{"#text":899},{"#text":3021}," \u003C 0.01) and stroke by 52% (RR: 0.48; 95% CI: 0.30–0.76; p for heterogeneity = 0.52; I2 = 0%; ",{"italic":3023},[3024],{"#text":899},{"#text":3026}," \u003C 0.01), a 40% reduction in risk of MI (RR: 0.60; 95% CI: 0.43–0.83; p for heterogeneity = 0.01; I2 = 59%; ",{"italic":3028},[3029],{"#text":899},{"#text":3031}," \u003C 0.01), a 32% reduction in risk of incidence of revascularization (RR: 0.68; 95% CI: 0.56–0.83; p for heterogeneity = 0.17; I2 = 40%; ",{"italic":3033},[3034],{"#text":899},{"#text":3036}," \u003C 0.01). However, colchicine did not reduce the risk of cardiovascular death compared with controls(RR: 0.77; 95% CI: 0.53–1.12; p for heterogeneity = 0.18; I2 = 34%; ",{"italic":3038},[3039],{"#text":899},{"#text":3041}," = 0.17) (",{"xref":3043,":@":3046},[3044],{"#text":3045},"Figure 3",{"@_ref-type":1297,"@_rid":3047},"F3",{"#text":1321},{"#text":787},{"fig":3051,":@":3100},[3052,3053,3057,3058,3094,3095,3099],{"#text":1372},{"label":3054},[3055],{"#text":3056},"FIGURE 3",{"#text":1372},{"caption":3059},[3060,3061,3093],{"#text":1376},{"p":3062},[3063,3065,3068,3070,3073,3075,3079,3081,3085,3087,3091],{"#text":3064},"Comparison of colchicine treatment vs. control group on the risks of ",{"bold":3066},[3067],{"#text":2974},{"#text":3069}," MACE, ",{"bold":3071},[3072],{"#text":2980},{"#text":3074}," CV death, ",{"bold":3076},[3077],{"#text":3078},"(C)",{"#text":3080}," stroke, ",{"bold":3082},[3083],{"#text":3084},"(D)",{"#text":3086}," MI, ",{"bold":3088},[3089],{"#text":3090},"(E)",{"#text":3092}," Revascularization. MACE, major adverse cardiovascular events; CV death, cardiovascular death; MI, myocardial infarction.",{"#text":1372},{"#text":1372},{"graphic":3096,":@":3097},[],{"@_mimetype":394,"@_mime-subtype":1343,"@_xlink:href":3098},"fcvm-09-947959-g003.tif",{"#text":787},{"@_id":3047,"@_position":1347},{"#text":793},{"@_id":3103},"S3.SS1.SSS1",{"#text":793},{"sec":3106,":@":3183},[3107,3108,3112,3113,3149,3150,3182],{"#text":787},{"title":3109},[3110],{"#text":3111},"All-cause and non-cardiovascular deaths",{"#text":787},{"p":3114},[3115,3117,3120,3122,3125,3127,3130,3132,3135,3137,3140,3142,3148],{"#text":3116},"All-cause mortality was reported in 13 trials (",{"italic":3118},[3119],{"#text":1414},{"#text":3121}," = 13,288) and colchicine did not reduce the risk of death from any cause compared with controls (RR: 1.07; 95% CI: 0.85–1.36; p for heterogeneity ",{"italic":3123},[3124],{"#text":899},{"#text":3126}," = 0.56; I2 = 19%; ",{"italic":3128},[3129],{"#text":899},{"#text":3131}," = 0.27), Seven studies reported non-cardiovascular mortality, and similarly, colchicine was not significantly associated with the risk of non-cardiovascular mortality compared with controls (RR: 1.38; 95% CI: 1.00–1.90; p for heterogeneity ",{"italic":3133},[3134],{"#text":899},{"#text":3136}," = 0.36; I2 = 7%; ",{"italic":3138},[3139],{"#text":899},{"#text":3141}," = 0.05) (",{"xref":3143,":@":3146},[3144],{"#text":3145},"Figure 4",{"@_ref-type":1297,"@_rid":3147},"F4",{"#text":1321},{"#text":787},{"fig":3151,":@":3181},[3152,3153,3157,3158,3175,3176,3180],{"#text":1372},{"label":3154},[3155],{"#text":3156},"FIGURE 4",{"#text":1372},{"caption":3159},[3160,3161,3174],{"#text":1376},{"p":3162},[3163,3164,3167,3169,3172],{"#text":3064},{"bold":3165},[3166],{"#text":2974},{"#text":3168}," All-cause death; ",{"bold":3170},[3171],{"#text":2980},{"#text":3173}," non-CV death. Non-CV death, Non-cardiovascular death.",{"#text":1372},{"#text":1372},{"graphic":3177,":@":3178},[],{"@_mimetype":394,"@_mime-subtype":1343,"@_xlink:href":3179},"fcvm-09-947959-g004.tif",{"#text":787},{"@_id":3147,"@_position":1347},{"#text":793},{"@_id":3184},"S3.SS1.SSS2",{"#text":793},{"sec":3187,":@":3342},[3188,3189,3193,3194,3235,3236,3268,3269,3293,3294,3317,3318,3341],{"#text":787},{"title":3190},[3191],{"#text":3192},"Gastrointestinal adverse events and diarrhea",{"#text":787},{"p":3195},[3196,3198,3201,3203,3206,3208,3211,3213,3216,3218,3221,3223,3226,3228,3234],{"#text":3197},"All 14 RCT (",{"italic":3199},[3200],{"#text":1414},{"#text":3202}," = 13,311) reported gastrointestinal adverse events, with a significantly higher incidence in the colchicine treatment group than in the control group (RR: 2.07; 95% CI: 1.45–2.95; ",{"italic":3204},[3205],{"#text":899},{"#text":3207}," for heterogeneity ",{"italic":3209},[3210],{"#text":899},{"#text":3212}," \u003C 0.01; I2 = 76%; ",{"italic":3214},[3215],{"#text":899},{"#text":3217}," = 0.04). Also, the risk of diarrhea was higher in the colchicine treated group compared to the control group (RR: 3.26; 95% CI: 1.29–8.25; p for heterogeneity ",{"italic":3219},[3220],{"#text":899},{"#text":3222}," \u003C 0.01; I2 = 83%; ",{"italic":3224},[3225],{"#text":899},{"#text":3227}," = 0.01) (",{"xref":3229,":@":3232},[3230],{"#text":3231},"Figure 5",{"@_ref-type":1297,"@_rid":3233},"F5",{"#text":1321},{"#text":787},{"fig":3237,":@":3267},[3238,3239,3243,3244,3261,3262,3266],{"#text":1372},{"label":3240},[3241],{"#text":3242},"FIGURE 5",{"#text":1372},{"caption":3245},[3246,3247,3260],{"#text":1376},{"p":3248},[3249,3250,3253,3255,3258],{"#text":3064},{"bold":3251},[3252],{"#text":2974},{"#text":3254}," GI side effect; ",{"bold":3256},[3257],{"#text":2980},{"#text":3259}," diarrhea. GI side effect, gastrointestinal side effects.",{"#text":1372},{"#text":1372},{"graphic":3263,":@":3264},[],{"@_mimetype":394,"@_mime-subtype":1343,"@_xlink:href":3265},"fcvm-09-947959-g005.tif",{"#text":787},{"@_id":3233,"@_position":1347},{"#text":787},{"p":3270},[3271,3273,3276,3278,3284,3286,3292],{"#text":3272},"Depending on the heterogeneity of the included RCT, we used either a random effects model or a fixed effects model for data analysis, and we used the Peters test and funnel plot for testing the risk of bias at ",{"italic":3274},[3275],{"#text":899},{"#text":3277}," \u003C 0.05, which was symmetrical from the point of view of the geometry in ",{"xref":3279,":@":3282},[3280],{"#text":3281},"Figure 6",{"@_ref-type":1297,"@_rid":3283},"F6",{"#text":3285},". This indicates that the risk of bias was low for the RCT included in our meta-analysis. we also performed a meta-regression analysis to determine outcome-related variables (",{"xref":3287,":@":3290},[3288],{"#text":3289},"Figure 7",{"@_ref-type":1297,"@_rid":3291},"F7",{"#text":1321},{"#text":787},{"fig":3295,":@":3316},[3296,3297,3301,3302,3310,3311,3315],{"#text":1372},{"label":3298},[3299],{"#text":3300},"FIGURE 6",{"#text":1372},{"caption":3303},[3304,3305,3309],{"#text":1376},{"p":3306},[3307],{"#text":3308},"The detection of publication bias. Funnel chart.",{"#text":1372},{"#text":1372},{"graphic":3312,":@":3313},[],{"@_mimetype":394,"@_mime-subtype":1343,"@_xlink:href":3314},"fcvm-09-947959-g006.tif",{"#text":787},{"@_id":3283,"@_position":1347},{"#text":787},{"fig":3319,":@":3340},[3320,3321,3325,3326,3334,3335,3339],{"#text":1372},{"label":3322},[3323],{"#text":3324},"FIGURE 7",{"#text":1372},{"caption":3327},[3328,3329,3333],{"#text":1376},{"p":3330},[3331],{"#text":3332},"Regression plot exhibiting association between age and nationality of patients and major adverse cardiovascular events.",{"#text":1372},{"#text":1372},{"graphic":3336,":@":3337},[],{"@_mimetype":394,"@_mime-subtype":1343,"@_xlink:href":3338},"fcvm-09-947959-g007.tif",{"#text":787},{"@_id":3291,"@_position":1347},{"#text":793},{"@_id":3343},"S3.SS1.SSS3",{"#text":955},{"@_id":3346},"S3.SS1",{"#text":955},{"sec":3349,":@":4065},[3350,3351,3354,3355,3459,3460,3624,3625,3773,3774,3841,3842,3975,3976,4064],{"#text":793},{"title":3352},[3353],{"#text":1201},{"#text":793},{"sec":3356,":@":3457},[3357,3358,3362,3363,3432,3433,3456],{"#text":787},{"title":3359},[3360],{"#text":3361},"Duration of follow-up visits",{"#text":787},{"p":3364},[3365,3367,3371,3372,3377,3379,3383,3384,3388,3389,3393,3395,3399,3400,3404,3405,3409,3411,3414,3415,3418,3420,3423,3425,3431],{"#text":3366},"Among the included studies, 7 studies had a follow-up time of ≤ 1 month (",{"xref":3368,":@":3370},[3369],{"#text":2169},{"@_ref-type":976,"@_rid":2171},{"#text":1003},{"xref":3373,":@":3375},[3374],{"#text":2201},{"@_ref-type":976,"@_rid":3376},"B21",{"#text":3378},"), 5 studies had a follow-up time of > 1 month and ≤ 1 year (",{"xref":3380,":@":3382},[3381],{"#text":1210},{"@_ref-type":976,"@_rid":1212},{"#text":979},{"xref":3385,":@":3387},[3386],{"#text":2551},{"@_ref-type":976,"@_rid":2553},{"#text":1003},{"xref":3390,":@":3392},[3391],{"#text":1770},{"@_ref-type":976,"@_rid":1772},{"#text":3394},"), and 3 studies had a follow-up time of > 1 year (",{"xref":3396,":@":3398},[3397],{"#text":1020},{"@_ref-type":976,"@_rid":1022},{"#text":979},{"xref":3401,":@":3403},[3402],{"#text":1027},{"@_ref-type":976,"@_rid":1029},{"#text":979},{"xref":3406,":@":3408},[3407],{"#text":1217},{"@_ref-type":976,"@_rid":1219},{"#text":3410},"). First, regardless of the length of follow-up, we found no significant effect of colchicine on cardiovascular mortality, non-cardiovascular mortality, and all-cause mortality compared to controls. Secondly, we found that colchicine treatment significantly increased the incidence of gastrointestinal adverse events compared to the control group when the follow-up period was \u003C 1 year but had no significant effect on the incidence of gastrointestinal adverse events compared to the control group when the follow-up period was > 1 year (RR: 1.06; 95% CI: 0.94–1.20; ",{"italic":3412},[3413],{"#text":899},{"#text":3207},{"italic":3416},[3417],{"#text":899},{"#text":3419}," = 0.01; I2 = 78%; ",{"italic":3421},[3422],{"#text":899},{"#text":3424}," = 0.55); In addition, when follow-up was ≤ 1 month, the colchicine treatment group had no significant effect on cardiovascular outcomes, all-cause mortality, and non-cardiovascular mortality, whereas when follow-up was > 1 month in the study, colchicine administration reduced the risk of MACE, MI, stroke, revascularization, and non-cardiovascular mortality (",{"xref":3426,":@":3429},[3427],{"#text":3428},"Figure 8",{"@_ref-type":1297,"@_rid":3430},"F8",{"#text":1321},{"#text":787},{"fig":3434,":@":3455},[3435,3436,3440,3441,3449,3450,3454],{"#text":1372},{"label":3437},[3438],{"#text":3439},"FIGURE 8",{"#text":1372},{"caption":3442},[3443,3444,3448],{"#text":1376},{"p":3445},[3446],{"#text":3447},"Forest plot of subgroup of study with different follow-up duration. MACE, major adverse cardiovascular events; CV death, cardiovascular death; MI, myocardial infarction; Non-CV death, Non-cardiovascular death. *Random-effect model.",{"#text":1372},{"#text":1372},{"graphic":3451,":@":3452},[],{"@_mimetype":394,"@_mime-subtype":1343,"@_xlink:href":3453},"fcvm-09-947959-g008.tif",{"#text":787},{"@_id":3430,"@_position":1347},{"#text":793},{"@_id":3458},"S3.SS2.SSS1",{"#text":793},{"sec":3461,":@":3622},[3462,3463,3467,3468,3597,3598,3621],{"#text":787},{"title":3464},[3465],{"#text":3466},"Dose of colchicine",{"#text":787},{"p":3469},[3470,3472,3476,3477,3481,3482,3486,3487,3491,3492,3496,3497,3501,3503,3507,3508,3512,3513,3517,3518,3522,3523,3527,3528,3532,3534,3538,3540,3543,3545,3548,3550,3553,3555,3558,3560,3563,3565,3568,3570,3573,3575,3578,3580,3583,3585,3588,3590,3596],{"#text":3471},"Six RCTs applied low doses of colchicine (dose = 0.5 mg) to 13,165 subjects (",{"xref":3473,":@":3475},[3474],{"#text":1020},{"@_ref-type":976,"@_rid":1022},{"#text":979},{"xref":3478,":@":3480},[3479],{"#text":1027},{"@_ref-type":976,"@_rid":1029},{"#text":979},{"xref":3483,":@":3485},[3484],{"#text":1210},{"@_ref-type":976,"@_rid":1212},{"#text":979},{"xref":3488,":@":3490},[3489],{"#text":1217},{"@_ref-type":976,"@_rid":1219},{"#text":979},{"xref":3493,":@":3495},[3494],{"#text":2551},{"@_ref-type":976,"@_rid":2553},{"#text":979},{"xref":3498,":@":3500},[3499],{"#text":2195},{"@_ref-type":976,"@_rid":2268},{"#text":3502},"),and eight other RCTs applied high doses of colchicine (dose ≥ 1 mg) to 1,295 subjects (",{"xref":3504,":@":3506},[3505],{"#text":1020},{"@_ref-type":976,"@_rid":1022},{"#text":979},{"xref":3509,":@":3511},[3510],{"#text":2169},{"@_ref-type":976,"@_rid":2171},{"#text":1003},{"xref":3514,":@":3516},[3515],{"#text":1872},{"@_ref-type":976,"@_rid":1874},{"#text":979},{"xref":3519,":@":3521},[3520],{"#text":2065},{"@_ref-type":976,"@_rid":2067},{"#text":979},{"xref":3524,":@":3526},[3525],{"#text":1474},{"@_ref-type":976,"@_rid":1476},{"#text":979},{"xref":3529,":@":3531},[3530],{"#text":1770},{"@_ref-type":976,"@_rid":1772},{"#text":3533},"), One trial did not report a definitive dose (",{"xref":3535,":@":3537},[3536],{"#text":2201},{"@_ref-type":976,"@_rid":3376},{"#text":3539},"). In our study, a subgroup analysis was conducted to establish the relationship between colchicine and cardiovascular risk. No significant differences were demonstrated in CV mortality and all-cause mortality compared to controls for either low or high dose colchicine; low dose colchicine significantly reduced the risk of MACE (RR: 0.65; 95% CI: 0.56–0.75; p for heterogeneity ",{"italic":3541},[3542],{"#text":899},{"#text":3544}," \u003C 0.01; I2 = 80%; ",{"italic":3546},[3547],{"#text":899},{"#text":3549}," \u003C 0.01), MI (RR: 0.66;95%CI:0.56–0.79;p for heterogeneity ",{"italic":3551},[3552],{"#text":899},{"#text":3554}," \u003C 0.01; I2 = 71%; ",{"italic":3556},[3557],{"#text":899},{"#text":3559}," \u003C 0.01), stroke (RR:0.45;95%CI:0.28–0.73;p for heterogeneity ",{"italic":3561},[3562],{"#text":899},{"#text":3564}," = 0.55; I2 = 0%; ",{"italic":3566},[3567],{"#text":899},{"#text":3569}," \u003C 0.01), and revascularization in subjects (RR:0.68;95%CI:0.56–0.83;p for heterogeneity ",{"italic":3571},[3572],{"#text":899},{"#text":3574}," = 0.08; I2 = 60%; ",{"italic":3576},[3577],{"#text":899},{"#text":3579}," = 0.02). However, high-dose colchicine did not show similar benefits for MACE, MI, stroke, or revascularization. Finally, both high and low doses of colchicine increased the risk of gastrointestinal events compared to the control group, but low-dose colchicine treatment was not significantly associated with the occurrence of diarrhea (RR: 1.15; 95% CI: 0.96–1.37; p for heterogeneity ",{"italic":3581},[3582],{"#text":899},{"#text":3584}," = 0.02; I2 = 84%; ",{"italic":3586},[3587],{"#text":899},{"#text":3589}," = 0.33) (",{"xref":3591,":@":3594},[3592],{"#text":3593},"Figure 9",{"@_ref-type":1297,"@_rid":3595},"F9",{"#text":1321},{"#text":787},{"fig":3599,":@":3620},[3600,3601,3605,3606,3614,3615,3619],{"#text":1372},{"label":3602},[3603],{"#text":3604},"FIGURE 9",{"#text":1372},{"caption":3607},[3608,3609,3613],{"#text":1376},{"p":3610},[3611],{"#text":3612},"Forest plot of subgroup of the application dose of colchicine. MACE, major adverse cardiovascular events; CV death, cardiovascular death; MI, myocardial infarction; Non-CV death, Non-cardiovascular death. *Random-effect model.",{"#text":1372},{"#text":1372},{"graphic":3616,":@":3617},[],{"@_mimetype":394,"@_mime-subtype":1343,"@_xlink:href":3618},"fcvm-09-947959-g009.tif",{"#text":787},{"@_id":3595,"@_position":1347},{"#text":793},{"@_id":3623},"S3.SS2.SSS2",{"#text":793},{"sec":3626,":@":3771},[3627,3628,3632,3633,3746,3747,3770],{"#text":787},{"title":3629},[3630],{"#text":3631},"Age",{"#text":787},{"p":3634},[3635,3637,3641,3642,3646,3647,3651,3652,3656,3657,3661,3662,3666,3667,3671,3672,3676,3678,3682,3683,3687,3688,3692,3693,3697,3699,3702,3704,3707,3709,3712,3714,3717,3719,3722,3724,3727,3729,3732,3734,3737,3739,3745],{"#text":3636},"The mean age of subjects in 11 RCTs was ≤ 65 years (",{"xref":3638,":@":3640},[3639],{"#text":1027},{"@_ref-type":976,"@_rid":1029},{"#text":979},{"xref":3643,":@":3645},[3644],{"#text":1210},{"@_ref-type":976,"@_rid":1212},{"#text":979},{"xref":3648,":@":3650},[3649],{"#text":2169},{"@_ref-type":976,"@_rid":2171},{"#text":979},{"xref":3653,":@":3655},[3654],{"#text":1573},{"@_ref-type":976,"@_rid":1575},{"#text":979},{"xref":3658,":@":3660},[3659],{"#text":1970},{"@_ref-type":976,"@_rid":1972},{"#text":1003},{"xref":3663,":@":3665},[3664],{"#text":2551},{"@_ref-type":976,"@_rid":2553},{"#text":979},{"xref":3668,":@":3670},[3669],{"#text":1474},{"@_ref-type":976,"@_rid":1476},{"#text":1003},{"xref":3673,":@":3675},[3674],{"#text":2361},{"@_ref-type":976,"@_rid":2363},{"#text":3677},") and the age of subjects in the other 4 RCTs was > 65 years (",{"xref":3679,":@":3681},[3680],{"#text":1020},{"@_ref-type":976,"@_rid":1022},{"#text":979},{"xref":3684,":@":3686},[3685],{"#text":1217},{"@_ref-type":976,"@_rid":1219},{"#text":979},{"xref":3689,":@":3691},[3690],{"#text":1536},{"@_ref-type":976,"@_rid":2649},{"#text":979},{"xref":3694,":@":3696},[3695],{"#text":1872},{"@_ref-type":976,"@_rid":1874},{"#text":3698},"),For all-cause deaths, CV deaths and non-CV deaths, colchicine had no effect at all age groups, In contrast, colchicine treatment significantly reduced the risk of MACE(RR: 0.69; 95% CI: 0.56–0.84; p for heterogeneity ",{"italic":3700},[3701],{"#text":899},{"#text":3703}," = 0.06; I2 = 54%; ",{"italic":3705},[3706],{"#text":899},{"#text":3708}," = 0.02), stroke(RR: 0.35; 95% CI: 0.16–0.74; p for heterogeneity ",{"italic":3710},[3711],{"#text":899},{"#text":3713}," = 0.54; I2 = 0%; ",{"italic":3715},[3716],{"#text":899},{"#text":3718}," \u003C 0.01), MI(RR: 0.73; 95% CI: 0.59–0.91; p for heterogeneity ",{"italic":3720},[3721],{"#text":899},{"#text":3723}," = 0.03; I2 = 62%; ",{"italic":3725},[3726],{"#text":899},{"#text":3728}," = 0.03) and revascularization(RR: 0.69; 95% CI: 0.57–0.83; p for heterogeneity ",{"italic":3730},[3731],{"#text":899},{"#text":3733}," = 0.17; I2 = 40%; ",{"italic":3735},[3736],{"#text":899},{"#text":3738}," \u003C 0.01) in subjects up to 65 years of age, but did not show significant differences in subjects over 65 years of age (",{"xref":3740,":@":3743},[3741],{"#text":3742},"Figure 10",{"@_ref-type":1297,"@_rid":3744},"F10",{"#text":1321},{"#text":787},{"fig":3748,":@":3769},[3749,3750,3754,3755,3763,3764,3768],{"#text":1372},{"label":3751},[3752],{"#text":3753},"FIGURE 10",{"#text":1372},{"caption":3756},[3757,3758,3762],{"#text":1376},{"p":3759},[3760],{"#text":3761},"Forest plot of subgroup of subjects with varied age. MACE, major adverse cardiovascular events; CV death, cardiovascular death; MI, myocardial infarction; Non-CV death, Non-cardiovascular death. *Random-effect model.",{"#text":1372},{"#text":1372},{"graphic":3765,":@":3766},[],{"@_mimetype":394,"@_mime-subtype":1343,"@_xlink:href":3767},"fcvm-09-947959-g010.tif",{"#text":787},{"@_id":3744,"@_position":1347},{"#text":793},{"@_id":3772},"S3.SS2.SSS3",{"#text":793},{"sec":3775,":@":3839},[3776,3777,3781,3782,3814,3815,3838],{"#text":787},{"title":3778},[3779],{"#text":3780},"Dosing before percutaneous coronary intervention",{"#text":787},{"p":3783},[3784,3786,3790,3791,3795,3797,3800,3802,3805,3807,3813],{"#text":3785},"Two RCTs (",{"xref":3787,":@":3789},[3788],{"#text":2169},{"@_ref-type":976,"@_rid":2171},{"#text":979},{"xref":3792,":@":3794},[3793],{"#text":1536},{"@_ref-type":976,"@_rid":2649},{"#text":3796},") reported the number of MACE events in patients after pre-PCI dosing. Pre-PCI colchicine did not have a significant effect on improving the risk of cardiovascular MACE in patients compared to the control group (RR: 0.90; 95% CI: 0.54–1.51; p for heterogeneity ",{"italic":3798},[3799],{"#text":899},{"#text":3801}," = 0.99; I2 = 0%; ",{"italic":3803},[3804],{"#text":899},{"#text":3806}," = 0.70) (",{"xref":3808,":@":3811},[3809],{"#text":3810},"Figure 11",{"@_ref-type":1297,"@_rid":3812},"F11",{"#text":1321},{"#text":787},{"fig":3816,":@":3837},[3817,3818,3822,3823,3831,3832,3836],{"#text":1372},{"label":3819},[3820],{"#text":3821},"FIGURE 11",{"#text":1372},{"caption":3824},[3825,3826,3830],{"#text":1376},{"p":3827},[3828],{"#text":3829},"Forest plot of subgroups of MACE from studies with pre-surgical colchicine treatment. MACE, major adverse cardiovascular events.",{"#text":1372},{"#text":1372},{"graphic":3833,":@":3834},[],{"@_mimetype":394,"@_mime-subtype":1343,"@_xlink:href":3835},"fcvm-09-947959-g011.tif",{"#text":787},{"@_id":3812,"@_position":1347},{"#text":793},{"@_id":3840},"S3.SS2.SSS4",{"#text":793},{"sec":3843,":@":3973},[3844,3845,3849,3850,3948,3949,3972],{"#text":787},{"title":3846},[3847],{"#text":3848},"Related comorbidities",{"#text":787},{"p":3851},[3852,3854,3858,3859,3863,3865,3868,3870,3873,3875,3878,3880,3883,3885,3888,3890,3893,3895,3898,3900,3903,3904,3910,3912,3916,3917,3921,3923,3926,3928,3931,3933,3936,3938,3941,3943,3947],{"#text":3853},"Two RCTs reported the number of MACE events in patients with diabetes and hypertension (",{"xref":3855,":@":3857},[3856],{"#text":1020},{"@_ref-type":976,"@_rid":1022},{"#text":979},{"xref":3860,":@":3862},[3861],{"#text":1027},{"@_ref-type":976,"@_rid":1029},{"#text":3864},") colchicine reduces the risk of MACE in patients with or without diabetes or hypertension. (diabetes: RR: 0.77; 95% CI: 0.60–0.99; p heterogeneity ",{"italic":3866},[3867],{"#text":899},{"#text":3869}," = 0.27; I2 = 16%; ",{"italic":3871},[3872],{"#text":899},{"#text":3874}," = 0.03; non-diabetes: RR: 0.73; 95% CI: 0.61–0.86; p heterogeneity ",{"italic":3876},[3877],{"#text":899},{"#text":3879}," = 0.14; I2 = 55%; ",{"italic":3881},[3882],{"#text":899},{"#text":3884}," = 0.02;hypertension: RR: 0.71; 95% CI: 0.59–0.86; p heterogeneity ",{"italic":3886},[3887],{"#text":899},{"#text":3889}," = 0.44; I2 = 0%; ",{"italic":3891},[3892],{"#text":899},{"#text":3894}," \u003C 0.01; non-hypertension: RR: 0.76; 95% CI: 0.62–0.94; p heterogeneity ",{"italic":3896},[3897],{"#text":899},{"#text":3899}," = 0.78; I2 = 0%; ",{"italic":3901},[3902],{"#text":899},{"#text":3227},{"xref":3905,":@":3908},[3906],{"#text":3907},"Figure 12",{"@_ref-type":1297,"@_rid":3909},"F12",{"#text":3911},"). Two RCTs reported the number of MACE events in patients with previous PCI or CABG (",{"xref":3913,":@":3915},[3914],{"#text":1020},{"@_ref-type":976,"@_rid":1022},{"#text":979},{"xref":3918,":@":3920},[3919],{"#text":1027},{"@_ref-type":976,"@_rid":1029},{"#text":3922},").,Patients with a reduced risk of MACE after colchicine compared to controls, regardless of whether PCI or CABG had been performed previously(prior PCI or GABG: RR: 0.74; 95% CI: 0.62–0.88; p heterogeneity ",{"italic":3924},[3925],{"#text":899},{"#text":3927}," = 0.24; I2 = 28%; ",{"italic":3929},[3930],{"#text":899},{"#text":3932}," \u003C 0.01; non-PCI or GABG: RR: 0.73; 95% CI: 0.58–0.93; p heterogeneity ",{"italic":3934},[3935],{"#text":899},{"#text":3937}," = 0.96; I2 = 0%; ",{"italic":3939},[3940],{"#text":899},{"#text":3942}," \u003C 0.01) (",{"xref":3944,":@":3946},[3945],{"#text":3907},{"@_ref-type":1297,"@_rid":3909},{"#text":1321},{"#text":787},{"fig":3950,":@":3971},[3951,3952,3956,3957,3965,3966,3970],{"#text":1372},{"label":3953},[3954],{"#text":3955},"FIGURE 12",{"#text":1372},{"caption":3958},[3959,3960,3964],{"#text":1376},{"p":3961},[3962],{"#text":3963},"Forest plot of subgroup of the diabetes or not, sex, prior PCI or not, hypertension or not, and frequency of smoking. MACE, major adverse cardiovascular events. *Random-effect model.",{"#text":1372},{"#text":1372},{"graphic":3967,":@":3968},[],{"@_mimetype":394,"@_mime-subtype":1343,"@_xlink:href":3969},"fcvm-09-947959-g012.tif",{"#text":787},{"@_id":3909,"@_position":1347},{"#text":793},{"@_id":3974},"S3.SS2.SSS5",{"#text":793},{"sec":3977,":@":4062},[3978,3979,3983,3984,4061],{"#text":787},{"title":3980},[3981],{"#text":3982},"Sex and smoking",{"#text":787},{"p":3985},[3986,3988,3992,3993,3997,3999,4002,4004,4007,4009,4012,4014,4017,4019,4023,4025,4029,4030,4034,4036,4039,4041,4044,4046,4049,4051,4054,4056,4060],{"#text":3987},"Two RCTs reported the number of MACE events in male and female subjects (",{"xref":3989,":@":3991},[3990],{"#text":1020},{"@_ref-type":976,"@_rid":1022},{"#text":979},{"xref":3994,":@":3996},[3995],{"#text":1027},{"@_ref-type":976,"@_rid":1029},{"#text":3998},"). The results showed that colchicine treatment significantly reduced the risk of MACE in men (RR: 0.70; 95% CI: 0.60–0.82; p heterogeneity ",{"italic":4000},[4001],{"#text":899},{"#text":4003}," = 0.86; I2 = 0%; ",{"italic":4005},[4006],{"#text":899},{"#text":4008}," \u003C 0.01), but had no significant effect on the risk of events in women (RR: 0.24; 95% CI: 0.19–0.32; p heterogeneity ",{"italic":4010},[4011],{"#text":899},{"#text":4013}," \u003C 0.01; I2 = 99%; ",{"italic":4015},[4016],{"#text":899},{"#text":4018}," = 0.31) (",{"xref":4020,":@":4022},[4021],{"#text":3907},{"@_ref-type":1297,"@_rid":3909},{"#text":4024},"). Two RCTs reported the number of MACE events in smoking and non-smoking subjects (",{"xref":4026,":@":4028},[4027],{"#text":1020},{"@_ref-type":976,"@_rid":1022},{"#text":979},{"xref":4031,":@":4033},[4032],{"#text":1027},{"@_ref-type":976,"@_rid":1029},{"#text":4035},"),Colchicine significantly reduced the risk of MACE in non-smoking subjects compared with controls (RR: 0.70; 95% CI: 0.60–0.81; p for heterogeneity ",{"italic":4037},[4038],{"#text":899},{"#text":4040}," = 0.69; I2 = 0%; ",{"italic":4042},[4043],{"#text":899},{"#text":4045}," \u003C 0.01), but had no significant effect on the risk of events in smoking subjects(RR:0.94; 95% CI:0.67–1.31; p for heterogeneity ",{"italic":4047},[4048],{"#text":899},{"#text":4050}," = 0.92; I2 = 0%; ",{"italic":4052},[4053],{"#text":899},{"#text":4055}," = 0.72) (",{"xref":4057,":@":4059},[4058],{"#text":3907},{"@_ref-type":1297,"@_rid":3909},{"#text":1321},{"#text":793},{"@_id":4063},"S3.SS2.SSS6",{"#text":955},{"@_id":4066},"S3.SS2",{"#text":958},{"@_id":4069,"@_sec-type":4070},"S3","results",{"#text":958},{"sec":4073,":@":4259,"anchorId":4260},[4074,4075,4079,4080,4084,4085,4136,4137,4167,4168,4207,4208,4241,4242,4253,4254,4258],{"#text":955},{"title":4076},[4077],{"#text":4078},"Discussion",{"#text":955},{"p":4081},[4082],{"#text":4083},"This study aimed to analyze the effect of colchicine on cardiovascular risk by pooling available clinical trials. The study indicates that when compared with the control group (with or without placebo), the colchicine treatment group reduced the risk of MACE, MI, non-fatal stroke, and revascularization in patients with coronary artery disease; however, it did not reduce the risk of all-cause death, cardiovascular death, or non-cardiovascular death in patients with coronary artery disease. Long-term low-dose Colchicine significantly increases cardiovascular benefits in patients with coronary artery disease compared to high-dose Colchicine, interestingly, colchicine reduced cardiovascular risk in patients under the age of 65, but there was no significant correlation in patients over the age of 65. At the same time, when given before surgery to a group of patients with PCI, colchicine did not have any long-term effects.",{"#text":955},{"p":4086},[4087,4089,4093,4095,4098,4100,4103,4105,4109,4110,4114,4116,4119,4121,4124,4125,4128,4130,4134],{"#text":4088},"We showed that the colchicine treatment group had a lower risk of MACE, MI, non-fatal stroke, and revascularization than the control group (with or without placebo). However, colchicine did not improve all-cause mortality or cardiovascular mortality in patients with coronary artery disease, nor did it reduce the risk of non-cardiovascular mortality in patients, as previous meta-analyses had found (",{"xref":4090,":@":4092},[4091],{"#text":1042},{"@_ref-type":976,"@_rid":1044},{"#text":4094},"). However, The non-cardiovascular death rate was higher in the colchicine group compared to the control group in two large RCT (",{"italic":4096},[4097],{"#text":1414},{"#text":4099}," = 5,522; ",{"italic":4101},[4102],{"#text":1414},{"#text":4104}," = 4,745) (",{"xref":4106,":@":4108},[4107],{"#text":1020},{"@_ref-type":976,"@_rid":1022},{"#text":979},{"xref":4111,":@":4113},[4112],{"#text":1027},{"@_ref-type":976,"@_rid":1029},{"#text":4115},"). We were surprised to discover that colchicine may increase the risk of non-cardiovascular mortality when we excluded the Tong DC-2020 (",{"italic":4117},[4118],{"#text":1414},{"#text":4120}," = 795) study from the meta-analysis(RR:1.42; 95% CI:1.01–1.98; p for heterogeneity; ",{"italic":4122},[4123],{"#text":899},{"#text":3889},{"italic":4126},[4127],{"#text":899},{"#text":4129}," = 0.04) (",{"xref":4131,":@":4133},[4132],{"#text":2551},{"@_ref-type":976,"@_rid":2553},{"#text":4135},"). Therefore, we think that colchicine’s effects on non-cardiovascular mortality should be interpreted with care. To verify this reliability, more substantial RCTs are required.",{"#text":955},{"p":4138},[4139,4141,4147,4149,4153,4154,4160,4161,4166],{"#text":4140},"At the same, subgroup analysis by colchicine dose showed that lower doses of colchicine reduced the risk of cardiovascular outcomes (MACE, MI, stroke, revascularization), whereas higher doses did not show a significant advantage in reducing the risks of cardiovascular outcomes. In a meta-analysis conducted by Thomas et al., a subgroup analysis was performed according to the colchicine dose used in each of the included studies, reporting outcomes including all-cause death, cardiovascular death, stroke/TIA, MI, and ischemia-driven revascularization, contradicting our findings in that they concluded that there was no significant difference between high and low doses regarding the incidence of stroke/TIA and ischemia-driven revascularization (",{"xref":4142,":@":4145},[4143],{"#text":4144},"27",{"@_ref-type":976,"@_rid":4146},"B27",{"#text":4148},"). This could be because we have clearly defined stroke as a non-fatal stroke, with both deaths from stroke and non-fatal stroke included in their outcome indicators. At the same time, we found that colchicine increased the risk of gastrointestinal symptoms at both high and low doses, but the effect was less at low doses than at high doses (high dose RR: 1.10, low dose RR: 3.42), confirming previous findings (",{"xref":4150,":@":4152},[4151],{"#text":1225},{"@_ref-type":976,"@_rid":1227},{"#text":979},{"xref":4155,":@":4158},[4156],{"#text":4157},"28",{"@_ref-type":976,"@_rid":4159},"B28",{"#text":979},{"xref":4162,":@":4164},[4163],{"#text":1903},{"@_ref-type":976,"@_rid":4165},"B29",{"#text":1321},{"#text":955},{"p":4169},[4170,4172,4177,4179,4185,4187,4193,4195,4199,4201,4205],{"#text":4171},"In addition, we discovered that differences in the duration of study follow-up contributed to differences in outcomes, as colchicine is frequently used as a lifelong treatment for chronic disease and the duration of treatment affects long-term benefits and harms. A meta-analysis by Xia et al. showed that colchicine treatment with a follow-up of more than 6 months significantly reduced the incidence of major adverse cardiovascular events in patients with coronary artery disease (",{"xref":4173,":@":4175},[4174],{"#text":1897},{"@_ref-type":976,"@_rid":4176},"B30",{"#text":4178},"). Which is consistent with our results, but they did not specify the efficacy of short-term colchicine treatment; Tien et al. previously reported an association between colchicine and the incidence of treatment-time MI in patients with coronary artery disease after PCI (",{"xref":4180,":@":4183},[4181],{"#text":4182},"31",{"@_ref-type":976,"@_rid":4184},"B31",{"#text":4186},"), but some subjects who had not undergone PCI were excluded from their study, which may have led to some bias. Their meta-analysis revealed that short-term (less than 6 months) treatment with colchicine significantly reduced the risk of MI after PCI compared to long-term treatment. To reduce bias, we included all patients with acute and chronic CAD in our study and divided the follow-up into three subgroups: 1 month, > 1 month and 1 year, and 1 year. In studies with less than 1 month of follow-up, we discovered that colchicine was not associated with a benefit in cardiovascular outcomes; however, in studies with longer follow-up, colchicine produced a more notable cardiovascular benefit when compared to controls. Gastrointestinal adverse events are colchicine’s most common side effects (",{"xref":4188,":@":4191},[4189],{"#text":4190},"32",{"@_ref-type":976,"@_rid":4192},"B32",{"#text":4194},"). We found that the effects of colchicine on gastrointestinal side effects were less noticeable with longer follow-up. This could also be because the COLCOT (",{"xref":4196,":@":4198},[4197],{"#text":1027},{"@_ref-type":976,"@_rid":1029},{"#text":4200},") and LoDoCo2 trials (",{"xref":4202,":@":4204},[4203],{"#text":1020},{"@_ref-type":976,"@_rid":1022},{"#text":4206},"), which had large sample sizes, were included in the subgroup of units that were followed for more than a year. As a result, more data are required to determine the risk of adverse gastrointestinal events over the duration of the study’s follow-up. In addition, colchicine did not affect improving all-cause and cardiovascular mortality in coronary artery disease patients, regardless of dose or duration of follow-up.",{"#text":955},{"p":4209},[4210,4212,4218,4219,4225,4227,4231,4233,4239],{"#text":4211},"Inflammation is a major factor in atherosclerosis (",{"xref":4213,":@":4216},[4214],{"#text":4215},"33",{"@_ref-type":976,"@_rid":4217},"B33",{"#text":979},{"xref":4220,":@":4223},[4221],{"#text":4222},"34",{"@_ref-type":976,"@_rid":4224},"B34",{"#text":4226},"). In theory, reducing inflammation levels could be a therapeutic option to reduce cardiovascular risk in patients with CAD. Bytyçi et al. recently conducted a meta-analysis that found that giving colchicine for 24 h reduced inflammatory markers (hs-CRP, IL-1, IL-6, and IL-18) in patients with unstable CAD (",{"xref":4228,":@":4230},[4229],{"#text":676},{"@_ref-type":976,"@_rid":1036},{"#text":4232},"). Meanwhile, the COPE-PCI trial by Cole et al. showed that when colchicine was given before PCI, it was associated with a reduction in perioperative myocardial injury and lower levels of pre-PCI Inflammation (",{"xref":4234,":@":4237},[4235],{"#text":4236},"35",{"@_ref-type":976,"@_rid":4238},"B35",{"#text":4240},"). Colchicine’s anti-inflammatory effect in CAD patients is well known. Surprisingly, we conducted a subgroup analysis of MACE events in subjects who had received preoperative colchicine for PCI and discovered that preoperative colchicine treatment did not affect the incidence of distant MACE events in patients. As far as we know, this study is the first to analyze the efficacy of colchicine in patients after preoperative administration of PCI. Unfortunately, due to the limited number of articles and the lack of substantial data to make definitive recommendations, this conclusion should be considered exploratory and further future studies are needed to demonstrate the long-term cardiovascular benefits of colchicine in patients after PCI.",{"#text":955},{"p":4243},[4244,4246,4251],{"#text":4245},"When the included RCT studies were categorized by age, we discovered that colchicine had no correlation with age for all-cause, cardiovascular, and non-cardiovascular mortality. Colchicine produced a greater cardiovascular benefit in subjects up to 65 years of age compared to controls, whereas no significant differences were observed in subjects over 65 years of age. In the CARDIA study, Lloyd-Jones et al. (",{"xref":4247,":@":4249},[4248],{"#text":1756},{"@_ref-type":976,"@_rid":4250},"B36",{"#text":4252},") demonstrated that the occurrence of cardiovascular disease is closely related to a person’s age group. The over-65 age group is at higher risk than other age groups, with approximately 60–80% of people facing subclinical cardiovascular disease, this may explain the result, in subjects of the aging population, the cardiovascular benefits of colchicine were outweighed by risk factors associated with their age.",{"#text":955},{"p":4255},[4256],{"#text":4257},"This study encounters some limitations. (1)The majority of the RCTs included in this study were conducted in Western countries, and there was a lack of data on Asians, which may have resulted in bias. (2)Although we included as many RCTs that met the inclusion criteria as possible, the number of studies included in some subgroup analyses was relatively small. More research is still required to support our results. (3)When performing subgroup analyses for age, we chose the mean age of the study for analysis, which may have been biased. (4)There was considerable heterogeneity in comparing some outcome indicators (MI, MACE) and we tried to eliminate this heterogeneity by sensitivity analysis and subgroup analysis. (5) Differences in sample size between large and small trials may affect our results. The previously mentioned limitations require more large-scale RCTs to investigate further.",{"#text":958},{"@_id":4260,"@_sec-type":4261},"S4","discussion",{"#text":958},{"sec":4264,":@":4275,"anchorId":4276},[4265,4266,4269,4270,4274],{"#text":955},{"title":4267},[4268],{"#text":925},{"#text":955},{"p":4271},[4272],{"#text":4273},"In this study, a meta-analysis of 15 RCTs was conducted to explore the clinical benefits and safety of colchicine after its treatment for coronary heart disease. We found that colchicine treatment reduced the risk of MACE, MI, stroke, and revascularization but had no significant effect on all-cause mortality, cardiovascular, or non-cardiovascular mortality. In addition, colchicine may increase the risk of gastrointestinal adverse effects, and long-term low-dose colchicine treatment may reduce the incidence of cardiovascular events compared to higher doses, but colchicine does not appear to reduce cardiovascular risk in patients over 65 years of age or preoperative PCI, which needs to be evaluated and explored in more large sample RCTs.",{"#text":958},{"@_id":4276,"@_sec-type":4277},"S5","conclusion",{"#text":958},{"sec":4280,":@":4299},[4281,4282,4286,4287,4298],{"#text":955},{"title":4283},[4284],{"#text":4285},"Data availability statement",{"#text":955},{"p":4288},[4289,4291,4296],{"#text":4290},"The original contributions presented in this study are included in the article/",{"xref":4292,":@":4295},[4293],{"#text":4294},"Supplementary material",{"@_ref-type":1113,"@_rid":1114},{"#text":4297},", further inquiries can be directed to the corresponding author/s.",{"#text":958},{"@_id":4300,"@_sec-type":4301},"S6","data-availability",{"#text":958},{"sec":4304,":@":4316},[4305,4306,4310,4311,4315],{"#text":955},{"title":4307},[4308],{"#text":4309},"Author contributions",{"#text":955},{"p":4312},[4313],{"#text":4314},"ZM and JC conceptualized the study and performed screening, data extraction, and data analysis by R software. KJ assessed the risk of bias. ZM, JC, and KJ performed original draft preparation, reviewing, and editing. XC supervised and funded the work. All authors contributed to the article, approved, read, and agreed to the submitted version of the manuscript.",{"#text":958},{"@_id":4317},"S7",{"#text":4319},"\n  ",[],[4322,4338,4349,4362,4376,4390,4414],{"title":4285,"order":401,"content":4323},[4324,4325,4328,4329,4337],{"#text":955},{"title":4326},[4327],{"#text":4285},{"#text":955},{"p":4330},[4331,4332,4336],{"#text":4290},{"xref":4333,":@":4335},[4334],{"#text":4294},{"@_ref-type":1113,"@_rid":1114},{"#text":4297},{"#text":958},{"title":4309,"order":443,"content":4339},[4340,4341,4344,4345,4348],{"#text":955},{"title":4342},[4343],{"#text":4309},{"#text":955},{"p":4346},[4347],{"#text":4314},{"#text":958},{"title":4350,"order":2932,"content":4351},"Funding",[4352,4353,4356,4357,4361],{"#text":955},{"title":4354},[4355],{"#text":4350},{"#text":955},{"p":4358},[4359],{"#text":4360},"This research was funded by the Project of Sinopharm Dongfeng General Hospital (2022S01).",{"#text":958},{"title":4363,"order":4364,"content":4365},"Conflict of interest",8,[4366,4367,4370,4371,4375],{"#text":955},{"title":4368},[4369],{"#text":4363},{"#text":955},{"p":4372},[4373],{"#text":4374},"The authors declare that the research was conducted in the absence of any commercial or financial relationships that could be construed as a potential conflict of interest.",{"#text":958},{"title":4377,"order":4378,"content":4379},"Publisher’s note",11,[4380,4381,4384,4385,4389],{"#text":955},{"title":4382},[4383],{"#text":4377},{"#text":955},{"p":4386},[4387],{"#t