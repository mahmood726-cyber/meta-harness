codex
The proposal JSON is written. I’m validating it against the benchmark rows now, including raw-file existence and verbatim identifier presence in the evidence files.
exec
"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "@'
import json
from pathlib import Path

bench=json.load(open('registry/search_benchmark.json', encoding='utf-8'))['topics']
expected=[]
for slug,obj in bench.items():
    for p in obj.get('positives',[]):
        if p.get('identifier_state')=='NAME_ONLY' or not (p.get('pmid') or p.get('nct') or p.get('doi')):
            expected.append((slug,p.get('trial')))
props=json.load(open('lane_r3/identifier_proposals.json', encoding='utf-8'))
actual=[(x['slug'],x['trial']) for x in props]
print('expected',len(expected),'actual',len(actual),'same_order',expected==actual)
if expected"'!=actual:
    print('"'missing', [x for x in expected if x not in actual])
    print('extra', [x for x in actual if x not in expected])
counts={s:sum(1 for x in props if x['status']==s) for s in ['RESOLVED','AMBIGUOUS','UNRESOLVED']}
print('counts',counts)
print('resolved_in_r2', sum(1 for x in props if x['status']=='RESOLVED' and x.get('in_r2_candidates')), 'of', counts['RESOLVED'])
missing_files=[]
missing_identifiers=[]
for x in props:
    for ev in x.get('evidence',[]):
        if not Path(ev).exists():
            missing_files.append((x['trial'],ev))
    if x['status'] in ('RESOLVED','AMBIGUOUS'):
        blob='\\n'.join(Path(ev).read_text(encoding='utf-8', errors='ignore') for ev in x.get('evidence',[]) if Path(ev).exists())
        records=[]
        if x.get('proposed'):
            records.append(('proposed', x['proposed']))
        for alt in x.get('alternatives',[]):
            records.append((alt.get('label','alternative'), alt))
        for label, rec in records:
            for key in ('pmid','nct','doi'):
                val=rec.get(key)
                if val and val not in blob:
                    missing_identifiers.append((x['trial'],label,key,val))
print('missing_files', missing_files)
print('missing_identifiers', missing_identifiers)
'@ | python -" in C:\mh-r-R3
