import json, os, time, urllib.parse, urllib.request, xml.etree.ElementTree as ET
from pathlib import Path

root = Path('lane_r3/raw')
root.mkdir(parents=True, exist_ok=True)
counter = 1
manifest = []

def slugify(s, n=70):
    out=[]
    for ch in s.lower():
        if ch.isalnum(): out.append(ch)
        elif ch in ' -_:.': out.append('-')
    r=''.join(out).strip('-')
    while '--' in r: r=r.replace('--','-')
    return (r or 'query')[:n]

def fetch(source, what, url, ext='json'):
    global counter
    fname = f\"{counter:03d}-{source}-{slugify(what)}.{ext}\"
    counter += 1
    path = root / fname
    req = urllib.request.Request(url, headers={'User-Agent':'meta-harness-lane-r3/1.0 (identifier verification; mailto:example@example.com)'})
    try:
        with urllib.request.urlopen(req, timeout=40) as resp:
            body = resp.read()
            status = resp.status
            ctype = resp.headers.get('Content-Type','')
    except Exception as e:
        body = json.dumps({'error': str(e), 'url': url}, indent=2).encode('utf-8')
        status = 'ERROR'
        ctype = 'application/json'
    path.write_bytes(body)
    manifest.append({'file': str(path).replace('\\\\','/'), 'source': source, 'what': what, 'url': url, 'status': status, 'content_type': ctype, 'bytes': len(body)})
    time.sleep(0.35)
    return path, body

def pubmed_search(label, term, retmax=20):
    qs = urllib.parse.urlencode({'db':'pubmed','term':term,'retmode':'json','retmax':str(retmax),'sort':'relevance'})
    url = 'https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esearch.fcgi?' + qs
    path, body = fetch('pubmed', label+'-esearch', url, 'json')
    ids=[]
    try:
        ids = json.loads(body.decode('utf-8')).get('esearchresult',{}).get('idlist',[])
    except Exception:
        pass
    return path, ids

def pubmed_fetch(label, ids):
    if not ids: return None, []
    qs = urllib.parse.urlencode({'db':'pubmed','id':','.join(ids),'retmode':'xml'})
    url = 'https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi?' + qs
    path, body = fetch('pubmed', label+'-efetch', url, 'xml')
    records=[]
    try:
        rootxml=ET.fromstring(body)
        for art in rootxml.findall('.//PubmedArticle'):
            pmid = art.findtext('.//PMID') or ''
            title = ''.join(art.find('.//ArticleTitle').itertext()) if art.find('.//ArticleTitle') is not None else ''
            journal = art.findtext('.//Journal/Title') or art.findtext('.//ISOAbbreviation') or ''
            year = art.findtext('.//JournalIssue/PubDate/Year') or art.findtext('.//ArticleDate/Year') or ''
            doi=''
            for aid in art.findall('.//ArticleId'):
                if aid.attrib.get('IdType','').lower()=='doi': doi=aid.text or ''
            ncts=[sid.text for sid in art.findall('.//DataBankList/DataBank/AccessionNumberList/AccessionNumber') if sid.text and sid.text.startswith('NCT')]
            records.append({'pmid':pmid,'title':title,'journal':journal,'year':year,'doi':doi,'nct':ncts})
    except Exception as e:
        records=[{'parse_error':str(e)}]
    return path, records

def epmc_search(label, query, pageSize=25):
    qs = urllib.parse.urlencode({'query':query,'format':'json','pageSize':str(pageSize)})
    url = 'https://www.ebi.ac.uk/europepmc/webservices/rest/search?' + qs
    path, body = fetch('europepmc', label, url, 'json')
    results=[]
    try:
        data=json.loads(body.decode('utf-8'))
        for r in data.get('resultList',{}).get('result',[])[:10]:
            results.append({'pmid':r.get('pmid',''), 'pmcid':r.get('pmcid',''), 'doi':r.get('doi',''), 'title':r.get('title',''), 'journal':r.get('journalTitle',''), 'year':r.get('pubYear','')})
    except Exception as e:
        results=[{'parse_error':str(e)}]
    return path, results

def ctgov_search(label, term, pageSize=50):
    qs = urllib.parse.urlencode({'query.term':term,'format':'json','pageSize':str(pageSize)})
    url = 'https://clinicaltrials.gov/api/v2/studies?' + qs
    path, body = fetch('ctgov', label, url, 'json')
    results=[]
    try:
        data=json.loads(body.decode('utf-8'))
        for st in data.get('studies',[])[:10]:
            proto=st.get('protocolSection',{})
            ident=proto.get('identificationModule',{})
            status=proto.get('statusModule',{})
            cond=proto.get('conditionsModule',{})
            arms=proto.get('armsInterventionsModule',{})
            refs=proto.get('referencesModule',{})
            results.append({'nct': ident.get('nctId',''), 'briefTitle': ident.get('briefTitle',''), 'officialTitle': ident.get('officialTitle',''), 'acronym': ident.get('acronym',''), 'conditions': cond.get('conditions',[]), 'interventions': [i.get('name','') for i in arms.get('interventions',[])], 'overallStatus': status.get('overallStatus',''), 'references': refs.get('references',[])[:5]})
    except Exception as e:
        results=[{'parse_error':str(e)}]
    return path, results

