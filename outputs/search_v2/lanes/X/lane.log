codex
The primary outcome map is now measured from `review.json`: for example, DOAC-VTE uses trial-reported recurrent VTE composite, probiotics uses AAD, and tocilizumab/COVID uses 28-day mortality. I’m fetching each PubMed XML one PMID at a time into `lane_x/raw/<pmid>.xml` so the raw archive matches the lane contract.
exec
"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "python -c \"import json, glob, os, time, urllib.request, pathlib
rows=[]
for path in sorted(glob.glob(r'C:/meta-harness/outputs/search_v2/verification/*/*.json')):
    slug=os.path.splitext(os.path.basename(path))[0]
    data=json.load(open(path, encoding='utf-8-sig'))
    items=data if isinstance(data, list) else data.get('records', data.get('items', data.get('rows', [])))
    for obj in items:
        if isinstance(obj, dict) and obj.get('verdict')=='ELIGIBLE_RCT':
            rows.append({'slug':slug,'id':obj.get('id'),'pmid':str(obj.get('pmid') or obj.get('id') or '').strip(),'nct':obj.get('nct'),'title':obj.get('title')})
out=pathlib.Path('lane_x')/'raw'
out.mkdir(parents=True, exist_ok=True)
seen=[]
for r in rows:
    if r['pmid'] and r['pmid'] not in seen:
        seen.append(r['pmid'])
for i, pmid in enumerate(seen, 1):
    url='https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi?db=pubmed&id={}&retmode=xml'.format(pmid)
    req=urllib.request.Request(url, headers={'User-Agent':'meta-harness-lane-x/1.0'})
    last=None
    for attempt in range(3):
        try:
            with urllib.request.urlopen(req, timeout=30) as resp:
                body=resp.read()
            (out/(pmid+'.xml')).write_bytes(body)
            print('{}/{} PMID {} {} bytes'.format(i, len(seen), pmid, len(body)))
            last=None
            break
        except Exception as exc:
            last=exc
            time.sleep(1+attempt)
    if last is not None:
        raise SystemExit('fetch failed for PMID {}: {}'.format(pmid,last))
    time.sleep(0.34)
print('fetched {} unique PMIDs'.format(len(seen)))\"" in C:\mh-r-X
