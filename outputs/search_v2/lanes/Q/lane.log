"'$code = @'"'
import json
import shutil
import subprocess
import tempfile
from pathlib import Path
from harness import search_completeness as sc

src = Path.cwd()
with tempfile.TemporaryDirectory(prefix=\"lane-q-d3i-\", dir=src / \".tmp\") as td:
    root = Path(td)
    (root / \"harness\").mkdir()
    (root / \"registry\").mkdir()
    (root / \"outputs\" / \"search_v2\").mkdir(parents=True)
    (root / \"docs\" / \"evidence\" / \"search-v2-measurement-2026-09-15\").mkdir(parents=True)
    subprocess.run([\"git\", \"init\", \"-q\", str(root)], check=True)
    for rel in [
        \"harness/search_v2.py\",
        \"registry/search_benchmark_split.json\",
        \"registry/search_completeness.json\",
        \"docs/search_recall_regression_corpus_search_v2.json\",
        \"docs/evidence/search-v2-measurement-2026-09-15/README.md\",
    ]:
        shutil.copyfile(src / rel, root / rel)
    cand = json.load(open(src / \"outputs/search_v2/candidates-2026-09-15r3-all.json\", encoding=\"utf-8\"))
    split = json.load(open(root / \"registry/search_benchmark_split.json\", encoding=\"utf-8\"))[\"assignments\"]
    victim = next(slug for slug in cand[\"topics\"] if split.get(slug, {}).get(\"set\") == \"MEASUREMENT\")
    del cand[\"topics\"][victim]
    with open(root / \"outputs/search_v2/candidates-2026-09-15r3-all.json\", \"w\", encoding=\"utf-8\", newline=\"\\n\") as f:
        json.dump(cand, f, indent=2, sort_keys=True)
        f.write(\"\\n\")
    ok, detail = sc.check(root)
    verdict = \"FIRED\" if (not ok and \"MEASUREMENT topics NOT_RUN\" in detail and victim in detail) else \"DID-NOT-FIRE\"
    print(f\"D3i post-fix {verdict} -- deleted MEASUREMENT topic {victim}; {detail}\")
