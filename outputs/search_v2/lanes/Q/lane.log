protocol = open(root / \"protocols\" / \"pcsk9-mace.md\", encoding=\"utf-8\").read()
mutated = copy.deepcopy(cfg)
mutated[\"intervention_agents\"] = {\"FOURIER\": [\"FOURIER\"], **(mutated.get(\"intervention_agents\") or {})}
bench = sealer.benchmark_acronyms(records_root=\"C:/meta-harness\")
collision = sealer.collision_row(mutated, bench)
row = {
    \"vocabulary_sha256\": search_v2.vocabulary_sha(mutated),
    \"benchmark_acronym_collision\": collision,
}
