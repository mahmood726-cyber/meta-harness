cap.append(f\"D3i deleted topic {first_slug}: ok={ok}; detail={detail}\")

def mutate_ran_zero_records(root: Path):
    p = root / cand_rel
    cand = json.loads(p.read_text(encoding=\"utf-8\"))
    for slug in measurement_slugs:
        sources = cand.get(\"topics\", {}).get(slug, {}).get(\"sources\") or []
        if sources:
            sources[0][\"state\"] = \"RAN_ZERO\"
            sources[0][\"record_count\"] = 3
            break
    write_json(p, cand)

ok, detail = sc_fixture_and_mutate(mutate_ran_zero_records)
