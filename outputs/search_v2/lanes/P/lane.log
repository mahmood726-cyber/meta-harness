cap = [\"D4 deploy-artifact check\", \"All check-artifact exit codes read from subprocess.run([...]), not a shell pipe.\"]
with tempfile.TemporaryDirectory(prefix=\"lane-p-d4-\") as raw:
    tmp = Path(raw)
    pr = tmp / \"pr\"
    (pr / \"scripts\").mkdir(parents=True)
    (pr / \"harness\").mkdir(parents=True)
    shutil.copy2(ROOT / \"scripts\" / \"production_record.py\", pr / \"scripts\" / \"production_record.py\")
    shutil.copy2(ROOT / \"harness\" / \"__init__.py\", pr / \"harness\" / \"__init__.py\")
    shutil.copy2(ROOT / \"harness\" / \"target.py\", pr / \"harness\" / \"target.py\")
    files = {\"a.txt\": b\"alpha\\n\", \"b.txt\": b\"bravo\\n\"}
    manifest = {\"commit_sha\": \"0123456789abcdef0123456789abcdef01234567\", \"files\": {k: sha_bytes(v) for k, v in files.items()}, \"n_files\": 2}
    man_path = tmp / \"manifest.json\"
    write_json(man_path, manifest)
    def make_tar(name: str, *, mutate: str | None = None, extra: bool = False) -> Path:
        tp = tmp / name
        with tarfile.open(tp, \"w\") as tf:
            for rel, data in files.items():
                body = data
                if mutate == rel:
                    body = (bytes([data[0] "'^ 1]) + data[1:]) if data else b"x"
                ti = tarfile.TarInfo(rel)
                ti.size = len(body)
                tf.addfile(ti, io.BytesIO(body))
            if extra:
                body = b"extra'"\\n\"
                ti = tarfile.TarInfo(\"extra.txt\")
                ti.size = len(body)
                tf.addfile(ti, io.BytesIO(body))
        return tp
    script = pr / \"scripts\" / \"production_record.py\"
    bad_diff = make_tar(\"bad-diff.tar\", mutate=\"a.txt\")
    bad_extra = make_tar(\"bad-extra.tar\", extra=True)
    good = make_tar(\"good.tar\")
    proc_diff = run_subprocess([PY, str(script), \"check-artifact\", \"--manifest\", str(man_path), \"--tar\", str(bad_diff)], cwd=tmp)
    proc_extra = run_subprocess([PY, str(script), \"check-artifact\", \"--manifest\", str(man_path), \"--tar\", str(bad_extra)], cwd=tmp)
    proc_good = run_subprocess([PY, str(script), \"check-artifact\", \"--manifest\", str(man_path), \"--tar\", str(good)], cwd=tmp)
    text_diff = (proc_diff.stdout + proc_diff.stderr).strip()
    text_extra = (proc_extra.stdout + proc_extra.stderr).strip()
    text_good = (proc_good.stdout + proc_good.stderr).strip()
    add_result(\"D4a\", \"FIRED\" if proc_diff.returncode == 1 and \"ARTIFACT REFUSED\" in text_diff else \"DID-NOT-FIRE\", text_diff)
    add_result(\"D4b\", \"FIRED\" if proc_extra.returncode == 1 and \"ARTIFACT REFUSED\" in text_extra else \"DID-NOT-FIRE\", text_extra)
    add_result(\"D4c\", \"FIRED\" if proc_good.returncode == 0 and \"artifact == manifest\" in text_good else \"DID-NOT-FIRE\", text_good)
    cap.extend([
        f\"D4a bad one-byte diff rc={proc_diff.returncode}\\n{text_diff}\",
        f\"D4b bad extra file rc={proc_extra.returncode}\\n{text_extra}\",
        f\"D4c intact tar rc={proc_good.returncode}\\n{text_good}\",
    ])
write_capture(\"04-d4-production-record.txt\", \"\\n\\n\".join(cap))

