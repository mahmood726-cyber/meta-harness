def mutate_delete_topic(root: Path):
    p = root / cand_rel
    cand = json.loads(p.read_text(encoding=\"utf-8\"))
    cand.get(\"topics\", {}).pop(first_slug, None)
    write_json(p, cand)

ok, detail = sc_fixture_and_mutate(mutate_delete_topic)
