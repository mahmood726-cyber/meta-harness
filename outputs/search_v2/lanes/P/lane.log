        items = json.loads(jp.read_text(encoding=\"utf-8\"))
        items[0][\"verdict\"] = \"MAYBE\"
        write_json(jp, items)
    row = d7_run(d7_maybe)
    probs = row.get(\"problems\") or []
    add_result(\"D7iii\", \"FIRED\" if any(\"verdict not in list\" in p for p in probs) else \"DID-NOT-FIRE\", \" | \".join(probs) or row)
