        _git(repo, "config", "user.name", "Test User")
        (repo / "README.md").write_text("base\n", encoding="utf-8", newline="\n")
        _git(repo, "add", "README.md")
        _git(repo, "commit", "-m", "base")

        proc = subprocess.run(
            [sys.executable, "-m", "harness.honest_ratchet", "--base", "no-such-ref"],
            cwd=repo,
