    def d7_delete_two(topic_dir: Path):
        jp = topic_dir / f\"{slug}.json\"
        items = json.loads(jp.read_text(encoding=\"utf-8\"))
        write_json(jp, items[:-2])
    row = d7_run(d7_delete_two)
    probs = row.get(\"problems\") or []
    add_result(\"D7i\", \"FIRED\" if any(\"json has\" in p and \"report says NEW\" in p for p in probs) else \"DID-NOT-FIRE\", \" | \".join(probs) or row)
    cap.append(\"D7i problems=\" + json.dumps(probs, ensure_ascii=False))

    def d7_blank_quote(topic_dir: Path):
        jp = topic_dir / f\"{slug}.json\"
        items = json.loads(jp.read_text(encoding=\"utf-8\"))
        for it in items:
            if it.get(\"verdict\") == \"ELIGIBLE_RCT\":
                it[\"quote\"] = \"\"
                break
        write_json(jp, items)
    row = d7_run(d7_blank_quote)
