from harness import search_completeness as sc

def copy_sc_fixture(tmp: Path) -> Path:
    files = [
        \"registry/search_completeness.json\",
        \"harness/search_v2.py\",
        \"registry/search_benchmark_split.json\",
    ]
    reg = json.loads((ROOT / \"registry\" / \"search_completeness.json\").read_text(encoding=\"utf-8\"))
    for key in (\"candidate_file\", \"register_file\", \"evidence_readme\"):
        if reg.get(key):
            files.append(reg[key])
    for rel in files:
        src = ROOT / rel
        dst = tmp / rel
        dst.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(src, dst)
    return tmp


def sc_fixture_and_mutate(mutator):
    td = tempfile.TemporaryDirectory(prefix=\"lane-p-d3-\")
    root = copy_sc_fixture(Path(td.name))
    mutator(root)
    ok, detail = sc.check(root)
    td.cleanup()
    return ok, detail

split_real = json.loads((ROOT / \"registry\" / \"search_benchmark_split.json\").read_text(encoding=\"utf-8\"))[\"assignments\"]
measurement_slugs = sorted(s for s, v in split_real.items() if v.get(\"set\") == \"MEASUREMENT\")
first_slug = measurement_slugs[0]
reg_real = json.loads((ROOT / \"registry\" / \"search_completeness.json\").read_text(encoding=\"utf-8\"))
