results: list[dict[str, str]] = []
captures: list[str] = []
internal_commands: list[str] = []


def one_line(text: object, limit: int = 200) -> str:
    s = \" \".join(str(text).replace(\"\\r\", \" \").replace(\"\\n\", \" \").split())
    if len(s) > limit:
        return s[: limit - 3] + \"...\"
    return s


def add_result(name: str, status: str, text: object) -> None:
    assert status in {\"FIRED\", \"DID-NOT-FIRE\"}
    results.append({\"name\": name, \"status\": status, \"text\": one_line(text)})


def write_capture(filename: str, text: str) -> None:
    path = LANE / filename
    path.write_text(text.rstrip() + \"\\n\", encoding=\"utf-8\", newline=\"\\n\")
    captures.append(str(path.relative_to(ROOT)).replace(\"\\\\\", \"/\"))


def load_module(name: str, rel: str):
    spec = importlib.util.spec_from_file_location(name, ROOT / rel)
    mod = importlib.util.module_from_spec(spec)
    assert spec and spec.loader
    spec.loader.exec_module(mod)  # type: ignore[attr-defined]
    return mod


def run_subprocess(args: list[str], cwd: Path | None = None) -> subprocess.CompletedProcess[str]:
    internal_commands.append(\" \".join(args) + (f\"  # cwd={cwd}\" if cwd else \"\"))
    return subprocess.run(
        args,
        cwd=str(cwd or ROOT),
        capture_output=True,
        text=True,
        encoding=\"utf-8\",
        errors=\"replace\",
        check=False,
        env={**os.environ, \"PYTHONIOENCODING\": \"utf-8\"},
    )


def sha_bytes(b: bytes) -> str:
    return hashlib.sha256(b).hexdigest()


def write_json(path: Path, payload) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(payload, ensure_ascii=False, indent=1, sort_keys=True) + \"\\n\", encoding=\"utf-8\", newline=\"\\n\")


