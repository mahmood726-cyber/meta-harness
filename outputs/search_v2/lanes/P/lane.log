    add_result(\"D7ii\", \"FIRED\" if any(\"verdict without quote\" in p for p in probs) else \"DID-NOT-FIRE\", \" | \".join(probs) or row)
    cap.append(\"D7ii problems=\" + json.dumps(probs, ensure_ascii=False))

    def d7_maybe(topic_dir: Path):
