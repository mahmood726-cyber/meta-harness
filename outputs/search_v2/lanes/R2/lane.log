+
+def _seal_row(cfg, collisions=None):
+    return {
+        "vocabulary_sha256": search_v2.vocabulary_sha(cfg),
+        "benchmark_acronym_collision": {"coverage_text": "plant", "collisions": collisions or []},
+    }
