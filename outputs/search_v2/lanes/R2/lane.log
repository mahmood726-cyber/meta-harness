+def _quote_isrctn(term: str) -> str:
+    text = str(term).strip().replace('"', " ")
+    if not text:
+        return ""
+    if " " in text or "-" in text or "*" in text or "." in text or "/" in text:
+        return f'"{text}"'
+    return text
