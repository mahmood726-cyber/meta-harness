+        trial.get("publicIdentifierDateAssigned") or "",
+        _child_text(trial, "isrctn"),
+        trial.get("lastUpdated") or "",
+    )
+    return {
+        "id": isrctn,
+        "id_type": "isrctn",
+        "pmid": "",
+        "pmcid": "",
+        "doi": _child_text(external, "doi"),
