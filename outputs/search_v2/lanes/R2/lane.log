+        offset += page_size
+        if offset >= (total or 0) or not page_records:
+            break
+        time.sleep(0.5)
+    fetched = len(records)
+    hits = total if total is not None else fetched
+    return records, {
+        "hits": hits,
+        "state": "RAN_OK" if fetched else "RAN_ZERO",
+        "error": None,
+        "funnel": {
+            "hits": hits,
+            "fetched": fetched,
+            "retained": fetched,
