@pytest.mark.parametrize(
    ("query", "kind", "token"),
    [
        ("FAIR-HF2 JAMA 2025 randomized clinical trial", "NAME_SEEDED", "FAIR-HF2"),
        ("10.1056/NEJMoa000000", "IDENTIFIER_SEEDED", "10.1056/NEJMoa000000"),
        ("40159390", "IDENTIFIER_SEEDED", "40159390"),
