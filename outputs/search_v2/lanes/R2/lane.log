+def _isrctn_search_records(query: str) -> tuple[list[dict], dict]:
+    text = str(query or "").strip()
+    if not text:
+        raise ValueError("ISRCTN query is empty")
+    records: list[dict] = []
+    seen: set[str] = set()
+    page_size = 1000
+    offset = 0
