"'$code = @'"'
import json, re
from pathlib import Path
root=Path(\".\")
bench=json.load(open(root/\"registry/search_benchmark.json\", encoding=\"utf-8\"))[\"topics\"]
split=json.load(open(root/\"registry/search_benchmark_split.json\", encoding=\"utf-8\"))[\"assignments\"]
cand=json.load(open(root/\"outputs/search_v2/candidates-2026-09-15r2-all.json\", encoding=\"utf-8\"))[\"candidates\"]
PMID=re.compile(r\""'^(?:PMID[:'"\\s]*)?(\\d{1,9})"'$",re.I)
NCT=re.compile(r"'"\\b(NCT\\d{8})\\b\",re.I)
def pmid(v):
    m=PMID.match(str(v or \"\").strip()); return m.group(1) if m else None
def nct(v):
    m=NCT.search(str(v or \"\")); return m.group(1).upper() if m else None
def keys(item):
    fields=[item] if not isinstance(item,dict) else [item.get(k) for k in (\"pmid\",\"nct\",\"id\")]
    out=set()
    for v in fields:
        p=pmid(v); n=nct(v)
        if p: out.add((\"pmid\",p))
        if n: out.add((\"nct\",n))
    return out
total=found=keyless=0; by_origin={}; missed=[]
for slug,row in sorted(bench.items()):
    if (split.get(slug) or {}).get(\"set\")"'!="MEASUREMENT": continue
    got=set().union(*(keys(x) for x in cand.get(slug,[]))) if cand.get(slug) else set()
    for pos in row.get("positives") or []:
        pk=keys({"pmid":pos.get("pmid"),"nct":pos.get("nct")}); hit=bool(pk & got); total+=1; found+=int(hit); keyless+=int(not pk)
        for o in str(pos.get("origin") or "<none>").split(";"): s=by_origin.setdefault(o.strip(),[0,0]); s[0]+=int(hit); s[1]+=1
        if not hit: missed.append((slug,pos.get("trial"),sorted(pk)))
print("MEASURED: own PMID/NCT scorer r2 found",found,"of",total,"measurement positives; keyless",keyless)
print("MEASURED: by_origin", {k:f"{v[0]} of {v[1]}" for k,v in sorted(by_origin.items())}); print("MEASURED: missed", missed)
'"'@
