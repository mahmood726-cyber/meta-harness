    'TITLE_ABS:"controlled trial" OR TITLE_ABS:randomly'
)

DEVELOPMENT_TOPICS = [
    "balanced-crystalloids-vs-saline-mortality",
    "colchicine-recurrent-pericarditis",
    "corticosteroids-covid19-mortality",
