+def measurement_recall() -> tuple[int, int, int, int]:
+    text = read_text(COMPARE_FILE)
+    match = re.search(r"benchmark positives found r2 (\d+) of (\d+) -> r3 (\d+) of (\d+)", text)
+    if not match:
