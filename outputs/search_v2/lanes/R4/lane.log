+        f"benchmark positives r2 {r2_found} of {total} -> r3 {r3_found} of {total}; "
+        f"register within kind {register_within_found} of 20, whole engine {register_whole_found} of 20"
+    )
+
+    lines: list[str] = [first_line, ""]
+    lines += [
