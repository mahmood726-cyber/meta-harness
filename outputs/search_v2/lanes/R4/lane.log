+    ]:
+        path = ROOT / rel
+        lines.append(f"- `{rel}`: exists {path.exists()} size {path.stat().st_size if path.exists() else 0} bytes")
+
+    lines += ["", "## Tar-Only Ledger", "| Topic | Asset | Bytes | SHA256 |", "|---|---|---:|---|"]
+    for slug, topic in topics.items():
