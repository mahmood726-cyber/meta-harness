"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -NoProfile -Command "python -X utf8 -c \"import json, pathlib, urllib.parse, urllib.request, time
base=pathlib.Path('lane_ft/raw'); base.mkdir(parents=True, exist_ok=True)
rows=[r for r in json.loads(pathlib.Path(r'C:\\meta-harness\\outputs\\search_v2\\lanes\\X\\lane_x\\second_opinion.json').read_text(encoding='utf-8')) if r.get('verdict')=='ELIGIBLE_RCT']
summary=[]
for i,r in enumerate(rows,1):
    pmid=str(r.get('pmid'))
    slug=r.get('slug')
    q=urllib.parse.quote(f'EXT_ID:{pmid} AND SRC:MED')
    search_url=f'https://www.ebi.ac.uk/europepmc/webservices/rest/search?query={q}&format=json&resultType=core&pageSize=1'
    req=urllib.request.Request(search_url, headers={'User-Agent':'meta-harness-lane-ft/1.0'})
    with urllib.request.urlopen(req, timeout=30) as resp:
        search_body=resp.read()
    search_path=base / f'{i:02d}_{slug}_{pmid}_europepmc_search.json'
    search_path.write_bytes(search_body)
    data=json.loads(search_body.decode('utf-8'))
    results=data.get('resultList',{}).get('result',[])
    rec=results[0] if results else {}
    pmcid=(rec.get('pmcid') or '').strip()
    is_oa=str(rec.get('isOpenAccess','')).upper()=='Y'
    raw_path=search_path
    fetched_xml=False
    if is_oa and pmcid:
        xml_id=pmcid if pmcid.upper().startswith('PMC') else 'PMC'+pmcid
        xml_url=f'https://www.ebi.ac.uk/europepmc/webservices/rest/{xml_id}/fullTextXML'
        try:
            req=urllib.request.Request(xml_url, headers={'User-Agent':'meta-harness-lane-ft/1.0'})
            with urllib.request.urlopen(req, timeout=60) as resp:
                xml_body=resp.read()
            raw_path=base / f'{i:02d}_{slug}_{pmid}_{xml_id}_fullTextXML.xml'
            raw_path.write_bytes(xml_body)
            fetched_xml=True
        except Exception as exc:
            err={'url':xml_url,'error':type(exc).__name__,'message':str(exc),'search_response_file':search_path.name}
            raw_path=base / f'{i:02d}_{slug}_{pmid}_{xml_id}_fullTextXML_error.json'
            raw_path.write_text(json.dumps(err, indent=2, ensure_ascii=False), encoding='utf-8')
    summary.append({'i':i,'slug':slug,'pmid':pmid,'title':r.get('title'),'pmcid':pmcid,'open_access':is_oa,'raw':str(raw_path).replace('\\\\','/'),'xml':fetched_xml})
    print(i, slug, pmid, 'pmcid=',pmcid, 'oa=',is_oa, 'xml=',fetched_xml, 'raw=',raw_path.name)
    time.sleep(0.2)
print('SUMMARY_JSON')
print(json.dumps(summary, ensure_ascii=False, indent=2))\"" in C:\mh-r-FT
