snap=json.load(open('cache/semaglutide-obesity-weight/snapshots/2026-09-15r2-search_v2/records.json',encoding='utf-8'))
records={r['id']:r for r in snap['records']}
def key(r): return r.get('pmid') or r.get('nct') or r.get('doi') or r.get('id')
kw=re.compile(r'\\b(random|semaglutide|placebo|adult|adolescent|diabetes|primary|endpoint|outcome|body ?weight|body weight|BMI|week|cardiovascular|kidney|albumin|gastric|appetite|hospital|health utility|quality of life|psychiatric|schizophrenia|PCOS|HFpEF|SELECT|STEP)\\b',re.I)
for d in snap['screening']['decisions']:
    if d.get('decision')"'!='"'include': continue
    r=records[d['id']]
    keys={str(k).strip() for k in (key(r),r.get('id'),r.get('pmid'),r.get('nct'),r.get('doi')) if str(k or '').strip()}
    if (keys & (legacy|accounted)) or not r.get('pmid'): continue
    txt=re.sub(r'<["'^>]+>'"',' ',r.get('abstract') or '')
    txt=re.sub(r'\\s+',' ',txt).strip()
    # split mostly on sentence boundaries before labels
    parts=re.split(r'(?<=[."'!?])'"\\s+(?=[A-Z(])', txt)
    hits=[]
    for p in parts:
        if kw.search(p):
            hits.append(p)
    print('\\n### PMID',r['pmid'],r.get('year'),r['title'])
    for h in hits[:12]:
        print('-', textwrap.shorten(h, width=300, placeholder=' ...'))
