accounted = set(legacy)
pooled_trials = []
absent_trials = []
for row in primary.get('trials', []):
    pooled_trials.append((row.get('id'), row.get('label')))
    for v in (row.get('label'), row.get('id')):
        v = str(v or '').strip()
        if v:
            accounted.add(v)
            accounted.add(re.sub(r'"'^(PMID|NCT)'"\\s+', '', v))
for row in primary.get('declared_absent_trials', []):
    absent_trials.append((row.get('id'), row.get('label')))
    for v in (row.get('label'), row.get('id')):
        v = str(v or '').strip()
        if v:
