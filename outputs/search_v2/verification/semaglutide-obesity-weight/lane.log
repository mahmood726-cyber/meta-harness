codex
Most of the new records are NCT-only registrations with empty abstracts, so I’ll treat those separately from PMID publications. For PMID records with complete snapshot abstracts, the prompt lets the snapshot record decide; PubMed efetch is only needed if the snapshot abstract is empty or truncated.
exec
"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "@'
import json, re, sys, textwrap
sys.path.insert(0, '.')
from harness import screen
from harness.pipeline import _dedup
cfg=json.load(open('topics/semaglutide-obesity-weight.json',encoding='utf-8'))
legacy={x['id'] for x in screen.run(_dedup(json.load(open('cache/semaglutide-obesity-weight/records.json',encoding='utf-8')),cfg.get('pivotal_trials')),cfg)['decisions'] if x['decision']=='include'}
review=json.load(open('docs/reviews/semaglutide-obesity-weight/review.json',encoding='utf-8'))
primary=[o for o in review['outcomes'] if o.get('primary')][0]
accounted=set()
for row in primary.get('trials',[])+primary.get('declared_absent_trials',[]):
    for v in (row.get('label'),row.get('id')):
        v=str(v or '').strip()
        if v:
            accounted.add(v); accounted.add(re.sub(r'"'^(PMID|NCT)'"\\s+','',v))
snap=json.load(open('cache/semaglutide-obesity-weight/snapshots/2026-09-15r2-search_v2/records.json',encoding='utf-8'))
records={r['id']:r for r in snap['records']}
def key(r): return r.get('pmid') or r.get('nct') or r.get('doi') or r.get('id')
new=[]
for d in snap['screening']['decisions']:
    if d.get('decision')"'!='"'include': continue
    r=records[d['id']]
    keys={str(k).strip() for k in (key(r),r.get('id'),r.get('pmid'),r.get('nct'),r.get('doi')) if str(k or '').strip()}
    if not (keys & (legacy|accounted)):
        new.append((r,d))
for r,d in sorted([rd for rd in new if rd[0].get('pmid')], key=lambda rd:(-(int(rd[0].get('year') or 0)), rd[0].get('pmid'))):
    print('\\n'+'='*90)
    print('PMID',r.get('pmid'),'YEAR',r.get('year'),'NCT',r.get('nct'),'DOI',r.get('doi'),'PUBTYPES',r.get('pubtypes'))
    print('TITLE:',r.get('title'))
    print('RULE:',d.get('rule_id'),d.get('reason'),'SPAN:',d.get('span'))
    txt=re.sub(r'<["'^>]+>'"',' ',r.get('abstract') or '')
    txt=re.sub(r'\\s+',' ',txt).strip()
    print(textwrap.fill(txt,width=110))
