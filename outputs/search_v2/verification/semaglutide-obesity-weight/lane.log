    old_raw.unlink()
for old_raw in RAW_DIR.glob('*.xml'):
    old_raw.unlink()

spaces = re.compile(r'\\s+')
def clean_text(s):
    s = re.sub(r'<["'^>]+>'"', ' ', s or '')
    return spaces.sub(' ', s).strip()

def validate_snapshot_quote(r, quote):
    haystacks = [clean_text(r.get('title')), clean_text(r.get('abstract'))]
    if not any(quote in h for h in haystacks):
        raise AssertionError(f\"quote not found for {r.get('pmid') or r.get('id')}: {quote"'!r}")
    if len(quote) > 300:
        raise AssertionError(f"quote too long for {r.get('"'pmid') or r.get('id')}: {len(quote)}\")

ctgov_cache = {}
def fetch_ctgov(nct):
    url = f'https://clinicaltrials.gov/api/v2/studies/{nct}'
    raw_path = RAW_DIR / f'{nct}.json'
    req = urllib.request.Request(url, headers={'User-Agent': 'lane-v-semaglutide-obesity-weight/1.0'})
    with urllib.request.urlopen(req, timeout=30) as resp:
        body = resp.read()
    raw_path.write_bytes(body)
    ctgov_cache[nct] = json.loads(body.decode('utf-8'))
    time.sleep(0.05)
    return ctgov_cache[nct], raw_path

def registry_quote(nct):
    study, raw_path = fetch_ctgov(nct)
    ps = study.get('protocolSection', {})
    status = ps.get('statusModule', {}).get('overallStatus') or 'OVERALL_STATUS_NOT_REPORTED'
    conditions = ps.get('conditionsModule', {}).get('conditions') or []
    interventions = [i.get('name') for i in ps.get('armsInterventionsModule', {}).get('interventions', []) if i.get('name')]
    cond_text = '; '.join(conditions) if conditions else 'CONDITIONS_NOT_REPORTED'
    intr_text = '; '.join(interventions) if interventions else 'INTERVENTIONS_NOT_REPORTED'
    quote = f\"overallStatus: {status}; conditions: {cond_text}; interventions: {intr_text}\"
    if len(quote) > 300:
        quote = f\"overallStatus: {status}; conditions: {cond_text[:90]}; interventions: {intr_text[:140]}\"
    return quote, f\"ctgov api (lane_v/{SLUG}-raw/{raw_path.name})\"

results = []
for r, d, k in verify_rows:
    obj = {
        'id': r.get('id') or '',
        'id_type': r.get('id_type') or '',
        'pmid': r.get('pmid') or '',
        'nct': r.get('nct') or '',
        'title': r.get('title') or '',
        'year': r.get('year') or '',
        'screen_rule': d.get('rule_id') or '',
    }
    if r.get('id_type') == 'nct' and not r.get('pmid'):
        quote, source = registry_quote(r.get('nct') or r.get('id'))
        obj.update({
            'verdict': 'REGISTRY_ONLY_NO_PUBLICATION',
            'quote': quote,
            'quote_source': source,
            'screen_agrees': False,
            'note': 'NCT-only registry record with no PMID publication in the r2 snapshot.'
        })
    elif r.get('pmid'):
        pmid = r['pmid']
        if pmid not in PMID_VERDICTS:
            raise AssertionError(f'missing PMID verdict for {pmid}')
        verdict, quote, note = PMID_VERDICTS[pmid]
        validate_snapshot_quote(r, quote)
        obj.update({
            'verdict': verdict,
            'quote': quote,
            'quote_source': 'snapshot abstract',
            'screen_agrees': verdict.startswith('ELIGIBLE'),
        })
        if note:
            obj['note'] = note
    else:
        obj.update({
            'verdict': 'UNDECIDABLE_FROM_RECORD',
            'quote': '',
            'quote_source': 'snapshot abstract',
            'screen_agrees': False,
            'note': 'No PMID/NCT publication abstract was available to settle this record.'
        })
    if obj['verdict'] not in VALID:
        raise AssertionError(f\"bad verdict {obj['verdict']} for {obj['id']}\")
    if obj['verdict'] not in {'UNDECIDABLE_FROM_RECORD', 'NOT_VERIFIED_CAP'} and not obj.get('quote'):
        raise AssertionError(f\"empty quote for {obj['id']}\")
    if obj.get('quote') and len(obj['quote']) > 300:
