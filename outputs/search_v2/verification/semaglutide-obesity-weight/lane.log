exec
"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "@'
import json, re, sys
sys.path.insert(0, '.')
from harness import screen
from harness.pipeline import _dedup
cfg = json.load(open('topics/semaglutide-obesity-weight.json', encoding='utf-8'))
legacy_records = json.load(open('cache/semaglutide-obesity-weight/records.json', encoding='utf-8'))
legacy = {x['id'] for x in screen.run(_dedup(legacy_records, cfg.get('pivotal_trials')), cfg)['decisions'] if x['decision'] == 'include'}
review = json.load(open('docs/reviews/semaglutide-obesity-weight/review.json', encoding='utf-8'))
primary = [o for o in review['outcomes'] if o.get('primary')][0]
accounted = set()
for row in primary.get('trials', []) + primary.get('declared_absent_trials', []):
    for v in (row.get('label'), row.get('id')):
        v = str(v or '').strip()
        if v:
            accounted.add(v)
            accounted.add(re.sub(r'"'^(PMID|NCT)'"\\s+', '', v))
accounted = {x for x in accounted if x}
snap = json.load(open('cache/semaglutide-obesity-weight/snapshots/2026-09-15r2-search_v2/records.json', encoding='utf-8'))
records = {r['id']: r for r in snap['records']}
includes = [d for d in snap['screening']['decisions'] if d.get('decision') == 'include']
def rec_key(r):
    return r.get('pmid') or r.get('nct') or r.get('doi') or r.get('id')
old = []
new = []
for d in includes:
    r = records[d['id']]
    keys = {rec_key(r), r.get('id'), r.get('pmid'), r.get('nct'), r.get('doi')}
    keys = {str(k).strip() for k in keys if str(k or '').strip()}
    (old if keys & (legacy | accounted) else new).append((r, d, rec_key(r)))
print('legacy', len(legacy), sorted(legacy))
print('accounted', len(accounted), sorted(accounted))
print('r2 includes', len(includes), 'of', len(snap['records']))
print('already accounted for', len(old))
print('NEW', len(new))
for i, (r, d, k) in enumerate(sorted(new, key=lambda rd: (-(int(rd[0].get('year') or 0)), str(rd[0].get('pmid') or rd[0].get('id')))), 1):
    print(f\"{i:03d}\\t{r.get('year')}\\t{r.get('id_type')}\\tkey={k}\\tpmid={r.get('pmid')}\\tnct={r.get('nct')}\\tdoi={r.get('doi')}\\trule={d.get('rule_id')}\\tabs={len(r.get('abstract') or '')}\\t{r.get('title')}\")
