duplicates = [o for o in results if o['verdict'] == 'DUPLICATE_OF_ACCOUNTED']
verified_n = N - counts['NOT_VERIFIED_CAP']
agreed_n = sum(1 for o in results if o['verdict'].startswith('ELIGIBLE'))

report_lines = []
