    (old_rows if prompt_key(r) in accounted else new_rows).append((r, d, prompt_key(r)))

new_rows = sorted(new_rows, key=lambda rd: (-(int(rd[0].get('year') or 0)), str(rd[0].get('pmid') or rd[0].get('nct') or rd[0].get('doi') or rd[0].get('id'))))
N = len(new_rows)
verify_rows = new_rows[:150] if N > 150 else new_rows
cap_rows = new_rows[150:] if N > 150 else []

OUT_DIR.mkdir(exist_ok=True)
RAW_DIR.mkdir(exist_ok=True)

# Avoid stale raw files for this lane without touching anything outside the required raw directory.
