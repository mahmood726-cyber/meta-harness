report_lines.append('')
report_lines.append('## Verdict table')
report_lines.append('| id | verdict | screen_agrees | note |')
report_lines.append('| --- | --- | --- | --- |')
for o in results:
    ident = o['pmid'] or o['nct'] or o['doi'] if 'doi' in o else (o['pmid'] or o['nct'] or o['id'])
    note = (o.get('note') or '').replace('|', '/')
    report_lines.append(f\"| {ident} | {o['verdict']} | {str(o['screen_agrees']).lower()} | {note} |\")
report_lines.append('')
report_lines.append('## Commands Run')
report_lines.append('MEASURED command log from this lane session:')
for cmd in COMMANDS_RUN:
    report_lines.append(f\"- "'`{cmd}`")

REPORT_PATH.write_text('"'\\n'.join(report_lines) + '\\n', encoding='utf-8')
print('wrote', JSON_PATH)
print('wrote', RAW_DIR, 'raw_json', len(list(RAW_DIR.glob('*.json'))))
print('wrote', REPORT_PATH)
