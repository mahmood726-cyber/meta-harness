    f\"ELIGIBLE_RCT_NO_PRIMARY {first_line_counts['ELIGIBLE_RCT_NO_PRIMARY']}; \"
    f\"NOT_RCT {first_line_counts['NOT_RCT']}; \"
    f\"WRONG_* {first_line_counts['WRONG_*']}; \"
    f\"DUPLICATE_OF_ACCOUNTED {first_line_counts['DUPLICATE_OF_ACCOUNTED']}; \"
    f\"UNDECIDABLE {first_line_counts['UNDECIDABLE']}; \"
    f\"NOT_VERIFIED_CAP {first_line_counts['NOT_VERIFIED_CAP']}; \"
    f\"REGISTRY_ONLY {first_line_counts['REGISTRY_ONLY']}\"
)
report_lines.append(f\"automated screen agreed on {agreed_n} of {verified_n} verified\")
report_lines.append(f\"r2 includes {len(r2_includes)} of {len(snap['records'])}; already accounted for {len(old_rows)}; NEW {N}\")
report_lines.append(f\"MEASURED: legacy includes {len(legacy)}; pooled primary-outcome trials {len(primary.get('trials', []))}; declared-absent primary-outcome trials {len(primary.get('declared_absent_trials', []))}.\")
report_lines.append(\"MEASURED: NEW definition used PMID first, NCT only when no PMID, DOI only when neither was present.\")
if cap_rows:
    report_lines.append(f\"MEASURED: N > 150; verified first 150 by year desc and identifier; marked {len(cap_rows)} NOT_VERIFIED_CAP.\")
else:
    report_lines.append(\"MEASURED: N <= 150; no NOT_VERIFIED_CAP records.\")
report_lines.append('')
report_lines.append('## ELIGIBLE_RCT ids with titles')
if eligible_rct:
    for o in eligible_rct:
        report_lines.append(f\"- {o['pmid'] or o['nct'] or o['id']} — {o['title']}\")
else:
    report_lines.append('- None.')
report_lines.append('')
report_lines.append('## DUPLICATE_OF_ACCOUNTED pairs')
if duplicates:
    for o in duplicates:
        report_lines.append(f\"- {o['pmid'] or o['nct'] or o['id']} — {o['title']} => {o.get('note','')}\")
else:
