decision_by_id = {d['id']: d for d in decisions}
r2_includes = [d for d in decisions if d.get('decision') == 'include']

def prompt_key(r):
    return r.get('pmid') or r.get('nct') or r.get('doi') or r.get('id')

old_rows = []
new_rows = []
for d in r2_includes:
