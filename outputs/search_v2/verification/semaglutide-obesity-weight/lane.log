    'NOT_RCT': counts['NOT_RCT'],
    'WRONG_*': wrong_count,
    'DUPLICATE_OF_ACCOUNTED': counts['DUPLICATE_OF_ACCOUNTED'],
    'UNDECIDABLE': counts['UNDECIDABLE_FROM_RECORD'],
    'NOT_VERIFIED_CAP': counts['NOT_VERIFIED_CAP'],
    'REGISTRY_ONLY': counts['REGISTRY_ONLY_NO_PUBLICATION'],
}
if sum(first_line_counts.values()) "'!= N:
    raise AssertionError(f"first line counts do not sum: {first_line_counts} vs {N}")

JSON_PATH.write_text(json.dumps(results, ensure_ascii=False, indent=2) + '"'\\n', encoding='utf-8')

