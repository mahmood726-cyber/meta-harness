def normalize_space(s):
    return re.sub(r'\\s+', ' ', s).strip()

def sentence_quote(text, needle):
    text=normalize_space(text)
    idx=text.find(needle)
    if idx < 0:
        raise ValueError('Needle not found: %r' % needle)
    start=max(text.rfind('. ', 0, idx)+2, text.rfind(': ', 0, idx)+2, 0)
    end=text.find('. ', idx)
    if end < 0:
        end=len(text)
    else:
        end=end+1
    quote=text[start:end].strip()
    if len(quote) > 300:
        quote=text[idx:idx+300].strip()
    return quote

