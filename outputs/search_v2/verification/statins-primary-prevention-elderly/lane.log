    elif mode == 'ctgov':
        snippets=[]
        for needle in ['\"overallStatus\":\"COMPLETED\"','\"conditions\":[\"Hypercholesterolemia\",\"Medication Adherence\"]','\"name\":\"Medication adherence intervention\"','\"name\":\"Attention-control\"']:
            if needle not in ctgov_text:
                raise ValueError('CT.gov quote needle not found: '+needle)
