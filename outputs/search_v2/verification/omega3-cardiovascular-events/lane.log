"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "@'
import json, re, sys
sys.path.insert(0,'.')
from harness import screen
from harness.pipeline import _dedup

def norm(x):
    if x is None: return ''
    s=str(x).strip()
    s=re.sub(r'"'^PMID'"\\s+', '', s, flags=re.I)
    return s.lower() if '/' in s or s.startswith('10.') else s.upper() if s.upper().startswith('NCT') else s

def record_key(r):
    return norm(r.get('pmid') or r.get('nct') or r.get('doi') or r.get('id'))

def ids_from_obj(o):
    vals=[]
    if isinstance(o, dict):
        for k in ('pmid','nct','doi','id','label','trial_id'):
            if o.get(k): vals.append(norm(o[k]))
    elif o:
        vals.append(norm(o))
    return vals
cfg=json.load(open('topics/omega3-cardiovascular-events.json',encoding='utf-8'))
legacy=json.load(open('cache/omega3-cardiovascular-events/records.json',encoding='utf-8'))
legacy_inc={norm(x['id']) for x in screen.run(_dedup(legacy,cfg.get('pivotal_trials')),cfg)['decisions'] if x['decision']=='include'}
review=json.load(open('docs/reviews/omega3-cardiovascular-events/review.json',encoding='utf-8'))
primary=next(o for o in review['outcomes'] if o.get('primary'))
accounted=set(legacy_inc)
for t in primary.get('trials',[]): accounted.update(ids_from_obj(t))
for t in primary.get('declared_absent_trials') or []: accounted.update(ids_from_obj(t))
r2=json.load(open('cache/omega3-cardiovascular-events/snapshots/2026-09-15r2-search_v2/records.json',encoding='utf-8'))
records=r2['records']; by_id={str(r['id']):r for r in records}
decs=r2['screening']['decisions']
incs=[d for d in decs if d.get('decision')=='include']
new=[]; old=[]; missing=[]
for d in incs:
    r=by_id.get(str(d['id']))
    if not r:
        missing.append(d['id']); continue
    key=record_key(r)
    if key in accounted:
        old.append((d['id'],key,r.get('title','')[:80]))
    else:
        new.append((d,r,key))
print('r2 includes', len(incs), 'of', len(records))
print('already accounted includes', len(old))
print('NEW', len(new))
print('missing matched records', len(missing), missing[:10])
print('accounted set size', len(accounted))
print('new first 20 sorted by year desc, pmid')
for d,r,key in sorted(new, key=lambda x: (-(int(x[1].get('year') or 0) if str(x[1].get('year') or '').isdigit() else 0), norm(x[1].get('pmid') or x[1].get('nct') or x[1].get('doi') or x[1].get('id'))))[:20]:
    print(r.get('year'), key, r.get('id_type'), r.get('title')[:120])
