from pathlib import Path
from urllib.request import urlopen, Request
raw=Path('lane_v/omega3-cardiovascular-events-raw')
raw.mkdir(parents=True, exist_ok=True)
for pmid in ['40883102','34689847']:
    url=f'https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi?db=pubmed&id={pmid}&retmode=xml'
    req=Request(url, headers={'User-Agent':'codex-lane-v-source-verify/1.0'})
    body=urlopen(req, timeout=30).read()
    (raw/f'pubmed_{pmid}.xml').write_bytes(body)
    print(pmid, len(body))
