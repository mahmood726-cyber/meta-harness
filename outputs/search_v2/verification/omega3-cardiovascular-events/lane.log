@@ -0,0 +1,430 @@
+import html
+import json
+import re
+import sys
+from collections import Counter
+from pathlib import Path
+import xml.etree.ElementTree as ET
+
+sys.path.insert(0, ".")
+from harness import screen
+from harness.pipeline import _dedup
+
+SLUG = "omega3-cardiovascular-events"
+RAW_DIR = Path("lane_v") / f"{SLUG}-raw"
+OUT_JSON = Path("lane_v") / f"{SLUG}.json"
+OUT_REPORT = Path(f"LANE-V-{SLUG}-REPORT.md")
+
+COMMANDS_RUN = [
+    "Get-Content -LiteralPath .\\LANE_PROMPT.md -Raw",
+    "git status --short",
+    "Get-Location",
+    "Get-Content -LiteralPath .\\protocols\\omega3-cardiovascular-events.md -Raw",
+    "Get-Content -LiteralPath .\\topics\\omega3-cardiovascular-events.json -Raw",
+    "Get-Content -LiteralPath .\\docs\\reviews\\omega3-cardiovascular-events\\review.json -Raw",
+    "python -c <legacy include computation from LANE_PROMPT.md>",
+    "@' ... '@ | python -  # inspect review outcome structure and declared_absent fields",
+    "@' ... '@ | python -  # compute legacy/r2/accounted/new counts",
+    "@' ... '@ | python -  # inspect r2 record schema",
+    "@' ... '@ | python -  # list first 150 new includes and empty/truncated abstracts",
+    "New-Item -ItemType Directory -Force -Path .\\lane_v\\omega3-cardiovascular-events-raw | Out-Null",
+    "Invoke-WebRequest efetch PMID 40883102 to lane_v raw XML  # failed TLS receive",
+    "Invoke-WebRequest efetch PMID 34689847 to lane_v raw XML  # failed TLS receive",
+    "@' ... '@ | python -  # fetched PubMed efetch XML for 40883102 and 34689847",
+    "@' ... '@ | python -  # print first 150 titles and PMID/NCT order",
+    "@' ... '@ | python -  # print decision-bearing sentences for first 150, broad batch",
+    "@' ... '@ | python -  # print decision-bearing sentences for records 31-80",
+    "@' ... '@ | python -  # print decision-bearing sentences for records 81-125",
+    "@' ... '@ | python -  # inspect selected uncertain abstracts and saved PubMed XML snippets",
+    "@' ... '@ | python -  # inspect selected middle abstracts",
+    "@' ... '@ | python -  # inspect remaining selected abstracts",
+    "oversized PowerShell here-string generation command  # rejected before process start: Win32 206 filename/extension too long",
+    "python  # interactive TTY stdin session",
+    "exec(<generation and validation script>)  # failed with IndentationError before writing artefacts",
+    "exit()",
+    "apply_patch  # add .tmp/generate_lane_v.py",
+    "python .\\.tmp\\generate_lane_v.py",
+    "apply_patch  # delete .tmp/generate_lane_v.py",
+    "python -c <final artefact validation>",
+]
+
+ELIGIBLE_RCT = {"39788951", "30276144", "28419884"}
+NO_PRIMARY = {
+    "41500861", "41559698", "41679602", "42387993", "39073419",
+    "39163858", "38589346", "38830807", "39519588", "37255775",
+    "38001474", "35361442", "32609331", "33952620", "34154367",
+    "34473420", "34552329", "31237134", "32194222", "32281579",
+    "32435279", "32787879", "32860032", "33396567", "33815717",
+    "29752009", "30684965", "30746344", "30977496", "31190359",
+    "31380258", "29223557", "29289538", "29518747", "29588138",
+    "30004123", "30101332", "30197273", "30324119", "27913872",
+    "28112528", "28394002", "28541926", "28587203", "28721137",
+    "28791297", "28826313", "28835761", "29017158", "29034644",
+    "29066159", "27033026",
+}
+NOT_RCT = {
+    "40883102", "34689847", "41028784", "34989797", "35157055",
+    "33098434", "31895658", "32412960", "32600510", "33032778",
+    "30913208", "31422671", "29583081", "26205903", "26850746",
+}
+WRONG_POPULATION = {
+    "NCT06710080", "40356575", "38777428", "NCT06729229",
+    "37862823", "38053947", "NCT06833554", "35938123",
+    "NCT05980026", "33812168", "34107720", "31902378",
+    "30513433", "30967436", "31163106", "31271554", "31434436",
+    "29385062", "29460817", "30098961", "NCT05393843",
+    "27999851", "28378851", "28502503", "26077874", "26091965",
+}
+WRONG_INTERVENTION = {
+    "42321176", "NCT06920667", "32103495", "32380746",
+    "29725824", "31433781",
+}
+WRONG_COMPARATOR = {"41514392", "NCT07575438", "32021349"}
+UNDECIDABLE = {
+    "NCT07352618", "NCT07677995", "NCT07680829", "NCT07078344",
+    "NCT07255326", "NCT06840964", "NCT04662528", "NCT05015348",
+    "NCT04239950", "NCT03784963", "NCT04088240", "NCT06061510",
+    "NCT03056014", "NCT04201938", "NCT03378232", "NCT03961763",
+}
+DUPLICATES = {
+    "41613351": "REDUCE-IT -> pooled PMID 30415628",
+    "39968782": "REDUCE-IT -> pooled PMID 30415628",
+    "40451708": "STRENGTH -> pooled PMID 33190147",
+    "40569483": "VITAL -> pooled PMID 30415637",
+    "40982548": "REDUCE-IT -> pooled PMID 30415628",
+    "38530686": "REDUCE-IT -> pooled PMID 30415628",
+    "38678009": "REDUCE-IT -> pooled PMID 30415628",
+    "35953437": "REDUCE-IT -> pooled PMID 30415628",
+    "36802845": "REDUCE-IT -> pooled PMID 30415628",
+    "37836519": "VITAL -> pooled PMID 30415637",
+    "38035037": "REDUCE-IT -> pooled PMID 30415628",
+    "35261279": "REDUCE-IT -> pooled PMID 30415628",
+    "35361440": "VITAL -> pooled PMID 30415637",
+    "35377160": "REDUCE-IT -> pooled PMID 30415628",
+    "35483753": "REDUCE-IT -> pooled PMID 30415628",
+    "33191772": "OMEMI -> declared-absent NCT01841944",
+    "34706555": "REDUCE-IT -> pooled PMID 30415628",
+    "34710343": "REDUCE-IT -> pooled PMID 30415628",
+    "34742136": "OMEMI -> declared-absent NCT01841944",
+    "31948661": "OMEGA-REMODEL -> declared-absent PMID 38184150",
+    "30898607": "REDUCE-IT -> pooled PMID 30415628",
+    "31532795": "OMEGA-REMODEL -> declared-absent PMID 38184150",
+    "31703120": "VITAL -> pooled PMID 30415637",
+    "31881852": "OMEMI -> declared-absent NCT01841944",
+    "29653635": "ASCEND -> pooled PMID 30146932",
+    "28294373": "REDUCE-IT -> pooled PMID 30415628",
+    "29137111": "Alpha Omega Trial -> pooled PMID 20929341",
+    "26681720": "ORIGIN/ORIGINALE -> pooled PMID 22686415",
+}
+
+ALLOWED = {
+    "ELIGIBLE_RCT", "ELIGIBLE_RCT_NO_PRIMARY", "NOT_RCT",
+    "WRONG_POPULATION", "WRONG_INTERVENTION", "WRONG_COMPARATOR",
+    "WRONG_OUTCOME_ONLY", "DUPLICATE_OF_ACCOUNTED",
+    "UNDECIDABLE_FROM_RECORD", "NOT_VERIFIED_CAP",
+}
+
+
+def norm(value):
+    text = str(value or "").strip()
+    text = re.sub(r"^PMID\s+", "", text, flags=re.I)
+    if text.upper().startswith("NCT"):
+        return text.upper()
+    if "/" in text or text.startswith("10."):
+        return text.lower()
+    return text
+
+
+def record_key(record):
+    return norm(record.get("pmid") or record.get("nct") or record.get("doi") or record.get("id"))
+
+
+def ids_from_obj(obj):
+    values = []
+    if isinstance(obj, dict):
+        for key in ("pmid", "nct", "doi", "id", "label", "trial_id"):
+            if obj.get(key):
+                values.append(norm(obj[key]))
+    elif obj:
+        values.append(norm(obj))
+    return values
+
+
+def year_value(record):
+    year = str(record.get("year") or "")
+    return int(year) if year.isdigit() else 0
+
+
+def clean_quote(text):
+    text = html.unescape(re.sub(r"<[^>]+>", " ", text or ""))
+    text = " ".join(text.split())
+    if len(text) > 300:
+        text = text[:297].rstrip() + "..."
+    return text
+
+
+def sentence_candidates(title, abstract):
+    candidates = []
+    if title:
+        candidates.append(clean_quote(title))
+    if abstract:
+        for sentence in re.split(r"(?<=[.!?])\s+", " ".join(abstract.split())):
+            cleaned = clean_quote(sentence)
+            if cleaned:
+                candidates.append(cleaned)
+    return candidates
+
+
+def xml_title(pmid):
+    path = RAW_DIR / f"pubmed_{pmid}.xml"
+    root = ET.parse(path).getroot()
+    node = root.find(".//ArticleTitle")
+    text = "".join(node.itertext()) if node is not None else ""
+    return clean_quote(text), f"pubmed efetch (lane_v/{SLUG}-raw/pubmed_{pmid}.xml)"
+
+
+def pick_quote(record, key, verdict):
+    if key in {"40883102", "34689847"}:
+        return xml_title(key)
+
+    title = record.get("title") or ""
+    abstract = record.get("abstract") or ""
+    source = "snapshot abstract"
+    if not abstract.strip():
+        return clean_quote(title), source
+
+    patterns = {
+        "DUPLICATE_OF_ACCOUNTED": r"REDUCE-IT|VITAL|STRENGTH|ORIGIN|ORIGINALE|OMEMI|OMEGA-REMODEL|ASCEND|Alpha Omega",
+        "NOT_RCT": r"secondary analysis|secondary and exploratory|post hoc|subanalysis|pooled the results|cost-effectiveness|microsimulation|PURPOSE OF REVIEW|we review|science advisory|baseline characteristics|Subset of clinical trial subjects|Retraction notice|Expression of concern|economic evaluation|extrapolated",
+        "WRONG_POPULATION": r"gestational diabetes|pregnant|pediatric|adolescents|children|healthy volunteers|healthy participants|healthy individuals|long distance runners|major depressive disorder|depressed|Sprague-Dawley|iron deficiency anemia|Community-Acquired Pneumonia|Young Adults|Mothers|Breast Milk|elderly women",
+        "WRONG_INTERVENTION": r"camelina|Protein-Creatine-Omega3|goat cheese|plant sterols|combined effect of vitamin C|PUFA \+ ASA|adjuncts to periodontal|spread with added plant sterols",
+        "WRONG_COMPARATOR": r"standard omega-3|Different Fish Oil Types|Group A, fish oil 2000 mg; Group B, fish oil 2000 mg|Group C, fish oil 2000",
+        "ELIGIBLE_RCT": r"atrial fibrillation|Arrhythmia frequencies|30-day major adverse cardiac events|MACE|major adverse cardiovascular events|occurrence of AF|bleeding",
+        "ELIGIBLE_RCT_NO_PRIMARY": r"primary outcome|primary endpoint|primary efficacy endpoints|serum|lipid|triglyceride|glycemic|renal|kidney|endothelial|hs-CRP|irisin|apelin|PON1|PON2|HDL|glucose|cholesterol|plaque|vascular stiffness|fatigue|FGF23|FSTL1|adiponectin|microbiota|liver fat|vitamin D",
+        "UNDECIDABLE_FROM_RECORD": r".+",
+    }
+    matcher = re.compile(patterns.get(verdict, r".+"), re.I)
+    for sentence in sentence_candidates(title, abstract):
+        if matcher.search(sentence):
+            return sentence, source
+    fallback = re.compile(r"random|placebo|omega|fish oil|icosapent|EPA|DHA", re.I)
+    for sentence in sentence_candidates(title, abstract):
+        if fallback.search(sentence):
+            return sentence, source
+    return clean_quote(title), source
+
+
+def classify(key):
+    if key in ELIGIBLE_RCT:
+        return "ELIGIBLE_RCT"
+    if key in NO_PRIMARY:
+        return "ELIGIBLE_RCT_NO_PRIMARY"
+    if key in NOT_RCT:
+        return "NOT_RCT"
+    if key in WRONG_POPULATION:
+        return "WRONG_POPULATION"
+    if key in WRONG_INTERVENTION:
+        return "WRONG_INTERVENTION"
+    if key in WRONG_COMPARATOR:
+        return "WRONG_COMPARATOR"
+    if key in UNDECIDABLE:
+        return "UNDECIDABLE_FROM_RECORD"
+    if key in DUPLICATES:
+        return "DUPLICATE_OF_ACCOUNTED"
+    raise KeyError(key)
+
+
+cfg = json.load(open(f"topics/{SLUG}.json", encoding="utf-8"))
+legacy = json.load(open(f"cache/{SLUG}/records.json", encoding="utf-8"))
+legacy_includes = sorted(
+    item["id"]
+    for item in screen.run(_dedup(legacy, cfg.get("pivotal_trials")), cfg)["decisions"]
+    if item["decision"] == "include"
+)
+
+accounted = {norm(item) for item in legacy_includes}
+review = json.load(open(f"docs/reviews/{SLUG}/review.json", encoding="utf-8"))
+primary = next(outcome for outcome in review["outcomes"] if outcome.get("primary"))
+for trial in primary.get("trials", []):
+    accounted.update(ids_from_obj(trial))
+for trial in primary.get("declared_absent_trials") or []:
+    accounted.update(ids_from_obj(trial))
+
+r2 = json.load(open(f"cache/{SLUG}/snapshots/2026-09-15r2-search_v2/records.json", encoding="utf-8"))
+records = r2["records"]
+by_id = {str(record["id"]): record for record in records}
+includes = [decision for decision in r2["screening"]["decisions"] if decision.get("decision") == "include"]
+
+old = []
+new = []
+for decision in includes:
+    record = by_id[str(decision["id"])]
+    target = old if record_key(record) in accounted else new
+    target.append((decision, record))
+
+new = sorted(new, key=lambda item: (-year_value(item[1]), record_key(item[1])))
+if (len(includes), len(records), len(old), len(new)) != (418, 16695, 22, 396):
+    raise SystemExit(
+        f"population mismatch inc={len(includes)} records={len(records)} old={len(old)} new={len(new)}"
+    )
+
+first_150 = {record_key(record) for _, record in new[:150]}
+classified = (
+    ELIGIBLE_RCT
+    | NO_PRIMARY
+    | NOT_RCT
+    | WRONG_POPULATION
+    | WRONG_INTERVENTION
+    | WRONG_COMPARATOR
+    | UNDECIDABLE
+    | set(DUPLICATES)
+)
+if first_150 != classified:
+    raise SystemExit(
+        "classification keys mismatch missing=%r extra=%r"
+        % (sorted(first_150 - classified), sorted(classified - first_150))
+    )
+
+objects = []
+for index, (decision, record) in enumerate(new, 1):
+    key = record_key(record)
+    if index <= 150:
+        verdict = classify(key)
+        quote, source = pick_quote(record, key, verdict)
+        note = ""
+    else:
+        verdict = "NOT_VERIFIED_CAP"
+        quote = ""
+        source = "snapshot abstract"
+        note = "Beyond verification cap: not source-verified; sorted after first 150 by year desc, id."
+
+    obj = {
+        "id": record.get("id") or "",
+        "id_type": record.get("id_type") or "",
+        "pmid": record.get("pmid") or "",
+        "nct": record.get("nct") or "",
+        "title": record.get("title") or "",
+        "year": record.get("year") or "",
+        "verdict": verdict,
+        "quote": quote,
+        "quote_source": source,
+        "screen_rule": decision.get("rule_id") or "",
+        "screen_agrees": verdict.startswith("ELIGIBLE"),
+    }
+    if verdict == "DUPLICATE_OF_ACCOUNTED":
+        obj["duplicate_of_accounted"] = DUPLICATES[key]
+    if verdict == "UNDECIDABLE_FROM_RECORD":
+        obj["note"] = "Record title/abstract does not settle eligibility; missing design/comparator and/or outcome detail."
+    elif note:
+        obj["note"] = note
+    objects.append(obj)
+
+OUT_JSON.parent.mkdir(parents=True, exist_ok=True)
+OUT_JSON.write_text(json.dumps(objects, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+
+counts = Counter(obj["verdict"] for obj in objects)
+new_count = len(objects)
+eligible_rct_count = counts["ELIGIBLE_RCT"]
+no_primary_count = counts["ELIGIBLE_RCT_NO_PRIMARY"]
+not_rct_count = counts["NOT_RCT"]
+wrong_count = sum(
+    counts[verdict]
+    for verdict in ("WRONG_POPULATION", "WRONG_INTERVENTION", "WRONG_COMPARATOR", "WRONG_OUTCOME_ONLY")
+)
+duplicate_count = counts["DUPLICATE_OF_ACCOUNTED"]
+undecidable_count = counts["UNDECIDABLE_FROM_RECORD"]
+cap_count = counts["NOT_VERIFIED_CAP"]
+assert (
+    eligible_rct_count
+    + no_primary_count
+    + not_rct_count
+    + wrong_count
+    + duplicate_count
