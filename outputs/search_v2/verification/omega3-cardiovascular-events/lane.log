import json,re,sys
sys.path.insert(0,'.')
from harness import screen
from harness.pipeline import _dedup

def norm(x):
    if x is None: return ''
    s=str(x).strip(); s=re.sub(r'"'^PMID'"\\s+','',s,flags=re.I)
    if s.upper().startswith('NCT'): return s.upper()
    if '/' in s or s.startswith('10.'): return s.lower()
    return s

def key(r): return norm(r.get('pmid') or r.get('nct') or r.get('doi') or r.get('id'))
def ids(o):
    vals=[]
    if isinstance(o,dict):
        for k in ('pmid','nct','doi','id','label','trial_id'):
            if o.get(k): vals.append(norm(o[k]))
    elif o: vals.append(norm(o))
    return vals
cfg=json.load(open('topics/omega3-cardiovascular-events.json',encoding='utf-8'))
legacy=json.load(open('cache/omega3-cardiovascular-events/records.json',encoding='utf-8'))
accounted={norm(x['id']) for x in screen.run(_dedup(legacy,cfg.get('pivotal_trials')),cfg)['decisions'] if x['decision']=='include'}
review=json.load(open('docs/reviews/omega3-cardiovascular-events/review.json',encoding='utf-8'))
primary=next(o for o in review['outcomes'] if o.get('primary'))
for t in primary.get('trials',[]): accounted.update(ids(t))
for t in primary.get('declared_absent_trials') or []: accounted.update(ids(t))
r2=json.load(open('cache/omega3-cardiovascular-events/snapshots/2026-09-15r2-search_v2/records.json',encoding='utf-8'))
by_id={str(r['id']):r for r in r2['records']}
new=[]
for d in r2['screening']['decisions']:
    if d.get('decision')=='include':
        r=by_id[str(d['id'])]
        if key(r) not in accounted: new.append((d,r))
def yval(r):
    y=str(r.get('year') or '')
    return int(y) if y.isdigit() else 0
new=sorted(new,key=lambda x:(-yval(x[1]),key(x[1])))
patterns=re.compile(r'random|placebo|control|primary|endpoint|end point|major|cardiovascular|vascular|atrial|fibrillation|bleed|diabetes|pregnan|pediatric|children|adolesc|depress|secondary|subgroup|post hoc|pooled|protocol|meta-analysis|review|cost|retraction|expression of concern|baseline|healthy|omega|fish oil|icosapent|EPA|DHA|flaxseed|camelina|yoga|sertraline|probiotic|vitamin|curcumin|glimepiride|goat cheese|fistula|kidney|renal|stroke', re.I)
for chunk_start,chunk_end in [(1,50),(51,100),(101,150)]:
    print(f'### {chunk_start}-{chunk_end}')
    for i,(d,r) in enumerate(new[chunk_start-1:chunk_end],chunk_start):
        txt=(r.get('abstract') or '').replace('\\n',' ').replace('\\r',' ')
        sents=re.split(r'(?<=[."'!?])'"\\s+', txt)
        hits=[]
        for s in sents:
            if patterns.search(s):
                s=' '.join(s.split())
                if len(s)>260: s=s[:257]+'...'
                hits.append(s)
            if len(hits)>=4: break
        print(f'[{i}] {key(r)} {r.get(\"year\")} | {r.get(\"title\")}')
        for h in hits: print('  -',h)
        if not hits: print('  - NO ABSTRACT HIT')
