+        f"were source-verified; remaining {cap_count} are NOT_VERIFIED_CAP."
+    ),
+    "",
+    "Eligible RCT ids with titles (could move the pool):",
+]
+for obj in objects:
+    if obj["verdict"] == "ELIGIBLE_RCT":
+        lines.append(f"- {obj['id']}: {obj['title']}")
+if not any(obj["verdict"] == "ELIGIBLE_RCT" for obj in objects):
+    lines.append("- none")
+
+lines.extend(["", "Duplicate-of-accounted pairs:"])
+for obj in objects:
+    if obj["verdict"] == "DUPLICATE_OF_ACCOUNTED":
+        lines.append(f"- {obj['id']}: {obj['duplicate_of_accounted']}; title: {obj['title']}")
+if not any(obj["verdict"] == "DUPLICATE_OF_ACCOUNTED" for obj in objects):
+    lines.append("- none")
+
+lines.extend(["", "Commands run:"])
+for command in COMMANDS_RUN:
+    lines.append(f"- `{command}`")
+
+lines.extend(
+    [
+        "",
