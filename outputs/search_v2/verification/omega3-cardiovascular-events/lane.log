+            "because their snapshot abstracts were empty."
+        ),
+    ]
+)
+OUT_REPORT.write_text("\n".join(lines) + "\n", encoding="utf-8")
+
+loaded = json.loads(OUT_JSON.read_text(encoding="utf-8"))
+assert len(loaded) == 396
+for obj in loaded:
+    assert obj["verdict"] in ALLOWED
+    if obj["verdict"] not in {"UNDECIDABLE_FROM_RECORD", "NOT_VERIFIED_CAP"}:
+        assert obj.get("quote")
+        assert len(obj["quote"]) <= 300
+assert OUT_REPORT.read_text(encoding="utf-8").splitlines()[0] == lines[0]
+
+print(f"wrote {OUT_JSON} with {len(loaded)} objects")
+print(f"wrote {OUT_REPORT}")
+print(
