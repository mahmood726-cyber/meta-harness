+    target.append((decision, record))
+
+new = sorted(new, key=lambda item: (-year_value(item[1]), record_key(item[1])))
+if (len(includes), len(records), len(old), len(new)) != (418, 16695, 22, 396):
+    raise SystemExit(
+        f"population mismatch inc={len(includes)} records={len(records)} old={len(old)} new={len(new)}"
+    )
+
+first_150 = {record_key(record) for _, record in new[:150]}
+classified = (
+    ELIGIBLE_RCT
+    | NO_PRIMARY
+    | NOT_RCT
+    | WRONG_POPULATION
+    | WRONG_INTERVENTION
+    | WRONG_COMPARATOR
+    | UNDECIDABLE
+    | set(DUPLICATES)
+)
+if first_150 != classified:
+    raise SystemExit(
+        "classification keys mismatch missing=%r extra=%r"
+        % (sorted(first_150 - classified), sorted(classified - first_150))
+    )
+
+objects = []
+for index, (decision, record) in enumerate(new, 1):
+    key = record_key(record)
+    if index <= 150:
+        verdict = classify(key)
+        quote, source = pick_quote(record, key, verdict)
+        note = ""
+    else:
+        verdict = "NOT_VERIFIED_CAP"
+        quote = ""
+        source = "snapshot abstract"
+        note = "Beyond verification cap: not source-verified; sorted after first 150 by year desc, id."
+
+    obj = {
+        "id": record.get("id") or "",
+        "id_type": record.get("id_type") or "",
+        "pmid": record.get("pmid") or "",
+        "nct": record.get("nct") or "",
+        "title": record.get("title") or "",
+        "year": record.get("year") or "",
+        "verdict": verdict,
+        "quote": quote,
+        "quote_source": source,
+        "screen_rule": decision.get("rule_id") or "",
+        "screen_agrees": verdict.startswith("ELIGIBLE"),
+    }
+    if verdict == "DUPLICATE_OF_ACCOUNTED":
+        obj["duplicate_of_accounted"] = DUPLICATES[key]
+    if verdict == "UNDECIDABLE_FROM_RECORD":
+        obj["note"] = "Record title/abstract does not settle eligibility; missing design/comparator and/or outcome detail."
+    elif note:
+        obj["note"] = note
+    objects.append(obj)
+
+OUT_JSON.parent.mkdir(parents=True, exist_ok=True)
+OUT_JSON.write_text(json.dumps(objects, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+
+counts = Counter(obj["verdict"] for obj in objects)
+new_count = len(objects)
+eligible_rct_count = counts["ELIGIBLE_RCT"]
+no_primary_count = counts["ELIGIBLE_RCT_NO_PRIMARY"]
+not_rct_count = counts["NOT_RCT"]
+wrong_count = sum(
+    counts[verdict]
+    for verdict in ("WRONG_POPULATION", "WRONG_INTERVENTION", "WRONG_COMPARATOR", "WRONG_OUTCOME_ONLY")
+)
+duplicate_count = counts["DUPLICATE_OF_ACCOUNTED"]
+undecidable_count = counts["UNDECIDABLE_FROM_RECORD"]
+cap_count = counts["NOT_VERIFIED_CAP"]
+assert (
+    eligible_rct_count
+    + no_primary_count
+    + not_rct_count
+    + wrong_count
+    + duplicate_count
+    + undecidable_count
+    + cap_count
+    == new_count
+)
+verified_count = new_count - cap_count
+screen_agree_count = sum(1 for obj in objects[:verified_count] if obj["screen_agrees"])
+
+lines = [
+    (
+        "V-omega3-cardiovascular-events VERDICTS: "
+        f"NEW {new_count}; ELIGIBLE_RCT {eligible_rct_count}; "
+        f"ELIGIBLE_RCT_NO_PRIMARY {no_primary_count}; NOT_RCT {not_rct_count}; "
+        f"WRONG_* {wrong_count}; DUPLICATE_OF_ACCOUNTED {duplicate_count}; "
+        f"UNDECIDABLE {undecidable_count}; NOT_VERIFIED_CAP {cap_count}"
+    ),
+    f"automated screen agreed on {screen_agree_count} of {verified_count} verified",
+    "",
+    f"r2 includes {len(includes)} of {len(records)}; already accounted for {len(old)}; NEW {new_count}",
+    (
+        "verification cap: N > 150, so first 150 by (year desc, pmid/NCT/DOI key) "
+        f"were source-verified; remaining {cap_count} are NOT_VERIFIED_CAP."
+    ),
+    "",
+    "Eligible RCT ids with titles (could move the pool):",
+]
+for obj in objects:
+    if obj["verdict"] == "ELIGIBLE_RCT":
+        lines.append(f"- {obj['id']}: {obj['title']}")
+if not any(obj["verdict"] == "ELIGIBLE_RCT" for obj in objects):
+    lines.append("- none")
+
+lines.extend(["", "Duplicate-of-accounted pairs:"])
+for obj in objects:
+    if obj["verdict"] == "DUPLICATE_OF_ACCOUNTED":
+        lines.append(f"- {obj['id']}: {obj['duplicate_of_accounted']}; title: {obj['title']}")
+if not any(obj["verdict"] == "DUPLICATE_OF_ACCOUNTED" for obj in objects):
+    lines.append("- none")
+
+lines.extend(["", "Commands run:"])
+for command in COMMANDS_RUN:
+    lines.append(f"- `{command}`")
+
+lines.extend(
+    [
+        "",
+        "Marks:",
+        (
+            "- MEASURED: all counts in the first two lines and population line are computed "
+            "from the listed JSON/cache inputs by the generation command."
+        ),
+        (
+            "- MEASURED: legacy includes, pooled trials, declared-absent trials, and r2 "
+            "screening decisions are read from the files named in LANE_PROMPT.md."
+        ),
+        (
+            "- INFERRED: each non-cap verdict is inferred from the quoted title/abstract/XML "
+            "span in the JSON object, following the protocol PICO and exclusion text."
+        ),
+        (
+            "- MEASURED: PubMed efetch XML files saved under "
+            "`lane_v/omega3-cardiovascular-events-raw/` for PMIDs 40883102 and 34689847 "
+            "because their snapshot abstracts were empty."
+        ),
+    ]
+)
+OUT_REPORT.write_text("\n".join(lines) + "\n", encoding="utf-8")
+
+loaded = json.loads(OUT_JSON.read_text(encoding="utf-8"))
+assert len(loaded) == 396
+for obj in loaded:
+    assert obj["verdict"] in ALLOWED
+    if obj["verdict"] not in {"UNDECIDABLE_FROM_RECORD", "NOT_VERIFIED_CAP"}:
+        assert obj.get("quote")
+        assert len(obj["quote"]) <= 300
+assert OUT_REPORT.read_text(encoding="utf-8").splitlines()[0] == lines[0]
+
+print(f"wrote {OUT_JSON} with {len(loaded)} objects")
+print(f"wrote {OUT_REPORT}")
+print(
+    "counts",
+    dict(counts),
+    "wrong_star",
+    wrong_count,
+    "verified",
+    verified_count,
+    "screen_agree",
+    screen_agree_count,
+)

diff --git a/.tmp/generate_lane_v.py b/.tmp/generate_lane_v.py
