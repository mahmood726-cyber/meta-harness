import json, re, sys
sys.path.insert(0,'.')
from harness import screen
from harness.pipeline import _dedup

def norm(x):
    if x is None: return ''
    s=str(x).strip()
    s=re.sub(r'"'^PMID'"\\s+', '', s, flags=re.I)
    if s.upper().startswith('NCT'): return s.upper()
    if '/' in s or s.startswith('10.'): return s.lower()
    return s

def key(r): return norm(r.get('pmid') or r.get('nct') or r.get('doi') or r.get('id'))
def ids(o):
    vals=[]
    if isinstance(o,dict):
        for k in ('pmid','nct','doi','id','label','trial_id'):
            if o.get(k): vals.append(norm(o[k]))
    elif o: vals.append(norm(o))
    return vals
cfg=json.load(open('topics/omega3-cardiovascular-events.json',encoding='utf-8'))
legacy=json.load(open('cache/omega3-cardiovascular-events/records.json',encoding='utf-8'))
accounted={norm(x['id']) for x in screen.run(_dedup(legacy,cfg.get('pivotal_trials')),cfg)['decisions'] if x['decision']=='include'}
review=json.load(open('docs/reviews/omega3-cardiovascular-events/review.json',encoding='utf-8'))
primary=next(o for o in review['outcomes'] if o.get('primary'))
for t in primary.get('trials',[]): accounted.update(ids(t))
for t in primary.get('declared_absent_trials') or []: accounted.update(ids(t))
r2=json.load(open('cache/omega3-cardiovascular-events/snapshots/2026-09-15r2-search_v2/records.json',encoding='utf-8'))
by_id={str(r['id']):r for r in r2['records']}
new=[]
for d in r2['screening']['decisions']:
    if d.get('decision')"'!='"'include': continue
    r=by_id[str(d['id'])]
    if key(r) not in accounted:
        new.append((d,r))
def yval(r):
    y=str(r.get('year') or '')
    return int(y) if y.isdigit() else 0
new_sorted=sorted(new, key=lambda x: (-yval(x[1]), key(x[1])))
for i,(d,r) in enumerate(new_sorted[:150],1):
    abs_text=(r.get('abstract') or '').replace('\\r',' ').replace('\\n',' ')
    trunc=('...' in abs_text[-20:] or abs_text.endswith('…') or '[Abstract truncated]' in abs_text)
    print(f\"## {i} | {r.get('year')} | {key(r)} | {r.get('id_type')} | abs_len={len(abs_text)} | empty={not bool(abs_text.strip())} | trunc={trunc}\")
    print('TITLE:', r.get('title',''))
    print('PUBTYPES:', '; '.join(r.get('pubtypes') or []))
    print('SCREEN:', d.get('rule_id'), '|', d.get('reason'), '|', d.get('span'))
    print('ABSTRACT:', abs_text[:1200])
    print()
