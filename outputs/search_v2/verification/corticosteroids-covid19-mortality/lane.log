import json, sys
sys.path.insert(0,'.')
from harness import screen
from harness.pipeline import _dedup
cfg=json.load(open('topics/corticosteroids-covid19-mortality.json',encoding='utf-8'))
legacy_data=json.load(open('cache/corticosteroids-covid19-mortality/records.json',encoding='utf-8'))
legacy=sorted(x['id'] for x in screen.run(_dedup(legacy_data,cfg.get('pivotal_trials')),cfg)['decisions'] if x['decision']=='include')
review=json.load(open('docs/reviews/corticosteroids-covid19-mortality/review.json',encoding='utf-8'))
primary=next(o for o in review['outcomes'] if o.get('primary'))
pooled=[(t.get('label') or t.get('id') or '') for t in primary.get('trials',[])]
absent=primary.get('declared_absent_trials') or []
print('legacy',legacy)
print('pooled',pooled)
print('absent',absent)
r2=json.load(open('cache/corticosteroids-covid19-mortality/snapshots/2026-09-15r2-search_v2/records.json',encoding='utf-8'))
recs={x['id']:x for x in r2['records']}
decs={x['id']:x for x in r2['screening']['decisions']}
inc=[recs[d['id']] for d in r2['screening']['decisions'] if d.get('decision')=='include']
def key_of(x):
    return str(x.get('pmid') or x.get('nct') or x.get('doi') or x.get('id') or '')
def normalize_abs(a):
    if isinstance(a,dict):
        return str(a.get('pmid') or a.get('nct') or a.get('id') or a.get('label') or '')
    return str(a)
def norm(s):
    s=str(s)
    return s.replace('PMID ','').replace('NCT ','').strip()
accounted=set(map(str,legacy))
accounted.update(norm(x) for x in pooled)
accounted.update(norm(normalize_abs(a)) for a in absent)
new=[x for x in inc if key_of(x) not in accounted]
new=sorted(new,key=lambda x:(-(int(x.get('year') or 0)), str(x.get('pmid') or x.get('nct') or x.get('doi') or x.get('id'))))
print('r2 includes',len(inc),'of',len(r2['records']))
print('accounted set',sorted(a for a in accounted if a))
print('already accounted in r2 includes',len(inc)-len(new))
print('NEW',len(new))
rows=[]
for x in new:
    row={k:x.get(k) for k in ['id','id_type','pmid','nct','doi','title','year','pubtypes']}
    row.update({'rule':decs[x['id']].get('rule_id'), 'reason':decs[x['id']].get('reason'), 'abstract_len':len(x.get('abstract') or '')})
    rows.append(row)
print(json.dumps(rows,indent=2,ensure_ascii=False))
