import json, pathlib, sys
sys.path.insert(0,'.')
from harness import screen
from harness.pipeline import _dedup

slug='corticosteroids-covid19-mortality'
r2_path=pathlib.Path('cache')/slug/'snapshots'/'2026-09-15r2-search_v2'/'records.json'
cfg_path=pathlib.Path('topics')/(slug+'.json')
legacy_path=pathlib.Path('cache')/slug/'records.json'
review_path=pathlib.Path('docs')/'reviews'/slug/'review.json'
out_dir=pathlib.Path('lane_v')
raw_dir=out_dir/(slug+'-raw')
out_dir.mkdir(exist_ok=True)
raw_dir.mkdir(exist_ok=True)

cfg=json.load(open(cfg_path,encoding='utf-8'))
legacy_data=json.load(open(legacy_path,encoding='utf-8'))
legacy=sorted(x['id'] for x in screen.run(_dedup(legacy_data,cfg.get('pivotal_trials')),cfg)['decisions'] if x['decision']=='include')
review=json.load(open(review_path,encoding='utf-8'))
primary=next(o for o in review['outcomes'] if o.get('primary'))
pooled=[(t.get('label') or t.get('id') or '') for t in primary.get('trials',[])]
absent=primary.get('declared_absent_trials') or []

def normalize_abs(a):
    if isinstance(a,dict):
        return str(a.get('pmid') or a.get('nct') or a.get('id') or a.get('label') or '')
    return str(a)

def norm(s):
    return str(s).replace('PMID ','').replace('NCT ','').strip()

def key_of(x):
    return str(x.get('pmid') or x.get('nct') or x.get('doi') or x.get('id') or '')

accounted=set(map(str,legacy))
accounted.update(norm(x) for x in pooled)
accounted.update(norm(normalize_abs(a)) for a in absent)
accounted={x for x in accounted if x}
r2=json.load(open(r2_path,encoding='utf-8'))
recs={x['id']:x for x in r2['records']}
decs={x['id']:x for x in r2['screening']['decisions']}
inc=[recs[d['id']] for d in r2['screening']['decisions'] if d.get('decision')=='include']
new=[x for x in inc if key_of(x) not in accounted]
new=sorted(new,key=lambda x:(-(int(x.get('year') or 0)), str(x.get('pmid') or x.get('nct') or x.get('doi') or x.get('id'))))

