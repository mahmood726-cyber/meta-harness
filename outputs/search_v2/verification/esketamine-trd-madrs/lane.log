if len(data)"'!=N: errors.append(f'"'json length {len(data)} "'!= NEW {N}'"')
if parts"'!=N: errors.append(f'"'first-line sum {parts} "'!= NEW {N}'"')
for i,x in enumerate(data,1):
    if x.get('verdict') not in allowed: errors.append(f'bad verdict at {i}: {x.get(\"verdict\")}')
    if x.get('verdict') not in {'UNDECIDABLE_FROM_RECORD','NOT_VERIFIED_CAP'} and not x.get('quote'):
        errors.append(f'missing quote at {i}: {x.get(\"id\")}')
    if len(x.get('quote',''))>300: errors.append(f'long quote at {i}: {x.get(\"id\")}')
raw=list(Path(f'lane_v/{slug}-raw').glob('*'))
if len(raw)<5: errors.append(f'raw files {len(raw)} < 5')
if errors:
    print('FAIL')
    print('\\n'.join(errors))
    raise SystemExit(1)
print('PASS')
print(first)
print(report[1])
print(f'json_objects={len(data)} raw_files={len(raw)}')
