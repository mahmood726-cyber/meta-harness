data=json.loads(Path(f'lane_v/{slug}.json').read_text(encoding='utf-8'))
report=Path(f'LANE-V-{slug}-REPORT.md').read_text(encoding='utf-8').splitlines()
first=report[0]
nums=[int(x) for x in re.findall(r'(?:NEW|ELIGIBLE_RCT|ELIGIBLE_RCT_NO_PRIMARY|NOT_RCT|WRONG_\\*|DUPLICATE_OF_ACCOUNTED|UNDECIDABLE|NOT_VERIFIED_CAP|REGISTRY_ONLY) (\\d+)', first)]
