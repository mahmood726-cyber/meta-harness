def registry_quote(nct):
    data=json.loads((raw_dir / f'{nct}-ctgov.json').read_text(encoding='utf-8'))
    proto=data.get('protocolSection',{})
    status=proto.get('statusModule',{}).get('overallStatus','')
    conds=proto.get('conditionsModule',{}).get('conditions') or []
    interventions=proto.get('armsInterventionsModule',{}).get('interventions') or []
    names=[x.get('name') or x.get('interventionName') for x in interventions]
    names=[x for x in names if x]
    q=f'overallStatus={status}; conditions={\"; \".join(conds)}; interventions={\"; \".join(names[:4])}'
    return q[:300]

