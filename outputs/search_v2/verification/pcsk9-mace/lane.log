    print('TITLE', rec.get('title'))
    print('PUBTYPES', rec.get('pubtypes'))
    print('ABSLEN', len(abs_text), 'ABSTRACT', abs_text[:1600])
    print('SCREEN_REASON', d.get('reason'))
    print('SCREEN_SPAN', d.get('span'))
