"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -NoProfile -Command "@'
import json
from harness import screen
from harness.pipeline import _dedup
cfg=json.load(open('topics/pcsk9-mace.json',encoding='utf-8'))
legacy=json.load(open('cache/pcsk9-mace/records.json',encoding='utf-8'))
legacy_includes={str(x['id']) for x in screen.run(_dedup(legacy,cfg.get('pivotal_trials')),cfg)['decisions'] if x['decision']=='include'}
r2=json.load(open(r'cache/pcsk9-mace/snapshots/2026-09-15r2-search_v2/records.json',encoding='utf-8'))
records=r2['records']
rec_by_id={str(r.get('id')):r for r in records}
for r in records:
    for k in ('pmid','nct','doi'):
        if r.get(k): rec_by_id.setdefault(str(r.get(k)), r)
review=json.load(open(r'docs/reviews/pcsk9-mace/review.json',encoding='utf-8'))
accounted=set(legacy_includes)
for out in review.get('outcomes',[]):
    for coll in ('trials','declared_absent_trials'):
        for t in out.get(coll) or []:
            for v in (t.get('label'), t.get('id')):
                if v: accounted.add(str(v).replace('PMID ','').strip())
rows=[]
for d in r2['screening']['decisions']:
    if d.get('decision')"'!='"'include': continue
    rec=rec_by_id.get(str(d.get('id')), {})
    key=str(rec.get('pmid') or rec.get('nct') or rec.get('doi') or d.get('id'))
    if key not in accounted:
        rows.append((int(rec.get('year') or 0), key, d, rec))
for i,(year,key,d,rec) in enumerate(sorted(rows, key=lambda x:(-x[0], x[1])),1):
    print(f\"{i:02d}\\t{d.get('id')}\\tkey={key}\\ttype={rec.get('id_type')}\\tpmid={rec.get('pmid')}\\tnct={rec.get('nct')}\\tyear={rec.get('year')}\\tabs={len(rec.get('abstract') or '')}\\tpubtypes={';'.join(rec.get('pubtypes') or [])}\\ttitle={rec.get('title')}\")
