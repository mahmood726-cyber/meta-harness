    'WRONG_POPULATION',
    'WRONG_INTERVENTION',
    'WRONG_COMPARATOR',
    'WRONG_OUTCOME_ONLY',
    'DUPLICATE_OF_ACCOUNTED',
    'UNDECIDABLE_FROM_RECORD',
    'REGISTRY_ONLY_NO_PUBLICATION',
    'NOT_VERIFIED_CAP',
}

def normalize_text(text):
    return re.sub(r'\\s+', ' ', text or '').strip()

def extract_quote(rec, marker):
    title = rec.get('title') or ''
    abstract = rec.get('abstract') or ''
    for source in (abstract, title):
        text = normalize_text(source)
        lower = text.lower()
        idx = lower.find(marker.lower())
        if idx == -1:
            continue
        # Prefer a sentence-sized contiguous span from the snapshot text.
        start_candidates = [text.rfind('. ', 0, idx), text.rfind('? ', 0, idx), text.rfind('"'! '"', 0, idx)]
        start = max(start_candidates)
        start = 0 if start == -1 else start + 2
        end_positions = [pos for pos in (text.find('. ', idx), text.find('? ', idx), text.find('"'! '"', idx)) if pos "'!= -1]
        end = min(end_positions) + 1 if end_positions else len(text)
        quote = text[start:end].strip()
        if len(quote) > 300:
            center = idx
            start = max(0, center - 135)
            end = min(len(text), center + len(marker) + 135)
            quote = text[start:end].strip()
        if len(quote) > 300:
            quote = quote[:300].rstrip()
        return quote
    raise AssertionError(f"marker not found for {rec.get('"'id')}: {marker}\")

def registry_quote(rec):
    parts = [
        f\"study_type={rec.get('study_type', '')}\",
        f\"allocation={rec.get('allocation', '')}\",
        f\"masking={rec.get('masking', '')}\",
        f\"has_results={rec.get('has_results', '')}\",
        'conditions=' + ' | '.join(rec.get('conditions') or []),
        'interventions=' + ' | '.join(rec.get('interventions') or []),
    ]
    quote = '; '.join(parts)
    if len(quote) > 300:
        quote = quote[:300].rstrip()
    return quote

out = []
duplicate_pairs = []
for _year, _key, dec, rec in new_rows:
    rid = str(dec.get('id'))
    if rec.get('id_type') == 'nct' and not rec.get('pmid'):
        verdict = 'REGISTRY_ONLY_NO_PUBLICATION'
        quote = registry_quote(rec)
        note = 'NCT-only registry record; snapshot has no publication abstract and no overall-status field.'
        dup_target = None
    else:
        if rid not in specs:
            raise AssertionError(f'missing verdict spec for {rid}')
        verdict, marker, note, dup_target = specs[rid]
        quote = extract_quote(rec, marker)
    if verdict not in valid_verdicts:
        raise AssertionError(f'invalid verdict {verdict}')
    if verdict not in {'UNDECIDABLE_FROM_RECORD', 'NOT_VERIFIED_CAP'} and not quote:
