def normalize_text(text):
    return re.sub(r'\\s+', ' ', text or '').strip()

def extract_quote(rec, marker):
    title = rec.get('title') or ''
    abstract = rec.get('abstract') or ''
    for source in (abstract, title):
        text = normalize_text(source)
        lower = text.lower()
        idx = lower.find(marker.lower())
        if idx == -1:
            continue
        start_candidates = [text.rfind('. ', 0, idx), text.rfind('? ', 0, idx), text.rfind('"'! '"', 0, idx)]
        start = max(start_candidates)
        start = 0 if start == -1 else start + 2
        end_positions = [pos for pos in (text.find('. ', idx), text.find('? ', idx), text.find('"'! '"', idx)) if pos "'!= -1]
        end = min(end_positions) + 1 if end_positions else len(text)
        quote = text[start:end].strip()
        if len(quote) > 300:
            start = max(0, idx - 135)
            end = min(len(text), idx + len(marker) + 135)
            quote = text[start:end].strip()
        if len(quote) > 300:
            quote = quote[:300].rstrip()
        return quote
    raise AssertionError(f"marker not found for {rec.get('"'id')}: {marker}\")

def registry_quote(rec):
    parts = [
        f\"study_type={rec.get('study_type', '')}\",
        f\"allocation={rec.get('allocation', '')}\",
        f\"masking={rec.get('masking', '')}\",
        f\"has_results={rec.get('has_results', '')}\",
        'conditions=' + ' | '.join(rec.get('conditions') or []),
        'interventions=' + ' | '.join(rec.get('interventions') or []),
    ]
    quote = '; '.join(parts)
    if len(quote) > 300:
        quote = quote[:300].rstrip()
    return quote

