legacy_includes={str(x['id']) for x in screen.run(_dedup(legacy,cfg.get('pivotal_trials')),cfg)['decisions'] if x['decision']=='include'}
r2=json.load(open('cache/pcsk9-mace/snapshots/2026-09-15r2-search_v2/records.json',encoding='utf-8'))
records=r2['records']
rec_by_id={str(r.get('id')):r for r in records}
for r in records:
    for k in ('pmid','nct','doi'):
        if r.get(k): rec_by_id.setdefault(str(r.get(k)), r)
decs=r2['screening']['decisions']
review=json.load(open('docs/reviews/pcsk9-mace/review.json',encoding='utf-8'))
accounted=set(legacy_includes)
for out in review.get('outcomes',[]):
    for t in out.get('trials') or []:
        vals=[t.get('label'), t.get('id')]
        for v in vals:
            if v:
                accounted.add(str(v).replace('PMID ','').strip())
    for t in out.get('declared_absent_trials') or []:
        vals=[t.get('label'), t.get('id')]
        for v in vals:
            if v:
                accounted.add(str(v).replace('PMID ','').strip())
inc=[]
old=[]
new=[]
for d in decs:
    if d.get('decision')"'!='"'include':
        continue
    rec=rec_by_id.get(str(d.get('id')), {})
    key=str(rec.get('pmid') or rec.get('nct') or rec.get('doi') or d.get('id'))
    row=(d,rec,key)
    inc.append(row)
    if key in accounted:
        old.append(row)
    else:
        new.append(row)
print('MEASURED n_records',len(records))
print('MEASURED r2_includes',len(inc))
print('MEASURED accounted_keys',sorted(accounted))
print('MEASURED old_count',len(old))
print('MEASURED new_count',len(new))
for d,rec,key in sorted(new, key=lambda x: (-(int(x[1].get('year') or 0)), str(x[1].get('pmid') or x[1].get('nct') or x[1].get('doi') or x[0].get('id')))):
    abs_text=(rec.get('abstract') or '').replace('\\n',' ')
