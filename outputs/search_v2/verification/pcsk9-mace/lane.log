    {
      "limitation_id": "topic:pcsk9-mace:riskofbias:rob-sensitivity",
      "kind": "ROB_SENSITIVITY",
      "limitation_class": "INFORMATIONAL",
      "severity": "QUALIFIES_CLAIM",
      "claim_affected": "risk-of-bias sensitivity interpretation",
      "evidence_state": "PARTIAL",
      "source_fields": [
        "/rob_sensitivity/full",
        "/rob_sensitivity/drop_high",
        "/rob_sensitivity/low_only"
