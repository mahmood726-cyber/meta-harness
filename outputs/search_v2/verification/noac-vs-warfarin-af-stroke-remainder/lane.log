snap=json.load(open(f'cache/{slug}/snapshots/2026-09-15r2-search_v2/records.json',encoding='utf-8'))
records=snap['records']
rec_by_id={str(r.get('id')):r for r in records}
decisions=snap['screening']['decisions']
inc_dec=[d for d in decisions if d.get('decision')=='include']
review=json.load(open(f'docs/reviews/{slug}/review.json',encoding='utf-8'))
accounted=set(str(x) for x in legacy_inc)
# primary outcome only per prompt
for tr in review['outcomes'][0].get('trials',[]):
    accounted.add(str(tr.get('label') or tr.get('id','')).replace('PMID ','').strip())
    accounted.add(str(tr.get('id','')).replace('PMID ','').strip())
for tr in review['outcomes'][0].get('declared_absent_trials',[]):
    accounted.add(str(tr.get('label') or tr.get('id','')).replace('PMID ','').strip())
    accounted.add(str(tr.get('id','')).replace('PMID ','').strip())
def key_for_record(r):
    return str(r.get('pmid') or r.get('nct') or r.get('doi') or r.get('id'))
def key_for_dec(d):
    r=rec_by_id.get(str(d.get('id')),{})
    return key_for_record(r)
new_dec=[d for d in inc_dec if key_for_dec(d) not in accounted]
