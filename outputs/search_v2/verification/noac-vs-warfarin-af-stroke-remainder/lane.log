cap_ids=set(str(x['id']) for x in cap)
print('cap minus generic',len(cap_ids-new_ids),sorted(list(cap_ids-new_ids))[:20])
print('generic minus cap',len(new_ids-cap_ids),sorted(list(new_ids-cap_ids))[:20])
print('generic id_type counts',collections.Counter(rec_by_id[str(d['id'])].get('id_type') for d in new_dec))
print('cap id_type counts',collections.Counter(x.get('id_type') for x in cap))
print('\\nCAP SAMPLE')
for x in cap[:10]:
    print(json.dumps({k:x.get(k) for k in ['id','id_type','pmid','nct','title','year','screen_rule']}, ensure_ascii=False))
print('\\nGENERIC NEW SAMPLE')
for d in new_dec[:10]:
    r=rec_by_id[str(d['id'])]
    print(json.dumps({k:r.get(k) for k in ['id','id_type','pmid','nct','doi','title','year','abstract']}, ensure_ascii=False)[:1000])
    print('decision', d.get('rule_id'), d.get('reason'), d.get('span'))
