def clean(s):
    return re.sub(r'\\s+', ' ', str(s or '')).strip()

def limit_quote(s, n=300):
    s=clean(s)
    if len(s)<=n:
        return s
    return s[:n-1].rstrip() + '…'

def span_around(text, patterns):
    text=clean(text)
    low=text.lower()
    for pat in patterns:
        idx=low.find(pat.lower())
        if idx>=0:
            start=max(0, idx-90)
            end=min(len(text), idx+len(pat)+190)
            # soften to word edges
            return limit_quote(text[start:end].strip(' ;,.-'))
    return limit_quote(text)

def title_quote(r):
    return limit_quote(r.get('title',''))

def registry_quote(r):
    cond=', '.join(r.get('conditions') or [])
    intr=', '.join(r.get('interventions') or [])
    status=r.get('overall_status') or r.get('status') or 'status not present in snapshot'
    q=f\"status: {status}; conditions: {cond}; interventions: {intr}; allocation: {r.get('allocation','')}; results: {r.get('has_results')}\"
    return limit_quote(q)

def note_for_not_rct(r):
    title=r.get('title','')
    nct=r.get('nct','')
    if nct in trial_by_nct:
        return f\"Secondary/subgroup/ancillary analysis of already-accounted trial(s): {trial_by_nct[nct]}.\"
    for pat,name in trial_name_patterns.items():
        if pat.lower() in title.lower() or pat.lower() in clean(r.get('abstract','')).lower():
            return f\"Secondary/subgroup/ancillary analysis of already-accounted trial(s): {name}.\"
    tl=title.lower()
    ab=clean(r.get('abstract','')).lower()
    if 'j-rocket' in tl or 'j-rocket' in ab:
        return \"Secondary/subgroup analysis of J-ROCKET AF rather than a new primary RCT report.\"
    if any(k in tl for k in ['cost-effectiveness','economic','representativeness']) or any(k in ab for k in ['markov model','decision analytic','cross-sectional','real-world','claims data','database analysis','decision aid']):
        return \"The record is observational, review/model/economic, registry, protocol/design, or secondary rather than a new primary RCT.\"
    if any(k in tl for k in ['rationale and design','design and rationale']) or any(k in ab for k in ['rationale and design','study design:', 'will be randomized', 'will determine']):
        return \"Protocol/design report rather than a completed outcome report.\"
    return \"The record is observational, review/model/economic, registry, protocol/design, or secondary rather than a new primary RCT.\"

def quote_for_not_rct(r):
    rid=str(r['id'])
    if rid in quote_overrides:
        return limit_quote(quote_overrides[rid])
    text=clean(r.get('abstract',''))
    title=r.get('title','')
    # Prefer title when it contains the decisive label.
    title_keys=['subgroup analysis','secondary analysis','insights from','cost-effectiveness','rationale and design','design and rationale','real-world','cross-sectional','decision aid','pharmacokinetics','risk assessment','predictor','outcomes of discontinuing','temporary interruption','intracranial hemorrhage','gastrointestinal bleeding','major bleeding']
    if any(k in title.lower() for k in title_keys):
        return title_quote(r)
    return span_around(text or title, ['Markov model','decision analytic','cross-sectional','real-world','claims data','paper under evaluation','subgroup analysis','secondary analysis','post-hoc analysis','data from','rationale and design','protocol','model'])

def quote_for_wrong(r, kind):
    rid=str(r['id'])
    if rid in quote_overrides:
        return limit_quote(quote_overrides[rid])
    if kind=='pop':
        return span_around((r.get('abstract') or '') + ' ' + (r.get('title') or ''), ['percutaneous coronary intervention','valvular disease','mitral','aortic valve'])
    return span_around((r.get('abstract') or '') + ' ' + (r.get('title') or ''), ['aspirin','acetylsalicylic','antiplatelet','no antithrombotic','rivaroxaban or dabigatran'])

