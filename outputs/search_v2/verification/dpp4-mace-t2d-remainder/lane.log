    '20463416':'Rationale/review article, not a randomized trial report.'
}
wrong_population={'20637971':'Healthy adult male Japanese volunteers, not adults with type 2 diabetes.'}
registry_only={'NCT01703286','NCT00614939','NCT00870194'}

def norm(s): return re.sub(r'\\s+',' ', s or '').strip()
def sentences(text):
    text=norm(text)
    if not text: return []
    return [p.strip() for p in re.split(r'(?<=[."'!?])'"\\s+(?=[A-Z0-9(])', text) if p.strip()]
def clipped(s, max_len=300):
    s=norm(s)
    if len(s)<=max_len: return s
    cut=s[:max_len]
    for sep in ['; ', '. ', ', ', ' ']:
        idx=cut.rfind(sep)
        if idx>=180: return cut[:idx+len(sep)-1].strip()
    return cut.strip()
def find_by_priority(abst, groups):
    sents=sentences(abst)
    for group in groups:
        for sent in sents:
            low=sent.lower()
            if all(p.lower() in low for p in group):
                return sent
    return sents[0] if sents else ''
def eligible_quote(r):
    groups=[
        ['primary', 'hba1c'], ['primary', 'a1c'], ['primary', 'glucose'], ['primary', 'pharmacokinetic'], ['primary', 'endpoint'], ['primary', 'outcome'],
        ['randomized', 'placebo'], ['randomised', 'placebo'], ['random', 'placebo'], ['double-blind', 'placebo'], ['double-blinded', 'placebo'],
        ['objective'], ['aim']
    ]
    return clipped(find_by_priority(r.get('abstract') or '', groups) or r.get('title',''))
def quote_for(rid, r, verdict):
    abst=r.get('abstract') or ''
    if verdict=='NOT_RCT':
        if rid=='21323504': return clipped(find_by_priority(abst, [['retrospective subgroup analysis'], ['five randomized']]))
        if rid=='21680990': return clipped(find_by_priority(abst, [['post-hoc subanalysis'], ['pooled safety']]))
        if rid=='20463416': return clipped(r.get('title') or find_by_priority(abst, [['rationale'], ['management']]))
    if verdict=='WRONG_POPULATION':
        return clipped(r.get('title') or find_by_priority(abst, [['healthy adult male Japanese volunteers'], ['healthy volunteers']]))
    if verdict=='ELIGIBLE_RCT_NO_PRIMARY':
        return eligible_quote(r)
    raise AssertionError(verdict)
def ctgov_quote(nct):
    data=json.load(open(raw_dir/f'{nct}.json',encoding='utf-8'))
    ps=data.get('protocolSection',{})
    status=ps.get('statusModule',{}).get('overallStatus','')
    cond=', '.join(ps.get('conditionsModule',{}).get('conditions') or [])
    intr=', '.join(i.get('name','') for i in ps.get('armsInterventionsModule',{}).get('interventions',[]) if i.get('name'))
    return clipped(f'overallStatus={status}; conditions={cond}; interventions={intr}')

rows=[]
for x in capped:
    rid=str(x['id']); r=records[rid]; d=decisions[rid]
    if rid in registry_only:
        verdict='REGISTRY_ONLY_NO_PUBLICATION'; quote=ctgov_quote(rid); quote_source=f'ctgov api (lane_v/{slug}-raw/{rid}.json)'; note='NCT-only registry record with no PMID in the snapshot.'
    elif rid in not_rct:
        verdict='NOT_RCT'; quote=quote_for(rid,r,verdict); quote_source='snapshot abstract'; note=not_rct[rid]
    elif rid in wrong_population:
        verdict='WRONG_POPULATION'; quote=quote_for(rid,r,verdict); quote_source='snapshot abstract'; note=wrong_population[rid]
    else:
        verdict='ELIGIBLE_RCT_NO_PRIMARY'; quote=quote_for(rid,r,verdict); quote_source='snapshot abstract'; note=''
    rows.append({'id':rid,'id_type':r.get('id_type') or x.get('id_type') or '', 'pmid':r.get('pmid') or x.get('pmid') or '', 'nct':r.get('nct') or x.get('nct') or '', 'title':r.get('title') or x.get('title') or '', 'year':str(r.get('year') or x.get('year') or ''), 'verdict':verdict, 'quote':quote, 'quote_source':quote_source, 'screen_rule':d.get('rule_id',''), 'screen_agrees':verdict.startswith('ELIGIBLE'), 'note':note})

inc=[d for d in r2['screening']['decisions'] if d.get('decision')=='include']; n_records=len(r2['records']); n_inc=len(inc)
legacy_includes={'23992601','23992602','26052984','28893244','30418475'}
rev=json.load(open(root/'docs'/'reviews'/slug/'review.json',encoding='utf-8'))
accounted=set(legacy_includes)
for t in rev.get('outcomes',[{}])[0].get('trials',[]):
