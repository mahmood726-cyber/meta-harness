    print('\\n###', i, rid, 'type', x.get('id_type'), 'year', x.get('year'), 'nct', x.get('nct'))
    print('TITLE:', (r or x).get('title'))
    print('DECISION:', d.get('rule_id') if d else None, d.get('reason') if d else None)
    if r:
        abst=(r.get('abstract') or '').replace('\\n',' ')
