        print('ABSTRACT:', abst[:1200])
        if r.get('id_type')=='nct':
            for k in ['overall_status','conditions','interventions','brief_summary','study_type','phases','design']:
                if k in r: print(k.upper()+':', r.get(k))
            # list keys maybe
            print('NCT_KEYS', sorted(r.keys()))
