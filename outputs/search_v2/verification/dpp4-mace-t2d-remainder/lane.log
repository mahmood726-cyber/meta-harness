    if label: accounted.add(label)
def key_for_decision(d):
    rid=str(d.get('id') or ''); rec=records.get(rid,{})
    return str(rec.get('pmid') or rec.get('nct') or rec.get('doi') or rid)
n_old=sum(1 for d in inc if key_for_decision(d) in accounted); full_new=n_inc-n_old
