def compact(text):
    text=re.sub(r'\\s+',' ',text or '').strip()
    parts=re.split(r'(?<=[."'!?])'"\\s+(?=[A-Z(])', text)
    keep=[]
    for p in parts:
        lp=p.lower()
        if len(keep)<2 or any(k in lp for k in ['random','double-blind','placebo','primary','endpoint','objective','aim','method','conclusion','trial']):
            keep.append(p)
        if len(' '.join(keep))>900: break
    return ' '.join(keep)[:1200]
