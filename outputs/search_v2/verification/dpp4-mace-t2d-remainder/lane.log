import json, sys
from pathlib import Path
sys.path.insert(0,'.')
from harness import screen
from harness.pipeline import _dedup
root=Path('.')
slug='dpp4-mace-t2d'
cfg=json.load(open(root/'topics'/f'{slug}.json',encoding='utf-8'))
legacy_records=json.load(open(root/'cache'/slug/'records.json',encoding='utf-8'))
legacy_m=_dedup(legacy_records, cfg.get('pivotal_trials'))
legacy_includes=sorted(x['id'] for x in screen.run(legacy_m,cfg)['decisions'] if x['decision']=='include')
r2=json.load(open(root/'cache'/slug/'snapshots'/'2026-09-15r2-search_v2'/'records.json',encoding='utf-8'))
records=r2['records'] if isinstance(r2,dict) and 'records' in r2 else r2
screening=(r2.get('screening') or {}).get('decisions') or r2.get('decisions') or []
inc=[d for d in screening if d.get('decision')=='include']
rev=json.load(open(root/'docs'/'reviews'/slug/'review.json',encoding='utf-8'))
print('legacy_includes', len(legacy_includes), legacy_includes)
print('r2 records', len(records), 'r2 includes', len(inc))
# find outcome trials and declared absent roughly
import collections
print('review keys top', sorted(rev.keys())[:50])
# recursive find keys named trials/declared_absent_trials
matches=[]
def walk(obj,path=''):
    if isinstance(obj,dict):
        for k,v in obj.items():
            if k in ('trials','declared_absent_trials'):
                matches.append((path+'/'+k, type(v).__name__, len(v) if hasattr(v,'__len__') else None, v if len(str(v))<1000 else str(v)[:1000]))
            walk(v,path+'/'+k)
    elif isinstance(obj,list):
        for i,v in enumerate(obj[:20]):
            walk(v,path+f'[{i}]')
walk(rev)
for m in matches[:20]:
    print('MATCH', m[0], m[1], m[2], m[3])
first=json.load(open(Path(r'C:/meta-harness/outputs/search_v2/verification/dpp4-mace-t2d/dpp4-mace-t2d.json'),encoding='utf-8'))
capped=[x for x in first if x.get('verdict')=='NOT_VERIFIED_CAP']
print('first lane total', len(first), 'capped', len(capped))
print('capped ids first/last', [x['id'] for x in capped[:10]], [x['id'] for x in capped[-10:]])
