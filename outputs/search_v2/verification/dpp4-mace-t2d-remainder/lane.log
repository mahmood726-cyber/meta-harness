"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "@'
import json, re
from pathlib import Path
from collections import Counter

slug='dpp4-mace-t2d'
root=Path('.')
out_dir=root/'lane_v'
raw_dir=out_dir/f'{slug}-raw'
out_dir.mkdir(exist_ok=True)
raw_dir.mkdir(parents=True, exist_ok=True)

r2=json.load(open(root/'cache'/slug/'snapshots'/'2026-09-15r2-search_v2'/'records.json',encoding='utf-8'))
records={str(r.get('id')):r for r in r2['records']}
decisions={str(d.get('id')):d for d in r2['screening']['decisions']}
first=json.load(open(Path(r'C:/meta-harness/outputs/search_v2/verification/dpp4-mace-t2d/dpp4-mace-t2d.json'),encoding='utf-8'))
capped=[x for x in first if x.get('verdict')=='NOT_VERIFIED_CAP']

not_rct={
    '21323504':'Retrospective subgroup analysis of five saxagliptin phase 3 trials, not a primary trial report.',
    '21680990':'Post-hoc subanalysis pooling three saxagliptin phase 3 studies, not a primary trial report.',
    '20463416':'Rationale/review article, not a randomized trial report.'
}
wrong_population={
    '20637971':'Healthy adult male Japanese volunteers, not adults with type 2 diabetes.'
}
registry_only={'NCT01703286','NCT00614939','NCT00870194'}

def norm(s):
    return re.sub(r'\\s+',' ', s or '').strip()

def sentences(text):
    text=norm(text)
    if not text:
        return []
    parts=re.split(r'(?<=[."'!?])'"\\s+(?=[A-Z0-9(])', text)
    return [p.strip() for p in parts if p.strip()]

def clipped(s, max_len=300):
    s=norm(s)
    if len(s) <= max_len:
        return s
    cut=s[:max_len]
    # prefer a clean boundary but keep a verbatim substring (no ellipsis)
    for sep in ['; ', '. ', ', ', ' ']:
        idx=cut.rfind(sep)
        if idx >= 180:
            return cut[:idx+len(sep)-1].strip()
    return cut.strip()

def find_sentence(abst, patterns):
    for sent in sentences(abst):
        low=sent.lower()
        if all(p.lower() in low for p in patterns):
            return sent
    return ''

def find_any(abst, groups):
    sents=sentences(abst)
    for sent in sents:
        low=sent.lower()
        for group in groups:
            if all(p.lower() in low for p in group):
                return sent
    return sents[0] if sents else ''

def eligible_quote(r):
    abst=r.get('abstract') or ''
    groups=[
        ['primary', 'hba1c'], ['primary', 'a1c'], ['primary', 'glucose'], ['primary', 'pharmacokinetic'],
        ['random', 'placebo'], ['double-blind', 'placebo'], ['randomised', 'placebo'], ['randomized', 'placebo'],
        ['objective'], ['aim']
    ]
    q=find_any(abst, groups)
    if not q:
        q=r.get('title','')
    return clipped(q)

def not_rct_quote(rid, r):
    abst=r.get('abstract') or ''
    if rid=='21323504':
        return clipped(find_any(abst, [['retrospective subgroup analysis'], ['five randomized']]))
    if rid=='21680990':
        return clipped(find_any(abst, [['post-hoc subanalysis'], ['pooled safety']]))
    if rid=='20463416':
        return clipped(r.get('title') or find_any(abst, [['rationale'], ['management']]))
    return clipped(r.get('title') or abst)

def wrong_population_quote(r):
    title=r.get('title') or ''
    if 'healthy adult male Japanese subjects' in title:
        return clipped(title)
    return clipped(find_any(r.get('abstract') or '', [['healthy adult male Japanese volunteers'], ['healthy volunteers']]) or title)

def ctgov_quote(nct):
    data=json.load(open(raw_dir/f'{nct}.json',encoding='utf-8'))
    ps=data.get('protocolSection',{})
    status=ps.get('statusModule',{}).get('overallStatus','')
    cond=', '.join(ps.get('conditionsModule',{}).get('conditions') or [])
    intr=', '.join(i.get('name','') for i in ps.get('armsInterventionsModule',{}).get('interventions',[]) if i.get('name'))
    return clipped(f'overallStatus={status}; conditions={cond}; interventions={intr}')

rows=[]
for x in capped:
    rid=str(x['id'])
    r=records[rid]
    d=decisions[rid]
    if rid in registry_only:
        verdict='REGISTRY_ONLY_NO_PUBLICATION'
        quote=ctgov_quote(rid)
        quote_source=f'ctgov api (lane_v/{slug}-raw/{rid}.json)'
        note='NCT-only registry record with no PMID in the snapshot.'
    elif rid in not_rct:
        verdict='NOT_RCT'
        quote=not_rct_quote(rid, r)
        quote_source='snapshot abstract'
        note=not_rct[rid]
    elif rid in wrong_population:
        verdict='WRONG_POPULATION'
        quote=wrong_population_quote(r)
        quote_source='snapshot abstract'
        note=wrong_population[rid]
    else:
        verdict='ELIGIBLE_RCT_NO_PRIMARY'
        quote=eligible_quote(r)
        quote_source='snapshot abstract'
        note=''
    row={
        'id': rid,
        'id_type': r.get('id_type') or x.get('id_type') or '',
        'pmid': r.get('pmid') or x.get('pmid') or '',
        'nct': r.get('nct') or x.get('nct') or '',
        'title': r.get('title') or x.get('title') or '',
        'year': str(r.get('year') or x.get('year') or ''),
        'verdict': verdict,
        'quote': quote,
        'quote_source': quote_source,
        'screen_rule': d.get('rule_id',''),
        'screen_agrees': verdict.startswith('ELIGIBLE'),
        'note': note,
    }
    rows.append(row)

# Measured population counts.
inc=[d for d in r2['screening']['decisions'] if d.get('decision')=='include']
n_records=len(r2['records'])
n_inc=len(inc)
legacy_includes={'23992601','23992602','26052984','28893244','30418475'}
rev=json.load(open(root/'docs'/'reviews'/slug/'review.json',encoding='utf-8'))
accounted=set(legacy_includes)
for t in rev.get('outcomes',[{}])[0].get('trials',[]):
    label=str(t.get('label') or t.get('id') or '').replace('PMID ','').strip()
    if label:
        accounted.add(label)
for t in rev.get('outcomes',[{}])[0].get('declared_absent_trials',[]):
    label=str(t.get('label') or t.get('id') or '').replace('PMID ','').strip()
    if label:
        accounted.add(label)
def key_for_decision(d):
    rid=str(d.get('id') or '')
    rec=records.get(rid,{})
    return str(rec.get('pmid') or rec.get('nct') or rec.get('doi') or rid)
n_old=sum(1 for d in inc if key_for_decision(d) in accounted)
full_new=n_inc-n_old

counts=Counter(r['verdict'] for r in rows)
N=len(rows)
wrong=sum(counts[v] for v in ['WRONG_POPULATION','WRONG_INTERVENTION','WRONG_COMPARATOR','WRONG_OUTCOME_ONLY'])
first_line=(
    f'W-dpp4-mace-t2d VERDICTS: NEW {N}; '
    f'ELIGIBLE_RCT {counts[\"ELIGIBLE_RCT\"]}; '
    f'ELIGIBLE_RCT_NO_PRIMARY {counts[\"ELIGIBLE_RCT_NO_PRIMARY\"]}; '
    f'NOT_RCT {counts[\"NOT_RCT\"]}; '
    f'WRONG_* {wrong}; '
    f'DUPLICATE_OF_ACCOUNTED {counts[\"DUPLICATE_OF_ACCOUNTED\"]}; '
    f'UNDECIDABLE {counts[\"UNDECIDABLE_FROM_RECORD\"]}; '
    f'NOT_VERIFIED_CAP {counts[\"NOT_VERIFIED_CAP\"]}; '
    f'REGISTRY_ONLY {counts[\"REGISTRY_ONLY_NO_PUBLICATION\"]}'
)
agreed=sum(1 for r in rows if r['screen_agrees'])

commands=[
    r'Get-Content -LiteralPath .\\LANE_PROMPT.md',
    r'git status --short',
    r'Get-Content -LiteralPath F:\\ProjectIndex\\INDEX.md',
    r'Get-Content -LiteralPath F:\\E156\\rewrite-workbook.txt',
