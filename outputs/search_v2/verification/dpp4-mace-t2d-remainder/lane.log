    r'python - (measured legacy includes, r2 includes, accounted trials, first-lane NOT_VERIFIED_CAP count)',
    r'python - (inspected all first-lane NOT_VERIFIED_CAP records against r2 snapshot abstracts)',
    r'rg -n \"NCT01703286|NCT00614939|NCT00870194\" .',
    r'Get-ChildItem -LiteralPath .\\cache\\dpp4-mace-t2d -Recurse -File | Select-Object -ExpandProperty FullName',
    r'python - (checked retrieval_ledger.json for NCT registry metadata)',
    r'python - (checked raw/INDEX.json for CT.gov raw call metadata)',
