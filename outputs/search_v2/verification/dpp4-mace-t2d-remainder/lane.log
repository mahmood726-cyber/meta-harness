ids={'NCT01703286','NCT00614939','NCT00870194'}
found=[]
def walk(obj,path=''):
    if isinstance(obj,dict):
        for n in ids:
            if n in obj:
                found.append((path+'/'+n, obj[n]))
        for k,v in obj.items():
            if isinstance(v,(dict,list)):
                walk(v,path+'/'+str(k))
    elif isinstance(obj,list):
        for i,v in enumerate(obj):
            if isinstance(v,(dict,list)):
                walk(v,path+f'[{i}]')
walk(led)
for path,val in found[:10]:
    print('PATH', path, 'TYPE', type(val).__name__)
