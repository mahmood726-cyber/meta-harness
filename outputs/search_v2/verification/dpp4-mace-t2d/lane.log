def clean(s):
    return re.sub(r'\\s+', ' ', str(s or '')).strip()

def truncate(s,n=300):
    s=clean(s)
    return s if len(s)<=n else s[:n-1].rstrip()+'…'

def sentences(text):
    return [clean(s) for s in re.split(r'(?<=[."'!?])'"\\s+', clean(text)) if clean(s)]

def pick_span(text, keywords, fallback_title=''):
    sents=sentences(text)
    keys=[k.lower() for k in keywords]
    for s in sents:
        low=s.lower()
        if all(k in low for k in keys):
            return truncate(s)
    for s in sents:
        low=s.lower()
        if any(k in low for k in keys):
            return truncate(s)
    return truncate(fallback_title or text)

def eligible_quote(r):
    ab=clean(r.get('abstract'))
    sents=sentences(ab)
    q=''
    for s in sents:
        low=s.lower()
        if ('random' in low or 'assigned' in low or 'crossover' in low) and 'placebo' in low:
            q=s; break
    if not q:
        for s in sents:
            low=s.lower()
            if 'placebo' in low and any(drug in low for drug in ['sitagliptin','saxagliptin','alogliptin','linagliptin','dpp-4','dpp4','omarigliptin','fotagliptin','trelagliptin','syr-472','gemigliptin','imigliptin']):
                q=s; break
    endpoint=''
    for s in sents:
        low=s.lower()
        if 'primary' in low and any(k in low for k in ['hba1c','glycat','albumin','glucose','pulse','endothelial','gastric','blood pressure','β-cell','beta-cell','renal','hepatic','dpp-4 inhibition','proteinuria','bone','oxidative','cardiac','hyperglycaemia','hyperglycemia']):
            endpoint=s; break
    if endpoint and endpoint "'!= q:
        combined=clean(q+'"' '+endpoint)
        if len(combined)<=300:
            return combined
    return truncate(q or ab or r.get('title'))

def registry_quote(nct, r):
    body=registry_bodies.get(nct,{})
    proto=body.get('protocolSection',{}) if isinstance(body,dict) else {}
    status=(((proto.get('statusModule') or {}).get('overallStatus')) or '')
    conds=(proto.get('conditionsModule') or {}).get('conditions') or r.get('conditions') or []
    arms=[]
    for arm in (proto.get('armsInterventionsModule') or {}).get('interventions') or []:
        name=arm.get('name')
        if name: arms.append(name)
    if not arms: arms=r.get('interventions') or []
    if status:
        return truncate(f'overallStatus={status}; conditions={\", \".join(conds)}; interventions={\", \".join(arms)}')
    return truncate(f'conditions={\", \".join(conds)}; interventions={\", \".join(arms)}; allocation={r.get(\"allocation\")}; masking={r.get(\"masking\")}; has_results={r.get(\"has_results\")}')

def quote_for(idx, verdict, d, r):
    title=r.get('title') or ''
    ab=r.get('abstract') or ''
    both=title+'. '+ab
    low=both.lower()
    if verdict=='NOT_VERIFIED_CAP': return '', 'snapshot abstract'
    if verdict=='REGISTRY_ONLY_NO_PUBLICATION':
        nct=r.get('nct') or r.get('id')
        return registry_quote(nct,r), f'ctgov api (lane_v/{SLUG}-raw/{nct}.json)'
    if verdict.startswith('ELIGIBLE'):
        return eligible_quote(r), 'snapshot abstract'
    if verdict=='DUPLICATE_OF_ACCOUNTED':
        for marker in ['CARMELINA','EXAMINE','TECOS','SAVOR']:
            if marker.lower() in low:
                return pick_span(both,[marker],title), 'snapshot abstract'
        return truncate(title), 'snapshot abstract'
    if verdict=='WRONG_POPULATION':
        return pick_span(both,['children','pediatric','youth','aged 10','10 to 17','young people'],title), 'snapshot abstract'
    if verdict=='WRONG_INTERVENTION':
        for keys in [
            ['background','sitagliptin'],['receiving','sitagliptin'],['receiving','dpp-4'],['add-on','dpp-4'],['add-on','sitagliptin'],['dapagliflozin','saxagliptin'],['empagliflozin','placebo'],['ertugliflozin','sitagliptin'],['ipragliflozin','placebo'],['canagliflozin','placebo'],['imeglimin','placebo'],['pioglitazone','alogliptin'],['gsk263','sitagliptin']
        ]:
            q=pick_span(both,keys,'')
            if q: return q, 'snapshot abstract'
        return truncate(title), 'snapshot abstract'
    if verdict=='WRONG_COMPARATOR':
        for keys in [['active placebo'],['linagliptin monotherapy'],['saxagliptin','dapagliflozin'],['oral placebo','sc placebo'],['sitagliptin','glimepiride'],['compared with placebo and sitagliptin']]:
            q=pick_span(both,keys,'')
            if q: return q, 'snapshot abstract'
        return truncate(title), 'snapshot abstract'
    if verdict=='NOT_RCT':
        for keys in [['post hoc'],['post-hoc'],['pooled analysis'],['subanalysis'],['sub-analysis'],['extension study'],['rationale and design'],['open-label'],['design and baseline'],['reconstructed individual patient data'],['pooled data']]:
            q=pick_span(both,keys,'')
            if q: return q, 'snapshot abstract'
        return truncate(title), 'snapshot abstract'
    return truncate(title or ab), 'snapshot abstract'

