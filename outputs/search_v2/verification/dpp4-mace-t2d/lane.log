import json, re, sys
sys.path.insert(0,'.')
from harness import screen
from harness.pipeline import _dedup
cfg=json.load(open('topics/dpp4-mace-t2d.json',encoding='utf-8'))
legacy=json.load(open('cache/dpp4-mace-t2d/records.json',encoding='utf-8'))
legacy_inc=set(x['id'] for x in screen.run(_dedup(legacy,cfg.get('pivotal_trials')),cfg)['decisions'] if x['decision']=='include')
review=json.load(open('docs/reviews/dpp4-mace-t2d/review.json',encoding='utf-8'))
def norm_id(s):
    s=str(s or '').strip(); m=re.search(r'PMID\\s*([0-9]+)',s,re.I)
    if m: return m.group(1)
    m=re.search(r'(NCT[0-9]+)',s,re.I)
    return m.group(1).upper() if m else s
accounted={norm_id(x) for x in legacy_inc}
for out in review.get('outcomes',[]):
    for t in (out.get('trials') or [])+(out.get('declared_absent_trials') or []): accounted.add(norm_id(t.get('label') or t.get('id')))
snap=json.load(open('cache/dpp4-mace-t2d/snapshots/2026-09-15r2-search_v2/records.json',encoding='utf-8'))
recs={str(r['id']):r for r in snap['records']}
def key_for(r): return norm_id(r.get('pmid') or r.get('nct') or r.get('doi') or r.get('id'))
def sort_key(x):
    d,r=x; y=int(r.get('year') or 0) if str(r.get('year') or '').isdigit() else 0; p=int(r.get('pmid')) if str(r.get('pmid') or '').isdigit() else 10**12; return (-y,p,str(r.get('id')))
new=sorted([(d,recs[str(d['id'])]) for d in snap['screening']['decisions'] if d.get('decision')=='include' and key_for(recs[str(d['id'])]) not in accounted], key=sort_key)
for i,(d,r) in enumerate(new[90:120],91):
    ab=(r.get('abstract') or '').replace('\\n',' ')
    print(f'[{i}] {r.get(\"year\")} {r.get(\"pmid\") or r.get(\"nct\") or r.get(\"id\")} NCT={r.get(\"nct\") or \"\"}')
    print('TITLE:',r.get('title'))
    print('PUB:', '; '.join(r.get('pubtypes') or []))
    print('AB:',ab[:1600])
    print()
