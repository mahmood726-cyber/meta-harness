"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "@'
import json
import re
import sys
from collections import Counter
from pathlib import Path
sys.path.insert(0, '.')
from harness import screen
from harness.pipeline import _dedup

slug = 'sglt2-hfref-hosp-cvdeath'
out_json = Path('lane_v/sglt2-hfref-hosp-cvdeath.json')
raw_dir = Path('lane_v/sglt2-hfref-hosp-cvdeath-raw')
report_path = Path('LANE-W-sglt2-hfref-hosp-cvdeath-REPORT.md')

snap = json.load(open(f'cache/{slug}/snapshots/2026-09-15r2-search_v2/records.json', encoding='utf-8'))
records = snap['records']
record_by_id = {r['id']: r for r in records}
decisions = snap['screening']['decisions']
decision_by_id = {d['id']: d for d in decisions}
include_ids = [d['id'] for d in decisions if d.get('decision') == 'include']

cfg = json.load(open(f'topics/{slug}.json', encoding='utf-8'))
legacy = json.load(open(f'cache/{slug}/records.json', encoding='utf-8'))
legacy_decisions = screen.run(_dedup(legacy, cfg.get('pivotal_trials')), cfg)['decisions']
legacy_include_keys = {x['id'] for x in legacy_decisions if x.get('decision') == 'include'}

review = json.load(open(f'docs/reviews/{slug}/review.json', encoding='utf-8'))
primary = review['outcomes'][0]

def norm_id(value):
    if not value:
        return ''
    value = str(value)
    value = re.sub(r'"'^(PMID|NCT)'"\\s+', '', value)
    return value.strip()

pooled_keys = {norm_id(t.get('label') or t.get('id')) for t in primary.get('trials', [])}
declared_absent_keys = {norm_id(t.get('label') or t.get('id')) for t in primary.get('declared_absent_trials', [])}
accounted_keys = set(legacy_include_keys) | pooled_keys | declared_absent_keys

def record_key(r):
    return str(r.get('pmid') or r.get('nct') or r.get('doi') or r.get('id') or '').strip()

r2_include_records = [record_by_id[i] for i in include_ids]
already_accounted = [r for r in r2_include_records if record_key(r) in accounted_keys]
full_new_records = [r for r in r2_include_records if record_key(r) not in accounted_keys]
full_new_ids = {r['id'] for r in full_new_records}

first = json.load(open('C:/meta-harness/outputs/search_v2/verification/sglt2-hfref-hosp-cvdeath/sglt2-hfref-hosp-cvdeath.json', encoding='utf-8'))
caps = [x for x in first if x.get('verdict') == 'NOT_VERIFIED_CAP']
cap_ids = [x['id'] for x in caps]
assert set(cap_ids) <= full_new_ids, sorted(set(cap_ids) - full_new_ids)
N = len(caps)

objects = []
for cap in caps:
    rid = cap['id']
    r = record_by_id[rid]
    d = decision_by_id[rid]
    obj = {
        'id': r.get('id', ''),
        'id_type': r.get('id_type', ''),
        'pmid': str(r.get('pmid') or ''),
        'nct': str(r.get('nct') or ''),
        'title': r.get('title', ''),
        'year': str(r.get('year') or ''),
        'verdict': '',
        'quote': '',
        'quote_source': 'snapshot abstract',
        'screen_rule': d.get('rule_id', ''),
        'screen_agrees': False,
    }
    if rid == '29020355':
        quote = 'patients with type 2 diabetes (T2D) and established CV disease (CVD)'
        assert quote in r.get('abstract', '')
        obj.update({
            'verdict': 'WRONG_POPULATION',
            'quote': quote,
            'note': 'Record population is type 2 diabetes with established cardiovascular disease, not adult HFrEF.'
        })
    elif r.get('id_type') == 'nct' and not r.get('pmid'):
        raw_path = raw_dir / f'{rid}.json'
        raw = json.load(open(raw_path, encoding='utf-8'))
        ps = raw.get('protocolSection', {})
        status = ps.get('statusModule', {}).get('overallStatus', '')
        conditions = ps.get('conditionsModule', {}).get('conditions', [])
        interventions = [x.get('name', '') for x in ps.get('armsInterventionsModule', {}).get('interventions', [])]
        quote = 'overallStatus={}; conditions={}; interventions={}'.format(
            status,
            ' | '.join([c for c in conditions if c]),
            ' | '.join([i for i in interventions if i]),
        )
        assert status, rid
        obj.update({
            'verdict': 'REGISTRY_ONLY_NO_PUBLICATION',
            'quote': quote,
            'note': f'NCT-only registry record has no PMID publication body; CT.gov raw status saved as {raw_path.as_posix()}.'
        })
    else:
        raise AssertionError(f'unhandled cap record {rid}')
    obj['screen_agrees'] = obj['verdict'].startswith('ELIGIBLE')
    objects.append(obj)

valid_verdicts = {
    'ELIGIBLE_RCT', 'ELIGIBLE_RCT_NO_PRIMARY', 'NOT_RCT', 'WRONG_POPULATION',
    'WRONG_INTERVENTION', 'WRONG_COMPARATOR', 'WRONG_OUTCOME_ONLY',
    'DUPLICATE_OF_ACCOUNTED', 'UNDECIDABLE_FROM_RECORD',
    'REGISTRY_ONLY_NO_PUBLICATION', 'NOT_VERIFIED_CAP'
}
for obj in objects:
    assert obj['verdict'] in valid_verdicts, obj
    assert obj['quote'] or obj['verdict'] in {'UNDECIDABLE_FROM_RECORD', 'NOT_VERIFIED_CAP'}, obj['id']
    assert len(obj['quote']) <= 300, (obj['id'], len(obj['quote']))
    assert obj['screen_rule'], obj['id']
assert len(objects) == N

counts = Counter(o['verdict'] for o in objects)
wrong_count = sum(counts[v] for v in ['WRONG_POPULATION', 'WRONG_INTERVENTION', 'WRONG_COMPARATOR', 'WRONG_OUTCOME_ONLY'])
first_line_numbers = [
    counts['ELIGIBLE_RCT'],
    counts['ELIGIBLE_RCT_NO_PRIMARY'],
    counts['NOT_RCT'],
    wrong_count,
    counts['DUPLICATE_OF_ACCOUNTED'],
    counts['UNDECIDABLE_FROM_RECORD'],
    counts['NOT_VERIFIED_CAP'],
    counts['REGISTRY_ONLY_NO_PUBLICATION'],
]
assert sum(first_line_numbers) == N
agreed = sum(1 for o in objects if o['verdict'].startswith('ELIGIBLE'))

out_json.parent.mkdir(parents=True, exist_ok=True)
out_json.write_text(json.dumps(objects, indent=2, ensure_ascii=True) + '\\n', encoding='utf-8')

commands = [
    r'Get-Content -Raw -LiteralPath .\\LANE_PROMPT.md',
