codex
I’m going to create the lane output directory now and save CT.gov raw JSON only for the nine NCT-only remainder records, because their normalized snapshot lacks the status text the prompt requires. The one PMID record already has a decisive snapshot abstract, so I won’t fetch PubMed for it.
exec
"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "@'
import json
import urllib.request
from pathlib import Path
ids = ['NCT03332212','NCT03448419','NCT03030222','NCT03036124','NCT03057977','NCT03128528','NCT03198585','NCT03200860','NCT02653482']
out = Path('lane_v/sglt2-hfref-hosp-cvdeath-raw')
out.mkdir(parents=True, exist_ok=True)
for nct in ids:
    url = f'https://clinicaltrials.gov/api/v2/studies/{nct}'
    req = urllib.request.Request(url, headers={'User-Agent': 'meta-harness-lane-verifier/1.0'})
    with urllib.request.urlopen(req, timeout=30) as resp:
        body = resp.read()
    data = json.loads(body.decode('utf-8'))
    path = out / f'{nct}.json'
    path.write_text(json.dumps(data, indent=2, ensure_ascii=False, sort_keys=True) + '\\n', encoding='utf-8')
    status = data.get('protocolSection', {}).get('statusModule', {}).get('overallStatus')
    conds = data.get('protocolSection', {}).get('conditionsModule', {}).get('conditions', [])
    arms = data.get('protocolSection', {}).get('armsInterventionsModule', {}).get('interventions', [])
    intr = [x.get('name') for x in arms]
    print(nct, status, '|', '; '.join(conds[:3]), '|', '; '.join([x for x in intr if x][:5]))
