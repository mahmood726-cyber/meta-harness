codex
Mid-year scan confirms many are bona fide placebo-controlled GLP-1 trials that simply target HbA1c, kidney, blood pressure, appetite, gastric emptying, or safety outcomes rather than 3-point MACE. I’m going to encode those decisions and then run validation checks for counts, quotes, and schema.
codex
I’m not writing the artifacts yet; first I’m letting the classifier produce a draft verdict ledger and checking the edge cases. Once the schema/quote checks are clean, I’ll write only the three allowed output locations.
exec
"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -NoProfile -Command "@'
import json,re,collections
snap=json.load(open('cache/glp1-ra-mace-t2d/snapshots/2026-09-15r2-search_v2/records.json',encoding='utf-8'))
prev=json.load(open('C:/meta-harness/outputs/search_v2/verification/glp1-ra-mace-t2d/glp1-ra-mace-t2d.json',encoding='utf-8'))
caps=[x['id'] for x in prev if x.get('verdict')=='NOT_VERIFIED_CAP']
recs={r['id']:r for r in snap['records']}
decs={d['id']:d for d in snap['screening']['decisions']}
accounted_nct={
 'NCT01179048':'LEADER accounted PMID 27295427',
 'NCT01720446':'SUSTAIN-6 accounted PMID 27633186',
 'NCT01394952':'REWIND accounted PMID 31189511',
 'NCT01144338':'EXSCEL accounted PMID 28910237',
 'NCT01147250':'ELIXA declared-absent PMID 26630143',
 'NCT02465515':'HARMONY Outcomes accounted PMID 30291013',
 'NCT02692716':'PIONEER 6 accounted PMID 31185157',
 'NCT03496298':'AMPLITUDE-O accounted PMID 34215025',
 'NCT03914326':'SOUL accounted PMID 40162642',
}
acronyms=[('HARMONY Outcomes','HARMONY Outcomes accounted PMID 30291013'),('PIONEER 6','PIONEER 6 accounted PMID 31185157'),('SUSTAIN 6','SUSTAIN-6 accounted PMID 27633186'),('SUSTAIN-6','SUSTAIN-6 accounted PMID 27633186'),('LEADER','LEADER accounted PMID 27295427'),('REWIND','REWIND accounted PMID 31189511'),('EXSCEL','EXSCEL accounted PMID 28910237'),('ELIXA','ELIXA declared-absent PMID 26630143'),('AMPLITUDE-O','AMPLITUDE-O accounted PMID 34215025'),('SOUL','SOUL accounted PMID 40162642')]
not_rct_terms=['post hoc','post-hoc','posthoc','secondary analysis','exploratory analysis','pooled analysis','integrated analysis','subanalysis','sub-analysis','subgroup analysis','subgroup','extension','interim analysis','baseline','predictors','correlates','variables associated','mathematical modeling','rationale and design','design and methods','protocol','real-world','cohort studies','observational','review','meta-analysis','pre-specified secondary study','prespecified secondary']
wrong_pop_terms=['healthy subjects','healthy volunteers','healthy people','healthy male volunteers','children and adolescents','adolescent patients','pediatric','paediatric','youth','young adults','prediabetes','prediabetic','impaired glucose tolerance']
wrong_interv_terms=['insulin degludec/liraglutide','ideglira','insulin glargine/lixisenatide','iglarlixi','cagrilintide-semaglutide','cagrisema','cotadutide','ly3437943','ly3502970','ly3493269','ly3457263','ibi362','bi 456906','tirzepatide','dpp-4 inhibitor, sitagliptin','addition of a dipeptidyl peptidase-4 inhibitor','adding insulin degludec','exenatide plus dapagliflozin','dapagliflozin once daily versus exenatide']
wrong_comp_terms=['versus sitagliptin','versus metformin','versus insulin','versus glimepiride','versus exenatide','versus liraglutide','compared with metformin','compared with placebo or pioglitazone','compared with the lyophilized','non-inferiority','active comparator']
primary_terms=['major adverse cardiovascular','major cardiovascular events','mace','cardiovascular death','nonfatal myocardial infarction','nonfatal stroke','primary composite outcome','cardiovascular outcome']

def sentences(text):
    t=' '.join((text or '').split())
    if not t: return []
    return re.split(r'(?<=[."'!?])'"\\s+(?=[A-Z0-9(])', t)

def trunc(s,n=300):
    s=' '.join((s or '').split())
    return s if len(s)<=n else s[:n-1].rstrip()+'…'

def find_quote(r, terms):
    title=r.get('title') or ''
    text=(r.get('abstract') or '')
    all_s=[title]+sentences(text)
    for term in terms:
        tl=term.lower()
        for s in all_s:
            if tl in s.lower(): return trunc(s)
    for s in all_s:
        if s.strip(): return trunc(s)
    return ''

def classify(r):
    if r.get('id_type')=='nct' and not r.get('pmid'):
        cond=', '.join(r.get('conditions') or [])
        intr=', '.join(r.get('interventions') or [])
        q=trunc(f\"has_results={r.get('has_results')}; allocation={r.get('allocation')}; masking={r.get('masking')}; conditions={cond}; interventions={intr}\")
        return 'REGISTRY_ONLY_NO_PUBLICATION', q, 'Registry-only NCT record; snapshot has no PMID/publication link, and the quote uses structured snapshot fields.'
    title=r.get('title') or ''
    abstract=r.get('abstract') or ''
    text=(title+' '+abstract).lower()
    nct=r.get('nct') or ''
    if nct in accounted_nct:
        return 'DUPLICATE_OF_ACCOUNTED', find_quote(r,[nct]+[a for a,n in acronyms if n in accounted_nct.get(nct,'')]+['trial']), 'Same trial as '+accounted_nct[nct]+'.'
    for acro,note in acronyms:
        if acro.lower() in text:
            # Avoid HARMONY 1/2/3/5 and broad SUSTAIN 1-7 unless exact accounted outcome trial names.
            if acro=='LEADER' and 'leader trial' not in text and 'liraglutide effect and action in diabetes' not in text:
                continue
            if acro in ['SUSTAIN 6','SUSTAIN-6'] and ('sustain 6' not in text and 'sustain-6' not in text):
                continue
            if acro=='HARMONY Outcomes' and 'harmony outcomes' not in text:
                continue
            return 'DUPLICATE_OF_ACCOUNTED', find_quote(r,[acro,'trial']), 'Same trial as '+note+'.'
    if any(t in text for t in not_rct_terms):
        return 'NOT_RCT', find_quote(r,not_rct_terms+['analysis','extension','trial']), 'Secondary/substudy/pooled/protocol/observational record rather than a primary randomized trial report.'
    if any(t in text for t in wrong_pop_terms):
        return 'WRONG_POPULATION', find_quote(r,wrong_pop_terms), 'Record population is not limited to adults with type 2 diabetes.'
    if any(t in text for t in wrong_interv_terms):
        return 'WRONG_INTERVENTION', find_quote(r,wrong_interv_terms), 'Randomized intervention is not an isolated protocol GLP-1 receptor agonist contrast.'
    # active comparator without placebo in title/abstract, after allowing mixed placebo arms
    has_placebo='placebo' in text
    if any(t in text for t in wrong_comp_terms) and not has_placebo:
        return 'WRONG_COMPARATOR', find_quote(r,wrong_comp_terms), 'No placebo comparator is established in the record.'
    if ('random' in text or 'randomized controlled trial' in ';'.join(r.get('pubtypes') or []).lower()) and has_placebo:
        if any(t in text for t in primary_terms):
            return 'ELIGIBLE_RCT', find_quote(r,primary_terms+['randomized','placebo']), ''
        return 'ELIGIBLE_RCT_NO_PRIMARY', find_quote(r,['random','placebo','primary end point','primary endpoint','hba1c','glycaemic','glycemic','efficacy','safety']), 'Eligible P/I/C/design, but the snapshot abstract does not report 3-point MACE.'
    if ('random' in text or 'randomized controlled trial' in ';'.join(r.get('pubtypes') or []).lower()) and not has_placebo:
        return 'WRONG_COMPARATOR', find_quote(r,['versus','compared with','random','controlled trial']), 'Randomized record does not establish a placebo comparator.'
    return 'UNDECIDABLE_FROM_RECORD', find_quote(r,['random','placebo','type 2 diabetes']) or trunc(title), 'The snapshot title and abstract do not settle RCT design, comparator, or outcome.'

rows=[]
for i in caps:
    r=recs[i]
    v,q,n=classify(r)
    rows.append((i,v,q,n,r))
