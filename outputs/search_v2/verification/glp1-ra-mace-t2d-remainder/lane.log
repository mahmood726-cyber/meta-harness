def has_primary(text):
 return any(p in text for p in ['major adverse cardiovascular','major cardiovascular events','cardiovascular death','nonfatal myocardial infarction','non-fatal myocardial infarction','nonfatal stroke','non-fatal stroke','primary composite outcome']) or re.search(r'\\bmace\\b', text) is not None

def sentences(text):
 t=' '.join((text or '').split()); return [] if not t else re.split(r'(?<=[."'!?])'"\\s+(?=[A-Z0-9(])', t)
def trunc(s,n=300):
 s=' '.join((s or '').split()); return s if len(s)<=n else s[:n-1].rstrip()+'…'
def find_quote(r,terms):
 all_s=[r.get('title') or '']+sentences(r.get('abstract') or '')
 for term in terms:
  tl=term.lower()
  for s in all_s:
   if tl in s.lower(): return trunc(s)
 for s in all_s:
  if s.strip(): return trunc(s)
 return ''
def classify(r):
 title=r.get('title') or ''; title_l=title.lower(); abstract=r.get('abstract') or ''; ab_l=abstract.lower(); text=(title+' '+abstract).lower(); nct=r.get('nct') or ''
