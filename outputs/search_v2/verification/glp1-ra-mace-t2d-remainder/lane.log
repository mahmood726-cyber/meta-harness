 if any(t in title_l for t in title_not_rct) or any(t in ab_l for t in abstract_not_rct) or 'review' in ';'.join(r.get('pubtypes') or []).lower():
  return 'NOT_RCT', find_quote(r,title_not_rct+abstract_not_rct+['analysis','extension','trial','areas covered']), 'Secondary/substudy/pooled/protocol/observational record rather than a primary randomized trial report.'
