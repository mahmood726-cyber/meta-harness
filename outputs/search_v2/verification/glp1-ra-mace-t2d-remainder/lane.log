def has_primary(text):
    phrases=['major adverse cardiovascular','major cardiovascular events','cardiovascular death','nonfatal myocardial infarction',
             'non-fatal myocardial infarction','nonfatal stroke','non-fatal stroke','primary composite outcome']
    return any(p in text for p in phrases) or re.search(r'\\bmace\\b', text) is not None

def sentences(text):
    t=' '.join((text or '').split())
    return [] if not t else re.split(r'(?<=[."'!?])'"\\s+(?=[A-Z0-9(])', t)

def trunc(s,n=300):
    s=' '.join((s or '').split())
    return s if len(s)<=n else s[:n-3].rstrip()+'...'

def find_quote(r, terms):
    all_s=[r.get('title') or '']+sentences(r.get('abstract') or '')
    for term in terms:
        tl=term.lower()
        for s in all_s:
            if tl in s.lower():
                return trunc(s)
    for s in all_s:
        if s.strip():
            return trunc(s)
    return ''

def classify(r):
    title=r.get('title') or ''
    title_l=title.lower()
    abstract=r.get('abstract') or ''
    ab_l=abstract.lower()
    text=(title+' '+abstract).lower()
    nct=r.get('nct') or ''
    if r.get('id_type')=='nct' and not r.get('pmid'):
        cond=', '.join(r.get('conditions') or [])
        intr=', '.join(r.get('interventions') or [])
        q=trunc(f\"has_results={r.get('has_results')}; allocation={r.get('allocation')}; masking={r.get('masking')}; conditions={cond}; interventions={intr}\")
        return 'REGISTRY_ONLY_NO_PUBLICATION', q, 'Registry-only NCT record; snapshot has no PMID/publication link, and the quote uses structured snapshot fields.'
    if nct in accounted_nct:
        terms=[nct,'trial']+[a for a,n in title_dup if n==accounted_nct[nct]]
        return 'DUPLICATE_OF_ACCOUNTED', find_quote(r,terms), 'Same trial as '+accounted_nct[nct]+'.'
    for acro,note in title_dup:
        if acro.lower() in title_l:
            if acro=='LEADER' and not ('leader trial' in title_l or 'liraglutide effect and action in diabetes' in title_l):
                continue
            return 'DUPLICATE_OF_ACCOUNTED', find_quote(r,[acro,'trial']), 'Same trial as '+note+'.'
    if any(t in title_l for t in wrong_pop_title_terms) or any(t in ab_l for t in wrong_pop_abstract_terms):
        return 'WRONG_POPULATION', find_quote(r,wrong_pop_title_terms+wrong_pop_abstract_terms), 'Record population is not limited to adults with type 2 diabetes.'
    if any(t in text for t in wrong_interv_terms):
        return 'WRONG_INTERVENTION', find_quote(r,wrong_interv_terms), 'Randomized intervention is not an isolated protocol GLP-1 receptor agonist contrast.'
    if any(t in title_l for t in title_wrong_comp) and 'placebo' not in title_l:
        return 'WRONG_COMPARATOR', find_quote(r,title_wrong_comp+['random','placebo']), 'Title/record establishes an active-comparator contrast rather than GLP-1 RA versus placebo.'
    if any(t in title_l for t in title_not_rct) or any(t in ab_l for t in abstract_not_rct) or 'review' in ';'.join(r.get('pubtypes') or []).lower():
        return 'NOT_RCT', find_quote(r,abstract_not_rct+title_not_rct+['open-label','areas covered','trial']), 'Secondary/substudy/pooled/protocol/observational record rather than a primary randomized trial report.'
    has_placebo='placebo' in text
    if ('random' in text or 'randomized controlled trial' in ';'.join(r.get('pubtypes') or []).lower()) and has_placebo:
        if has_primary(text):
            return 'ELIGIBLE_RCT', find_quote(r,['major adverse cardiovascular','major cardiovascular events','MACE','cardiovascular death','nonfatal myocardial infarction','nonfatal stroke','primary composite outcome','randomized','placebo']), ''
        return 'ELIGIBLE_RCT_NO_PRIMARY', find_quote(r,no_primary_terms), 'Eligible P/I/C/design, but the snapshot abstract does not report 3-point MACE.'
    if ('random' in text or 'randomized controlled trial' in ';'.join(r.get('pubtypes') or []).lower()) and not has_placebo:
        return 'WRONG_COMPARATOR', find_quote(r,['versus','compared with','random','controlled trial']), 'Randomized record does not establish a placebo comparator.'
    return 'UNDECIDABLE_FROM_RECORD', find_quote(r,['random','placebo','type 2 diabetes']) or trunc(title), 'The snapshot title and abstract do not settle RCT design, comparator, or outcome.'

