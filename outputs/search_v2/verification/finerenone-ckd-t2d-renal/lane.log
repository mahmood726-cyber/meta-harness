        raise SystemExit(f'invalid verdict {verdict} for {r[\"id\"]}')
    title = r.get('title') or ''
    abstract = r.get('abstract') or ''
    haystack = title + '\\n' + abstract
    if verdict not in {'UNDECIDABLE_FROM_RECORD', 'NOT_VERIFIED_CAP'} and not quote:
        raise SystemExit(f'missing quote for {r[\"id\"]}')
    if quote and quote not in haystack:
        raise SystemExit(f'quote not found for {r[\"id\"]}: {quote"'!r}'"')
    if len(quote) > 300:
        raise SystemExit(f'quote too long for {r[\"id\"]}: {len(quote)}')
    d = decisions[r['id']]
    objects.append({
