import base64
import json
import subprocess
import sys
from collections import Counter
from pathlib import Path

SLUG = 'sacubitril-valsartan-hfref'
SNAP = Path('cache/sacubitril-valsartan-hfref/snapshots/2026-09-15r2-search_v2/records.json')
TOPIC = Path('topics/sacubitril-valsartan-hfref.json')
LEGACY = Path('cache/sacubitril-valsartan-hfref/records.json')
REVIEW = Path('docs/reviews/sacubitril-valsartan-hfref/review.json')
OUT_DIR = Path('lane_v')
RAW_DIR = OUT_DIR / f'{SLUG}-raw'
CTGOV_RAW = RAW_DIR / 'raw/ctgov_condition_intervention#1/001.json'
OUT_JSON = OUT_DIR / f'{SLUG}.json'
REPORT = Path('LANE-V-sacubitril-valsartan-hfref-REPORT.md')

sys.path.insert(0, '.')
from harness import screen
from harness.pipeline import _dedup

cfg = json.load(open(TOPIC, encoding='utf-8'))
legacy_data = json.load(open(LEGACY, encoding='utf-8'))
legacy_includes = set(
    x['id'] for x in screen.run(_dedup(legacy_data, cfg.get('pivotal_trials')), cfg)['decisions']
    if x['decision'] == 'include'
)

snap = json.load(open(SNAP, encoding='utf-8'))
records = snap['records']
record_by_id = {r['id']: r for r in records}
include_decs = [d for d in snap['screening']['decisions'] if d.get('decision') == 'include']

def rec_key(r):
    return str(r.get('pmid') or r.get('nct') or r.get('doi') or r.get('id'))

def year_num(r):
    try:
        return int(r.get('year') or 0)
    except Exception:
        return 0

review = json.load(open(REVIEW, encoding='utf-8'))
accounted = set(legacy_includes)
pooled_trials = []
declared_absent = []
for outcome in review.get('outcomes', []):
    for t in outcome.get('trials', []):
