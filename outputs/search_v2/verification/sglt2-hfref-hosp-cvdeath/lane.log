new=sorted([r for r in r2['records'] if decs.get(r.get('id'),{}).get('decision')=='include' and key(r) not in accounted], key=lambda r: (-(int(r.get('year') or 0) if str(r.get('year') or '').isdigit() else 0), str(r.get('pmid') or r.get('nct') or r.get('doi') or r.get('id'))))
