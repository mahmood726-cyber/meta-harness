def load_inputs():
    cfg = json.load(open(f'topics/{SLUG}.json', encoding='utf-8'))
    legacy = json.load(open(f'cache/{SLUG}/records.json', encoding='utf-8'))
    legacy_m = _dedup(legacy, cfg.get('pivotal_trials'))
    legacy_inc = set(x['id'] for x in screen.run(legacy_m, cfg)['decisions'] if x['decision'] == 'include')
    review = json.load(open(f'docs/reviews/{SLUG}/review.json', encoding='utf-8'))
    primary = [o for o in review['outcomes'] if o.get('primary')][0]
    r2 = json.load(open(f'cache/{SLUG}/snapshots/2026-09-15r2-search_v2/records.json', encoding='utf-8'))
    return cfg, legacy_inc, review, primary, r2


def norm_id(value):
    return str(value or '').replace('PMID ', '').replace('NCT ', '').strip()


def record_key(record):
    return str(record.get('pmid') or record.get('nct') or record.get('doi') or record.get('id') or '').strip()


def clean(text):
    return re.sub(r'\\s+', ' ', re.sub(r'<["'^>]+>'"', ' ', text or '')).strip()


def has(pattern, text):
    return re.search(pattern, text, re.I) is not None


def truncate(text, limit=300):
    text = clean(text)
    if len(text) <= limit:
        return text
    return text[: limit - 3].rstrip() + '...'


def find_quote(text, patterns):
    text = clean(text)
    if not text:
        return ''
    sentences = re.split(r'(?<=[."'!?])'"\\s+', text)
    for pat in patterns:
        for sent in sentences:
            if re.search(pat, sent, re.I):
                return truncate(sent)
        m = re.search(pat, text, re.I)
        if m:
            start = max(0, m.start() - 120)
            end = min(len(text), m.end() + 170)
            return truncate(text[start:end])
    return truncate(sentences[0] if sentences else text)

WRONG_POP_PAT = (r'PRESERVED-HF|preserved ejection fraction|mildly reduced|improved ejection fraction|'
                 r'LVEF greater than 40|LVEF >40|ejection fraction >40|ejection fraction of 49% or less|'
                 r'ejection fraction ≤50|EF ≤50|risk of heart failure|at risk of HF|without diabetes and HF are lacking|'
                 r'without overt heart failure|primary prevention|type 2 diabetes and (?:in|established)|'
                 r'type 2 diabetes mellitus and atherosclerotic|DECLARE-TIMI|acute heart failure|acute decompensated heart failure|'
                 r'regardless of (?:left ventricular )?ejection fraction|pulmonary arterial hypertension|hypertrophic cardiomyopathy|'
                 r'breast cancer|congenital heart disease|end stage renal disease')
NOT_RCT_PAT = (r'meta-analysis|systematic review|plain language summary|expert perspective|position paper|porcine|pigs|rats|mice|'
               r'protocol-only|This is a randomized.*will elucidate|Ongoing event-driven trials|will be included')
SECONDARY_PAT = (r'post hoc|post-hoc|secondary analysis|substudy|sub-study|subanalysis|sub-analysis|exploratory analysis|'
                 r'prespecified analysis|pre-specified analysis|An analysis of|analysis from|data from|Findings From|Insights From|'
                 r'biomarker substudy|proteomics|mechanistic insights')


def classify(record, index):
    title = clean(record.get('title'))
    abstract = clean(record.get('abstract'))
    text = f'{title}. {abstract}'
    nct = record.get('nct') or ''
    if index > 150:
        return 'NOT_VERIFIED_CAP', '', 'Cap applied after sorting by year desc and identifier; this record was not source-verified.'
    if record.get('id_type') == 'nct' and not record.get('pmid'):
        return 'REGISTRY_ONLY_NO_PUBLICATION', 'NCT-only registry record, not a publication; snapshot has no overall_status field.', 'Snapshot registry row has no PMID/publication body.'
    if nct == 'NCT03036124' or has(r'\\bDAPA-HF\\b|Dapagliflozin (And|and) Prevention of Adverse', text):
        return 'DUPLICATE_OF_ACCOUNTED', 'DAPA-HF / PMID 31535829', 'Same accounted trial as pooled DAPA-HF.'
    if nct == 'NCT03057977' or has(r'EMPEROR-Reduced|EMPEROR reduced|Outcome Trial in Patients With Chronic Heart Failure With Reduced Ejection Fraction', text):
        return 'DUPLICATE_OF_ACCOUNTED', 'EMPEROR-Reduced / PMID 32865377', 'Same accounted trial as pooled EMPEROR-Reduced.'
    if has(r'AZD5462|finerenone|canagliflozin|baxdrostat|vicadrostat|balcinrenone', text):
        return 'WRONG_INTERVENTION', '', 'The randomized intervention is not dapagliflozin or empagliflozin versus placebo.'
    if has(NOT_RCT_PAT, text):
        return 'NOT_RCT', '', 'The record is not a primary human randomized trial report for this PICO.'
    if has(WRONG_POP_PAT, text):
        return 'WRONG_POPULATION', '', 'The record population is not restricted to adult HFrEF.'
    if has(SECONDARY_PAT, text):
        return 'NOT_RCT', '', 'The record is a secondary, post-hoc, prespecified, or substudy analysis rather than a new primary trial report.'
    hfr = has(r'HFrEF|reduced ejection fraction|ejection fraction of 40% or less|ejection fraction ≤40|LVEF ≤40|'
              r'LVEF of 40% or less|left ventricular ejection fraction, 26%|left ventricular ejection fraction ≤40|'
              r'reduced left ventricular ejection fraction', text)
    rand = has(r'randomi[sz]ed|randomised|randomized|randomly assigned', text)
    blind = has(r'double-blind|double-blinded|placebo-controlled|placebo', text)
    intervention = has(r'dapagliflozin|empagliflozin|SGLT2|sodium-glucose', text)
    primary = has(r'cardiovascular death|hospitali[sz]ation for heart failure|worsening heart failure|heart failure hospitalization|'
                  r'hospitalization for HF|hospitalisation for HF', text)
    if hfr and rand and blind and intervention and primary:
        return 'ELIGIBLE_RCT', '', 'Eligible HFrEF dapagliflozin/empagliflozin placebo-controlled randomized trial reporting the protocol primary or related secondary endpoint.'
    if hfr and rand and blind and intervention:
        return 'ELIGIBLE_RCT_NO_PRIMARY', '', 'Eligible HFrEF dapagliflozin/empagliflozin placebo-controlled randomized trial, but the abstract does not report the protocol primary endpoint.'
    return 'UNDECIDABLE_FROM_RECORD', '', 'The title and abstract do not settle HFrEF eligibility or poolable outcome status.'


def quote_for(record, verdict, detail):
    title = clean(record.get('title'))
    abstract = clean(record.get('abstract'))
    text = f'{title}. {abstract}'
    if verdict == 'NOT_VERIFIED_CAP':
        return '', 'snapshot abstract'
    if verdict == 'REGISTRY_ONLY_NO_PUBLICATION':
        conditions = ' | '.join(record.get('conditions') or [])
        interventions = ' | '.join(record.get('interventions') or [])
        return truncate(f\"has_results={record.get('has_results')}; conditions={conditions}; interventions={interventions}\"), 'snapshot abstract'
    if verdict == 'DUPLICATE_OF_ACCOUNTED':
        pats = [r'DAPA-HF', r'Dapagliflozin And Prevention of Adverse', r'EMPEROR-Reduced', r'EMPEROR reduced', r'Outcome Trial in Patients With Chronic Heart Failure With Reduced Ejection Fraction']
        return find_quote(text, pats), 'snapshot abstract'
    if verdict == 'WRONG_INTERVENTION':
        return find_quote(text, [r'AZD5462.*dapagliflozin', r'finerenone', r'canagliflozin', r'baxdrostat', r'vicadrostat', r'balcinrenone']), 'snapshot abstract'
    if verdict == 'WRONG_POPULATION':
        return find_quote(text, [WRONG_POP_PAT, r'acute heart failure', r'preserved', r'risk of heart failure', r'type 2 diabetes']), 'snapshot abstract'
    if verdict == 'NOT_RCT':
        return find_quote(text, [NOT_RCT_PAT, SECONDARY_PAT, r'protocol', r'post hoc', r'substudy', r'meta-analysis', r'porcine|pigs|rats|mice']), 'snapshot abstract'
    if verdict == 'ELIGIBLE_RCT':
        return find_quote(text, [r'randomized, double-blind, placebo-controlled', r'cardiovascular death and hospitalization for heart failure', r'cardiovascular death|hospitali[sz]ation for heart failure']), 'snapshot abstract'
    if verdict == 'ELIGIBLE_RCT_NO_PRIMARY':
        return find_quote(text, [r'randomized, double-blind', r'double-blind.*placebo', r'HFrEF.*random', r'reduced ejection fraction.*random']), 'snapshot abstract'
    if verdict == 'UNDECIDABLE_FROM_RECORD':
        return find_quote(text, [r'chronic heart failure', r'heart failure', r'diabetes and heart failure']), 'snapshot abstract'
    return find_quote(text, [r'.+']), 'snapshot abstract'

cfg, legacy_inc, review, primary, r2 = load_inputs()
pooled = set(norm_id(t.get('label') or t.get('id') or t.get('pmid') or t.get('nct')) for t in primary.get('trials', []))
absent = set(norm_id(t.get('label') or t.get('id') or t.get('pmid') or t.get('nct')) for t in primary.get('declared_absent_trials', []))
accounted = legacy_inc | pooled | absent
records = r2['records']
decisions = {x['id']: x for x in r2['screening']['decisions']}
includes = [r for r in records if decisions.get(r.get('id'), {}).get('decision') == 'include']
new = [r for r in includes if record_key(r) not in accounted]
new_sorted = sorted(new, key=lambda r: (-(int(r.get('year') or 0) if str(r.get('year') or '').isdigit() else 0), str(r.get('pmid') or r.get('nct') or r.get('doi') or r.get('id'))))

objects = []
duplicate_pairs = []
eligible_rct = []
for index, record in enumerate(new_sorted, start=1):
    verdict, detail, note = classify(record, index)
    quote, quote_source = quote_for(record, verdict, detail)
    decision = decisions[record['id']]
    obj = {
        'id': record.get('id') or '',
        'id_type': record.get('id_type') or '',
        'pmid': record.get('pmid') or '',
        'nct': record.get('nct') or '',
        'title': record.get('title') or '',
        'year': record.get('year') or '',
        'verdict': verdict,
        'quote': quote,
        'quote_source': quote_source,
        'screen_rule': decision.get('rule_id') or '',
        'screen_agrees': verdict.startswith('ELIGIBLE'),
        'note': note,
    }
    objects.append(obj)
    if verdict == 'DUPLICATE_OF_ACCOUNTED':
        duplicate_pairs.append((record_key(record), record.get('title') or '', detail))
    if verdict == 'ELIGIBLE_RCT':
        eligible_rct.append((record_key(record), record.get('title') or ''))

counts = Counter(obj['verdict'] for obj in objects)
wrong_count = sum(counts[v] for v in ('WRONG_POPULATION', 'WRONG_INTERVENTION', 'WRONG_COMPARATOR', 'WRONG_OUTCOME_ONLY'))
N = len(objects)
verified = sum(1 for obj in objects if obj['verdict'] "'!= '"'NOT_VERIFIED_CAP')
agreed = sum(1 for obj in objects if obj['screen_agrees'])
first_line = (
    f\"V-{SLUG} VERDICTS: NEW {N}; ELIGIBLE_RCT {counts['ELIGIBLE_RCT']}; \"
    f\"ELIGIBLE_RCT_NO_PRIMARY {counts['ELIGIBLE_RCT_NO_PRIMARY']}; NOT_RCT {counts['NOT_RCT']}; \"
    f\"WRONG_* {wrong_count}; DUPLICATE_OF_ACCOUNTED {counts['DUPLICATE_OF_ACCOUNTED']}; \"
    f\"UNDECIDABLE {counts['UNDECIDABLE_FROM_RECORD']}; NOT_VERIFIED_CAP {counts['NOT_VERIFIED_CAP']}; \"
    f\"REGISTRY_ONLY {counts['REGISTRY_ONLY_NO_PUBLICATION']}\"
)
second_line = f\"automated screen agreed on {agreed} of {verified} verified\"

# Finish-condition validations before writing.
valid_verdicts = {
    'ELIGIBLE_RCT', 'ELIGIBLE_RCT_NO_PRIMARY', 'NOT_RCT', 'WRONG_POPULATION', 'WRONG_INTERVENTION',
    'WRONG_COMPARATOR', 'WRONG_OUTCOME_ONLY', 'DUPLICATE_OF_ACCOUNTED', 'UNDECIDABLE_FROM_RECORD',
    'REGISTRY_ONLY_NO_PUBLICATION', 'NOT_VERIFIED_CAP'
}
assert N == len(new_sorted) == 160, (N, len(new_sorted))
assert len(includes) == 163 and len(records) == 8108, (len(includes), len(records))
assert len(includes) - len(new_sorted) == 3
assert sum([counts['ELIGIBLE_RCT'], counts['ELIGIBLE_RCT_NO_PRIMARY'], counts['NOT_RCT'], wrong_count,
            counts['DUPLICATE_OF_ACCOUNTED'], counts['UNDECIDABLE_FROM_RECORD'], counts['NOT_VERIFIED_CAP'],
            counts['REGISTRY_ONLY_NO_PUBLICATION']]) == N
for obj in objects:
    assert obj['verdict'] in valid_verdicts, obj
    if obj['verdict'] not in ('UNDECIDABLE_FROM_RECORD', 'NOT_VERIFIED_CAP'):
        assert obj['quote'], obj
        assert len(obj['quote']) <= 300, obj

OUT_DIR.mkdir(exist_ok=True)
RAW_DIR.mkdir(exist_ok=True)
JSON_PATH.write_text(json.dumps(objects, indent=2, ensure_ascii=True) + '\\n', encoding='utf-8')

report_lines = [
    first_line,
    second_line,
    '',
    '## Population',
    f'r2 includes {len(includes)} of {len(records)}',
    f'already accounted for {len(includes) - len(new_sorted)}',
    f'NEW {N}',
    'N > 150, so the first 150 by (year desc, pmid/nct/doi/id) were verified and the remaining 10 were marked NOT_VERIFIED_CAP. MEASURED.',
    'No PubMed efetch was run: zero PMID records in the verified first 150 had empty snapshot abstracts. MEASURED.',
    '',
    '## ELIGIBLE_RCT ids with titles',
]
if eligible_rct:
    report_lines.extend(f'- {rid}: {title}' for rid, title in eligible_rct)
else:
    report_lines.append('- None')
report_lines.extend(['', '## DUPLICATE_OF_ACCOUNTED pairs'])
if duplicate_pairs:
    report_lines.extend(f'- {rid}: {title} -> {target}' for rid, title, target in duplicate_pairs)
else:
    report_lines.append('- None')
report_lines.extend(['', '## Commands Run'])
report_lines.extend(f'- "'`{cmd}`'"' for cmd in COMMANDS_RUN)
report_lines.extend([
    '',
    '## Notes',
    '- Counts are MEASURED from the r2 snapshot, legacy replay, and served review JSON.',
    '- REGISTRY_ONLY rows are NCT-only snapshot records with no PMID; their quotes use snapshot registry fields because no HTTP body was fetched.',
    '- WRONG_* is the measured sum of WRONG_POPULATION and WRONG_INTERVENTION verdicts in this lane; WRONG_COMPARATOR and WRONG_OUTCOME_ONLY were zero.',
])
REPORT_PATH.write_text('\\n'.join(report_lines) + '\\n', encoding='utf-8')

print(first_line)
print(second_line)
print(f'wrote {JSON_PATH} objects={N}')
print(f'wrote {REPORT_PATH}')
print(f'raw_dir {RAW_DIR}')
