codex
The automated screen is permissive enough that “include” does not mean “poolable”; I’m separating exact accounted-trial duplicates from genuinely independent HFrEF RCT reports with no protocol primary endpoint. This matters because only `ELIGIBLE_RCT` items go into the report’s possible pool-moving list.
exec
"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "@'
import json, sys, re
sys.path.insert(0,'.')
from harness import screen
from harness.pipeline import _dedup
cfg=json.load(open('topics/sglt2-hfref-hosp-cvdeath.json',encoding='utf-8'))
legacy=json.load(open('cache/sglt2-hfref-hosp-cvdeath/records.json',encoding='utf-8'))
legacy_inc=set(x['id'] for x in screen.run(_dedup(legacy,cfg.get('pivotal_trials')),cfg)['decisions'] if x['decision']=='include')
review=json.load(open('docs/reviews/sglt2-hfref-hosp-cvdeath/review.json',encoding='utf-8'))
primary=[o for o in review['outcomes'] if o.get('primary')][0]
def norm(x): return str(x or '').replace('PMID ','').replace('NCT ','').strip()
accounted=legacy_inc|set(norm(t.get('label') or t.get('id')) for t in primary.get('trials',[]))|set(norm(t.get('label') or t.get('id')) for t in primary.get('declared_absent_trials',[]))
r2=json.load(open('cache/sglt2-hfref-hosp-cvdeath/snapshots/2026-09-15r2-search_v2/records.json',encoding='utf-8'))
decs={x['id']:x for x in r2['screening']['decisions']}
def key(r): return str(r.get('pmid') or r.get('nct') or r.get('doi') or r.get('id') or '').strip()
new=sorted([r for r in r2['records'] if decs.get(r.get('id'),{}).get('decision')=='include' and key(r) not in accounted], key=lambda r: (-(int(r.get('year') or 0) if str(r.get('year') or '').isdigit() else 0), str(r.get('pmid') or r.get('nct') or r.get('doi') or r.get('id'))))
for i,r in enumerate(new[:150],1):
    if r.get('id_type')"'!='"'pmid': continue
    title=r.get('title') or ''
    text=re.sub(r'\\s+',' ',(r.get('abstract') or ''))
    flags=[]
    for pat,label in [('post hoc','posthoc'),('secondary analysis','secondary'),('prespecified','prespec'),('substudy|sub-study|subanalysis|sub-analysis','substudy'),('randomized|randomised','rand'),('double-blind|double-blinded','blind'),('reduced ejection fraction|HFrEF|ejection fraction of 40% or less|ejection fraction ≤40|LVEF ≤40','HFrEF'),('preserved|mildly reduced|improved ejection|>40%|risk of heart failure|without overt heart failure|type 2 diabetes|acute heart failure|acute decompensated','wrongpop_hint'),('primary outcome|primary endpoint|cardiovascular death|hospitalization for heart failure|hospitalisation for heart failure|worsening heart failure','primary_hint')]:
        if re.search(pat,text+' '+title,re.I): flags.append(label)
    print(f\"{i:03d}\\t{key(r)}\\t{r.get('nct') or ''}\\t{';'.join(r.get('pubtypes') or [])}\\t{','.join(flags)}\\t{title[:100]}\")
