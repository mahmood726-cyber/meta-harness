import json, sys, re
sys.path.insert(0,'.')
from harness import screen
from harness.pipeline import _dedup
cfg=json.load(open('topics/sglt2-hfref-hosp-cvdeath.json',encoding='utf-8'))
legacy=json.load(open('cache/sglt2-hfref-hosp-cvdeath/records.json',encoding='utf-8'))
legacy_m=_dedup(legacy,cfg.get('pivotal_trials'))
legacy_inc=set(x['id'] for x in screen.run(legacy_m,cfg)['decisions'] if x['decision']=='include')
review=json.load(open('docs/reviews/sglt2-hfref-hosp-cvdeath/review.json',encoding='utf-8'))
primary=[o for o in review['outcomes'] if o.get('primary')][0]
def norm(x): return str(x or '').replace('PMID ','').replace('NCT ','').strip()
pooled=set(norm(t.get('label') or t.get('id') or t.get('pmid') or t.get('nct')) for t in primary.get('trials',[]))
absent=set(norm(t.get('label') or t.get('id') or t.get('pmid') or t.get('nct')) for t in primary.get('declared_absent_trials',[]))
accounted=legacy_inc|pooled|absent
r2=json.load(open('cache/sglt2-hfref-hosp-cvdeath/snapshots/2026-09-15r2-search_v2/records.json',encoding='utf-8'))
decs={x['id']:x for x in r2['screening']['decisions']}
def key(r): return str(r.get('pmid') or r.get('nct') or r.get('doi') or r.get('id') or '').strip()
inc=[r for r in r2['records'] if decs.get(r.get('id'),{}).get('decision')=='include']
new=[r for r in inc if key(r) not in accounted]
new_sorted=sorted(new, key=lambda r: (-(int(r.get('year') or 0) if str(r.get('year') or '').isdigit() else 0), str(r.get('pmid') or r.get('nct') or r.get('doi') or r.get('id'))))
for i,r in enumerate(new_sorted,1):
    if i>170: break
    txt=((r.get('title') or '')+' '+(r.get('abstract') or '')).replace('\\n',' ')
    txt=re.sub(r'\\s+',' ',txt)
    print(f\"{i:03d}\\t{r.get('year')}\\t{key(r)}\\t{r.get('id_type')}\\tNCT={r.get('nct') or ''}\\t{r.get('title')}\")
    print('   ', txt[:500])
