for nct in ctgov_ids:
    path = os.path.join(raw_dir, f'{nct}.ctgov.json')
    if not os.path.exists(path):
        raise SystemExit(f'missing CT.gov raw body: {path}')
    d = json.load(open(path, encoding='utf-8'))
    ps = d.get('protocolSection', {})
    status = ps.get('statusModule', {}).get('overallStatus') or 'UNKNOWN'
    conditions = ps.get('conditionsModule', {}).get('conditions') or []
    interventions = [x.get('name') for x in ps.get('armsInterventionsModule', {}).get('interventions', []) if x.get('name')]
    ctgov_quotes[nct] = {
        'quote': 'overallStatus={}; conditions={}; interventions={}'.format(status, ', '.join(conditions), ', '.join(interventions)),
