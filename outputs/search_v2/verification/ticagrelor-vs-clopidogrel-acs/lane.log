json_path = os.path.join(out_dir, slug + '.json')
report_path = 'LANE-V-ticagrelor-vs-clopidogrel-acs-REPORT.md'
os.makedirs(out_dir, exist_ok=True)
os.makedirs(raw_dir, exist_ok=True)

cfg = json.load(open(f'topics/{slug}.json', encoding='utf-8'))
legacy = json.load(open(f'cache/{slug}/records.json', encoding='utf-8'))
legacy_ids = {str(x['id']) for x in screen.run(_dedup(legacy, cfg.get('pivotal_trials')), cfg)['decisions'] if x['decision'] == 'include'}
snap = json.load(open(f'cache/{slug}/snapshots/2026-09-15r2-search_v2/records.json', encoding='utf-8'))
records = snap.get('records', [])
decisions = snap.get('screening', {}).get('decisions', [])
dec = {str(x.get('id')): x for x in decisions}
review = json.load(open(f'docs/reviews/{slug}/review.json', encoding='utf-8'))
primary = next(o for o in review['outcomes'] if o.get('primary'))
accounted = set(legacy_ids)

def toks(v):
    if v is None:
        return []
    s = str(v)
    return [s, re.sub(r'"'^(PMID|NCT|DOI)'"\\\\s*[:#]?\\\\s*', '', s, flags=re.I)]

for t in primary.get('trials', []):
    for k in ('id', 'label', 'pmid', 'nct', 'doi'):
        for z in toks(t.get(k)):
            accounted.add(z)
for t in primary.get('declared_absent_trials', []):
    for k in ('id', 'label', 'pmid', 'nct', 'doi'):
        for z in toks(t.get(k)):
            accounted.add(z)

def key(r):
    return str(r.get('pmid') or r.get('nct') or r.get('doi') or r.get('id'))

includes = [r for r in records if dec.get(str(r.get('id')), {}).get('decision') == 'include']
new = [r for r in includes if key(r) not in accounted]
new_sorted = sorted(new, key=lambda r: (-(int(r.get('year') or 0)), str(r.get('pmid') or r.get('nct') or r.get('doi') or r.get('id'))))
new_ids = [str(r.get('id')) for r in new_sorted]
by_id = {str(r.get('id')): r for r in records}

ctgov_ids = ['NCT03145194', 'NCT02792712', 'NCT02798874', 'NCT02293395', 'NCT02044146', 'NCT02415803', 'NCT01294462', 'NCT02120092', 'NCT00391872']
