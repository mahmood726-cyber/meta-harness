import json,re
slug='omega3-cardiovascular-events'
r2=json.load(open(f'cache/{slug}/snapshots/2026-09-15r2-search_v2/records.json',encoding='utf-8'))
records={r['id']:r for r in r2['records']}
first=json.load(open('C:/meta-harness/outputs/search_v2/verification/omega3-cardiovascular-events/omega3-cardiovascular-events.json',encoding='utf-8'))
pmids=[x for x in first if x.get('verdict')=='NOT_VERIFIED_CAP' and x.get('id_type')=='pmid']
keys=['protocol','rationale','secondary','substudy','post hoc','healthy','pregnan','infant','children','adolescent','dog','HIV','random','double-blind','placebo','single-blind','open','major','cardiovascular event','atrial fibrillation','bleeding','mortality','restenosis','thrombosis','heart failure','myocardial infarction','diabetes','hypertriglyceridemia','dyslipidemia']
for i,x in enumerate(pmids,1):
    r=records[x['id']]
    text=re.sub(r'\\s+',' ',(r.get('title') or '')+' '+(r.get('abstract') or '')).strip()
    hits=[k for k in keys if k.lower() in text.lower()]
    sentences=re.split(r'(?<=[."'!?])'"\\s+', re.sub(r'\\s+',' ',r.get('abstract') or '').strip())
    ev=[]
    for s in sentences:
        sl=s.lower()
        if any(k in sl for k in ['design:', 'methods:', 'random', 'double-blind', 'placebo', 'primary', 'major', 'atrial', 'bleeding', 'cardiovascular events', 'protocol', 'secondary analysis', 'post hoc', 'substudy']):
            ev.append(s[:240])
    print(f\"{i:03d} {r['id']} {r['year']} {r['title']}\")
    print('HITS:', ', '.join(hits))
    print('EV:', ' || '.join(ev[:4]))
