from pathlib import Path

sys.path.insert(0, '.')
from harness import screen
from harness.pipeline import _dedup

slug = 'omega3-cardiovascular-events'
out_dir = Path('lane_v')
raw_dir = out_dir / f'{slug}-raw'
json_path = out_dir / f'{slug}.json'
report_path = Path('LANE-W-omega3-cardiovascular-events-REPORT.md')
out_dir.mkdir(exist_ok=True)
raw_dir.mkdir(exist_ok=True)

# Source inputs.
cfg = json.load(open(f'topics/{slug}.json', encoding='utf-8'))
legacy_records = json.load(open(f'cache/{slug}/records.json', encoding='utf-8'))
r2 = json.load(open(f'cache/{slug}/snapshots/2026-09-15r2-search_v2/records.json', encoding='utf-8'))
review = json.load(open(f'docs/reviews/{slug}/review.json', encoding='utf-8'))
first_lane = json.load(open(f'C:/meta-harness/outputs/search_v2/verification/{slug}/{slug}.json', encoding='utf-8'))

records = {r['id']: r for r in r2['records']}
decisions = {d['id']: d for d in r2['screening']['decisions']}
legacy_includes = sorted(x['id'] for x in screen.run(_dedup(legacy_records, cfg.get('pivotal_trials')), cfg)['decisions'] if x['decision'] == 'include')
r2_include_decisions = [d for d in r2['screening']['decisions'] if d.get('decision') == 'include']

def clean_id(value):
    if value is None:
        return ''
    s = str(value).strip()
    if s.upper().startswith('PMID '):
        return s.split()[-1]
    return s

primary = review['outcomes'][0]
accounted = set(legacy_includes)
for bucket in ('trials', 'declared_absent_trials'):
    for item in primary.get(bucket, []):
        if isinstance(item, dict):
            for k in ('pmid', 'nct', 'doi', 'id', 'label'):
                val = clean_id(item.get(k))
                if val:
                    accounted.add(val)
        else:
            val = clean_id(item)
            if val:
                accounted.add(val)

def include_key(rec):
    return rec.get('pmid') or rec.get('nct') or rec.get('doi') or rec.get('id')

n_records = len(r2['records'])
n_inc = len(r2_include_decisions)
n_old = sum(1 for d in r2_include_decisions if include_key(records[d['id']]) in accounted)
total_new_measured = n_inc - n_old
cap = [x for x in first_lane if x.get('verdict') == 'NOT_VERIFIED_CAP']
N = len(cap)

verdict = {}
duplicate_note = {}
manual_note = {}

def v(ids, verdict_name, note=None):
    for id_ in ids:
        verdict[id_] = verdict_name
        if note:
            manual_note[id_] = note

def d(ids, note):
    for id_ in ids:
        verdict[id_] = 'DUPLICATE_OF_ACCOUNTED'
        duplicate_note[id_] = note

eligible_no_primary = [
    '27034958','27404516','27596132','25932792','26073395','26328624','26687697','26836268','24356795','24528690','24988179','27482256','25185754','23275364','23584593','23592752','23855973','23900468','23998969','24023466','24049619','24071458','24116330','23023905','23056097','21159789','21570522','21617138','21630032','21701167','21757893','21775113','21800004','22091264','22108152','20071644','20118387','20394870','21036355','19002433','19397392','19745175','21291831','17327864','18156400','18561722','18678300','18065585','16461054','16818127','16960167','17112442','15930485','14767865','15250255','12482554','11590875','11789299','10982541','10532692','9622285','9733230','1328817','1495569','1537131','1771612','1831755','2035283','2222347','2537349','2568519','3276185','6320945','8112187','8165608','8211009','8349330','8436250','9081682','9101424','22623230','22811376','22892157','22894624','20716712','17676423','16552404','12421024','11303007','10334433','8908381','23700945','23789288'
]
