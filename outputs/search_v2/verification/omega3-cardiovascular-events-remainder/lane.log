" rowspan="1" align="left" valign="top">Serum vitamin B-12 (pg/ml):</td><td colspan="1" rowspan="1" align="center" valign="top"/><td colspan="1" rowspan="1" align="center" valign="top"/><td colspan="1" rowspan="1" align="center" valign="top"/><td colspan="1" rowspan="1" align="center" valign="top"/></tr><tr><td colspan="1" rowspan="1" align="left" valign="top"> Baseline*</td><td colspan="1" rowspan="1" align="center" valign="top">361 (291-455)</td><td colspan="1" rowspan="1" align="center" valign="top">365 (290-468)</td><td colspan="1" rowspan="1" align="center" valign="top">359 (298-455)</td><td colspan="1" rowspan="1" align="center" valign="top">376 (306-474)</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top"> 1 year†</td><td colspan="1" rowspan="1" align="center" valign="top">506 (405-646)</td><td colspan="1" rowspan="1" align="center" valign="top">381 (296-488)</td><td colspan="1" rowspan="1" align="center" valign="top">491 (390-639)</td><td colspan="1" rowspan="1" align="center" valign="top">378 (303-481)</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top"> End of supplementation‡</td><td colspan="1" rowspan="1" align="center" valign="top">504 (397-620)</td><td colspan="1" rowspan="1" align="center" valign="top">367 (286-468)</td><td colspan="1" rowspan="1" align="center" valign="top">497 (390-615)</td><td colspan="1" rowspan="1" align="center" valign="top">370 (312-469)</td></tr><tr><td colspan="5" rowspan="1" align="left" valign="top" content-type="TableSubHead"><bold>Fatty acid composition of plasma lipids (% of total)§</bold></td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top">Eicosapentanoic acid:</td><td colspan="1" rowspan="1" align="center" valign="top"/><td colspan="1" rowspan="1" align="center" valign="top"/><td colspan="1" rowspan="1" align="center" valign="top"/><td colspan="1" rowspan="1" align="center" valign="top"/></tr><tr><td colspan="1" rowspan="1" align="left" valign="top"> Baseline</td><td colspa