v(['27894336','26116581','25108576','21924882','23701295','19159453','21474462','20196975','20451686','12589702','12062374','11838000','10235440','27919362','23835245'], 'NOT_RCT')
d(['27482002'], 'OMEGA-REMODEL -> declared-absent PMID 38184150')
d(['27632919','21315217','19589110','15302013'], 'GISSI-HF -> declared-absent PMID 18757090')
d(['24879357','23774275','25104273','21967845','22301766','22110169','20362710'], 'Alpha Omega -> pooled PMID 20929341')
d(['24574355'], 'ORIGIN -> pooled PMID 22686415')
d(['22365647','14625623'], 'SU.FOL.OM3 -> pooled PMID 21115589')
d(['20509875'], 'Rischio e Prevenzione -> declared-absent PMID 23656645')
d(['16926660'], 'Diet and Omega-3 Intervention Trial -> declared-absent PMID 20389249')
d(['12792664','14624050'], 'High-dose n-3 after acute MI trial -> declared-absent PMID 11451717')
