For the NCT-only remainder, the normalized snapshot really does not carry `overall_status`; it has `conditions`, `interventions`, allocation, masking, and results flags. Since the lane specifically wants status quoted, I’ll fetch CT.gov study JSON for those registry-only records into the allowed raw artefact folder and quote that source directly instead of pretending the field existed locally.
exec
"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "@'
import json,re
slug='omega3-cardiovascular-events'
r2=json.load(open(f'cache/{slug}/snapshots/2026-09-15r2-search_v2/records.json',encoding='utf-8'))
records={r['id']:r for r in r2['records']}
dec={d['id']:d for d in r2['screening']['decisions']}
first=json.load(open('C:/meta-harness/outputs/search_v2/verification/omega3-cardiovascular-events/omega3-cardiovascular-events.json',encoding='utf-8'))
cap=[x for x in first if x.get('verdict')=='NOT_VERIFIED_CAP']
for i,x in enumerate([x for x in cap if x.get('id_type')=='pmid'],1):
    r=records[x['id']]
    abstract=re.sub(r'\\s+',' ',r.get('abstract') or '').strip()
    print(f\"{i:03d}\\t{r.get('id')}\\t{r.get('year')}\\tNCT={r.get('nct','')}\\tpubtypes={','.join(r.get('pubtypes') or [])}\\trule={dec[r['id']].get('rule_id')}\\tTITLE: {r.get('title')}\")
    print(f\"    ABS: {abstract[:900]}\")
'@ | python -" in C:\mh-r-W-omega3-cardiovascular-events
