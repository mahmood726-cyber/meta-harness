(68,1)</td><td colspan="1" rowspan="1" align="center" valign="top">422 (67.9)</td><td colspan="1" rowspan="1" align="center" valign="top">428 (68.4)</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top"> Calcium and channel blockers</td><td colspan="1" rowspan="1" align="center" valign="top">86 (13.9)</td><td colspan="1" rowspan="1" align="center" valign="top">103 (16.3)</td><td colspan="1" rowspan="1" align="center" valign="top">79 (12.7)</td><td colspan="1" rowspan="1" align="center" valign="top">86 (13.7)</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top"> Lipid lowering agents</td><td colspan="1" rowspan="1" align="center" valign="top">531 (85.7)</td><td colspan="1" rowspan="1" align="center" valign="top">544 (85.9)</td><td colspan="1" rowspan="1" align="center" valign="top">518 (83.3)</td><td colspan="1" rowspan="1" align="center" valign="top">544 (86.9)</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top"> Aspirin or antiplatelet agents</td><td colspan="1" rowspan="1" align="center" valign="top">569 (91.8)</td><td colspan="1" rowspan="1" align="center" valign="top">595 (94.0)</td><td colspan="1" rowspan="1" align="center" valign="top">584 (93.9)</td><td colspan="1" rowspan="1" align="center" valign="top">588 (93.9)</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top"> ACE inhibitors</td><td colspan="1" rowspan="1" align="center" valign="top">340 (54.8)</td><td colspan="1" rowspan="1" align="center" valign="top">331 (52.3)</td><td colspan="1" rowspan="1" align="center" valign="top">328 (52.7)</td><td colspan="1" rowspan="1" align="center" valign="top">342 (54.6)</td></tr><tr><td colspan="1" rowspan="1" align="left" valign="top"> Angiotensin II receptor blockers</td><td colspan="1" rowspan="1" align="center" valign="top">61 (9.8)</td><td colspan="1" rowspan="1" align="center" valign="top">44 (7.0)</td><td colspan="1" rowspan="1" align="center" valign="top">64 (10.3)</td><td colspan="1" rowspan="1" align="c