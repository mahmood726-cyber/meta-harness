/subj-group></article-categories><title-group><article-title>Effect of High-Dose Omega-3 Fatty Acids vs Corn Oil on Major Adverse Cardiovascular Events in Patients at High Cardiovascular Risk</article-title><subtitle>The STRENGTH Randomized Clinical Trial</subtitle><alt-title alt-title-type="headline">Omega-3 Fatty Acids vs Corn Oil and Major Adverse Cardiovascular Events in Patients at High Risk</alt-title><alt-title alt-title-type="running-head">Omega-3 Fatty Acids vs Corn Oil and Major Adverse Cardiovascular Events in Patients at High Risk</alt-title></title-group><contrib-group><contrib contrib-type="author"><name name-style="western"><surname>Nicholls</surname><given-names initials="SJ">Stephen J.</given-names></name><degrees>MBBS</degrees><degrees>PhD</degrees><xref ref-type="aff" rid="joi200120aff1"><sup>1</sup></xref></contrib><contrib contrib-type="author"><name name-style="western"><surname>Lincoff</surname><given-names initials="AM">A. Michael</given-names></name><degrees>MD</degrees><xref ref-type="aff" rid="joi200120aff2"><sup>2</sup></xref></contrib><contrib contrib-type="author"><name name-style="western"><surname>Garcia</surname><given-names initials="M">Michelle</given-names></name><degrees>RN</degrees><degrees>BSN</degrees><degrees>CCRC</degrees><xref ref-type="aff" rid="joi200120aff2"><sup>2</sup></xref></contrib><contrib contrib-type="author"><name name-style="western"><surname>Bash</surname><given-names initials="D">Dianna</given-names></name><degrees>BSN</degrees><xref ref-type="aff" rid="joi200120aff2"><sup>2</sup></xref></contrib><contrib contrib-type="author"><name name-style="western"><surname>Ballantyne</surname><given-names initials="CM">Christie M.</given-names></name><degrees>MD</degrees><xref ref-type="aff" rid="joi200120aff3"><sup>3</sup></xref></contrib><contrib contrib-type="author"><name name-style="western"><surname>Barter</surname><given-names initials="PJ">Philip J.</given-names></name><degrees>MBBS</degrees><degrees>PhD</degree