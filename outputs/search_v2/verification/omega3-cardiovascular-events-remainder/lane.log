PMID_ALLOWED = {x['id'] for x in cap if x.get('id_type') == 'pmid'}
missing = sorted(PMID_ALLOWED - set(verdict))
extra = sorted(set(verdict) - PMID_ALLOWED)
if missing or extra:
    raise SystemExit(f'verdict map mismatch missing={missing} extra={extra}')

patterns = {
    'ELIGIBLE_RCT': ['atrial fibrillation', 'cardiovascular events', 'cardiac events', 'major adverse', 'ischemic events', 'bleeding', 'primary outcome', 'cardiovascular event-free'],
    'ELIGIBLE_RCT_NO_PRIMARY': ['double-blind', 'placebo-controlled', 'randomized', 'randomised', 'randomly assigned', 'randomly allocated', 'placebo', 'control'],
    'NOT_RCT': ['protocol', 'rationale', 'review', 'post hoc', 'secondary analysis', 'subset', 'single-blind', 'model', 'analyzed plasma from a subset', 'embedded in this trial'],
    'WRONG_POPULATION': ['gestational', 'pregnant', 'infants', 'children', 'adolescents', 'healthy', 'dogs', 'normotensive', 'normal subjects', 'healthy volunteers', 'offspring'],
    'WRONG_INTERVENTION': ['plus low-dose aspirin', 'glutamine and fish oil', 'omega-3 plus vitamin e', 'enriched pork', 'co-supplementation'],
    'WRONG_COMPARATOR': ['versus standard omega-3', 'linseed oil', 'dietary oils', 'canola oil', 'randomized crossover'],
    'DUPLICATE_OF_ACCOUNTED': ['alpha omega', 'gissi', 'origin', 'su.fol', 'omega-remodel', 'vital', 'rischio', 'diet and omega-3 intervention'],
}

def normalize_text(s):
    return re.sub(r'\\s+', ' ', (s or '').replace('\\u00a0', ' ')).strip()

def sentences_for(rec):
    title = normalize_text(rec.get('title', ''))
    abstract = normalize_text(rec.get('abstract', ''))
    pieces = [title]
    pieces.extend([s.strip() for s in re.split(r'(?<=[."'!?])'"\\s+', abstract) if s.strip()])
    return pieces

def clip_quote(s, limit=300):
    s = normalize_text(s)
    if len(s) <= limit:
        return s
    return s[:limit].rstrip()

def pick_quote(rec, verdict_name):
    pieces = sentences_for(rec)
    pats = patterns.get(verdict_name, [])
    for pat in pats:
        p = pat.lower()
        for s in pieces:
            if p in s.lower():
                return clip_quote(s)
    if verdict_name.startswith('ELIGIBLE'):
        for s in pieces:
            sl = s.lower()
            if ('random' in sl or 'randomised' in sl) and ('placebo' in sl or 'control' in sl):
                return clip_quote(s)
    return clip_quote(pieces[0] if pieces else rec.get('id', ''))

def fetch_ctgov(nct):
    path = raw_dir / f'ctgov_{nct}.json'
    url = f'https://clinicaltrials.gov/api/v2/studies/{nct}'
    req = urllib.request.Request(url, headers={'User-Agent': 'meta-harness-lane-verifier/1.0'})
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            data = resp.read()
        path.write_bytes(data)
        obj = json.loads(data.decode('utf-8'))
        ps = obj.get('protocolSection', {})
        status = ps.get('statusModule', {}).get('overallStatus', '')
        conditions = ps.get('conditionsModule', {}).get('conditions', []) or []
        interventions = [i.get('name', '') for i in ps.get('armsInterventionsModule', {}).get('interventions', []) if i.get('name')]
        return {'ok': True, 'path': path, 'status': status, 'conditions': conditions, 'interventions': interventions, 'url': url}
    except Exception as exc:
        err_path = raw_dir / f'ctgov_{nct}_ERROR.json'
        err_path.write_text(json.dumps({'url': url, 'error': str(exc)}, ensure_ascii=False, indent=2), encoding='utf-8')
        return {'ok': False, 'path': err_path, 'status': '', 'conditions': [], 'interventions': [], 'url': url, 'error': str(exc)}

ct_cache = {}
objects = []
for item in cap:
    rec = records[item['id']]
    dec = decisions[item['id']]
    base = {
        'id': rec.get('id', ''),
        'id_type': rec.get('id_type', ''),
        'pmid': rec.get('pmid', ''),
        'nct': rec.get('nct', ''),
        'title': rec.get('title', ''),
        'year': str(rec.get('year', '')),
    }
    if rec.get('id_type') == 'nct' and not rec.get('pmid'):
        nct = rec.get('nct') or rec.get('id')
        if nct not in ct_cache:
            ct_cache[nct] = fetch_ctgov(nct)
            time.sleep(0.03)
        ct = ct_cache[nct]
        conditions = ct['conditions'] or rec.get('conditions', []) or []
        interventions = ct['interventions'] or rec.get('interventions', []) or []
        status = ct['status'] or 'STATUS_NOT_AVAILABLE'
        quote = clip_quote('overallStatus=' + status + '; conditions=' + '; '.join(conditions[:4]) + '; interventions=' + '; '.join(interventions[:4]))
        obj = {
            **base,
            'verdict': 'REGISTRY_ONLY_NO_PUBLICATION',
            'quote': quote,
            'quote_source': f'ctgov api (lane_v/{slug}-raw/{ct[\"path\"].name})',
            'screen_rule': dec.get('rule_id', ''),
            'screen_agrees': False,
            'note': 'NCT-only registry record with no PMID; not a publication report.' if ct['ok'] else f'NCT-only registry record; CT.gov fetch failed: {ct.get(\"error\", \"unknown error\")}',
        }
    else:
        vd = verdict[rec['id']]
        obj = {
            **base,
            'verdict': vd,
            'quote': pick_quote(rec, vd),
            'quote_source': 'snapshot abstract',
            'screen_rule': dec.get('rule_id', ''),
            'screen_agrees': vd.startswith('ELIGIBLE'),
        }
        if rec['id'] in duplicate_note:
            obj['duplicate_of_accounted'] = duplicate_note[rec['id']]
        if rec['id'] in manual_note:
            obj['note'] = manual_note[rec['id']]
    objects.append(obj)

allowed_verdicts = {
    'ELIGIBLE_RCT', 'ELIGIBLE_RCT_NO_PRIMARY', 'NOT_RCT', 'WRONG_POPULATION', 'WRONG_INTERVENTION', 'WRONG_COMPARATOR', 'WRONG_OUTCOME_ONLY', 'DUPLICATE_OF_ACCOUNTED', 'UNDECIDABLE_FROM_RECORD', 'REGISTRY_ONLY_NO_PUBLICATION'
}
for o in objects:
    if o['verdict'] not in allowed_verdicts:
        raise SystemExit(f'bad verdict {o[\"id\"]}: {o[\"verdict\"]}')
    if o['verdict'] not in {'UNDECIDABLE_FROM_RECORD', 'NOT_VERIFIED_CAP'} and not o.get('quote'):
        raise SystemExit(f'missing quote {o[\"id\"]}')
    if len(o.get('quote', '')) > 300:
        raise SystemExit(f'quote too long {o[\"id\"]}: {len(o[\"quote\"])}')

json_path.write_text(json.dumps(objects, ensure_ascii=False, indent=2) + '\\n', encoding='utf-8')

counts = collections.Counter(o['verdict'] for o in objects)
wrong_star = counts['WRONG_POPULATION'] + counts['WRONG_INTERVENTION'] + counts['WRONG_COMPARATOR'] + counts['WRONG_OUTCOME_ONLY']
