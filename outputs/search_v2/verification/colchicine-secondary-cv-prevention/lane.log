"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "@'
import json, sys, re
from pathlib import Path
sys.path.insert(0,'.')
from harness import screen
from harness.pipeline import _dedup
slug='colchicine-secondary-cv-prevention'
cfg=json.load(open(f'topics/{slug}.json', encoding='utf-8'))
legacy=json.load(open(f'cache/{slug}/records.json', encoding='utf-8'))
legacy_ids=set(str(x['id']) for x in screen.run(_dedup(legacy, cfg.get('pivotal_trials')), cfg)['decisions'] if x['decision']=='include')
r2=json.load(open(f'cache/{slug}/snapshots/2026-09-15r2-search_v2/records.json', encoding='utf-8'))
records=r2['records']
decs=r2['screening']['decisions']
inc=[d for d in decs if d.get('decision')=='include']
review=json.load(open(f'docs/reviews/{slug}/review.json', encoding='utf-8'))
primary=next(o for o in review['outcomes'] if o.get('primary'))
def clean_id(x):
    if not x: return None
    s=str(x)
    s=s.replace('PMID','').replace('NCT','NCT').strip()
    m=re.search(r'(NCT\\d+|\\d{4,}|10\\.\\S+)', s)
    return m.group(1).rstrip('.,;') if m else s
pooled=set(clean_id(t.get('label') or t.get('id')) for t in primary.get('trials',[]))
declared=set(clean_id(t.get('label') or t.get('id')) for t in primary.get('declared_absent_trials',[]))
accounted=legacy_ids|pooled|declared
print('legacy',len(legacy_ids),sorted(legacy_ids))
print('pooled primary',len(pooled),sorted(pooled))
print('declared primary',len(declared),sorted(declared))
print('accounted union',len(accounted),sorted(accounted))
rec_by_id={str(r.get('id')):r for r in records}
def key_for_record(r):
    if r.get('pmid'):
        return str(r['pmid'])
    if r.get('nct'):
        return str(r['nct'])
    if r.get('doi'):
        return str(r['doi'])
    return str(r.get('id'))
rows=[]
for d in inc:
    r=rec_by_id.get(str(d['id']))
    if not r:
        r=next((x for x in records if str(d['id']) in [str(x.get('pmid')),str(x.get('nct')),str(x.get('doi'))]), None)
    k=key_for_record(r)
    rows.append((k in accounted, k, d['id'], r.get('id_type'), r.get('pmid'), r.get('nct'), r.get('doi'), r.get('year'), r.get('title'), d.get('rule_id')))
old=[x for x in rows if x[0]]
new=[x for x in rows if not x[0]]
print('r2 includes', len(inc), 'already accounted', len(old), 'NEW', len(new))
print('OLD')
for row in old:
    print(row[1], row[2], row[7], row[8])
print('NEW sorted year desc, pmid')
# sorting first 150 by year desc, pmid. Need include non pmid: sort key? use key string.
def sort_key(row):
    year=row[7] if isinstance(row[7], int) else int(row[7] or 0)
    k=row[1]
    # pmid numeric if key all digits else high string or nct
    pmid=int(k) if str(k).isdigit() else 10**12
    return (-year, pmid, str(k))
for row in sorted(new, key=sort_key):
    print('\\t'.join(str(x) if x is not None else '' for x in row[1:]))
