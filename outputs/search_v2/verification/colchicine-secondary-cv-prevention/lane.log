def clean_id(value):
    if not value:
        return None
    s = str(value).replace('PMID', '').strip()
    m = re.search(r'(NCT\\d+|\\d{4,}|10\\.\\S+)', s)
    return m.group(1).rstrip('.,;') if m else s

pooled_primary = {clean_id(t.get('label') or t.get('id')) for t in primary.get('trials', [])}
declared_primary = {clean_id(t.get('label') or t.get('id')) for t in primary.get('declared_absent_trials', [])}
accounted = legacy_ids | pooled_primary | declared_primary
