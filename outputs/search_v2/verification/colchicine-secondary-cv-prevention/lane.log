import json, sys, re
from pathlib import Path
sys.path.insert(0,'.')
from harness import screen
from harness.pipeline import _dedup
slug='colchicine-secondary-cv-prevention'
cfg=json.load(open(f'topics/{slug}.json', encoding='utf-8'))
legacy=json.load(open(f'cache/{slug}/records.json', encoding='utf-8'))
legacy_ids=set(str(x['id']) for x in screen.run(_dedup(legacy, cfg.get('pivotal_trials')), cfg)['decisions'] if x['decision']=='include')
r2=json.load(open(f'cache/{slug}/snapshots/2026-09-15r2-search_v2/records.json', encoding='utf-8'))
records=r2['records']; decs=r2['screening']['decisions']
review=json.load(open(f'docs/reviews/{slug}/review.json', encoding='utf-8'))
primary=next(o for o in review['outcomes'] if o.get('primary'))
def clean_id(x):
    if not x: return None
    s=str(x).replace('PMID','').strip()
    m=re.search(r'(NCT\\d+|\\d{4,}|10\\.\\S+)', s)
    return m.group(1).rstrip('.,;') if m else s
accounted=legacy_ids|set(clean_id(t.get('label') or t.get('id')) for t in primary.get('trials',[]))|set(clean_id(t.get('label') or t.get('id')) for t in primary.get('declared_absent_trials',[]))
rec_by_id={str(r.get('id')):r for r in records}
def key_for_record(r): return str(r.get('pmid') or r.get('nct') or r.get('doi') or r.get('id'))
new=[]
for d in decs:
    if d.get('decision')"'!='"'include': continue
    r=rec_by_id.get(str(d['id'])) or next((x for x in records if str(d['id']) in [str(x.get('pmid')),str(x.get('nct')),str(x.get('doi'))]), None)
    if key_for_record(r) not in accounted:
        new.append((r,d))
def sort_key(rd):
    r,d=rd; year=int(r.get('year') or 0); k=key_for_record(r); pmid=int(k) if str(k).isdigit() else 10**12
    return (-year, pmid, str(k))
for r,d in sorted(new, key=sort_key):
    abstract=(r.get('abstract') or '').replace('\\n',' ')
    print('---')
    print('ID:', key_for_record(r), 'TYPE:', r.get('id_type'), 'YEAR:', r.get('year'), 'NCT:', r.get('nct'), 'DOI:', r.get('doi'))
    print('TITLE:', r.get('title'))
    print('PUBTYPES:', '; '.join(r.get('pubtypes') or []))
    print('ABSTRACT_LEN:', len(abstract))
    print('ABSTRACT:', abstract[:1600])
    if r.get('id_type')=='nct':
        print('ACRONYM:', r.get('acronym'), 'ALLOC:', r.get('allocation'), 'MASKING:', r.get('masking'), 'HAS_RESULTS:', r.get('has_results'), 'STUDY_TYPE:', r.get('study_type'))
        print('CONDITIONS:', '; '.join(r.get('conditions') or []))
        print('INTERVENTIONS:', '; '.join(r.get('interventions') or []))
    print('SCREEN:', d.get('rule_id'), d.get('span'))
