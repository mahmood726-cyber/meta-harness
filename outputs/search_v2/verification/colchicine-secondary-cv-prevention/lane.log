def key_for_record(r):
    return str(r.get('pmid') or r.get('nct') or r.get('doi') or r.get('id'))

def sort_key(r):
    key = key_for_record(r)
    year = int(r.get('year') or 0)
    pmid_sort = int(key) if key.isdigit() else 10**12
    return (-year, pmid_sort, key)

def source_text(r):
    return ((r.get('title') or '') + '\\n' + (r.get('abstract') or '')).replace('\\n', ' ')

def quote_from_hint(r, hint, before=0, length=260):
    if hint == '__TITLE__':
        return (r.get('title') or '').strip()
    if hint == '__EMPTY__':
        return ''
    text = source_text(r)
    idx = text.find(hint)
    if idx == -1:
        idx = text.lower().find(hint.lower())
    if idx == -1:
        raise SystemExit(f'hint not found for {key_for_record(r)}: {hint"'!r}'"')
    start = max(0, idx - before)
    quote = re.sub(r'\\s+', ' ', text[start:start + length]).strip()
    return quote

