def clean_id(value):
    if not value:
        return None
    s = str(value).replace('PMID', '').strip()
    m = re.search(r'(NCT\\d+|\\d{4,}|10\\.\\S+)', s)
    return m.group(1).rstrip('.,;') if m else s

