import json, os, re
from collections import Counter
from pathlib import Path
from harness import screen
from harness.pipeline import _dedup

slug = 'colchicine-postop-af'
root = Path('.')
out_dir = root / 'lane_v'
raw_dir = out_dir / f'{slug}-raw'
out_dir.mkdir(exist_ok=True)
raw_dir.mkdir(parents=True, exist_ok=True)

cfg = json.load(open(root / 'topics' / f'{slug}.json', encoding='utf-8'))
legacy_records = json.load(open(root / 'cache' / slug / 'records.json', encoding='utf-8'))
legacy_m = _dedup(legacy_records, cfg.get('pivotal_trials'))
legacy_includes = sorted(x['id'] for x in screen.run(legacy_m, cfg)['decisions'] if x['decision'] == 'include')

snap_path = root / 'cache' / slug / 'snapshots' / '2026-09-15r2-search_v2' / 'records.json'
snap = json.load(open(snap_path, encoding='utf-8'))
records = {r['id']: r for r in snap['records']}
decisions = snap['screening']['decisions']
decision_by_id = {d['id']: d for d in decisions}
r2_includes = [d for d in decisions if d.get('decision') == 'include']

review = json.load(open(root / 'docs' / 'reviews' / slug / 'review.json', encoding='utf-8'))
primary = review['outcomes'][0]
accounted = set(legacy_includes)
for group in ('trials', 'declared_absent_trials'):
    for t in primary.get(group, []):
        raw = str(t.get('id') or t.get('label') or '')
        accounted.add(re.sub(r'"'^(PMID|NCT|DOI)'"\\s+', '', raw, flags=re.I))
        accounted.add(str(t.get('label', '')))

def key_for(r):
    return str(r.get('pmid') or r.get('nct') or r.get('doi') or r.get('id'))

def year_int(r):
    try:
        return int(r.get('year') or 0)
    except Exception:
        return 0

new_ids = []
for d in r2_includes:
    r = records[d['id']]
    if key_for(r) not in accounted:
        new_ids.append(d['id'])
new_ids = sorted(new_ids, key=lambda rid: (-year_int(records[rid]), str(records[rid].get('pmid') or records[rid].get('nct') or records[rid].get('doi') or records[rid].get('id'))))

