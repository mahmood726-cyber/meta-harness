cfg=json.load(open('topics/probiotics-aad-prevention.json',encoding='utf-8'))
legacy=json.load(open('cache/probiotics-aad-prevention/records.json',encoding='utf-8'))
legacy_inc=set(x['id'] for x in screen.run(_dedup(legacy,cfg.get('pivotal_trials')),cfg)['decisions'] if x['decision']=='include')
review=json.load(open('docs/reviews/probiotics-aad-prevention/review.json',encoding='utf-8'))
primary=next(o for o in review['outcomes'] if o.get('primary'))
def norm_id(x):
    s=str(x or '').strip()
    if s.upper().startswith('PMID '):
        return s.split()[-1]
    return s
pooled={norm_id(x.get('label') or x.get('id')) for x in primary.get('trials',[])}
absent={norm_id(x.get('id') or x.get('label')) for x in primary.get('declared_absent_trials',[])}
r2=json.load(open('cache/probiotics-aad-prevention/snapshots/2026-09-15r2-search_v2/records.json',encoding='utf-8'))
dec={x['id']:x for x in r2['screening']['decisions']}
inc=[]
new=[]
accounted=[]
for r in r2['records']:
    if dec.get(r['id'],{}).get('decision')=='include':
        key=r.get('pmid') or r.get('nct') or r.get('doi') or r.get('id')
        inc.append((key,r))
        if key in legacy_inc or key in pooled or key in absent:
            accounted.append((key,r))
        else:
            new.append((key,r))
summary={'r2_records':len(r2['records']),'r2_includes':len(inc),'legacy_inc':len(legacy_inc),'pooled':len(pooled),'declared_absent_primary':len(absent),'accounted_r2_includes':len(accounted),'new':len(new)}
print(json.dumps(summary, indent=2))
print(json.dumps([{**{k:r.get(k) for k in ['id','id_type','pmid','nct','doi','title','abstract','journal','year','pubtypes','found_by']}, 'key':key, 'screen_rule':dec[r['id']]['rule_id'], 'screen_reason':dec[r['id']].get('reason'), 'screen_span':dec[r['id']].get('span')} for key,r in sorted(new,key=lambda kr:(-(int(kr[1].get('year') or 0)), kr[0]))], ensure_ascii=False, indent=2))
