import json, sys
sys.path.insert(0,'.')
from harness import screen
from harness.pipeline import _dedup
cfg=json.load(open('topics/probiotics-aad-prevention.json',encoding='utf-8'))
legacy=json.load(open('cache/probiotics-aad-prevention/records.json',encoding='utf-8'))
legacy_records=legacy['records'] if isinstance(legacy,dict) else legacy
legacy_inc={x['id'] for x in screen.run(_dedup(legacy,cfg.get('pivotal_trials')),cfg)['decisions'] if x['decision']=='include'}
review=json.load(open('docs/reviews/probiotics-aad-prevention/review.json',encoding='utf-8'))
primary=next(o for o in review['outcomes'] if o.get('primary'))
def norm_id(x):
    s=str(x or '').strip()
    if s.upper().startswith('PMID '): return s.split()[-1]
    return s
pooled={norm_id(x.get('label') or x.get('id')) for x in primary.get('trials',[])}
absent={norm_id(x.get('id') or x.get('label')) for x in primary.get('declared_absent_trials',[])}
accounted=legacy_inc|pooled|absent
r2=json.load(open('cache/probiotics-aad-prevention/snapshots/2026-09-15r2-search_v2/records.json',encoding='utf-8'))
all_records=[]
all_records += r2['records']
all_records += legacy_records
acct_records=[]
for r in all_records:
    key=r.get('pmid') or r.get('nct') or r.get('doi') or r.get('id')
    if key in accounted or r.get('id') in accounted:
        acct_records.append(r)
new_ncts=['NCT03334604','NCT02765217','NCT02871908','NCT02462590','NCT01782755','NCT01972932','NCT01596829','NCT01143272','NCT00958308']
for nct in new_ncts:
    matches=[r for r in acct_records if r.get('nct')==nct or r.get('id')==nct]
    print('\\n'+nct)
    for r in matches:
        print(json.dumps({k:r.get(k) for k in ['id','id_type','pmid','nct','title','year','acronym']}, ensure_ascii=False))
