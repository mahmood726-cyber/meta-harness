    try:
        return int(r.get('year') or 0)
    except Exception:
        return 0

def clean(s):
    return re.sub(r'\\s+', ' ', str(s or '')).strip()

def truncate(s, n=300):
    s = clean(s)
    if len(s) <= n:
        return s
    return s[: n - 3].rstrip() + '...'

def sentences(title, abstract):
    text = clean((title or '') + '. ' + (abstract or ''))
    parts = re.split(r'(?<=[."'!?])'"\\s+', text)
    return [p.strip() for p in parts if p.strip()]

def find_quote(r, verdict):
    title = clean(r.get('title'))
    abstract = clean(r.get('abstract'))
    sents = sentences(title, abstract)
    key = rec_key(r)
    lower_title = title.lower()

    if verdict == 'REGISTRY_ONLY_NO_PUBLICATION':
        conditions = ', '.join(r.get('conditions') or [])
        interventions = ', '.join(r.get('interventions') or [])
        status = r.get('overall_status') or 'overall_status field absent'
        return truncate(f\"overall_status: {status}; conditions: {conditions}; interventions: {interventions}\")

    if verdict == 'NOT_VERIFIED_CAP':
        return ''

    if verdict == 'WRONG_INTERVENTION':
        for pat in ['pioglitazone', 'lobeglitazone', 'anagliptin', 'semaglutide', 'gemigliptin', 'evogliptin']:
            if pat in lower_title:
                return truncate(title)
        for sent in sents:
            low = sent.lower()
            if any(p in low for p in ['randomized to receive additional', 'randomised to receive either', 'randomized 1:1 to anagliptin', 'semaglutide or placebo', 'gemigliptin', 'evogliptin']):
                return truncate(sent)
        return truncate(title or abstract)

    if verdict == 'WRONG_COMPARATOR':
        for sent in sents:
            if 'glimepiride' in sent.lower():
                return truncate(sent)
        return truncate(title or abstract)

    if verdict == 'WRONG_POPULATION':
        for sent in [title] + sents:
            low = sent.lower()
            if any(p in low for p in ['children', 'adolescents', 'paediatric', 'pediatric', 'heart failure', 'ckd', 'chronic kidney disease', 'albuminuria', 'type 1 diabetes', 'nondiabetic', 'hNF1A'.lower(), 'mody']):
                return truncate(sent)
        return truncate(title or abstract)

    if verdict == 'NOT_RCT':
        for sent in sents:
            low = sent.lower()
            if any(p in low for p in ['post hoc', 'post-hoc', 'secondary analysis', 'subgroup analysis', 'sub-analysis', 'substudy', 'pooled', 'multiverse', 'cost-effectiveness', 'economic evaluation', 'overview', 'summary of research', 'prespecified secondary', 'exploratory analysis', 'machine learning', 'mediators', 'biomarker substudy']):
                return truncate(sent)
        return truncate(title or abstract)

    if verdict == 'ELIGIBLE_RCT_NO_PRIMARY':
        for sent in sents:
            low = sent.lower()
            if 'primary outcome' in low or 'primary endpoint' in low or 'primary end point' in low:
                return truncate(sent)
        for sent in sents:
            low = sent.lower()
            if 'random' in low and ('placebo' in low or 'controlled' in low):
                return truncate(sent)
        return truncate(title or abstract)

    if verdict == 'ELIGIBLE_RCT':
        for sent in sents:
            if any(p in sent.lower() for p in ['hospitalization for heart failure', 'hospitalisation for heart failure', 'heart failure hospitalization', 'hhf']):
                return truncate(sent)
        return truncate(title or abstract)

    return truncate(title or abstract)

def note_for(r, verdict):
    text = clean((r.get('title') or '') + ' ' + (r.get('abstract') or ''))
    low = text.lower()
    if verdict == 'REGISTRY_ONLY_NO_PUBLICATION':
        return 'NCT-only registry record; the snapshot has no PMID, no abstract, and no overall-status field.'
    if verdict == 'NOT_VERIFIED_CAP':
        return 'Not verified because NEW=523 exceeds the 150-record cap; this record falls after the cap in required sort order.'
    if verdict == 'ELIGIBLE_RCT_NO_PRIMARY':
        return 'INFERRED from the quoted record: SGLT2-placebo randomized design is present, but the abstract does not report hospitalization for heart failure.'
    if verdict == 'WRONG_INTERVENTION':
