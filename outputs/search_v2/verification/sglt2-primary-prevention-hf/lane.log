"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command '$code = @'"'
import json, re
legacy=set(['22238392','22431673','22632452','23356556','23668478','24378206','25271206','26378978','27651331','28605608','30314978','30415602','31434508','31984646','32966714','33464703','34132018','35061894','39843293','NCT02796170'])
r2=json.load(open('cache/sglt2-primary-prevention-hf/snapshots/2026-09-15r2-search_v2/records.json',encoding='utf-8'))
review=json.load(open('docs/reviews/sglt2-primary-prevention-hf/review.json',encoding='utf-8'))
accounted=set(legacy); primary=review['outcomes'][0]
for arr in ('trials','declared_absent_trials'):
    for x in primary.get(arr,[]):
        vals=[x] if not isinstance(x,dict) else [x.get(k) for k in ('pmid','nct','doi','label','id')]
        for v in vals:
            if v:
                s=str(v); accounted.add(s); accounted.add(s.replace('PMID ','').strip())
rec_by_id={str(r.get('id')):r for r in r2['records']}
def key(r): return str(r.get('pmid') or r.get('nct') or r.get('doi') or r.get('id'))
def year(r):
    try: return int(r.get('year') or 0)
    except Exception: return 0
new=[]
for d in r2['screening']['decisions']:
    if d.get('decision')=='include':
        r=rec_by_id.get(str(d.get('id')))
        if r and key(r) not in accounted:
            new.append((d,r))
new=sorted(new, key=lambda dr:(-year(dr[1]), key(dr[1])))
for i,(d,r) in enumerate(new[:80],1):
    a=re.sub(r'\\s+',' ',r.get('abstract') or '')
    print(f\"{i:03d}|{key(r)}|{r.get('id_type')}|{r.get('year')}|{d.get('rule_id')}|{r.get('title')}\")
    print(f\"PT|{'; '.join(r.get('pubtypes') or [])}\")
    print(f\"AB|{a[:450]}\")
'@
