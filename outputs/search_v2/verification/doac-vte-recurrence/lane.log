import json
from pathlib import Path
from pprint import pprint
snap_path=Path('cache/doac-vte-recurrence/snapshots/2026-09-15r2-search_v2/records.json')
review_path=Path('docs/reviews/doac-vte-recurrence/review.json')
legacy={'19966341','21128814','22449293','23808982','23991658','24344086'}
snap=json.loads(snap_path.read_text(encoding='utf-8'))
review=json.loads(review_path.read_text(encoding='utf-8'))
print('snapshot top keys', snap.keys())
records=snap.get('records') or []
decisions=snap.get('screening',{}).get('decisions') or snap.get('screening',{}).get('records') or []
print('n records', len(records), 'n decisions', len(decisions))
inc=[d for d in decisions if d.get('decision')=='include']
print('n include decisions', len(inc))
print('review top keys', review.keys())
for k,v in review.items():
    if k in ('outcomes','declared_absent_trials','primary_outcome','extraction','included_trials','trials'):
        print('\\nKEY',k, 'type', type(v).__name__)
        if isinstance(v,(list,dict)):
            pprint(v if (isinstance(v,dict) and len(v)<5) or (isinstance(v,list) and len(v)<5) else (list(v)[:5] if isinstance(v,dict) else v[:2]))
# recursive key paths for declared_absent/trials/outcomes
paths=[]
def walk(obj,path=''):
    if isinstance(obj,dict):
        for k,v in obj.items():
            if 'trial' in k.lower() or 'absent' in k.lower() or 'outcome' in k.lower():
                paths.append((path+'/'+k, type(v).__name__, (len(v) if isinstance(v,(list,dict,str)) else None)))
            walk(v,path+'/'+k)
    elif isinstance(obj,list):
        for i,v in enumerate(obj[:10]):
            walk(v,path+f'[{i}]')
walk(review)
print('\\npaths sample')
for p in paths[:100]:
    print(p)
# collect likely pooled trial ids and declared absent ids
print('\\noutcomes summary')
outs=review.get('outcomes') or []
for i,o in enumerate(outs if isinstance(outs,list) else []):
    print(i, o.get('name') or o.get('outcome') or o.get('id'), 'keys', o.keys())
    tr=o.get('trials')
    if tr is not None:
        print(' trials', len(tr), tr[:3] if isinstance(tr,list) else tr)
    da=o.get('declared_absent_trials')
    if da is not None:
        print(' declared_absent_trials', len(da), da[:3] if isinstance(da,list) else da)
# map records by key
recs_by_id={r.get('id'):r for r in records}
# what decision ids not legacy?
print('\\ninclude IDs sorted year desc/pmid')
incs=[]
for d in inc:
    r=recs_by_id.get(d.get('id')) or {}
    key=r.get('pmid') or r.get('nct') or r.get('doi') or r.get('id') or d.get('id')
    year=r.get('year')
    try: yi=int(year)
    except: yi=-9999
    ics=(yi, str(r.get('pmid') or r.get('nct') or r.get('doi') or r.get('id') or ''))
    incs.append((ics,key,d.get('id'),r.get('title'),r.get('id_type'),r.get('pmid'),r.get('nct'),d.get('rule_id'),d.get('reason')))
for _,key,*rest in sorted(incs, key=lambda x:(-x[0][0], x[0][1])):
    print(key, rest)
