    if isinstance(t, dict):
        for key in ('id', 'label', 'pmid', 'nct', 'doi'):
            val = norm_accounted(t.get(key))
            if val:
                declared.add(val)
    else:
        val = norm_accounted(t)
        if val:
            declared.add(val)

accounted = legacy | pooled | declared
includes = [d for d in snap['screening']['decisions'] if d.get('decision') == 'include']

def record_key(r):
    return norm_accounted(r.get('pmid') or r.get('nct') or r.get('doi') or r.get('id'))

new_ids = []
old_ids = []
for d in includes:
    r = records[d['id']]
    if record_key(r) in accounted:
        old_ids.append(d['id'])
    else:
        new_ids.append(d['id'])

def year_num(r):
    try:
        return int(r.get('year') or -9999)
    except Exception:
        return -9999

new_ids = sorted(new_ids, key=lambda id_: (-year_num(records[id_]), record_key(records[id_]) or ''))

