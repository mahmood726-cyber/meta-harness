codex
The r2 snapshot has 5,342 records and 84 automated includes. The served primary outcome pools the six legacy/pivotal PMIDs and has no declared-absent trials in the primary outcome, so the lane will need to classify the remaining automated includes rather than touching any pool.
exec
"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "@'
import json, re
from pathlib import Path
legacy=set(['19966341','21128814','22449293','23808982','23991658','24344086'])
snap=json.loads(Path('cache/doac-vte-recurrence/snapshots/2026-09-15r2-search_v2/records.json').read_text(encoding='utf-8'))
review=json.loads(Path('docs/reviews/doac-vte-recurrence/review.json').read_text(encoding='utf-8'))
primary=next(o for o in review['outcomes'] if o.get('primary'))
def norm(s):
    if s is None: return None
    s=str(s).strip()
    s=re.sub(r'"'^(PMID|NCT|DOI)'"\\s*[:#]?\\s*','',s,flags=re.I)
    return s.upper() if s.upper().startswith('NCT') else s
pooled=set()
for t in primary.get('trials',[]):
    for k in ('id','label','pmid','nct','doi'):
        if t.get(k): pooled.add(norm(t.get(k)))
declared=set()
for t in primary.get('declared_absent_trials',[]) or []:
    if isinstance(t,dict):
        for k in ('id','label','pmid','nct','doi'):
            if t.get(k): declared.add(norm(t.get(k)))
    else:
        declared.add(norm(t))
records=snap['records']
by_id={r['id']:r for r in records}
dec=snap['screening']['decisions']
inc=[d for d in dec if d.get('decision')=='include']
accounted=legacy|pooled|declared
new=[]
old=[]
for d in inc:
    r=by_id[d['id']]
    key=norm(r.get('pmid') or r.get('nct') or r.get('doi') or r.get('id'))
    item=(key,d,r)
    if key in accounted: old.append(item)
    else: new.append(item)
def yearnum(r):
    try: return int(r.get('year') or -9999)
    except: return -9999
new_sorted=sorted(new,key=lambda x:(-yearnum(x[2]), norm(x[2].get('pmid') or x[2].get('nct') or x[2].get('doi') or x[2].get('id')) or ''))
print('n_records',len(records))
print('n_includes',len(inc))
print('legacy',sorted(legacy))
print('pooled',sorted(pooled))
print('declared',sorted(declared))
print('already_accounted_for',len(old))
print('new',len(new_sorted))
for i,(key,d,r) in enumerate(new_sorted,1):
    abst=(r.get('abstract') or '').replace('\\n',' ')
    print(f\"{i:02d}\\t{key}\\t{r.get('id_type')}\\t{r.get('pmid')}\\t{r.get('nct')}\\t{r.get('year')}\\t{d.get('rule_id')}\\t{len(abst)}\\t{r.get('title')}\")
