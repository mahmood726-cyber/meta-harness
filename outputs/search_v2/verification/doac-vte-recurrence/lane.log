def squish(text):
    return ' '.join((text or '').split())

def combined_snapshot_source(r):
    return squish((r.get('title') or '') + ' ' + (r.get('abstract') or ''))

def registry_source(r):
    bits = [
        f\"title: {r.get('title') or ''}\",
        f\"allocation: {r.get('allocation') or ''}\",
        f\"study_type: {r.get('study_type') or ''}\",
        f\"has_results: {str(r.get('has_results'))}\",
        f\"conditions: {'; '.join(r.get('conditions') or [])}\",
        f\"interventions: {'; '.join(r.get('interventions') or [])}\",
    ]
    return squish('; '.join(bits))

def clip_at_word(text, limit=300):
    text = squish(text)
    if len(text) <= limit:
        return text
    cut = text[:limit]
    if ' ' in cut:
        cut = cut[:cut.rfind(' ')]
    return cut.rstrip(' ,;:')

def quote_from_start(source, start, limit=300):
    source = squish(source)
    start_norm = squish(start)
    idx = source.find(start_norm)
    if idx < 0:
        # ASCII fallback for >= and similar normalized source-writing mismatches.
        source_ascii = source.replace('≥', '>=').replace('≤', '<=').replace('–', '-').replace('—', '-').replace('‑', '-')
        start_ascii = start_norm.replace('≥', '>=').replace('≤', '<=').replace('–', '-').replace('—', '-').replace('‑', '-')
        idx = source_ascii.find(start_ascii)
        if idx < 0:
            raise ValueError(f'quote start not found: {start"'!r}'"')
        return clip_at_word(source_ascii[idx:idx+limit+80], limit)
    return clip_at_word(source[idx:idx+limit+80], limit)

def efetch_source_20459411():
    root = ET.fromstring(EFETCH_20459411.read_bytes())
    parts = []
    for tag in ['ArticleTitle', 'AbstractText']:
        for elem in root.iter(tag):
            val = squish(''.join(elem.itertext()))
            if val:
                parts.append(val)
    return squish(' '.join(parts))

