def year_int(value):
    try:
        return int(str(value)[:4])
    except Exception:
        return -1

legacy_accounted = {'18191732','19920054','25176939','28701470','33197395','34080008','36347265','37632463','40159390'}
includes = [d for d in snap['screening']['decisions'] if d.get('decision') == 'include']
new_ids = []
old_ids = []
for d in includes:
    r = records[d['id']]
    key = str(r.get('pmid') or r.get('nct') or r.get('doi') or r.get('id') or '')
    if key.upper().startswith('NCT'):
        key = key.upper()
    if key in legacy_accounted:
        old_ids.append(d['id'])
    else:
        new_ids.append(d['id'])
new_ids = sorted(new_ids, key=lambda rid: (-year_int(records[rid].get('year')), str(records[rid].get('pmid') or records[rid].get('id'))))

missing = sorted(set(new_ids) - set(verdict_specs))
extra = sorted(set(verdict_specs) - set(new_ids))
if missing or extra:
    raise SystemExit(f'verdict spec mismatch missing={missing} extra={extra}')

allowed = {'ELIGIBLE_RCT','ELIGIBLE_RCT_NO_PRIMARY','NOT_RCT','WRONG_POPULATION','WRONG_INTERVENTION','WRONG_COMPARATOR','WRONG_OUTCOME_ONLY','DUPLICATE_OF_ACCOUNTED','UNDECIDABLE_FROM_RECORD','NOT_VERIFIED_CAP'}
objects = []
for rid in new_ids:
    r = records[rid]
    d = decisions[rid]
    verdict, quote, note = verdict_specs[rid]
    if verdict not in allowed:
        raise SystemExit(f'bad verdict {verdict} for {rid}')
    haystack = ((r.get('title') or '') + '\\n' + (r.get('abstract') or ''))
    if quote and quote not in haystack:
        raise SystemExit(f'quote not found for {rid}: {quote}')
    obj = {
        'id': r.get('id') or '',
        'id_type': r.get('id_type') or '',
        'pmid': r.get('pmid') or '',
        'nct': r.get('nct') or '',
        'title': r.get('title') or '',
        'year': r.get('year') or '',
        'verdict': verdict,
        'quote': quote,
        'quote_source': 'snapshot abstract',
        'screen_rule': d.get('rule_id') or '',
        'screen_agrees': verdict.startswith('ELIGIBLE'),
    }
    if note:
        obj['note'] = note
    objects.append(obj)

