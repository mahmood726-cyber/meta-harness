import json, sys, re
from pathlib import Path
sys.path.insert(0,'.')
from harness import screen
from harness.pipeline import _dedup
cfg=json.loads(Path('topics/iv-iron-hfref-hosp.json').read_text(encoding='utf-8'))
legacy_data=json.loads(Path('cache/iv-iron-hfref-hosp/records.json').read_text(encoding='utf-8'))
legacy=sorted(x['id'] for x in screen.run(_dedup(legacy_data,cfg.get('pivotal_trials')),cfg)['decisions'] if x['decision']=='include')
review=json.loads(Path('docs/reviews/iv-iron-hfref-hosp/review.json').read_text(encoding='utf-8'))
primary=next(o for o in review['outcomes'] if o.get('primary'))
accounted=set(legacy)
for x in primary.get('trials',[]):
    for v in (x.get('label'), x.get('id')):
        if v:
            m=re.search(r'(\\d{6,}|NCT\\d+|10\\.\\S+)', str(v), re.I)
            accounted.add(m.group(1).upper() if m and m.group(1).upper().startswith('NCT') else (m.group(1) if m else str(v)))
for x in primary.get('declared_absent_trials',[]):
    for v in (x.get('label'), x.get('id')):
        if v:
            m=re.search(r'(\\d{6,}|NCT\\d+|10\\.\\S+)', str(v), re.I)
            accounted.add(m.group(1).upper() if m and m.group(1).upper().startswith('NCT') else (m.group(1) if m else str(v)))
snap=json.loads(Path('cache/iv-iron-hfref-hosp/snapshots/2026-09-15r2-search_v2/records.json').read_text(encoding='utf-8'))
records=snap['records']
byid={r.get('id'):r for r in records}
decisions=snap['screening']['decisions']
includes=[d for d in decisions if d.get('decision')=='include']
def key_for(r):
    return str(r.get('pmid') or r.get('nct') or r.get('doi') or r.get('id') or '').upper() if str(r.get('nct') or '').upper().startswith('NCT') and not r.get('pmid') else str(r.get('pmid') or r.get('nct') or r.get('doi') or r.get('id') or '')
new=[]
old=[]
for d in includes:
    r=byid[d['id']]
    k=key_for(r)
    if k in accounted:
        old.append((d['id'], k, r.get('title')))
    else:
        new.append((d,r,k))
print('legacy', legacy)
print('accounted', sorted(accounted))
print('n_records', len(records), 'n_inc', len(includes), 'n_old', len(old), 'NEW', len(new))
print('old ids', [x[0] for x in old])
print('\\nNEW DETAILS')
for d,r,k in sorted(new, key=lambda drk: (-(drk[1].get('year') or 0), str(drk[1].get('pmid') or drk[1].get('id')))):
    print('='*80)
    print('ID', r.get('id'), 'key', k, 'id_type', r.get('id_type'), 'pmid', r.get('pmid'), 'nct', r.get('nct'), 'doi', r.get('doi'), 'year', r.get('year'))
    print('title:', r.get('title'))
    print('journal:', r.get('journal'))
    print('pubtypes:', r.get('pubtypes'))
    print('found_by:', r.get('found_by'))
    print('screen:', d.get('rule_id'), d.get('reason'), 'span:', d.get('span'))
    abs=(r.get('abstract') or '').replace('\\n',' ')
    print('abstract_len', len(abs))
    print(abs[:2500])
