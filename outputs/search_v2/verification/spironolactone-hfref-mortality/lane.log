def find_quote(text, needle):
    if not needle:
        return ''
    if needle in text:
        return needle
    def norm_map(s):
        out=[]; pos=[]; last=False
        for i,ch in enumerate(s):
            if ch.isspace():
                if not last:
                    out.append(' '); pos.append(i); last=True
            else:
                out.append(ch); pos.append(i); last=False
        return ''.join(out), pos
    nt, mp = norm_map(text)
    nn = ' '.join(needle.split())
    idx = nt.find(nn)
    if idx < 0:
        idx = nt.lower().find(nn.lower())
    if idx < 0:
        raise AssertionError('quote needle not found: '+needle)
    start = mp[idx]
    end = mp[idx+len(nn)-1]+1
    return text[start:end]

