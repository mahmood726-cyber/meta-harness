.\cache\probiotics-aad-prevention\diagnostic-2026-09-15\raw\2026-09-15-ctgov-search-page-1-a7d4e49223a0112d.json:11:{"protocolSection":{"identificationModule":{"nctId":"NCT01143623","orgStudyIdInfo":{"id":"09-SBC-2-DAN-03"},"organization":{"fullName":"Changhai Hospital","class":"OTHER"},"briefTitle":"Dose Response Effect of Probiotics for the Prevention of Antibiotic-associated Diarrhea in Chinese Adults","officialTitle":"Dose Response Effect of a Proprietary Probiotic Formula for the Prevention of Antibiotic-associated Diarrhea in Chinese Adults"},"statusModule":{"statusVerifiedDate":"2011-09","overallStatus":"COMPLETED","expandedAccessInfo":{"hasExpandedAccess":false},"startDateStruct":{"date":"2010-05"},"primaryCompletionDateStruct":{"date":"2011-07","type":"ACTUAL"},"completionDateStruct":{"date":"2011-07","type":"ACTUAL"},"studyFirstSubmitDate":"2010-06-11","studyFirstSubmitQcDate":"2010-06-11","studyFirstPostDateStruct":{"date":"2010-06-14","type":"ESTIMATED"},"lastUpdateSubmitDate":"2011-09-19","lastUpdatePostDateStruct":{"date":"2011-09-20","type":"ESTIMATED"}},"sponsorCollaboratorsModule":{"responsibleParty":{"type":"PRINCIPAL_INVESTIGATOR","investigatorFullName":"Cai DongLian","investigatorTitle":"Professor","investigatorAffiliation":"Changhai Hospital"},"leadSponsor":{"name":"Changhai Hospital","class":"OTHER"}},"oversightModule":{"oversightHasDmc":false},"descriptionModule":{"briefSummary":"The purpose of this study is to determine the dose response effect of probiotic capsules for the prevention of antibiotic-associated diarrhea (AAD)."},"conditionsModule":{"conditions":["Antibiotic-associated Diarrhea"],"keywords":["antibiotic","diarrhea","probiotic"]},"designModule":{"studyType":"INTERVENTIONAL","phases":["PHASE2","PHASE3"],"designInfo":{"allocation":"RANDOMIZED","interventionModel":"PARALLEL","primaryPurpose":"PREVENTION","maskingInfo":{"masking":"QUADRUPLE","whoMasked":["PARTICIPANT","CARE_PROVIDER","INVESTIGATOR","OUTCOMES_ASSESSOR"]}},"enrollmentI