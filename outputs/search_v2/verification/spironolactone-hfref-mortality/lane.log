import json, sys
from pathlib import Path
import xml.etree.ElementTree as ET
sys.path.insert(0,'.')
from harness import screen
from harness.pipeline import _dedup

slug='spironolactone-hfref-mortality'
out_dir=Path('lane_v')
raw_dir=out_dir/(slug+'-raw')
out_dir.mkdir(exist_ok=True)
raw_dir.mkdir(parents=True, exist_ok=True)

cfg=json.load(open('topics/'+slug+'.json',encoding='utf-8'))
legacy=json.load(open('cache/'+slug+'/records.json',encoding='utf-8'))
legacy_inc={x['id'] for x in screen.run(_dedup(legacy, cfg.get('pivotal_trials')),cfg)['decisions'] if x['decision']=='include'}
review=json.load(open('docs/reviews/'+slug+'/review.json',encoding='utf-8'))
primary=next(o for o in review['outcomes'] if o.get('primary'))
def norm_ident(v):
    if v is None:
        return None
    s=str(v).strip()
    if s.upper().startswith('PMID '):
        s=s.split(None,1)[1]
    return s
pooled={norm_ident(t.get('label') or t.get('id')) for t in primary.get('trials',[])}
absent={norm_ident(t.get('label') or t.get('id')) for t in primary.get('declared_absent_trials',[])}
accounted=legacy_inc|pooled|absent
snap=json.load(open('cache/'+slug+'/snapshots/2026-09-15r2-search_v2/records.json',encoding='utf-8'))
records=snap['records']
decisions=snap['screening']['decisions']
rec_by_id={str(r.get('id')):r for r in records}
include_rows=[]
for d in decisions:
    if d.get('decision')=='include':
        r=rec_by_id[str(d.get('id'))]
        key=str(r.get('pmid') or r.get('nct') or r.get('doi') or r.get('id'))
        include_rows.append((key,r,d))
new=[(key,r,d) for key,r,d in include_rows if key not in accounted]
new=sorted(new, key=lambda x: (-(int(x[1].get('year') or 0)), str(x[1].get('pmid') or x[1].get('nct') or x[1].get('doi') or x[1].get('id'))))
N=len(new)
if len(records)"'!=8105 or len(include_rows)!=76 or (len(include_rows)-N)!=3 or N!=73:
    raise SystemExit(f'"'denominator changed: records={len(records)} includes={len(include_rows)} accounted={len(include_rows)-N} new={N}')

def efetch_abstract(pmid):
    path=raw_dir/(pmid+'.xml')
    root=ET.parse(path).getroot()
    parts=[]
    for elem in root.findall('.//AbstractText'):
        label=elem.attrib.get('Label')
        text=''.join(elem.itertext()).strip()
        parts.append((label+': '+text) if label else text)
    return ' '.join(parts)

