 derived from the study shall be submitted to Bio-K+. Bio-K+ will have 15 business days to give comments to the Investigator.This review is no way intended to restrict publication of facts or opinions formulated by the Investigator through this research."},"pointOfContact":{"title":"Dr. Serge Carrière","organization":"Bio-K+ International Inc.","email":"scarriere@biokplus.com","phone":"450-978-2465"}}},"derivedSection":{"miscInfoModule":{"versionHolder":"2026-09-14"},"conditionBrowseModule":{"meshes":[{"id":"D003967","term":"Diarrhea"},{"id":"D003015","term":"Clostridium Infections"}],"ancestors":[{"id":"D012817","term":"Signs and Symptoms, Digestive"},{"id":"D012816","term":"Signs and Symptoms"},{"id":"D013568","term":"Pathological Conditions, Signs and Symptoms"},{"id":"D016908","term":"Gram-Positive Bacterial Infections"},{"id":"D001424","term":"Bacterial Infections"},{"id":"D001423","term":"Bacterial Infections and Mycoses"},{"id":"D007239","term":"Infections"}]}},"hasResults":true},
.\cache\probiotics-aad-prevention\diagnostic-2026-09-15\raw\2026-09-15-ctgov-search-page-1-a7d4e49223a0112d.json:24:{"protocolSection":{"identificationModule":{"nctId":"NCT01414010","orgStudyIdInfo":{"id":"2010P000319"},"organization":{"fullName":"Beth Israel Deaconess Medical Center","class":"OTHER"},"briefTitle":"Effects of Pre-, Pro- & Anti-biotics on Gut Microbiota","officialTitle":"Effects of Mushroom Extract, S Boulardii and Amoxicillin on the Human Microbiome"},"statusModule":{"statusVerifiedDate":"2017-06","overallStatus":"COMPLETED","expandedAccessInfo":{"hasExpandedAccess":false},"startDateStruct":{"date":"2011-08"},"primaryCompletionDateStruct":{"date":"2012-02","type":"ACTUAL"},"completionDateStruct":{"date":"2012-02","type":"ACTUAL"},"studyFirstSubmitDate":"2011-08-05","studyFirstSubmitQcDate":"2011-08-10","studyFirstPostDateStruct":{"date":"2011-08-11","type":"ESTIMATED"},"resultsFirstSubmitDate":"2015-12-29","resultsFirstSubmitQcDate":"2017-06-25","resultsFirstPostDateStruct":{"date":"2017-07-24","type":"ACTUAL"},"lastUpdateSubmitDate":"2017-06-25","lastUpdatePostDateStruct":{"date":"2017-07-24","type":"ACTUAL"}},"sponsorCollaboratorsModule":{"responsibleParty":{"type":"PRINCIPAL_INVESTIGATOR","investigatorFullName":"Ciaran Kelly","investigatorTitle":"Professor of Medicine","investigatorAffiliation":"Beth Israel Deaconess Medical Center"},"leadSponsor":{"name":"Beth Israel Deaconess Medical Center","class":"OTHER"},"collaborators":[{"name":"Hong Kong Association for Health Care","class":"UNKNOWN"},{"name":"Integrated Chinese Medicine Holdings","class":"UNKNOWN"}]},"oversightModule":{"oversightHasDmc":false},"descriptionModule":{"briefSummary":"The purpose of this study is to compare and contrast the effects of a prebiotic (Trametes Versicolor), a probiotic (Saccharomyces boulardii) and an antibiotic (amoxicillin) on the gut microbiota of healthy volunteers. It is expected that treatment will result in the rapid and reproducible alterations in fecal microbiota that will spontaneously reverse in the weeks after treatment is discontinued."},"conditionsModule":{"conditions":["Human Gut Microbiota"],"keywords":["healthy volunteers","gut microbiota","gut microbiome","prebiotic","probiotic","antibiotic","antibiotic-associated diarrhea","intestinal bacterial overgrowth"]},"designModule":{"studyType":"INTERVENTIONAL","phases":["NA"],"designInfo":{"allocation":"RANDOMIZED","interventionModel":"PARALLEL","primaryPurpose":"BASIC_SCIENCE","maskingInfo":{"masking":"NONE"}},"enrollmentInfo":{"count":32,"type":"ACTUAL"}},"armsInterventionsModule":{"armGroups":[{"label":"Prebiotic","type":"ACTIVE_COMPARATOR","interventionNames":["Dietary Supplement: Trametes versicolor extract"]},{"label":"Probiotic","type":"ACTIVE_COMPARATOR","interventionNames":["Dietary Supplement: Saccharomyces boulardii"]},{"label":"Antibiotic","type":"ACTIVE_COMPARATOR","interventionNames":["Drug: Amoxicillin"]},{"label":"Control","type":"NO_INTERVENTION","description":"Control group, no intervention given."}],"interventions":[{"type":"DIETARY_SUPPLEMENT","name":"Trametes versicolor extract","description":"1,200 mg, 3 times daily on an empty stomach for 14 days","armGroupLabels":["Prebiotic"],"otherNames":["turkey tail"]},{"type":"DIETARY_SUPPLEMENT","name":"Saccharomyces boulardii","description":"250 mg, 3 times daily on an empty stomach for 14 days","armGroupLabels":["Probiotic"]},{"type":"DRUG","name":"Amoxicillin","description":"250 mg 3 times daily at least 1 hour before meals for 7 days","armGroupLabels":["Antibiotic"]}]},"outcomesModule":{"primaryOutcomes":[{"measure":"Bacteria Prevalence in Stool","description":"The most prevalent bacterial genera within the study population\n\nBefore Treatment: Average of Day -7 and Day 0 During Treatment: Average of Days 10 and 14 After Treatment: Average of Days 21, 28, and 56","timeFrame":"Day 0 to 56"}]},"eligibilityModule":{"eligibilityCriteria":"Inclusion Criteria:\n\n* Age 18 to 39 years (male or female)\n* Good general health\n* Able to comply with study requirements and to provide informed consent\n* For women of childbearing potential\n* A negative urine pregnancy test immediately prior to starting the study treatment\n* Agreement to comply with approved methods of contraception during the period of active study treatment (not required during follow-up)\n\nExclusion Criteria:\n\n* Any diagnosed autoimmune disease\n* History of organ transplantation\n* Known chronic or recurrent systemic disorder associated with immunocompromise\n* A history of allergy or hypersensitivity to mushroom or mushroom extract, brewer's or baker's yeast or to penicillins or cephalosporins (including amoxicillin).\n* History of severe allergic reaction (requiring hospital admission and/or the administration of parenteral medication or associated with dyspnoea, wheezing, hypotension, loss of consciousness).\n* Systemic antibacterial therapy during the 3 months prior to study enrollment\n* New prescription medications during the 4 weeks prior to study enrollment\n* Prescription or OTC medications or supplements that are known to alter gut function or microflora (i.e. acid antisecretory drugs, probiotics) during the 4 weeks prior to study enrollment\n* Active gastrointestinal or metabolic disease\n* Prior gastrointestinal surgery (apart from appendectomy or cholecystectomy)\n* History of chronic constipation with passage of fewer than 3 spontaneous bowel movements per week on average or chronic or recurrent diarrhea with spontaneous bowel movements more often than 3 times daily\n* Any condition or personal circumstance that, in the opinion of the investigator, renders the subject unlikely or unable to comply with the full study protocol.","healthyVolunteers":true,"sex":"ALL","minimumAge":"18 Years","maximumAge":"39 Years","stdAges":["ADULT"]},"contactsLocationsModule":{"overallOfficials":[{"name":"Ciaran P Kelly, MD","affiliation":"Beth Israel Deaconess Medical Center","role":"PRINCIPAL_INVESTIGATOR"}],"locations":[{"facility":"Beth Israel Deaconess Medical Center","city":"Boston","state":"Massachusetts","zip":"02215","country":"United States","geoPoint":{"lat":42.35843,"lon":-71.05977}}]}},"resultsSection":{"participantFlowModule":{"groups":[{"id":"FG000","title":"Prebiotic","description":"Trametes versicolor extract: 1,200 mg, 3 times daily on an empty stomach for 14 days"},{"id":"FG001","title":"Probiotic","description":"Saccharomyces boulardii: 250 mg, 3 times daily on an empty stomach for 14 days"},{"id":"FG002","title":"Antibiotic","description":"Amoxicillin: 250 mg 3 times daily at least 1 hour before meals for 7 days"},{"id":"FG003","title":"Control","description":"Control group, no intervention given."}],"periods":[{"title":"Overall Study","milestones":[{"type":"STARTED","achievements":[{"groupId":"FG000","numSubjects":"8"},{"groupId":"FG001","numSubjects":"8"},{"groupId":"FG002","numSubjects":"8"},{"groupId":"FG003","numSubjects":"8"}]},{"type":"COMPLETED","achievements":[{"groupId":"FG000","numSubjects":"6"},{"groupId":"FG001","numSubjects":"8"},{"groupId":"FG002","numSubjects":"8"},{"groupId":"FG003","numSubjects":"8"}]},{"type":"NOT COMPLETED","achievements":[{"groupId":"FG000","numSubjects":"2"},{"groupId":"FG001","numSubjects":"0"},{"groupId":"FG002","numSubjects":"0"},{"groupId":"FG003","numSubjects":"0"}]}]}]},"baselineCharacteristicsModule":{"groups":[{"id":"BG000","title":"Prebiotic","description":"Trametes versicolor extract: 1,200 mg, 3 times daily on an empty stomach for 14 days"},{"id":"BG001","title":"Probiotic","description":"Saccharomyces boulardii: 250 mg, 3 times daily on an empty stomach for 14 days"},{"id":"BG002","title":"Antibiotic","description":"Amoxicillin: 250 mg 3 times daily at least 1 hour before meals for 7 days"},{"id":"BG003","title":"Control","description":"Control group, no intervention given."},{"id":"BG004","title":"Total","description":"Total of all reporting groups"}],"denoms":[{"units":"Participants","coun