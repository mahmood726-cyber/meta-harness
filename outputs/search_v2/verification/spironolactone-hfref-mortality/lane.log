,"keywords":["human Gut Microbiota","gut microbiota","gut microbiome","probiotic","antibiotic","antibiotic-associated diarrhea","intestinal bacterial overgrowth"]},"designModule":{"studyType":"INTERVENTIONAL","phases":["NA"],"designInfo":{"allocation":"RANDOMIZED","interventionModel":"PARALLEL","primaryPurpose":"BASIC_SCIENCE","maskingInfo":{"masking":"NONE"}},"enrollmentInfo":{"count":53,"type":"ACTUAL"}},"armsInterventionsModule":{"armGroups":[{"label":"prebiotic (Saccharomyces boulardii)","type":"ACTIVE_COMPARATOR","description":"500 mg, 2 times daily for 14 days","interventionNames":["Dietary Supplement: Saccharomyces boulardii"]},{"label":"antibiotic (Amoxicillin Clavulanate)","type":"ACTIVE_COMPARATOR","description":"875/125 mg 2 times daily at least 1 hour before meals for 7 days","interventionNames":["Drug: Amoxicillin Clavulanate"]},{"label":"combination (prebiotic and antibiotic)","type":"ACTIVE_COMPARATOR","description":"Amoxicillin Clavulanate for 7 days (days 1 to 7; 875/125 mg 2 times daily at least 1 hour before meals) in addition to the dietary supplement Saccharomyces boulardii for 14 days (days 1 to 14; 500 mg, 2 times daily).","interventionNames":["Dietary Supplement: Saccharomyces boulardii","Drug: Amoxicillin Clavulanate"]},{"label":"control","type":"NO_INTERVENTION"}],"interventions":[{"type":"DIETARY_SUPPLEMENT","name":"Saccharomyces boulardii","description":"500 mg, 2 times daily for 14 days","armGroupLabels":["combination (prebiotic and antibiotic)","prebiotic (Saccharomyces boulardii)"]},{"type":"DRUG","name":"Amoxicillin Clavulanate","description":"875/125 mg 2 times daily at least 1 hour before meals for 7 days","armGroupLabels":["antibiotic (Amoxicillin Clavulanate)","combination (prebiotic and antibiotic)"]}]},"outcomesModule":{"primaryOutcomes":[{"measure":"Gastrointestinal Symptom Rating Scale","description":"Mean Gastrointestinal Symptom Rating Scale scores Range from 15 to 90 Increasing score means increasing symptoms","timeFrame":"Day 0"},{"measure":"Gastrointestinal Symptom Rating Scale","description":"Mean Gastrointestinal Symptom Rating Scale scores Range from 15 to 90 Increasing score means increasing symptoms","timeFrame":"Day 7"},{"measure":"Gastrointestinal Symptoms Response Score","description":"Mean Gastrointestinal Symptom Rating Scale scores Range from 15 to 90 Increasing score means increasing symptoms","timeFrame":"Day 14"},{"measure":"Gastrointestinal Symptoms Response Scale","description":"Mean Gastrointestinal Symptom Rating Scale scores Range from 15 to 90 Increasing score means increasing symptoms","timeFrame":"Day 21"},{"measure":"Prevalence of Escherichia in Stool","description":"Control arm was not assessed as there was no intervention for this group.\n\nBefore Treatment: Average of Day -7 and Day 0 During Treatment: Average of Day 3, Day 7, Day 10, Day 13 After Treatment: Average of Day 21","timeFrame":"Day -7 to Day 21"},{"measure":"Operational Taxonomic Units","description":"Core Microbiome includes control samples and baseline samples (Day -7 and Day 0) for antibiotic, probiotic, and combination groups. Data for Core microbiome for individual arms are not available.\n\nBefore Treatment: Average of Day -7 and Day 0 During Treatment: Average of Day 3, Day 7, Day 10, Day 13 After Treatment: Average of Day 21","timeFrame":"Day 0 to Day 21"}]},"eligibilityModule":{"eligibilityCriteria":"Inclusion Criteria:\n\n* Age 18 to 65 years (male or female)\n* Good general health\n* Able to comply with study requirements and to provide informed consent\n* For women of childbearing potential oA negative urine pregnancy test immediately prior to starting the study treatment oAgreement to comply with approved methods of contraception during the period of active study treatment (not required during follow-up)\n\nExclusion Criteria:\n\n* History of organ transplantation\n* Known chronic or recurrent systemic disorder associated with immunocompromise\n* A history of allergy or hypersensitivity to Saccharomyces boulardii, brewer's or baker's yeast, amoxicillin, penicillins, or cephalosporins\n* History of severe allergic reaction (requiring hospital admission and/or the administration of parenteral medication or associated with dyspnoea, wheezing, hypotension, loss of consciousness).\n* Oral or systemic antibacterial therapy during the 3 months prior to study enrollment\n* New prescription medications during the 4 weeks prior to study enrollment\n* Prescription, OTC medications or supplements that are known to alter gut function or microflora (i.e. acid antisecretory drugs, probiotics) during the 4 weeks prior to study enrollment\n* Active gastrointestinal disease\n* Patients with a central venous catheter\n* Patients taking antifungals or laxatives within 14 days of enrolment\n* Patients enrolled in other clinical trials within the past 60 days\n* Prior gastrointestinal surgery (apart from appendectomy or cholecystectomy)\n* History of chronic constipation with passage of fewer than 3 bowel movements per week on average\n* Any condition or personal circumstance that, in the opinion of the investigator, renders the subject unlikely or unable to comply with the full study protocol.","healthyVolunteers":true,"sex":"ALL","minimumAge":"18 Years","maximumAge":"65 Years","stdAges":["ADULT","OLDER_ADULT"]},"contactsLocationsModule":{"overallOfficials":[{"name":"Ciaran P Kelly, MD","affiliation":"Beth Israel Deaconess Medical Center","role":"PRINCIPAL_INVESTIGATOR"}],"locations":[{"facility":"Beth Israel Deaconess Medical Center","city":"Boston","state":"Massachusetts","zip":"02215","country":"United States","geoPoint":{"lat":42.35843,"lon":-71.05977}}]},"referencesModule":{"references":[{"pmid":"30881353","type":"DERIVED","citation":"Kelly CP, Chong Nguyen C, Palmieri LJ, Pallav K, Dowd SE, Humbert L, Seksik P, Bado A, Coffin B, Rainteau D, Kabbani T, Duboc H. Saccharomyces boulardii CNCM I-745 Modulates the Fecal Bile Acids Metabolism During Antimicrobial T