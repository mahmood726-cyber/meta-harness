from harness import screen
from harness.pipeline import _dedup
cfg=json.load(open('topics/sglt2-ckd-progression.json',encoding='utf-8'))
legacy=set(x['id'] for x in screen.run(_dedup(json.load(open('cache/sglt2-ckd-progression/records.json',encoding='utf-8')), cfg.get('pivotal_trials')),cfg)['decisions'] if x['decision']=='include')
review=json.load(open('docs/reviews/sglt2-ckd-progression/review.json',encoding='utf-8'))
primary=next(o for o in review['outcomes'] if o.get('primary'))
accounted=set(legacy)
accounted.update(re.sub(r'"'^PMID'"\\s+','',t.get('id','')) for t in primary.get('trials',[]))
accounted.update(re.sub(r'"'^PMID'"\\s+','',t.get('id','')) for t in primary.get('declared_absent_trials',[]))
snap=json.load(open('cache/sglt2-ckd-progression/snapshots/2026-09-15r2-search_v2/records.json',encoding='utf-8'))
dec={d['id']:d for d in snap['screening']['decisions']}
rows=[]
for r in snap['records']:
    if r.get('id_type')=='nct' and dec.get(r.get('id'),{}).get('decision')=='include':
        key=str(r.get('pmid') or r.get('nct') or r.get('doi') or r.get('id') or '')
        if key not in accounted:
            rows.append((int(r.get('year') or 0), r.get('nct'), r.get('title'), r.get('conditions'), r.get('interventions'), r.get('allocation'), r.get('masking'), r.get('has_results')))
rows.sort(key=lambda x:(-x[0], x[1] or ''))
print('nct_new', len(rows))
for row in rows:
    print(json.dumps({'year':row[0],'nct':row[1],'title':row[2],'conditions':row[3],'interventions':row[4],'allocation':row[5],'masking':row[6],'has_results':row[7]}, ensure_ascii=False))
