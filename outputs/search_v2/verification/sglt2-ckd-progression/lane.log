ctgov_cache = {}
def fetch_ctgov(nct):
    out = RAW / f'ctgov_{nct}.json'
    url = f'https://clinicaltrials.gov/api/v2/studies/{nct}'
    req = urllib.request.Request(url, headers={'User-Agent':'meta-harness-lane-v/1.0'})
    with urllib.request.urlopen(req, timeout=30) as resp:
        body = resp.read()
    out.write_bytes(body)
    data = json.loads(body.decode('utf-8'))
    ctgov_cache[nct] = (out, data)
    time.sleep(0.12)
    return out, data

