def clean_text(rec):
    title = rec.get('title') or ''
    ab = rec.get('abstract') or ''
    ab = re.sub(r'<["'^>]+>'"', ' ', ab)
    return html.unescape(re.sub(r'\\s+', ' ', f'{title}. {ab}')).strip()

def trim_quote(q, limit=300):
    q = re.sub(r'\\s+', ' ', q).strip()
    if len(q) <= limit:
        return q
    cut = q[:limit]
    last = max(cut.rfind('. '), cut.rfind('; '), cut.rfind(', '))
    if last >= 120:
        cut = cut[:last+1]
    return cut.strip()

def quote_around(text, terms, limit=300):
    low = text.lower()
    for term in terms:
        idx = low.find(term.lower())
        if idx >= 0:
            start = max(0, idx - 90)
            # Prefer starting after a nearby heading/sentence boundary.
            for sep in ['. ', ' METHODS: ', ' BACKGROUND: ', ' AIMS: ', ' AIM: ', ' OBJECTIVE: ', ' INTRODUCTION: ', ' DESIGN: ']:
                j = text.rfind(sep, 0, idx)
                if j >= 0 and idx - j < 140:
                    start = j + (2 if sep == '. ' else len(sep))
                    break
            end = min(len(text), start + limit)
            # Extend to a nearby sentence boundary if possible without exceeding too much.
            boundary = text.find('. ', idx)
            if boundary "'!= -1 and boundary + 1 - start <= limit:
                end = boundary + 1
            return trim_quote(text[start:end], limit)
    return trim_quote(text[:limit], limit)

def duplicate_terms_for(pmid):
    target = duplicate_target[pmid]
    if '"'DAPA-CKD' in target:
        return ['NCT03036150', 'DAPA-CKD', 'Dapagliflozin and Prevention of Adverse Outcomes']
    if 'CREDENCE' in target:
        return ['NCT02065791', 'CREDENCE', 'Canagliflozin and Renal Events']
    if 'EMPA-KIDNEY' in target:
        return ['NCT03594110', 'EMPA-KIDNEY', 'Study of Heart and Kidney Protection']
    return ['NCT06350123']

