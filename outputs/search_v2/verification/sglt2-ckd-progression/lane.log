cache\sglt2-ckd-progression\snapshots\2026-09-15r2-search_v2\retrieval_ledger.json:51169:      "query": "NCT:NCT06326034 OR NCT:NCT06344247 OR NCT:NCT06350123 OR NCT:NCT06374043 OR NCT:NCT06391450 OR NCT:NCT06398977 OR NCT:NCT06421870 OR NCT:NCT06430684 OR NCT:NCT06432751 OR NCT:NCT06435858 OR NCT:NCT06453161 OR NCT:NCT06483074 OR NCT:NCT06499948 OR NCT:NCT06527846 OR NCT:NCT06528405 OR NCT:NCT06531824 OR NCT:NCT06532682 OR NCT:NCT06560801 OR NCT:NCT06572215 OR NCT:NCT06610526 OR NCT:NCT06614712 OR NCT:NCT06625073 OR NCT:NCT06639087 OR NCT:NCT06642272 OR NCT:NCT06642623 OR NCT:NCT06653738 OR NCT:NCT06668753 OR NCT:NCT06676384 OR NCT:NCT06742723 OR NCT:NCT06759077 OR NCT:NCT06813222 OR NCT:NCT06818305 OR NCT:NCT06820567 OR NCT:NCT06821919 OR NCT:NCT06825156 OR NCT:NCT06825676 OR NCT:NCT06843902 OR NCT:NCT06890143 OR NCT:NCT06897605 OR NCT:NCT06902493 OR NCT:NCT06913647 OR NCT:NCT06926660 OR NCT:NCT06929169 OR NCT:NCT06942910 OR NCT:NCT06954090 OR NCT:NCT06982079 OR NCT:NCT06983054 OR NCT:NCT07025629 OR NCT:NCT07032116 OR NCT:NCT07035834",
