    rec_id = rec.get('id') or rec.get('pmid') or rec.get('nct') or rec.get('doi')
    dec = decisions.get(rec.get('id'), {})
    if rec.get('id_type') == 'nct' and not rec.get('pmid'):
        verdict = 'REGISTRY_ONLY_NO_PUBLICATION'
        nct = rec.get('nct') or rec.get('id')
        raw_path, data = fetch_ctgov(nct)
        ps = data.get('protocolSection', {})
        status = ps.get('statusModule', {}).get('overallStatus', '')
        conditions = ps.get('conditionsModule', {}).get('conditions') or rec.get('conditions') or []
        interventions_raw = ps.get('armsInterventionsModule', {}).get('interventions') or []
        interventions = [x.get('name','') for x in interventions_raw if isinstance(x, dict) and x.get('name')] or rec.get('interventions') or []
        quote = trim_quote('overallStatus: {}; conditions: {}; interventions: {}'.format(status, ', '.join(conditions), ', '.join(interventions)), 300)
        quote_source = f'ctgov fetch (lane_v/sglt2-ckd-progression-raw/{raw_path.name})'
        note = 'NCT-only registry record with no PMID in the snapshot; this is not a publication report.'
    else:
        pmid = str(rec.get('pmid') or rec_id)
        if pmid not in manual_verdict:
            raise RuntimeError(f'Missing manual verdict for PMID {pmid}')
        verdict = manual_verdict[pmid]
        text = clean_text(rec)
        terms = quote_terms.get(pmid)
        if verdict == 'DUPLICATE_OF_ACCOUNTED':
            terms = duplicate_terms_for(pmid)
        quote = quote_around(text, terms or [rec.get('title') or ''], 300)
        quote_source = 'snapshot abstract'
        note = ''
        if verdict == 'DUPLICATE_OF_ACCOUNTED':
            target = duplicate_target[pmid]
            duplicate_pairs.append((pmid, target, rec.get('title') or ''))
            note = f'Same trial/acronym or registration as {target}; not a new independent trial for pooling.'
        elif verdict == 'ELIGIBLE_RCT_NO_PRIMARY':
            note = 'Eligible P/I/C/design, but the quoted abstract reports a non-primary or surrogate/mechanistic outcome rather than the protocol primary kidney composite.'
        elif verdict == 'ELIGIBLE_RCT':
            note = 'Eligible P/I/C/design and the quoted abstract reports a kidney-function-decline outcome.'
            eligible_rct_ids.append((pmid, rec.get('title') or ''))
        elif verdict == 'UNDECIDABLE_FROM_RECORD':
            note = 'The abstract does not state masking and uses the comparator wording placebo/control, so double-blind placebo-controlled eligibility is not settled by the record.'
        elif verdict.startswith('WRONG_'):
            note = 'The quoted record text fails the named PICO/outcome axis.'
        elif verdict == 'NOT_RCT':
            note = 'The quoted record text is a design/baseline, pooled, model, consensus, subgroup, or secondary report rather than a new primary RCT report.'
    obj = {
        'id': rec_id,
        'id_type': rec.get('id_type') or '',
        'pmid': rec.get('pmid') or '',
        'nct': rec.get('nct') or '',
        'title': rec.get('title') or '',
        'year': rec.get('year') or '',
        'verdict': verdict,
        'quote': quote,
        'quote_source': quote_source,
        'screen_rule': dec.get('rule_id') or '',
        'screen_agrees': verdict.startswith('ELIGIBLE'),
    }
    if note:
        obj['note'] = note
    if verdict not in valid:
        raise RuntimeError(f'Bad verdict {verdict}')
    if verdict not in {'UNDECIDABLE_FROM_RECORD', 'NOT_VERIFIED_CAP'} and not quote:
        raise RuntimeError(f'Missing quote for {rec_id}')
    if quote and len(quote) > 300:
        raise RuntimeError(f'Quote too long for {rec_id}: {len(quote)}')
    objects.append(obj)

if len(objects) "'!= len(new_records):
    raise RuntimeError((len(objects), len(new_records)))

counts = Counter(o['"'verdict'] for o in objects)
wrong_count = sum(counts[k] for k in ['WRONG_POPULATION','WRONG_INTERVENTION','WRONG_COMPARATOR','WRONG_OUTCOME_ONLY'])
first_line = (
    f\"V-sglt2-ckd-progression VERDICTS: NEW {len(objects)}; \"
    f\"ELIGIBLE_RCT {counts['ELIGIBLE_RCT']}; \"
    f\"ELIGIBLE_RCT_NO_PRIMARY {counts['ELIGIBLE_RCT_NO_PRIMARY']}; \"
    f\"NOT_RCT {counts['NOT_RCT']}; \"
    f\"WRONG_* {wrong_count}; \"
    f\"DUPLICATE_OF_ACCOUNTED {counts['DUPLICATE_OF_ACCOUNTED']}; \"
    f\"UNDECIDABLE {counts['UNDECIDABLE_FROM_RECORD']}; \"
    f\"NOT_VERIFIED_CAP {counts['NOT_VERIFIED_CAP']}; \"
    f\"REGISTRY_ONLY {counts['REGISTRY_ONLY_NO_PUBLICATION']}\"
)
category_sum = counts['ELIGIBLE_RCT'] + counts['ELIGIBLE_RCT_NO_PRIMARY'] + counts['NOT_RCT'] + wrong_count + counts['DUPLICATE_OF_ACCOUNTED'] + counts['UNDECIDABLE_FROM_RECORD'] + counts['NOT_VERIFIED_CAP'] + counts['REGISTRY_ONLY_NO_PUBLICATION']
if category_sum "'!= len(objects):
    raise RuntimeError((category_sum, len(objects)))

OUT_JSON.write_text(json.dumps(objects, ensure_ascii=False, indent=2) + '"'\\n', encoding='utf-8')

