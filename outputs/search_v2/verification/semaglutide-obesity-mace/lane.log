"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "python -c @'
import json
import pathlib
import re
import sys
from collections import Counter

sys.path.insert(0, '.')
from harness import screen
from harness.pipeline import _dedup

slug = 'semaglutide-obesity-mace'
snap_path = pathlib.Path('cache') / slug / 'snapshots' / '2026-09-15r2-search_v2' / 'records.json'
legacy_path = pathlib.Path('cache') / slug / 'records.json'
topic_path = pathlib.Path('topics') / f'{slug}.json'
review_path = pathlib.Path('docs') / 'reviews' / slug / 'review.json'
raw_dir = pathlib.Path('lane_v') / f'{slug}-raw'
out_json = pathlib.Path('lane_v') / f'{slug}.json'
out_report = pathlib.Path(f'LANE-V-{slug}-REPORT.md')
raw_dir.mkdir(parents=True, exist_ok=True)

cfg = json.load(open(topic_path, encoding='utf-8'))
legacy = json.load(open(legacy_path, encoding='utf-8'))
legacy_decisions = screen.run(_dedup(legacy, cfg.get('pivotal_trials')), cfg)['decisions']
legacy_includes = sorted(x['id'] for x in legacy_decisions if x['decision'] == 'include')

review = json.load(open(review_path, encoding='utf-8'))
accounted = set(legacy_includes)
accounted_trials = []
for outcome in review.get('outcomes', []):
    for bucket in ('trials', 'declared_absent_trials'):
        for trial in outcome.get(bucket, []):
            accounted_trials.append((bucket, outcome.get('name'), trial))
            for value in (trial.get('label'), trial.get('id'), trial.get('pmid'), trial.get('nct'), trial.get('doi')):
                if not value:
                    continue
                s = str(value)
                m = re.search(r'(?:PMID\\s*)?(\\d{6,9})', s)
                accounted.add(m.group(1) if m else s)

snap = json.load(open(snap_path, encoding='utf-8'))
records = snap['records']
decisions = {x['id']: x for x in snap['screening']['decisions']}
r2_includes = [r for r in records if decisions[r['id']]['decision'] == 'include']

def record_key(record):
    return record.get('pmid') or record.get('nct') or record.get('doi') or record.get('id')

accounted_in_r2 = [r for r in r2_includes if record_key(r) in accounted]
new_records = [r for r in r2_includes if record_key(r) not in accounted]
new_ids = [r['id'] for r in new_records]
expected_new = ['35015037', '38740993', '40156748', '42610271', 'NCT03574597']
assert new_ids == expected_new, {'new_ids': new_ids, 'expected': expected_new}
rec = {r['id']: r for r in new_records}

def base(record_id, verdict, quote, quote_source, note=''):
    r = rec[record_id]
    d = decisions[record_id]
    obj = {
        'id': r.get('id', ''),
        'id_type': r.get('id_type', ''),
        'pmid': r.get('pmid', ''),
        'nct': r.get('nct', ''),
        'title': r.get('title', ''),
        'year': r.get('year', ''),
        'verdict': verdict,
        'quote': quote,
        'quote_source': quote_source,
        'screen_rule': d.get('rule_id', ''),
        'screen_agrees': verdict.startswith('ELIGIBLE'),
    }
    if note:
        obj['note'] = note
    return obj

ctgov_raw = raw_dir / 'ctgov-NCT03574597.json'
ctgov = json.load(open(ctgov_raw, encoding='utf-8'))
proto = ctgov['protocolSection']
status = proto.get('statusModule', {}).get('overallStatus', '')
conditions = ', '.join(proto.get('conditionsModule', {}).get('conditions', []))
interventions = ', '.join(i.get('name', '') for i in proto.get('armsInterventionsModule', {}).get('interventions', []))
registry_quote = f'overallStatus: {status}; conditions: {conditions}; interventions: {interventions}'

verdicts = [
    base(
        '35015037',
        'WRONG_POPULATION',
        'OBJECTIVE: To compare the efficacy and adverse event profiles of once-weekly subcutaneous semaglutide, 2.4 mg, vs once-daily subcutaneous liraglutide, 3.0 mg (both with diet and physical activity), in people with overweight or obesity.',
        'snapshot abstract',
        'INFERRED from the quoted record population/comparison: STEP 8 is an obesity-without-diabetes weight-management trial, not established cardiovascular disease SELECT-population MACE.'
    ),
    base(
        '38740993',
        'DUPLICATE_OF_ACCOUNTED',
        'In the SELECT cardiovascular outcomes trial, semaglutide showed a 20% reduction in major adverse cardiovascular events in 17,604 adults with preexisting cardiovascular disease, overweight or obesity, without diabetes.',
        'snapshot abstract',
        'Same trial as accounted PMID 37952131: SELECT / NCT03574597; this is a long-term weight-loss secondary analysis.'
    ),
    base(
        '40156748',
        'DUPLICATE_OF_ACCOUNTED',
        'This study is a secondary analysis of data from the randomized, double-blind SELECT trial (ClinicalTrials.gov NCT03574597) of once-weekly subcutaneous administration of semaglutide compared with placebo',
        'snapshot abstract',
        'Same trial as accounted PMID 37952131: SELECT / NCT03574597; this is a number-needed-to-treat secondary analysis.'
    ),
    base(
        '42610271',
        'DUPLICATE_OF_ACCOUNTED',
        'In this prespecified SELECT substudy, we evaluated whether baseline hsCRP levels predicted MACE risk and examined the relationships between changes in hsCRP levels and time to first MACE',
        'snapshot abstract',
        'Same trial as accounted PMID 37952131: SELECT / NCT03574597; this is a prespecified hsCRP secondary analysis.'
    ),
    base(
        'NCT03574597',
        'REGISTRY_ONLY_NO_PUBLICATION',
        registry_quote,
        'ctgov raw (lane_v/semaglutide-obesity-mace-raw/ctgov-NCT03574597.json)',
        'NCT-only registry record with no PMID; raw CT.gov was fetched only because the snapshot record lacked overallStatus.'
    ),
]

valid_verdicts = {
    'ELIGIBLE_RCT', 'ELIGIBLE_RCT_NO_PRIMARY', 'NOT_RCT', 'WRONG_POPULATION',
    'WRONG_INTERVENTION', 'WRONG_COMPARATOR', 'WRONG_OUTCOME_ONLY',
    'DUPLICATE_OF_ACCOUNTED', 'UNDECIDABLE_FROM_RECORD', 'REGISTRY_ONLY_NO_PUBLICATION',
    'NOT_VERIFIED_CAP',
}
assert len(verdicts) == len(new_records)
assert [v['id'] for v in verdicts] == expected_new
for v in verdicts:
    assert v['verdict'] in valid_verdicts, v
    if v['verdict'] not in {'UNDECIDABLE_FROM_RECORD', 'NOT_VERIFIED_CAP'}:
        assert v['quote'].strip(), v
        assert len(v['quote']) <= 300, (v['id'], len(v['quote']))

out_json.parent.mkdir(parents=True, exist_ok=True)
out_json.write_text(json.dumps(verdicts, indent=2, ensure_ascii=True) + '\\n', encoding='utf-8')

counts = Counter(v['verdict'] for v in verdicts)
N = len(verdicts)
wrong_n = sum(counts[k] for k in counts if k.startswith('WRONG_'))
eligible = counts['ELIGIBLE_RCT']
elig_no_primary = counts['ELIGIBLE_RCT_NO_PRIMARY']
not_rct = counts['NOT_RCT']
dup = counts['DUPLICATE_OF_ACCOUNTED']
undecidable = counts['UNDECIDABLE_FROM_RECORD']
cap = counts['NOT_VERIFIED_CAP']
registry = counts['REGISTRY_ONLY_NO_PUBLICATION']
line_sum = eligible + elig_no_primary + not_rct + wrong_n + dup + undecidable + cap + registry
assert line_sum == N, (line_sum, N, counts)
agreed = sum(1 for v in verdicts if v['screen_agrees'])
verified_n = N - cap

commands = [
    \"Get-Content -Raw -LiteralPath '.\\\\LANE_PROMPT.md'\",
    \"Get-Content -Raw -LiteralPath '.\\\\LIVE_CONTEXT.md' (failed: file not found)\",
    \"Get-Content -Raw -LiteralPath 'F:\\\\ProjectIndex\\\\INDEX.md'\",
    \"Get-Content -Raw -LiteralPath 'F:\\\\E156\\\\rewrite-workbook.txt'\",
    \"git status --short\",
    \"Get-Content -Raw -LiteralPath '.\\\\protocols\\\\semaglutide-obesity-mace.md'\",
    \"Get-Content -Raw -LiteralPath '.\\\\topics\\\\semaglutide-obesity-mace.json'\",
    \"python -c <computed legacy includes with harness.screen/_dedup exactly as LANE_PROMPT specified>\",
    \"python -c <inspected docs/reviews/semaglutide-obesity-mace/review.json top-level primary/absent fields>\",
    \"python -c <measured r2 snapshot record and screening decision counts>\",
    \"python -c <printed review outcomes/trials/declared_absent_trials>\",
    \"python -c <printed review screening block for context>\",
    \"python -c <listed r2 automated include records with decisions>\",
    \"python -c <printed full NEW include records and abstracts>\",
    \"rg --files -g '*LANE*REPORT*.md' -g '*.json' -g 'lane_*'\",
    \"python -c <printed NCT03574597 snapshot record keys and full local record>\",
    \"rg -n \\\"overall_status|overallStatus|NCT03574597|Semaglutide Effects\\\" cache topics docs protocols\",
    \"Get-Content -Raw -LiteralPath '.\\\\LANE-S3-REPORT.md'\",
    \"Get-Content -Raw -LiteralPath '.\\\\LANE-AE-REPORT.md'\",
    \"python -c <fetched https://clinicaltrials.gov/api/v2/studies/NCT03574597 and saved lane_v/semaglutide-obesity-mace-raw/ctgov-NCT03574597.json>\",
    \"python -c <extracted CT.gov status/conditions/interventions from saved raw body>\",
    \"python -c <listed accounted review trials and declared_absent trials>\",
    \"python -c <computed r2 includes/accounted/NEW counts and NEW ids>\",
    \"python -c <wrote lane_v/semaglutide-obesity-mace.json and LANE-V-semaglutide-obesity-mace-REPORT.md; validated object count, verdict enum, quotes, and first-line sum>\",
]

eligible_lines = [v for v in verdicts if v['verdict'] == 'ELIGIBLE_RCT']
dup_lines = [v for v in verdicts if v['verdict'] == 'DUPLICATE_OF_ACCOUNTED']

report = []
report.append(f'V-semaglutide-obesity-mace VERDICTS: NEW {N}; ELIGIBLE_RCT {eligible}; ELIGIBLE_RCT_NO_PRIMARY {elig_no_primary}; NOT_RCT {not_rct}; WRONG_* {wrong_n}; DUPLICATE_OF_ACCOUNTED {dup}; UNDECIDABLE {undecidable}; NOT_VERIFIED_CAP {cap}; REGISTRY_ONLY {registry}')
report.append(f'automated screen agreed on {agreed} of {verified_n} verified')
report.append(f'r2 includes {len(r2_includes)} of {len(records)}; already accounted for {len(accounted_in_r2)}; NEW {N}')
report.append('')
report.append('Marks: every numeric count above is MEASURED from the local snapshot/review files and generated JSON. Verdict labels are source-verified from the quoted record spans; the STEP 8 wrong-population label is INFERRED from the record population/comparison against the protocol PICO.')
report.append('')
report.append('## ELIGIBLE_RCT ids with titles')
if eligible_lines:
    for v in eligible_lines:
        report.append(f'- {v[\"id\"]}: {v[\"title\"]}')
else:
    report.append('- None MEASURED.')
report.append('')
report.append('## DUPLICATE_OF_ACCOUNTED pairs')
if dup_lines:
    for v in dup_lines:
        report.append(f'- {v[\"id\"]} -> PMID 37952131 / SELECT / NCT03574597 ({v[\"note\"]})')
else:
    report.append('- None MEASURED.')
report.append('')
report.append('## Verdict Table')
for v in verdicts:
    report.append(f'- {v[\"id\"]} | {v[\"verdict\"]} | screen_rule={v[\"screen_rule\"]} | screen_agrees={str(v[\"screen_agrees\"]).lower()} | quote_source={v[\"quote_source\"]} | quote=\"{v[\"quote\"]}\"')
report.append('')
report.append('## Raw HTTP Bodies Relied On')
report.append('- lane_v/semaglutide-obesity-mace-raw/ctgov-NCT03574597.json')
report.append('')
report.append('## Commands Run')
for c in commands:
    report.append(f'- "'`{c}`'"')
report.append('')
report.append('No commit was made.')

out_report.write_text('\\n'.join(report) + '\\n', encoding='utf-8')

# Re-read generated artifacts for finish-condition validation.
generated = json.load(open(out_json, encoding='utf-8'))
first = out_report.read_text(encoding='utf-8').splitlines()[0]
nums = [int(x) for x in re.findall(r'(?:NEW|ELIGIBLE_RCT|ELIGIBLE_RCT_NO_PRIMARY|NOT_RCT|WRONG_\\*|DUPLICATE_OF_ACCOUNTED|UNDECIDABLE|NOT_VERIFIED_CAP|REGISTRY_ONLY) (\\d+)', first)]
assert len(generated) == N
assert sum(nums[1:]) == nums[0] == N, (first, nums)
print(f'WROTE {out_json} objects={len(generated)}')
print(f'WROTE {out_report} first_line_sum={sum(nums[1:])} N={N}')
