def strip_text(s):
    s = re.sub(r'<["'^>]+>'"', ' ', s or '')
    s = html.unescape(s)
    s = re.sub(r'\\s+', ' ', s).strip()
    return s

def limit(s, n=300):
    s=strip_text(s)
    if len(s)<=n:
        return s
    return s[:n-1].rstrip()+'…'

def sentence_with(text, terms):
    clean=strip_text(text)
    parts=re.split(r'(?<=[."'!?])'"\\s+', clean)
    low_parts=[p.lower() for p in parts]
    for term in terms:
        term_l=term.lower()
        for p,pl in zip(parts,low_parts):
            if term_l in pl:
                return limit(p)
    for term in terms:
        m=re.search(re.escape(term), clean, flags=re.I)
        if m:
            start=max(0,m.start()-120); end=min(len(clean),m.end()+180)
            return limit(clean[start:end])
    return ''

def quote_for(seq, r, verdict, note):
    title=strip_text(r.get('title'))
    abstract=strip_text(r.get('abstract'))
    combined=(title+'. '+abstract).strip()
    if verdict=='REGISTRY_ONLY_NO_PUBLICATION':
        return limit('has_results={}; allocation={}; masking={}; conditions={}; interventions={}'.format(
            r.get('has_results'), r.get('allocation'), r.get('masking'), ', '.join(r.get('conditions') or []), ', '.join(r.get('interventions') or [])
        ))
    if seq==104:
        return limit(title)
    if verdict=='DUPLICATE_OF_ACCOUNTED':
        q=sentence_with(combined, ['Harmony Outcomes','SOUL','EXSCEL','SUSTAIN 6','PIONEER 6','AMPLITUDE-O','REWIND','LEADER','NCT03914326','NCT03496298','NCT01394952','NCT01720446','NCT02692716'])
        return q or limit(title)
    if verdict=='NOT_RCT':
        q=sentence_with(combined, ['post hoc','post-hoc','secondary analysis','prespecified secondary','pooled analysis','meta-analytic review','cohort studies','observational','cost-effectiveness','design and rationale','subgroup analysis','sub-study','substudy','as part of a larger study','screened','will be enrolled','exploratory analysis','indirect treatment comparison'])
        return q or limit(title)
    if verdict in wrong_set:
        q=sentence_with(combined, ['children and adolescents','youth','youths','risk of developing type 2 diabetes','pediatric','Cagrilintide-semaglutide','CagriSema','tirzepatide','survodutide','probiotics','dual glucagon','active comparator','open-label semaglutide'])
        return q or limit(title)
    if verdict=='ELIGIBLE_RCT':
        q=sentence_with(combined, ['major cardiovascular events','major adverse cardiovascular','MACE','CV death/MI/stroke','cardiovascular death, non-fatal myocardial infarction (MI), or non-fatal stroke','risk of major cardiovascular events'])
        return q or limit(title)
    if verdict=='ELIGIBLE_RCT_NO_PRIMARY':
        q=sentence_with(combined, ['primary endpoint','primary end point','primary efficacy end point','primary objective','primary outcome','primary and confirmatory secondary endpoints','coprimary endpoints','co-primary outcomes','two co-primary outcomes','primary efficacy'])
        return q or sentence_with(combined, ['HbA1c','body weight','glycaemic','albuminuria','gastric emptying','arterial inflammation','walking distance','plaque','energy intake','kidney oxygenation']) or limit(title)
    return limit(title)

