{"id": "35089960", "id_type": "pmid", "pmid": "35089960", "nct": "", "doi": "10.1371/journal.pone.0262987", "title": "Metformin exposure, maternal PCOS status and fetal venous liver circulation: A randomized, placebo-controlled study.", "year": "2022", "journal": "PLoS One", "pubtypes": ["Journal Article", "Multicenter Study", "Randomized Controlled Trial", "Research Support, Non-U.S. Gov't"]}
