"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -NoProfile -Command "@'
import json, sys, re
from pathlib import Path
sys.path.insert(0,'.')
from harness import screen
from harness.pipeline import _dedup
slug='metformin-pcos-ovulation'
cfg=json.load(open(f'topics/{slug}.json',encoding='utf-8'))
legacy=json.load(open(f'cache/{slug}/records.json',encoding='utf-8'))
legacy_inc={x['id'] for x in screen.run(_dedup(legacy, cfg.get('pivotal_trials')),cfg)['decisions'] if x['decision']=='include'}
snap=json.load(open(f'cache/{slug}/snapshots/2026-09-15r2-search_v2/records.json',encoding='utf-8'))
records=snap['records']
decisions=snap['screening']['decisions']
by_id={r['id']:r for r in records}
inc=[d for d in decisions if d.get('decision')=='include']
review=json.load(open(f'docs/reviews/{slug}/review.json',encoding='utf-8'))
primary=next(o for o in review['outcomes'] if o.get('primary'))
pooled={re.sub(r'\\D','', t.get('id','')) or t.get('label','') for t in primary.get('trials',[])}
absent={re.sub(r'\\D','', t.get('id','')) or t.get('label','') for t in primary.get('declared_absent_trials',[])}
accounted=legacy_inc | pooled | absent
def key(r):
    return str(r.get('pmid') or r.get('nct') or r.get('doi') or r.get('id') or '')
old=[]; new=[]
for d in inc:
    r=by_id[d['id']]
    item=(r,d,key(r))
    if key(r) in accounted:
        old.append(item)
    else:
        new.append(item)
def sort_key(item):
    r,d,k=item
    try: year=int(r.get('year') or 0)
    except Exception: year=0
    pmid=r.get('pmid') or r.get('id') if r.get('id_type')=='pmid' else r.get('pmid')
    try: pmid_int=int(pmid) if pmid else 0
    except Exception: pmid_int=0
    return (-year, pmid_int)
new_sorted=sorted(new, key=sort_key)
print('MEASURED r2_records', len(records))
print('MEASURED r2_includes', len(inc))
print('MEASURED already_accounted_for', len(old))
print('MEASURED NEW', len(new_sorted))
print('legacy_inc', sorted(legacy_inc))
print('pooled', sorted(pooled))
print('primary_absent', sorted(absent))
print('accounted', sorted(accounted))
for i,(r,d,k) in enumerate(new_sorted,1):
    abst=(r.get('abstract') or '').replace('\\n',' ')
    print('\\n--- NEW', i, 'key', k, 'id', r.get('id'), 'id_type', r.get('id_type'), 'pmid', r.get('pmid'), 'nct', r.get('nct'), 'doi', r.get('doi'), 'year', r.get('year'))
    print('title:', r.get('title'))
    print('pubtypes:', r.get('pubtypes'))
