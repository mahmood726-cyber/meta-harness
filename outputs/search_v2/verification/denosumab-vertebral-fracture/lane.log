exec
"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "python -c \"import json,re; p='cache/denosumab-vertebral-fracture/snapshots/2026-09-15r2-search_v2/records.json'; d=json.load(open(p,encoding='utf-8')); rec={r.get('id'):r for r in d['records']}; dec={x['id']:x for x in d['screening']['decisions']}; accounted={'19671655'}; new=[];
for x in d['screening']['decisions']:
    if x.get('decision')=='include':
        r=rec[x['id']]; key=r.get('pmid') or r.get('nct') or r.get('doi') or r.get('id')
        if key not in accounted: new.append((r,x))
new=sorted(new,key=lambda rx: (-(int(rx[0].get('year') or 0)), str(rx[0].get('pmid') or rx[0].get('nct') or rx[0].get('doi') or rx[0].get('id'))))
keys=re.compile(r'FREEDOM|extension|subgroup|post hoc|post-hoc|substudy|subset|primary|endpoint|random|double-blind|placebo|zoledronic|biosimilar|JMT103|TST002|MW031|vertebral|nonvertebral|hip fracture|BMD|bone mineral|adverse|infection|safety|open-label|previously treated',re.I)
for r,x in new:
    print('\\n###',r.get('id'),r.get('year'),r.get('title'))
    print('pmid',r.get('pmid'),'nct',r.get('nct'),'doi',r.get('doi'),'pubtypes',r.get('pubtypes'))
    if r.get('id_type')=='nct': print('fields', {k:r.get(k) for k in ['conditions','interventions','allocation','masking','study_type','has_results','acronym']})
    text=(r.get('abstract') or '')
    if not text:
        print('NO ABSTRACT')
        continue
    sents=re.split(r'(?<=[."'!?])'"\\s+', text)
