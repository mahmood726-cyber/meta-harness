    haystack = ((r.get('title') or '') + '\\n' + (r.get('abstract') or ''))
    if quote and quote not in haystack:
        raise SystemExit(f'quote is not a title/abstract substring for {r[\"id\"]}: {quote"'!r}'"')
    obj = {
        'id': r.get('id', ''),
        'id_type': r.get('id_type', ''),
        'pmid': r.get('pmid', ''),
        'nct': r.get('nct', ''),
        'title': r.get('title', ''),
        'year': r.get('year', ''),
        'verdict': verdict,
        'quote': quote,
        'quote_source': 'snapshot abstract',
        'screen_rule': d.get('rule_id', ''),
        'screen_agrees': verdict.startswith('ELIGIBLE'),
    }
    if v.get('note'):
