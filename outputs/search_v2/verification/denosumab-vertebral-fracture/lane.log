def ids_from_trial(t):
    vals = []
    for key in ('id', 'label', 'pmid', 'nct', 'doi'):
        v = t.get(key)
        if not v:
            continue
        vals.append(str(v))
        m = re.search(r'PMID\\s*(\\d+)', str(v), flags=re.I)
        if m:
            vals.append(m.group(1))
    return vals

