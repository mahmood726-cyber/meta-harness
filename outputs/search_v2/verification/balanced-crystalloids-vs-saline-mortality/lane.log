topic_path = pathlib.Path('topics') / f'{slug}.json'
legacy_path = pathlib.Path('cache') / slug / 'records.json'
review_path = pathlib.Path('docs') / 'reviews' / slug / 'review.json'
out_dir = pathlib.Path('lane_v')
raw_dir = out_dir / f'{slug}-raw'
out_json = out_dir / f'{slug}.json'
report_path = pathlib.Path(f'LANE-V-{slug}-REPORT.md')

cfg = json.load(open(topic_path, encoding='utf-8'))
legacy_records = json.load(open(legacy_path, encoding='utf-8'))
legacy = sorted(
    x['id']
    for x in screen.run(_dedup(legacy_records, cfg.get('pivotal_trials')), cfg)['decisions']
    if x['decision'] == 'include'
)

snap = json.load(open(snap_path, encoding='utf-8'))
records = snap['records']
decisions = {x['id']: x for x in snap['screening']['decisions']}
include_records = [r for r in records if decisions.get(r['id'], {}).get('decision') == 'include']

review = json.load(open(review_path, encoding='utf-8'))
primary = next(o for o in review['outcomes'] if o.get('primary'))
accounted = set(legacy)
accounted.update((t.get('id') or '').replace('PMID ', '') for t in primary.get('trials', []))
accounted.update((t.get('id') or '').replace('PMID ', '') for t in primary.get('declared_absent_trials', []))
accounted = {x for x in accounted if x}

old_records = []
new_records = []
for r in include_records:
    key = r.get('pmid') or r.get('nct') or r.get('doi') or r.get('id')
    if key in accounted or r.get('id') in accounted:
        old_records.append(r)
    else:
        new_records.append(r)
new_records = sorted(new_records, key=lambda r: (-(int(r.get('year') or 0)), str(r.get('pmid') or r.get('nct') or r.get('doi') or r.get('id'))))

