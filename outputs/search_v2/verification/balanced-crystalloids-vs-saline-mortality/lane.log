codex
The one-line Python got too contorted for PowerShell; I’m switching to stdin-fed Python for the local calculations. That keeps the audit commands readable and avoids creating scratch files outside the required artefacts.
exec
"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "@'
import json, sys
sys.path.insert(0, '.')
from harness import screen
from harness.pipeline import _dedup

cfg = json.load(open('topics/balanced-crystalloids-vs-saline-mortality.json', encoding='utf-8'))
legacy_records = json.load(open('cache/balanced-crystalloids-vs-saline-mortality/records.json', encoding='utf-8'))
legacy_map = _dedup(legacy_records, cfg.get('pivotal_trials'))
legacy = sorted(x['id'] for x in screen.run(legacy_map, cfg)['decisions'] if x['decision'] == 'include')

snap = json.load(open('cache/balanced-crystalloids-vs-saline-mortality/snapshots/2026-09-15r2-search_v2/records.json', encoding='utf-8'))
recs = snap['records']
dec = {x['id']: x for x in snap['screening']['decisions']}
inc = [r for r in recs if dec.get(r['id'], {}).get('decision') == 'include']

review = json.load(open('docs/reviews/balanced-crystalloids-vs-saline-mortality/review.json', encoding='utf-8'))
primary = next(o for o in review['outcomes'] if o.get('primary'))
acc = set(legacy)
acc.update((t.get('id') or '').replace('PMID ', '') for t in primary.get('trials', []))
acc.update((t.get('id') or '').replace('PMID ', '') for t in primary.get('declared_absent_trials', []))
acc = {x for x in acc if x}

old = []
new = []
for r in inc:
    key = r.get('pmid') or r.get('nct') or r.get('doi') or r.get('id')
    (old if key in acc or r.get('id') in acc else new).append(r)

print('legacy', legacy)
print('accounted', sorted(acc))
print('r2 records', len(recs))
print('r2 includes', len(inc))
print('already among r2 includes', len(old), sorted((r.get('pmid') or r.get('nct') or r.get('doi') or r.get('id')) for r in old))
print('NEW', len(new))
print('NEW_LIST')
for r in sorted(new, key=lambda r: (-(int(r.get('year') or 0)), str(r.get('pmid') or r.get('nct') or r.get('doi') or r.get('id')))):
    d = dec[r['id']]
    print('\\t'.join(str(x or '') for x in [r.get('year'), r.get('id_type'), r.get('id'), r.get('pmid'), r.get('nct'), r.get('doi'), d.get('rule_id'), len(r.get('abstract') or ''), r.get('title')[:220].replace('\\n', ' ')]))
