    low_terms=[t.lower() for t in terms]
    for s in sentences(abstract):
        ls=s.lower()
        if any(t in ls for t in low_terms):
            return clip(s)
    if any(t in title.lower() for t in low_terms):
        return clip(title)
    for s in sentences(abstract):
