import json, re, collections, textwrap
slug='sglt2-primary-prevention-hf'
prior=json.load(open(r'C:\\meta-harness\\outputs\\search_v2\\verification\\sglt2-primary-prevention-hf\\sglt2-primary-prevention-hf.json',encoding='utf-8'))
cap=[x for x in prior if x.get('verdict')=='NOT_VERIFIED_CAP']
snap=json.load(open(f'cache/{slug}/snapshots/2026-09-15r2-search_v2/records.json',encoding='utf-8'))
recs={str(r.get('id')):r for r in snap['records']}
decs={str(d.get('id')):d for d in snap['screening']['decisions']}

accounted_nct={
    'NCT01131676':'PMID 26378978 EMPA-REG OUTCOME',
    'NCT01032629':'PMID 28605608 CANVAS Program',
    'NCT01989754':'PMID 28605608 CANVAS-R/CANVAS Program',
    'NCT01730534':'PMID 30415602 DECLARE-TIMI 58',
