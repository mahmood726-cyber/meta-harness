    'NCT02964247':'declared-absent PMID 34132018',
    'NCT03151343':'declared-absent PMID 35061894',
    'NCT03198585':'declared-absent PMID 39843293',
}
accounted_acronyms={
    'empa-reg outcome':'PMID 26378978 EMPA-REG OUTCOME',
    'canvas program':'PMID 28605608 CANVAS Program',
    'canagliflozin cardiovascular assessment study':'PMID 28605608 CANVAS Program',
    'declare-timi 58':'PMID 30415602 DECLARE-TIMI 58',
    'vertis cv':'PMID 32966714 VERTIS CV',
    'empa-heart cardiolink-6':'declared-absent PMID 31434508',
    'simple trial':'declared-absent PMID 35061894',
    'duration-8':'declared-absent PMID 27651331',
    'lira-add2sglt2i':'declared-absent PMID 31984646/34132018',
}
not_rct_terms=[
    'secondary analysis','secondary analyses','post hoc','post-hoc','subanalysis','sub-analysis','exploratory analysis',
    'pooled analysis','pooled data','meta-analysis','systematic review','review','overview','cost effectiveness','cost-effectiveness',
    'model','modelling','modeling','pharmacokinetic model','population pharmacokinetics','study protocol','protocol for',
    'rationale','design and baseline','baseline characteristics','description of the','real-world','observational','retrospective',
    'comparative effectiveness','quality of life','patient-reported outcomes'
]
wrong_intervention_terms=[
    'pioglitazone as add-on','lobeglitazone','anagliptin added','teneligliptin added','semaglutide once weekly as add-on',
    'dulaglutide as add-on','linagliptin as add-on to empagliflozin','saxagliptin add-on to dapagliflozin',
    'liraglutide as add-on','jt-001','yyc405','evogliptin','hm11260c','electoglipron','elecoglipron',
    'exenatide twice daily and dapagliflozin, alone and in combination', # combo design not pure sglt2 vs placebo
]
wrong_comparator_terms=[
    'versus glimepiride','vs glimepiride','compared with saxagliptin','versus saxagliptin','semaglutide vs once-daily canagliflozin',
    'versus exenatide or dapagliflozin alone','saxagliptin plus dapagliflozin addition versus single addition',
    'compared with placebo and sitagliptin', # has placebo too; not wrong necessarily
]
wrong_population_terms=[
    'type 1 diabetes','children with type 2 diabetes','adolescents','pediatric','paediatric','healthy subjects','healthy volunteers',
    'heart failure with reduced ejection fraction','preserved ejection fraction','hfpef','hfref','chronic heart failure','type 2 diabetes and heart failure',
    'kidney transplant','renal transplant','moderate renal impairment','renal impairment','chronic kidney disease','diabetic kidney disease','nephropathy'
]
primary_outcome_terms=['hospitalization for heart failure','hospitalisation for heart failure','heart failure hospitalization','heart failure hospitalisation','hospitalized hf','hospitalised hf','hhf','first hhf']

def clean(s): return ' '.join((s or '').split())
def sentences(txt):
    txt=clean(txt)
    parts=re.split(r'(?<=[."'!?])'"\\s+(?=[A-Z0-9])', txt)
    return [p.strip() for p in parts if p.strip()]
def clip(s):
    s=clean(s)
    if len(s)<=300: return s
    return s[:297].rstrip()+\"...\"
def find_quote(title, abstract, terms):
    low_terms=[t.lower() for t in terms]
    for s in sentences(abstract):
        ls=s.lower()
        if any(t in ls for t in low_terms):
            return clip(s)
    if any(t in title.lower() for t in low_terms):
        return clip(title)
    # fallback: title
    return clip(title or abstract)
def classify(x):
    r=recs[x['id']]
    d=decs[x['id']]
    title=clean(r.get('title'))
    abstract=clean(r.get('abstract'))
    text=(title+' '+abstract).lower()
    nct=r.get('nct') or ''
    if x.get('id_type')=='nct' and not x.get('pmid'):
        cond=', '.join(r.get('conditions') or []) or 'conditions field absent'
        intr=', '.join(r.get('interventions') or []) or 'interventions field absent'
        status=r.get('overall_status') or r.get('status') or 'overall_status field absent'
        q=clip(f'overall_status: {status}; conditions: {cond}; interventions: {intr}')
        return 'REGISTRY_ONLY_NO_PUBLICATION', q, 'NCT-only registry record; the snapshot has no PMID and no publication abstract.'
    # wrong intervention/background before general eligible
    if any(t in text for t in wrong_intervention_terms):
        return 'WRONG_INTERVENTION', find_quote(title, abstract, wrong_intervention_terms), 'INFERRED from the quoted record: the randomized treatment contrast is not the topic SGLT2 inhibitor versus placebo contrast.'
    # active comparator designs without placebo or background-only SGLT2
    if any(t in text for t in ['semaglutide vs once-daily canagliflozin','versus glimepiride','vs glimepiride','compared with saxagliptin','versus saxagliptin']):
        return 'WRONG_COMPARATOR', find_quote(title, abstract, ['semaglutide vs once-daily canagliflozin','versus glimepiride','compared with saxagliptin','versus saxagliptin']), 'INFERRED from the quoted record: the comparator is not placebo for the SGLT2 contrast.'
    # not RCT / secondary / synthesis / protocol
    if any(t in text for t in not_rct_terms):
        target=None
        for a,lab in accounted_acronyms.items():
            if a in text:
                target=lab; break
        q=find_quote(title, abstract, not_rct_terms+list(accounted_acronyms.keys()))
        note='INFERRED from the quoted record: this is a secondary, post hoc, pooled, protocol, model, review, or non-primary trial report.'
        if target:
            note=f'INFERRED from the quoted record: secondary/non-primary report of already-accounted {target}.'
        return 'NOT_RCT', q, note
    # duplicate of accounted by NCT/acronym only if no secondary flag caught it
    if nct in accounted_nct:
        return 'DUPLICATE_OF_ACCOUNTED', find_quote(title, abstract, [nct, 'randomized', 'randomised', 'placebo-controlled']), f'Same NCT as {accounted_nct[nct]}.'
    for a,lab in accounted_acronyms.items():
        if a in text:
            return 'DUPLICATE_OF_ACCOUNTED', find_quote(title, abstract, [a]), f'Same trial/acronym as {lab}.'
    # wrong population
    if any(t in text for t in wrong_population_terms):
        return 'WRONG_POPULATION', find_quote(title, abstract, wrong_population_terms), 'INFERRED from the quoted record: the enrolled population is outside the adult broad type-2-diabetes/cardiovascular-risk population for this topic.'
    # outcome report in primary record
    if any(t in text for t in primary_outcome_terms):
        return 'ELIGIBLE_RCT', find_quote(title, abstract, primary_outcome_terms+['randomized','randomised','placebo-controlled']), ''
    # eligible no primary by default for randomized SGLT2-placebo T2D records
    return 'ELIGIBLE_RCT_NO_PRIMARY', find_quote(title, abstract, ['primary endpoint','primary end point','primary outcome','randomized','randomised','placebo-controlled','placebo']), 'INFERRED from the quoted record: SGLT2-placebo randomized design is present, but the abstract does not report hospitalization for heart failure.'

rows=[]
for x in cap:
    v,q,n=classify(x)
    rows.append((x['id'], x.get('year'), v, q, n, recs[x['id']].get('title')))
print(collections.Counter(v for _,_,v,_,_,_ in rows))
for v in sorted(set(r[2] for r in rows)):
    print('\\n##', v)
    for rid,year,vv,q,n,title in [r for r in rows if r[2]==v][:80]:
        print(year, rid, title)
    if sum(1 for r in rows if r[2]==v)>80:
        print('... total', sum(1 for r in rows if r[2]==v))
