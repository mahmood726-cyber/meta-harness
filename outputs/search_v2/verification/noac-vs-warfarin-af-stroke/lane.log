def default_patterns(verdict):
    if verdict == 'NOT_RCT':
        return ['post hoc','posthoc','secondary analysis','subanalysis','analysis from','Insights from','observational','cohort','registry','model','simulation','systematic review','meta-analysis','cost-effectiveness','Markov model','Design and Rationale','rationale and design','open-label extension','retrospective analysis','economic analysis','new initiator cohort','population-based cohort','real-world']
    if verdict == 'WRONG_POPULATION':
        return ['percutaneous coronary intervention','PCI','coronary stenting','TAVR','valve replacement','bioprosthetic','mitral valve','rheumatic','valvular','valve disease','post cardiac surgery','CIED','tooth extraction','left atrial appendage','postoperatively','peri-operative','STEMI','acute coronary']
    if verdict == 'WRONG_COMPARATOR':
        return ['apixaban and rivaroxaban','compared with aspirin','versus placebo','Half-Dose Versus Full-Dose','lower-dose edoxaban regimen']
    if verdict == 'WRONG_OUTCOME_ONLY':
        return ['primary endpoint','primary outcome','biomarkers','cognitive']
    if verdict == 'ELIGIBLE_RCT':
        return ['stroke or systemic embolism','stroke/systemic embolism','Secondary outcomes included stroke','recurrent strokes/TIA','clinical ischemic stroke','new ischemic lesion']
    if verdict == 'ELIGIBLE_RCT_NO_PRIMARY':
        return ['primary endpoint','primary end point','primary outcome','randomly assigned','randomized','randomised','prospective, randomized','Randomized clinical trial','multicenter prospective, randomized']
    return []

def clean(s):
    return re.sub(r'\\s+', ' ', s or '').strip()

def snippet_around(text, pattern, max_len=300):
    if not text:
        return ''
    low=text.lower(); pat=pattern.lower(); pos=low.find(pat)
    if pos < 0:
        return ''
    # Prefer sentence-like boundaries around the hit, then trim verbatim if too long.
    start=max(text.rfind('. ',0,pos), text.rfind(': ',0,pos), text.rfind('; ',0,pos))
    start=0 if start < 0 else start+2
    end_candidates=[p for p in [text.find('. ',pos+len(pattern)), text.find('; ',pos+len(pattern))] if p>=0]
    end=(min(end_candidates)+1) if end_candidates else min(len(text), pos+len(pattern)+220)
    q=clean(text[start:end])
    if len(q) <= max_len:
        return q
    start=max(0,pos-80)
    end=min(len(text), start+max_len)
    return clean(text[start:end])[:max_len]

def pick_quote(r, idx, verdict):
    title=clean(r.get('title') or '')
    abstract=clean(r.get('abstract') or '')
    if r.get('id') == '29653640':
        raw_path=os.path.join(raw_dir,'pubmed-29653640.xml')
        if os.path.exists(raw_path):
            root=ET.parse(raw_path).getroot()
            node=root.find('.//ArticleTitle')
            if node is not None:
                title=clean(''.join(node.itertext()))
    if verdict in ('UNDECIDABLE_FROM_RECORD','NOT_VERIFIED_CAP'):
        return title[:300]
    patterns=custom_patterns.get(idx, []) + default_patterns(verdict)
    for pat in patterns:
        q=snippet_around(title, pat)
        if q:
            return q[:300]
        q=snippet_around(abstract, pat)
        if q:
            return q[:300]
    # Last resort: title is still a verbatim source span.
    return title[:300]

def note_for(r, idx, verdict):
    title=(r.get('title') or '')
    text=(title+' '+(r.get('abstract') or '')).lower()
    if verdict == 'ELIGIBLE_RCT':
        return 'P/I/C/design are met and the record reports stroke or systemic embolism/stroke outcome text.'
    if verdict == 'ELIGIBLE_RCT_NO_PRIMARY':
        return 'P/I/C/design are met, but the record does not report the protocol primary outcome as its abstract result.'
    if verdict == 'UNDECIDABLE_FROM_RECORD':
        return 'The title/abstract does not settle randomized design, direct comparator, and/or reportable outcome.'
    if verdict == 'WRONG_COMPARATOR':
        return 'The record does not compare a direct oral anticoagulant with warfarin/VKA for this topic.'
    if verdict == 'WRONG_POPULATION':
        return 'The record population is outside the protocol non-valvular AF stroke-prevention population.'
    if verdict == 'WRONG_OUTCOME_ONLY':
        return 'The record is otherwise on P/I/C/design but reports only an off-protocol outcome.'
    if verdict == 'DUPLICATE_OF_ACCOUNTED':
        return 'The record is the same trial as an already-accounted pooled or declared-absent trial.'
    if verdict == 'NOT_RCT':
        names=[]
        for name in ['RE-LY','ROCKET AF','ARISTOTLE','ENGAGE AF-TIMI 48']:
            if name.lower() in text:
                names.append(name)
        if names:
            return 'Secondary/subgroup/ancillary analysis of already-accounted trial(s): '+', '.join(dict.fromkeys(names))+'.'
        return 'The record is observational, review/model/economic, registry, protocol/design, or secondary rather than a new primary RCT.'
    return ''

