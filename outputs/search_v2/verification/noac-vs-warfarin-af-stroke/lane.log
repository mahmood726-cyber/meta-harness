import json, sys
sys.path.insert(0,'.')
from harness import screen
from harness.pipeline import _dedup
cfg=json.load(open('topics/noac-vs-warfarin-af-stroke.json',encoding='utf-8'))
legacy=json.load(open('cache/noac-vs-warfarin-af-stroke/records.json',encoding='utf-8'))
m=_dedup(legacy, cfg.get('pivotal_trials'))
legacy_inc={x['id'] for x in screen.run(m,cfg)['decisions'] if x['decision']=='include'}
review=json.load(open('docs/reviews/noac-vs-warfarin-af-stroke/review.json',encoding='utf-8'))
primary=next(o for o in review['outcomes'] if o.get('primary'))
pooled=set()
for t in primary.get('trials',[]):
    pooled.add(str(t.get('label','')).replace('PMID ',''))
    pooled.add(str(t.get('id','')).replace('PMID ',''))
absent=set()
for t in primary.get('declared_absent_trials',[]):
    absent.add(str(t.get('label','')))
    absent.add(str(t.get('id','')))
accounted={x for x in (legacy_inc|pooled|absent) if x}
r2=json.load(open('cache/noac-vs-warfarin-af-stroke/snapshots/2026-09-15r2-search_v2/records.json',encoding='utf-8'))
recs={r['id']:r for r in r2['records']}
incs=[x for x in r2['screening']['decisions'] if x.get('decision')=='include']
def key(r):
    return str(r.get('pmid') or r.get('nct') or r.get('doi') or r.get('id') or '')
new=[]; old=[]
for x in incs:
    r=recs[x['id']]
    (old if key(r) in accounted else new).append((x,r,key(r)))
print('accounted', len(accounted), sorted(accounted))
