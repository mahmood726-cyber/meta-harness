    print(f\"{i:03d}\\t{r.get('year')}\\t{k}\\t{r.get('nct') or ''}\\t{';'.join(r.get('pubtypes') or [])[:80]}\\t{r.get('title')}\\tCUES={', '.join(hits[:12])}\")
