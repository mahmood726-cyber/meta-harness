import json, sys, textwrap
sys.path.insert(0,'.')
from harness import screen
from harness.pipeline import _dedup
# compact stable rows 32-70 only
cfg=json.load(open('topics/noac-vs-warfarin-af-stroke.json',encoding='utf-8'))
legacy=json.load(open('cache/noac-vs-warfarin-af-stroke/records.json',encoding='utf-8'))
legacy_inc={x['id'] for x in screen.run(_dedup(legacy, cfg.get('pivotal_trials')),cfg)['decisions'] if x['decision']=='include'}
review=json.load(open('docs/reviews/noac-vs-warfarin-af-stroke/review.json',encoding='utf-8'))
primary=next(o for o in review['outcomes'] if o.get('primary'))
accounted=set(legacy_inc)
for t in primary.get('trials',[]): accounted.update([str(t.get('label','')).replace('PMID ',''), str(t.get('id','')).replace('PMID ','')])
for t in primary.get('declared_absent_trials',[]): accounted.update([str(t.get('label','')), str(t.get('id',''))])
accounted={x for x in accounted if x}
r2=json.load(open('cache/noac-vs-warfarin-af-stroke/snapshots/2026-09-15r2-search_v2/records.json',encoding='utf-8'))
recs={r['id']:r for r in r2['records']}; incs=[x for x in r2['screening']['decisions'] if x.get('decision')=='include']
def key(r): return str(r.get('pmid') or r.get('nct') or r.get('doi') or r.get('id') or '')
rows=sorted([(x,recs[x['id']],key(recs[x['id']])) for x in incs if key(recs[x['id']]) not in accounted], key=lambda t: (-(int(t[1].get('year') or 0)), str(t[1].get('pmid') or t[1].get('nct') or t[1].get('doi') or t[1].get('id'))))
for i,(x,r,k) in enumerate(rows[31:70], start=32):
    abstr=(r.get('abstract') or '').replace('\\n',' ')
    cue=''
    for marker in ['post hoc','posthoc','secondary','subgroup','analysis from','Insights from','observational','cohort','registry','model','systematic review','rationale','design','randomized','randomised','randomly assigned','primary endpoint','primary outcome','stroke/systemic embolism','major bleeding']:
        j=abstr.lower().find(marker.lower())
        if j>=0:
            cue=abstr[max(0,j-120):j+320]
            break
    print(f\"{i:03d} {r.get('year')} {k} NCT={r.get('nct') or ''}\\nTITLE: {r.get('title')}\\nPUBTYPES: {'; '.join(r.get('pubtypes') or [])}\\nCUE: {textwrap.shorten(cue, width=700, placeholder=' ...')}\\n\")
