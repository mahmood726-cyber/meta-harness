patterns=['random','post hoc','posthoc','secondary','subgroup','observational','cohort','registry','meta-analysis','systematic review','cost-effectiveness','model','simulation','design','rationale','protocol','renal','hemodialysis','dialysis','TAVR','percutaneous coronary intervention','PCI','acute coronary','bioprosthetic','rheumatic','mitral stenosis','valvular','valve','cardioversion','ablation','left atrial appendage','stroke/systemic embolism','systemic embolism','major bleeding','primary endpoint','primary outcome']
