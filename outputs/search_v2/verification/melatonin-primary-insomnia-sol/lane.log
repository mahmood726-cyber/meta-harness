review_path=f'docs/reviews/{slug}/review.json'

cfg=json.load(open(topic_path,encoding='utf-8'))
legacy_data=json.load(open(legacy_path,encoding='utf-8'))
legacy=set(x['id'] for x in screen.run(_dedup(legacy_data,cfg.get('pivotal_trials')),cfg)['decisions'] if x['decision']=='include')
review=json.load(open(review_path,encoding='utf-8'))
accounted=set(legacy)
primary=[o for o in review['outcomes'] if o.get('primary')][0]
for sec in ('trials','declared_absent_trials'):
    for t in primary.get(sec,[]):
        for v in (t.get('label'),t.get('id')):
