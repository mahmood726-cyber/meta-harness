lign="center" colspan="1" rowspan="1">17 (9.9%)</td><td align="center" colspan="1" rowspan="1">6 (7.0%)</td><td align="center" colspan="1" rowspan="1">11 (12.8%)</td><td align="center" colspan="1" rowspan="1">10 (7.9%)</td><td align="center" colspan="1" rowspan="1">6 (15.4%)</td></tr><tr><td colspan="8" rowspan="1"><hr/></td></tr><tr><td align="left" colspan="1" rowspan="1">Taking codeine†</td><td align="center" colspan="1" rowspan="1">1</td><td align="center" colspan="1" rowspan="1"><italic toggle="yes">N </italic>(%)</td><td align="center" colspan="1" rowspan="1">29 (16.9%)</td><td align="center" colspan="1" rowspan="1">13 (15.1%)</td><td align="center" colspan="1" rowspan="1">16 (18.6%)</td><td align="center" colspan="1" rowspan="1">21 (16.5%)</td><td align="center" colspan="1" rowspan="1">8 (20.5%)</td></tr><tr><td colspan="8" rowspan="1"><hr/></td></tr><tr><td align="left" colspan="1" rowspan="1">Taking codeine</td><td align="center" colspan="1" rowspan="1">2</td><td align="center" colspan="1" rowspan="1"><italic toggle="yes">N </italic>(%)</td><td align="center" colspan="1" rowspan="1">26 (15.1%)</td><td align="center" colspan="1" rowspan="1">16 (18.6%)</td><td align="center" colspan="1" rowspan="1">10 (11.6%)</td><td align="center" colspan="1" rowspan="1">21 (16.5%)</td><td align="center" colspan="1" rowspan="1">5 (12.8%)</td></tr><tr><td colspan="8" rowspan="1"><hr/></td></tr><tr><td align="left" colspan="1" rowspan="1">Confirmed<break/>codeine analgesic</td><td align="center" colspan="1" rowspan="1">2</td><td align="center" colspan="1" rowspan="1"><italic toggle="yes">N </italic>(%)</td><td align="center" colspan="1" rowspan="1">15 (8.7%)</td><td align="center" colspan="1" rowspan="1">8 (9.3%)</td><td align="center" colspan="1" rowspan="1">7 (8.1%)</td><td align="center" colspan="1" rowspan="1">11 (8.7%)</td><td align="center" colspan="1" rowspan="1">4 (10.3%)</td></tr></tbody></table><table-wrap-foot><p>*One patient missing observation.</p><p>†Two patients