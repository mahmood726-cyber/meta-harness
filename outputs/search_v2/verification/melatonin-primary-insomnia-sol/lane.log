snap=json.load(open(snap_path,encoding='utf-8'))
records={r['id']:r for r in snap['records']}
decisions={d['id']:d for d in snap['screening']['decisions']}
def key(r):
    return r.get('pmid') or r.get('nct') or r.get('doi') or r.get('id')
def year_int(r):
    try:
        return int(r.get('year') or 0)
    except Exception:
        return 0
