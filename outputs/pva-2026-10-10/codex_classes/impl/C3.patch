@@ -0,0 +1,106 @@
+"""Single-trial wording contracts; only committed review objects are required."""
+import copy
+import html
+import json
+from pathlib import Path
+import re
+
+import pytest
+
+from harness import grade, manuscript, page, review_tabs, trial_family
+
+
+REVIEWS = Path(__file__).resolve().parents[1] / "docs" / "reviews"
+BAD = re.compile(
+    r"Pooling used random effects|and the pooled result\.|Trials pooled \(k\)|"
+    r"\b1 of 1 pooled trials|primary-outcome pooled trials assessed|pooled in primary|"
+    r"derived from the pooled result|page's pooled numbers|this pooled number|"
+    r"full pool \(k=1|prediction interval are descriptive only|"
+    r"per pooled trial|each pooled trial|Effect-measure labels pooled", re.I
+)
+MODEL_BAD = re.compile(r"pooled|random.effects|Paule-Mandel|HKSJ|heterogeneity|prediction interval", re.I)
+
+
+def relevant_texts(review):
+    primary = next((o for o in review.get("outcomes", []) if o.get("primary")), {})
+    if primary.get("result", {}).get("k") == 1:
+        yield manuscript.render(review)
+        yield page._overview(review, False)
+        yield page._riskofbias(review, False)
+        yield page._comparator(review, False)
+        yield page._reproduction(review, False)
+        yield page._reporting(review, False)
+        yield review_tabs.conclusions(review)
+        yield grade.stale_heterogeneity(review)
+        chain = trial_family.derive_count_chain(review.get("trial_families", []))
+        yield trial_family.count_sentence(chain)
+        yield page._trial_families(review)
+    for outcome in review.get("outcomes", []):
+        if outcome.get("result", {}).get("k") == 1:
+            yield page._outcome_block(outcome, review=review)
+            yield review_tabs.analysis_tab({"outcomes": [outcome]})
+
+
+def violations(review):
+    found = []
+    for text in relevant_texts(review):
+        found.extend(m.group() for m in BAD.finditer(html.unescape(re.sub(r"<[^>]*>", " ", text))))
+    for outcome in review.get("outcomes", []):
+        if outcome.get("result", {}).get("k") != 1:
+            continue
+        analysis = review_tabs.analysis_tab({"outcomes": [outcome]})
+        for method in re.findall(r"<p class='method'>(.*?)</p>", analysis):
+            found.extend(m.group() for m in MODEL_BAD.finditer(method))
+    return found
+
+
+@pytest.mark.parametrize("provenance,kind", [
+    ("source-reported-CI:k=1-verbatim", "Reported"),
+    ("synth.pool:single-trial-Wald-z(k=1):v1", "Reconstructed"),
+    ("unrecognised", "provenance not established"),
+])
+def test_plant(provenance, kind):
+    outcome = {
+        "name": "Constructed outcome", "primary": True, "estimand": "RR",
+        "method": "Pooled by PM/HKSJ", "trials": [],
+        "result": {"k": 1, "present": True, "scale": "RR", "estimate": 0.8,
+                   "ci_low": 0.6, "ci_high": 0.9, "ci_provenance": provenance},
+        "compat_key": {"randomised_contrast": {"verified": 1, "total": 1}},
+    }
+    review = {"title": "Constructed review", "outcomes": [outcome]}
+    before = copy.deepcopy(review)
+    texts = [manuscript.render(review), page._outcome_block(outcome, review=review),
+             review_tabs.analysis_tab(review)]
+    for text in texts:
+        assert not BAD.search(text)
+        assert not re.search(r"PM/HKSJ|random.effects|Paule-Mandel|heterogeneity|prediction interval", text, re.I)
+        assert kind in text
+    assert review == before
+
+
+def test_sweep():
+    paths = sorted(REVIEWS.glob("*/review.json"))
+    assert len(paths) == 32
+    failures = {}
+    for path in paths:
+        review = json.loads(path.read_text(encoding="utf-8"))
+        before = copy.deepcopy(review)
+        found = violations(review)
+        if found:
+            failures[path.parent.name] = found
+        assert review == before
+        for outcome in review.get("outcomes", []):
+            res = outcome.get("result") or {}
+            if res.get("k") != 1:
+                continue
+            analysis = review_tabs.analysis_tab({"outcomes": [outcome]})
+            if "class='method'" not in analysis:  # Withheld outcomes retain their gate explanation.
+                continue
+            kind = ("Reported" if res.get("ci_provenance") == "source-reported-CI:k=1-verbatim"
+                    else "Reconstructed" if res.get("ci_provenance") == "synth.pool:single-trial-Wald-z(k=1):v1"
+                    else "provenance not established")
+            assert kind in analysis
+            for key in ("estimate", "ci_low", "ci_high"):
+                if res.get(key) is not None:
+                    assert review_tabs._fmt(res[key]) in analysis
+    assert not failures, failures
