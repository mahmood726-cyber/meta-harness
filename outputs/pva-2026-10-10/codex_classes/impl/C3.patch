@@ -0,0 +1,25 @@
+"""Outcome-aware display wording; never changes synthesis values or decisions."""
+
+
+def single_trial_label(result):
+    provenance = result.get("ci_provenance")
+    if provenance == "source-reported-CI:k=1-verbatim":
+        return "Reported single-trial estimate"
+    if provenance == "synth.pool:single-trial-Wald-z(k=1):v1":
+        return "Reconstructed single-trial estimate"
+    return "Single-trial estimate (provenance not established)"
+
+
+def method(outcome):
+    result = outcome.get("result") or {}
+    if result.get("k") == 1:
+        return single_trial_label(result) + "; one trial contributes this outcome."
+    return outcome.get("method")
+
+
+def membership_state(membership, outcomes):
+    if membership.get("state") == "POOLED":
+        outcome = next((o for o in outcomes if o.get("name") == membership.get("outcome")), {})
+        if (outcome.get("result") or {}).get("k") == 1:
+            return "SINGLE_TRIAL"
+    return membership.get("state", "UNKNOWN")
