new file mode 100644
index 0000000..07d6410
--- /dev/null
+++ b/tests/test_class_C1.py
@@ -0,0 +1,82 @@
+"""C1: bounded completeness prose and separate, fail-closed PICO evidence."""
+from copy import deepcopy
+import html
+import json
+from pathlib import Path
+import re
+
+from harness import page, review_tabs, scope
+
+
+ROOT = Path(__file__).resolve().parents[1]
+BAD = re.compile(
+    r"complete (?:single-drug )?evidence base|not a search gap|"
+    r"every eligible trial|no eligible trial is missing|not unretrieved evidence|"
+    r"population match:\s*(?:True|False)|same-question comparator|same question</strong>",
+    re.I,
+)
+
+
+def plain(text):
+    return " ".join(html.unescape(re.sub(r"<[^>]+>", "", text)).split())
+
+
+def relevant(review):
+    return {
+        "Included studies": review_tabs.included_tab(review),
+        "Comparison": page._comparator(review, False),
+        "Overview": page._overview(review, False),
+    }
+
+
+def test_plant():
+    review = {
+        "search": {"retrieval_class": {"class": "KNOWN_ITEM_RETRIEVAL"}},
+        "comparator": {"name": "Drug-class review", "scope": {
+            "scope_valid": True, "population_match": True,
+            "note": "same-question comparator",
+        }},
+        "comparator_scope_note": "Complete evidence base; not a search gap; network-level analysis.",
+        "outcomes": [{"name": "Outcome", "declared_absent_trials": [
+            {"id": "constructed-trial", "state": "not extracted"},
+        ]}],
+    }
+    text = page._comparator(review, False) + review_tabs.included_tab(review)
+    assert not BAD.search(text)
+    assert "network-level" not in text
+    assert all(f"{axis}:" in text for axis in "PICO")
+    config = {"include": {"population_any": ["obesity", "cardiovascular disease"],
+                          "population_none": ["diabetes"],
+                          "intervention_any": ["agent"], "comparator_any": ["placebo"]},
+              "primary_outcome": {"keywords": ["mortality"]}}
+    result = scope.assess(config, "Agent in obesity", "Compared with placebo")
+    assert set(result["axes"]) == set("PICO")
+    assert result["axes"]["P"]["state"] == "UNKNOWN"
+    assert [e["present"] for e in result["axes"]["P"]["term_evidence"]] == [True, False]
+    assert result["axes"]["P"]["restriction_evidence"] == [
+        {"term": "diabetes", "present": False}]
+    assert result["axes"]["C"]["term_evidence"][0]["present"] is True
+    assert result["axes"]["O"]["term_evidence"][0]["present"] is False
+    assert not BAD.search(result["note"])
+
+
+def test_sweep():
+    paths = sorted((ROOT / "docs/reviews").glob("*/review.json"))
+    assert len(paths) == 32
+    report = json.loads((ROOT / "CLASS_REPORT.json").read_text(encoding="utf-8"))
+    remaining = []
+    for path in paths:
+        review = json.loads(path.read_text(encoding="utf-8"))
+        original = deepcopy(review)
+        texts = relevant(review)
+        assert review == original, path.parent.name  # Includes all numerical inputs and decisions.
+        for text in texts.values():
+            assert not BAD.search(plain(text)), path.parent.name
+        for instance in report["instances"]:
+            if instance["slug"] != path.parent.name:
+                continue
+            tab = "Comparison" if instance["tab"].startswith("Comparison") else instance["tab"]
+            if plain(instance["page_quote"]) in plain(texts[tab]):
+                remaining.append(instance)
+        assert all(f"{axis}:" in texts["Comparison"] for axis in "PICO"), path.parent.name
+    assert remaining == []
