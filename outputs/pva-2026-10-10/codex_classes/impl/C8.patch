+"""C8: scope refusals require a trial-bound protocol decision; no pool changes."""
+import copy
+import html
+import json
+from pathlib import Path
+
+from harness.page import _refusal_reason, _reproduction
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def test_plant_unregistered_chronic_restriction():
+    review = {
+        "protocol": {"eligibility": "Adults with HFrEF."},
+        "reproduction": {"refusals": [{
+            "trial": "PIONEER-HF",
+            "verified": "Harms available in structured results",
+            "not_pooled_because": "Out of scope: chronic-HFrEF only.",
+        }]},
+    }
+    before = copy.deepcopy(review)
+    rendered = _reproduction(review, False)
+    assert "chronic-HFrEF" not in rendered
+    assert "unresolved" in rendered
+    assert review == before
+
+
+def test_scope_decision_is_trial_bound_and_uses_protocol_criterion():
+    protocol = {
+        "eligibility": "Exclude post-myocardial-infarction populations.",
+        "scope_decisions": {"population": {
+            "trial": "example",
+            "criterion": "Exclude post-myocardial-infarction populations.",
+            "disposition": "excluded",
+        }},
+    }
+    row = {"trial": "example", "scope_decision": "population",
+           "not_pooled_because": "Chronic-HFrEF only."}
+    rendered = _reproduction({"protocol": protocol,
+                              "reproduction": {"refusals": [row]}}, False)
+    assert protocol["eligibility"] in rendered
+    assert "excluded" in rendered
+    assert "Chronic-HFrEF" not in rendered
+    for changes in ({"trial": "another trial"},
+                    {"criterion": "Chronic-HFrEF only."},
+                    {"disposition": "invented"}):
+        altered = copy.deepcopy(protocol)
+        altered["scope_decisions"]["population"].update(changes)
+        assert "unresolved" in _refusal_reason(altered, row)
+    row["scope_decision"] = "missing"
+    assert "unresolved" in _refusal_reason(protocol, row)
+
+
+def test_sweep_all_served_reviews():
+    paths = sorted((ROOT / "docs" / "reviews").glob("*/review.json"))
+    assert len(paths) == 32
+    report = json.loads((ROOT / "CLASS_REPORT.json").read_text(encoding="utf-8"))
+    # The report missed a declared-timepoint restriction: CAP specifies 30 days,
+    # but the stored refusal calls 28 days the declared timepoint.
+    instances = [(x["slug"], x["page_quote"]) for x in report["instances"]]
+    instances.append(("corticosteroids-cap-mortality", "not the declared 28-day"))
+    before_count = after_count = 0
+    for path in paths:
+        review = json.loads(path.read_text(encoding="utf-8"))
+        before = copy.deepcopy(review)
+        rendered = html.unescape(_reproduction(review, False))
+        rows = review.get("reproduction", {}).get("refusals", [])
+        legacy = " ".join(row.get("not_pooled_because", "") for row in rows)
+        for slug, quote in instances:
+            if slug == path.parent.name:
+                before_count += quote in legacy
+                after_count += quote in rendered
+                assert quote not in rendered, (slug, quote)
+        for row in rows:
+            assert html.escape(row["verified"]) in _reproduction(review, False)
+            reason = _refusal_reason(review.get("protocol") or {}, row)
+            assert html.escape(reason) in _reproduction(review, False)
+        # Rendering must not change estimates, membership, decisions, or any input.
+        assert review == before
+        if path.parent.name == "corticosteroids-covid19-mortality":
+            # Numeric results embedded in extraction-only prose also survive.
+            assert "RR 1.30, 95% CI 0.0002-6827" in rendered
+    assert before_count == 7
+    assert after_count == 0
