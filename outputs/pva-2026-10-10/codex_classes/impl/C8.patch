+def _refusal_reason(protocol, row):
+    """Scope authority lives in protocol.scope_decisions, keyed by row reference.
+
+    Legacy scope prose cannot establish eligibility. Extraction-only notes remain
+    verbatim; mixed scope/extraction notes need an explicit protocol decision.
+    This formatter changes no screening or pooling decisions.
+    """
+    reason = row.get("not_pooled_because") or ""
+    reference = row.get("scope_decision")
+    decisions = protocol.get("scope_decisions") or {}
+    decision = decisions.get(reference) if isinstance(reference, str) and isinstance(decisions, dict) else None
+    if isinstance(decision, dict) and decision.get("trial") == row.get("trial"):
+        criterion = decision.get("criterion")
+        disposition = decision.get("disposition")
+        # Require a verbatim protocol criterion, not a second independent rationale.
+        if (isinstance(criterion, str) and criterion.strip()
+                and criterion in (protocol.get("eligibility") or "")
+                and disposition in ("included", "excluded")):
+            return f"Protocol scope decision: {disposition}. Criterion: {criterion}"
+    if reference is not None or re.search(
+            r"scope|population|preregister|preregist|criteria|exclu|"
+            r"chronic.only|chronic.HFrEF|timepoint|declared|"
+            r"broader composite|non-standard composite", reason, re.I):
+        return "Scope restriction not established by the protocol; exclusion rationale unresolved."
+    return reason
