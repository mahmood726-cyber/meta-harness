#!/bin/sh
# Held-out names are sealed outside the repo. The Python checker owns the HMAC
# matching; CI is the authority because it has the register-holder key.
set -u
ROOT="$(git rev-parse --show-toplevel)" || { echo "GATE: not in a repo - refusing"; exit 1; }
cd "$ROOT" || { echo "GATE: cannot cd to repo root - refusing"; exit 1; }
PY="python"
command -v "$PY" >/dev/null 2>&1 || { echo "GATE: 'python' not found - refusing (fail closed)"; exit 1; }
[ $# -ge 1 ] || { echo "GATE: commit message path missing - refusing (fail closed)"; exit 1; }
[ -f "$1" ] || { echo "GATE: commit message file missing - refusing (fail closed)"; exit 1; }
[ -f harness/heldout.py ] || { echo "GATE: harness/heldout.py missing - refusing (fail closed)"; exit 1; }

if grep -E '(^|[^A-Z_])(INTERNALLY_VERIFIED|INDEPENDENTLY_VERIFIED|GENERALIZED|VERIFIED)([^A-Z_]|$)' "$1" >/dev/null 2>&1; then
  echo "GATE: old fix-state ladder word in commit message - refusing"
  exit 1
fi
if grep -E '(^|[[:space:]])(status|statuses|fix_state)[[:space:]]*:' "$1" >/dev/null 2>&1; then
  echo "GATE: commit messages carry no fix-state authority - refusing"
  exit 1
fi

OUT="$("$PY" -m harness.heldout --message "$1" 2>&1)"
RC=$?
[ -z "$OUT" ] || printf '%s\n' "$OUT"
if [ "$RC" -eq 2 ]; then
  case "$OUT" in
    *"held-out key not available"*)
      echo "held-out detector cannot run locally (no key) — CI will enforce"
      exit 0
      ;;
  esac
fi
if [ "$RC" -ne 0 ]; then
  exit 1
fi
exit 0
