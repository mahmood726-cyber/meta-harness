#!/bin/sh
# Publication gate, local copy. Runs the SAME standard as CI: scripts/verify_all.py (unit tests,
# offline reproduction of every live page, publication gate on every page, index currency, leak scan).
# Fail-closed: if the standard cannot execute, it REFUSES. Never edit this to get past a refusal --
# fix the harness that produced the page.
#
# This hook is a convenience so you find out BEFORE the push. It is not the enforcement: a fresh clone
# has no hook (core.hooksPath is local config). Enforcement is server-side -- main accepts a push only
# if the `verify` check passed on that SHA (repository ruleset), and Pages deploys only from a green
# verify. See README "How a commit lands".
#
# Scope note: the standard runs against the WORKING TREE (as CI runs against the pushed tree). With
# partially staged changes the two can differ; CI is the authority.
set -u
ROOT="$(git rev-parse --show-toplevel)" || { echo "GATE: not in a repo - refusing"; exit 1; }
cd "$ROOT" || { echo "GATE: cannot cd to repo root - refusing"; exit 1; }
# git exports GIT_DIR/GIT_INDEX_FILE to this hook. Everything below spawns git against explicit roots
# (temporary fixture repositories, the held-out canary self-test); inheriting these would make those
# commands act on THIS repository (2026-09-19: eleven fixture commits landed on a workshop branch).
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR
PY="python"
command -v "$PY" >/dev/null 2>&1 || { echo "GATE: 'python' not found - refusing (fail closed)"; exit 1; }
[ -f scripts/verify_all.py ] || { echo "GATE: scripts/verify_all.py missing - refusing (fail closed)"; exit 1; }

echo "GATE: running the full standard (scripts/verify_all.py) -- same limbs as CI"
"$PY" scripts/verify_all.py || {
  echo "GATE: REFUSED. Fix the harness, never the gate. (never --no-verify)"
  exit 1
}
echo "GATE: executed OK - all limbs passed."
exit 0
