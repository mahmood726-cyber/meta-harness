#!/bin/sh
# Two-limb publication gate. Fail-closed: if the gate cannot execute, it REFUSES.
# Never edit this to get past a refusal - fix the harness that produced the page.
set -u
ROOT="$(git rev-parse --show-toplevel)" || { echo "GATE: not in a repo - refusing"; exit 1; }
cd "$ROOT" || { echo "GATE: cannot cd to repo root - refusing"; exit 1; }

PY="python"
command -v "$PY" >/dev/null 2>&1 || { echo "GATE: 'python' not found - refusing (fail closed)"; exit 1; }

DIRS=$(git diff --cached --name-only --diff-filter=ACM \
        | grep -E '^docs/reviews/[^/]+/index\.html$' \
        | sed -E 's#/index\.html$##' | sort -u)

# Pipeline INPUTS: a live page is a pure function of these, so a change to any of them can leave a
# page stale even when no page itself is staged. Computed up front so the dependency rule below
# runs whether or not a review page is in this commit (a machinery-only commit is the case that
# matters most, and an early "no pages" exit used to skip it -- a fail-open hole).
MACHINERY=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '^(harness/.*\.py|topics/.*\.json|protocols/.*\.md|cache/.*\.json)$' || true)

if [ -z "$DIRS" ] && [ -z "$MACHINERY" ]; then
  echo "GATE: executed - nothing to gate (no review pages or pipeline inputs staged)."
  exit 0
fi

if [ -n "$DIRS" ]; then
  echo "GATE: executing two-limb gate on staged review page(s):"
  FAIL=0
  N=0
  for d in $DIRS; do
    N=$((N+1))
    "$PY" -m harness.gate "$d" || FAIL=1
  done
  echo "GATE: gated $N page(s)."
  if [ "$FAIL" -ne 0 ]; then
    echo "GATE: REFUSED. Fix the harness, never the gate. (SENTINEL: no --no-verify)"
    exit 1
  fi
fi

# The index is generated, never hand-maintained: refuse a stale/hand-edited index.
"$PY" - <<'PYEOF' || exit 1
import io, sys
from harness.index import build_index
want = build_index("docs")
try:
    cur = io.open("docs/index.html", encoding="utf-8").read()
except OSError:
    cur = None
if cur != want:
    print("GATE: docs/index.html is stale or hand-edited. Regenerate & stage:")
    print("      python -m harness.index docs && git add docs/index.html")
    sys.exit(1)
print("GATE: generated index is current.")
PYEOF

# DEPENDENCY RULE (not memory): if any pipeline input is staged, EVERY live page must still replay
# byte-for-byte -- a change that leaves a page stale is a silent invariant failure (the multi-arm
# guard once left colchicine-postop stale; an edited outcome_judgments cache would do the same).
# MACHINERY is computed at the top so this runs even on a machinery-only commit (no page staged).
if [ -n "$MACHINERY" ]; then
  echo "GATE: pipeline inputs changed -> re-verifying ALL live pages reproduce (dependency rule)"
  "$PY" scripts/reproduce_review.py || {
    echo "GATE: REFUSED. A change to code/config/cache left a live page stale. See exactly which"
    echo "      pages and how their NUMBERS move, then review & stage the rebuilds:"
    echo "      python scripts/reproduce_review.py --rebuild-stale"
    exit 1
  }
fi

echo "GATE: executed OK - all limbs passed."
exit 0
