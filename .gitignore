__pycache__/
*.pyc
.pytest_cache/
PROGRESS.md
scratch/
*.tmp
.DS_Store
scratchpad/
repo/
docs/_production/
gate-scorecard-test-*/

# raw HTTP bodies of search_v2 snapshots are archived off-tree (scripts/archive_raw_bodies.py); raw/INDEX.json and ARCHIVE.json stay in-tree
cache/*/snapshots/*/raw/*/
evidence/extractions/raw/*.log
evidence/extractions/raw/*.tmp
evidence/extractions/raw/*.unparsed
evidence/held_local/
evidence/extractions/*.log
evidence/second_adjudication/*.log
evidence/second_adjudication/*.tmp
evidence/gaps/*.log
evidence/gaps/*.tmp
evidence/**/*.log
evidence/codex_queue.txt.tmp
evidence/codex_queue.STOP
evidence/codex_queue.txt
# acquisition cascade: held OA full texts stay local (sha256 in held/HELD.json, re-fetchable); only CC-BY documents
# that witness a scored candidate row are committed
evidence/acquisition_cascade/held/_secondary/*
!evidence/acquisition_cascade/held/_secondary/PMC6720402.xml
!evidence/acquisition_cascade/held/_secondary/PMC9531702.xml
# held pages / PDFs / supplement archives that may be read but not redistributed (or are redundant copies): local only;
# the harness binds to committed EXCERPTS (evidence/acquisition_cascade/excerpts/) that name each file's sha256
evidence/acquisition_cascade/held/**/*.html
evidence/acquisition_cascade/held/**/*.pdf
evidence/acquisition_cascade/held/**/*.zip
# full-text extraction of a manuscript that is not redistributed (the harness binds to its committed one-sentence excerpt)
evidence/acquisition_cascade/held/CARMELINA/unpaywall.txt
# FIDELITY full text is CC BY-NC 4.0: held locally (sha256 in HELD.json), not redistributed
evidence/acquisition_cascade/held/FIDELITY/PMC8830527.xml
