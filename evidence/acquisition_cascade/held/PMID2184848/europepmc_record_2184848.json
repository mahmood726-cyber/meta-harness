{"version":"6.9","hitCount":1,"request":{"queryString":"EXT_ID:2184848 AND SRC:MED","internalQuery":"EXT_ID:2184848 AND SRC:MED","resultType":"CORE","cursorMark":"*","pageSize":25,"sort":"","synonym":false},"resultList":{"result":[{"id":"2184848","source":"MED","pmid":"2184848","doi":"10.3109/07853899009147243","title":"Effect of Lactobacillus GG yoghurt in prevention of antibiotic associated diarrhoea.","authorString":"Siitonen S, Vapaatalo H, Salminen S, Gordin A, Saxelin M, Wikberg R, Kirkkola AL.","authorList":{"author":[{"fullName":"Siitonen S","lastName":"Siitonen","firstName":"S","initials":"S","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Biomedical Sciences, University of Tampere, Finland."}]}},{"fullName":"Vapaatalo H","lastName":"Vapaatalo","firstName":"H","initials":"H"},{"fullName":"Salminen S","lastName":"Salminen","firstName":"S","initials":"S"},{"fullName":"Gordin A","lastName":"Gordin","firstName":"A","initials":"A"},{"fullName":"Saxelin M","lastName":"Saxelin","firstName":"M","initials":"M"},{"fullName":"Wikberg R","lastName":"Wikberg","firstName":"R","initials":"R"},{"fullName":"Kirkkola AL","lastName":"Kirkkola","firstName":"A L","initials":"AL"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics"]},"journalInfo":{"issue":"1","volume":"22","journalIssueId":740665,"dateOfPublication":"1990 Feb","monthOfPublication":2,"yearOfPublication":1990,"journal":{"medlineAbbreviation":"Ann Med","title":"Annals of medicine","essn":"1365-2060","issn":"0785-3890","nlmid":"8906388","isoabbreviation":"Ann Med"},"printPublicationDate":"1990-02-01"},"pubYear":"1990","pageInfo":"57-59","abstractText":"The efficacy of Lactobacillus GG yoghurt in preventing erythromycin associated diarrhoea was studied. Sixteen healthy volunteers were given erythromycin acistrate 400 mg t.i.d for a week. The volunteers were randomly assigned into two groups taking twice daily 125 ml of either Lactobacillus GG fermented yoghurt or pasteurized regular yoghurt as placebo during the drug treatment. Subjects receiving Lactobacillus GG yoghurt with erythromycin had less diarrhoea than those taking pasteurized yoghurt. Other side effects of erythromycin, such as abdominal distress, stomach pain and flatulence, were less common in the GG yoghurt group than in the placebo yoghurt group. The subjects receiving Lactobacillus GG yoghurt were colonized with these bacteria even during erythromycin treatment as measured by faecal counts of total Lactobacillus GG. No Lactobacillus GG was found in the faecal samples of volunteers in the group taking pasteurized yoghurt.","affiliation":"Department of Biomedical Sciences, University of Tampere, Finland.","publicationStatus":"ppublish","language":"eng","pubModel":"Print","pubTypeList":{"pubType":["Clinical Trial","Randomized Controlled Trial","Journal Article"]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"N","descriptorName":"Clostridium","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"IP","qualifierName":"isolation & purification"}]}},{"majorTopic_YN":"N","descriptorName":"Lactobacillus","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"Y","abbreviation":"PH","qualifierName":"physiology"}]}},{"majorTopic_YN":"N","descriptorName":"Diarrhea","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"ET","qualifierName":"etiology"},{"majorTopic_YN":"Y","abbreviation":"PC","qualifierName":"prevention & control"}]}},{"majorTopic_YN":"N","descriptorName":"Erythromycin","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"Y","abbreviation":"AE","qualifierName":"adverse effects"},{"majorTopic_YN":"N","abbreviation":"BL","qualifierName":"blood"}]}},{"majorTopic_YN":"Y","descriptorName":"Dairy Products"},{"majorTopic_YN":"Y","descriptorName":"Yogurt"},{"majorTopic_YN":"N","descriptorName":"Adolescent"},{"majorTopic_YN":"N","descriptorName":"Adult"},{"majorTopic_YN":"N","descriptorN