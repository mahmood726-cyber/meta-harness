irstName":"W","initials":"W"},{"fullName":"Witkiewicz W","lastName":"Witkiewicz","firstName":"W","initials":"W"},{"fullName":"Zawilska K","lastName":"Zawilska","firstName":"K","initials":"K"},{"fullName":"Engelbrecht J","lastName":"Engelbrecht","firstName":"J","initials":"J"},{"fullName":"Jacobson B","lastName":"Jacobson","firstName":"B","initials":"B"},{"fullName":"v Marle J","lastName":"v Marle","firstName":"J","initials":"J"},{"fullName":"Wright N","lastName":"Wright","firstName":"N","initials":"N"},{"fullName":"Aagesen J","lastName":"Aagesen","firstName":"J","initials":"J"},{"fullName":"Agren A","lastName":"Agren","firstName":"A","initials":"A"},{"fullName":"Eriksson H","lastName":"Eriksson","firstName":"H","initials":"H"},{"fullName":"Jonson T","lastName":"Jonson","firstName":"T","initials":"T"},{"fullName":"Lärfars G","lastName":"Lärfars","firstName":"G","initials":"G"},{"fullName":"Wallen T","lastName":"Wallen","firstName":"T","initials":"T"},{"fullName":"ten Cate H","lastName":"ten Cate","firstName":"H","initials":"H"},{"fullName":"Kooy Mv","lastName":"Kooy","firstName":"M v Marwijk","initials":"Mv"},{"fullName":"van der Meer J","lastName":"van der Meer","firstName":"J","initials":"J"},{"fullName":"Middeldorp S","lastName":"Middeldorp","firstName":"S","initials":"S"},{"fullName":"de Swart K","lastName":"de Swart","firstName":"K","initials":"K"},{"fullName":"Garcia D","lastName":"Garcia","firstName":"D","initials":"D"},{"fullName":"Lyons R","lastName":"Lyons","firstName":"R","initials":"R"},{"fullName":"Rehm J","lastName":"Rehm","firstName":"J","initials":"J"},{"fullName":"Spyropoulos A","lastName":"Spyropoulos","firstName":"A","initials":"A"}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-1492-9764"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics"]},"journalInfo":{"issue":"8","volume":"6","journalIssueId":1551244,"dateOfPublication":"2008 Aug","monthOfPublication":8,"yearOfPublication":2008,"journal":{"medlineAbbreviation":"J Thromb Haemost","title":"Journal of thrombosis and haemostasis : JTH","essn":"1538-7836","issn":"1538-7933","isoabbreviation":"J Thromb Haemost","nlmid":"101170508"},"printPublicationDate":"2008-08-01"},"pubYear":"2008","pageInfo":"1313-1318","abstractText":"<h4>Background</h4>Apixaban, an oral potent reversible direct inhibitor of activated factor X, has shown promise in the prevention of venous thromboembolism following major orthopedic surgery. We conducted a dose-ranging study in patients with deep vein thrombosis.<h4>Methods</h4>Consecutive patients with symptomatic deep vein thrombosis were included and randomized to receive 84-91 days of apixaban 5 mg twice-daily, 10 mg twice-daily, or 20 mg once-daily, or low molecular weight heparin (LMWH) followed by a vitamin K antagonist (VKA). The primary efficacy outcome was the composite of symptomatic recurrent venous thromboembolism and asymptomatic deterioration of bilateral compression ultrasound or perfusion lung scan. The principal safety outcome was the composite of major and clinically relevant, non-major bleeding.<h4>Results</h4>The mean age of the 520 included patients was 59 years, and 62% were male. The primary outcome occurred in 17 of the 358 apixaban-treated patients [4.7%, 95% confidence interval (CI) 2.8-7.5%] and in five of the 118 LMWH/VKA-treated patients (4.2%, 95% CI 1.4-9.6%) who were evaluable. The incidence in all three apixaban groups was low and comparable without evidence of a dose response. The principal safety outcome occurred in 28 (7.3%) of the 385 apixaban-treated patients and in 10 (7.9%) of the 126 LMWH/VKA-treated patients. No dose response for apixaban was observed.<h4>Conclusion</h4>These observations warrant further evaluation of apixaban in phase III studies. The attractive fixed-dose regimen of this compound may meet the demand to simplify anticoagulant treatment in patients with established venous thromboembolism.","affiliation":"Department of Vascular medicine, Academic Medical Centre, University of Amsterdam, Amsterdam, the Netherlands.","publicationStatus":"ppublish","language":"eng","pubModel":"Print-Electronic","pubTypeList":{"pubType":["Research Support, Non-U.S. Gov't","Randomized Controlled Trial","Journal Article"]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"N","descriptorName":"Venous Thrombosis","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"Y","abbreviation":"DT","qualifierName":"drug therapy"}]}},{"majorTopic_YN":"N","descriptorName":"Recurrence"},{"majorTopic_YN":"N","descriptorName":"Hemorrhage","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"ET","qualifierName":"etiology"}]}},{"majorTopic_YN":"N","descriptorName":"Vitamin K","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"AI","qualifierName":"antagonists & inhibitors"}]}},{"majorTopic_YN":"N","descriptorName":"Pyrazoles","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"Y","abbreviation":"AD","qualifierName":"administration & dosage"},{"majorTopic_YN":"N","abbreviation":"AE","qualifierName":"adverse effects"}]}},{"majorTopic_YN":"N","descriptorName":"Pyridones","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"Y","abbreviation":"AD","qualifierName":"administration & dosage"},{"majorTopic_YN":"N","abbreviation":"AE","qualifierName":"adverse effects"}]}},{"majorTopic_YN":"N","descriptorName":"Heparin, Low-Molecular-Weight","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"AD","qualifierName":"administration & dosage"}]}},{"majorTopic_YN":"N","descriptorName":"Fibrinolytic Agents","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"Y","abbreviation":"AD","qualifierName":"administration & dosage"},{"majorTopic_YN":"N","abbreviation":"AE","qualifierName":"adverse effects"}]}},{"majorTopic_YN":"N","descriptorName":"Anticoagulants","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"AD","qualifierName":"admi