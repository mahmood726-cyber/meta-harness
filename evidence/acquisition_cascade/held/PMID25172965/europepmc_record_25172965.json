ic use"}]}}]},"chemicalList":{"chemical":[{"name":"Tubulin Modulators","registryNumber":"0"},{"name":"Colchicine","registryNumber":"SML2Y3J35T"}]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Unpaywall","url":"http://hdl.handle.net/2434/634839"},{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1001/jama.2014.11026"}]},"commentCorrectionList":{"commentCorrection":[{"source":"MED","id":"25223449","reference":"Nat Rev Cardiol. 2014 Nov;11(11):620. doi: 10.1038/nrcardio.2014.152","type":"Comment in","orderIn":1}]},"isOpenAccess":"N","inEPMC":"N","inPMC":"N","citedByCount":274,"hasReferences":"N","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasPDF":"N","hasBook":"N","hasSuppl":"N","hasLabsLinks":"Y","hasData":"Y","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["nct"]},"dateOfCompletion":"2014-10-01","dateOfCreation":"2014-08-31","dateOfRevision":"2022-03-11","firstPublicationDate":"2014-09-01","firstIndexDate":"2014-08-31","hasEvaluations":"N"}]}}