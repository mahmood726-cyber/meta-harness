et. 2011 Sep 10;378(9795):980; author reply 981. doi: 10.1016/S0140-6736(11)61441-4","type":"Comment in","orderIn":5},{"source":"MED","id":"21930843","reference":"Ann Intern Med. 2011 Sep 20;155(6):JC3-6. doi: 10.7326/0003-4819-155-6-201109200-02006","type":"Comment in","orderIn":6},{"source":"MED","id":"21949254","reference":"Evid Based Med. 2012 Apr;17(2):51-2. doi: 10.1136/ebm.2011.100154","type":"Comment in","orderIn":7},{"source":"MED","id":"22229155","reference":"Med Mal Infect. 2011 Nov;41(11):631-2. doi: 10.1016/j.medmal.2011.09.002","type":"Comment in","orderIn":8}]},"isOpenAccess":"N","inEPMC":"N","inPMC":"N","citedByCount":245,"hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasPDF":"N","hasBook":"N","hasSuppl":"N","hasLabsLinks":"Y","hasData":"Y","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["nct"]},"dateOfCompletion":"2011-06-21","dateOfCreation":"2011-06-04","dateOfRevision":"2015-06-16","electronicPublicationDate":"2011-06-01","firstPublicationDate":"2011-06-01","firstIndexDate":"2011-06-06","hasEvaluations":"N"}]}}