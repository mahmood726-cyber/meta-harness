n":"St Georges Hospital, London, SW17 ORE, UK."}]}},{"fullName":"Poullis A","lastName":"Poullis","firstName":"A","initials":"A","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"St Georges Hospital, London, SW17 ORE, UK."}]}},{"fullName":"Pollok R","lastName":"Pollok","firstName":"R","initials":"R","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"St Georges Hospital, London, SW17 ORE, UK."}]}},{"fullName":"Ala A","lastName":"Ala","firstName":"A","initials":"A","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Frimley Park Hospital NHS Trust, SW17 7 HS, UK."}]}},{"fullName":"Chauhan A","lastName":"Chauhan","firstName":"A","initials":"A","authorId":{"type":"ORCID","value":"0000-0003-4044-6114"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Portsmouth Hospitals NHS Trust, PO6 3LY, UK."}]}},{"fullName":"Patel M","lastName":"Patel","firstName":"M","initials":"M","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Lewisham Healthcare NHS Trust, SE13 6LH, UK."}]}},{"fullName":"Roberts H","lastName":"Roberts","firstName":"H","initials":"H","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"University Hospital Southampton, SO16 6YD, UK."}]}},{"fullName":"Conroy S","lastName":"Conroy","firstName":"S","initials":"S","authorId":{"type":"ORCID","value":"0000-0002-4306-6064"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"University Hospitals of Leicester, LE2 7LX, UK."}]}},{"fullName":"McGowan D","lastName":"McGowan","firstName":"D","initials":"D","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"University Hospitals of Morecambe Bay, LA1 4RP, UK."}]}},{"fullName":"Pathansali R","lastName":"Pathansali","firstName":"R","initials":"R","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Kings College Hospital, SE5 9RS, UK."}]}},{"fullName":"Yau CY","lastName":"Yau","firstName":"C Y","initials":"CY","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Stoke Mandeville Hospital, HP21 8AL, UK."}]}},{"fullName":"Vasileiadis E","lastName":"Vasileiadis","firstName":"E","initials":"E","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Hillingdon Hospital, UB8 3NN, UK."}]}},{"fullName":"Guleri A","lastName":"Guleri","firstName":"A","initials":"A","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Blackpool Victoria Hospital, FY3 8NR, UK."}]}},{"fullName":"Orr D","lastName":"Orr","firstName":"David","initials":"D","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Lancashire Teaching Hospitals, PR2 9HT, UK."}]}},{"fullName":"Aldulami D","lastName":"Aldulami","firstName":"David","initials":"D","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Worcestershire 0041cute Hospitals, BN8 7UB, UK."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-4306-6064"},{"type":"ORCID","value":"0000-0002-6240-5121"},{"type":"ORCID","value":"0000-0002-8482-081X"},{"type":"ORCID","value":"0000-0002-9426-4351"},{"type":"ORCID","value":"0000-0003-0005-014X"},{"type":"ORCID","value":"0000-0003-4044-6114"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics"]},"journalInfo":{"issue":"2","volume":"105","journalIssueId":2965725,"dateOfPublication":"2020 Jun","monthOfPublication":6,"yearOfPublication":2020,"journal":{"medlineAbbreviation":"J Hosp Infect","title":"The Journal of hospital infection","essn":"1532-2939","issn":"0195-6701","isoabbreviation":"J Hosp Infect","nlmid":"8007166"},"printPublicationDate":"2020-06-01"},"pubYear":"2020","pageInfo":"280-288","abstractText":"<h4>Background</h4>Antibiotic-associated diarrhoea (AAD) is a side-effect of antibiotic consumption and probiotics have been shown to reduce AAD.<h4>Methods</h4>A multicentre, double-blind, placebo-controlled, randomized trial was conducted to evaluate the role of Lactobacillus casei DN114001 (combined as a drink with two regular yoghurt bacterial strains) in reducing AAD and Clostridioides difficile infection in patients aged over 55 years. The primary outcome was the incidence of AAD during 2 weeks of follow-up.<h4>Results</h4>A total of 1127 patients (mean age ± standard deviation: 73.6 ± 10.5) were randomized to the active group (N = 549) or placebo group (N = 577). Both groups were followed up as per protocol. The proportion of patients experiencing AAD during follow-up was 19.3% (106/549) in the probiotic group vs 17.9% (103/577) in the placebo group (unadjusted odds ratio 1.10, 95% confidence interval 0.82-1.49, P = 0.53).<h4>Conclusions</h4>No significant evidence was found of a beneficial effect of the specific probiotic formulation in preventing AAD in this elderly population drawn from a number of different UK hospitals. However, in the UK and in many other healthcare systems there have, in recent years, been many changes in antibiotic stewardship policies, an overall decrease in incidence in C. difficile infection, as well as an increased awareness of infection prevention, and modifications in nursing practice. In light of these factors, it is impossible to conclude definitively from the current trial that the study-specific probiotic formulation has no role in preventing AAD, and it is our view that further trials may be indicated, controlling for these variables.","affiliation":"Brighton and Sussex Medical School, Universities of Brighton & Sussex, Brighton, UK. Electronic address: C.rajkumar@bsms.ac.uk.","publicationStatus":"ppublish","language":"eng","pubModel":"Print-Electronic","pubTypeList":{"pubType":["Multicenter Study","Randomized Controlled Trial","Journal Article"]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"N","descriptorName":"Clostridium Infections","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"CO","qualifierName":"complications"},{"majorTopic_YN":"N","abbreviation":"DT","qualifierN