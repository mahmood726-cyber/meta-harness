":"Unpaywall","url":"https://www.nejm.org/doi/pdf/10.1056/NEJMoa0906598?articleTools=true"},{"availability":"Free","availabilityCode":"F","documentStyle":"abs","site":"content.nejm.org","url":"http://content.nejm.org/cgi/content/abstract/361/24/2342"},{"availability":"Subscription required","availabilityCode":"S","documentStyle":"html","site":"content.nejm.org","url":"http://content.nejm.org/cgi/content/full/361/24/2342"},{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1056/NEJMoa0906598"}]},"commentCorrectionList":{"commentCorrection":[{"source":"MED","id":"20237354","reference":"N Engl J Med. 2010 Mar 18;362(11):1050; author reply 1050-1. doi: 10.1056/NEJMc1000696","type":"Comment in","orderIn":1},{"source":"MED","id":"20301800","reference":"N Engl J Med. 2010 Mar 18;362(11):1050; author reply 1050-1.","type":"Comment in","orderIn":2},{"source":"MED","id":"20404376","reference":"Ann Intern Med. 2010 Apr 20;152(8):JC4-7. doi: 10.7326/0003-4819-152-8-201004200-02007","type":"Comment in","orderIn":3},{"source":"MED","id":"20494300","reference":"J Vasc Nurs. 2010 Jun;28(2):84. doi: 10.1016/j.jvn.2010.03.002","type":"Comment in","orderIn":4},{"source":"MED","id":"20528634","reference":"Expert Rev Cardiovasc Ther. 2010 Jun;8(6):771-4. doi: 10.1586/erc.10.67","type":"Comment in","orderIn":5}]},"isOpenAccess":"N","inEPMC":"N","inPMC":"N","citedByCount":1699,"hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasPDF":"N","hasBook":"N","hasSuppl":"N","hasLabsLinks":"Y","hasData":"Y","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["nct"]},"dateOfCompletion":"2010-01-05","dateOfCreation":"2009-12-08","dateOfRevision":"2022-04-09","firstPublicationDate":"2009-12-01","firstIndexDate":"2010-06-11","hasEvaluations":"N"}]}}