+def classify_declared(name, arm_terms):
+    """The PROTOCOL side of one arm name from a declared 'A vs B' label -- never its position in the label.
+    Same principle as ctgov_results._classify_arms: comparator vocabulary first, then the configured terms."""
+    low = normalized(name).lower()
+    comp = [normalized(t).lower() for t in (arm_terms or {}).get("comparator") or [] if t]
+    intv = [normalized(t).lower() for t in (arm_terms or {}).get("intervention") or [] if t]
+    on_i = any(re.search(r"(?<![\w-])" + re.escape(i) + r"(?![\w-])", low) for i in intv)
+    on_c = any(re.search(r"(?<![\w-])" + re.escape(c) + r"(?![\w-])", low) for c in comp)
+    # the CONFIGURED terms decide first (review 5: 'non-operative' is a configured intervention term, 'non-invasive
+    # ventilation' too -- control vocabulary must not override them); control words only place a name no term places
+    if on_i and not on_c:
+        return "intervention"
+    if on_c and not on_i:
+        return "comparator"
+    if not on_i and not on_c and CONTROL_WORDS.search(low):
+        return "comparator"
+    return None
+
+
+def declared_roles(declared, arm_terms):
+    """(role by name, reversed?) for a declared 'A vs B' label. Positional stamping was the defect: the first name of
+    the label became the intervention (evid2, 2026-09-25, from the main lane's item 36 note). A name the protocol cannot
+    place contributes nothing; a label whose order is the protocol's reverse is reported, not silently re-stamped."""
+    pair = re.fullmatch(r"\s*(.+?)\s+(?:vs\.?|versus)\s+(.+?)\s*", declared or "", re.I)
+    if not pair:
+        return {}, False
+    sides = [classify_declared(n, arm_terms) for n in pair.groups()]
+    roles = {n: sd for n, sd in zip(pair.groups(), sides) if sd}
+    if sides[0] and sides[0] == sides[1]:
+        return roles, "one-sided"          # both names on one side: the label says nothing usable about direction
+    return roles, sides == ["comparator", "intervention"]
+
