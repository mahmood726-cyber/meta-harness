+def test_configured_terms_decide_before_control_words():
+    """review 5: 'non-operative' / 'non-invasive ventilation' are CONFIGURED intervention terms; control vocabulary must
+    not flip them, and a label with both names on one side is its own refusal."""
+    from harness import count_observations as co
