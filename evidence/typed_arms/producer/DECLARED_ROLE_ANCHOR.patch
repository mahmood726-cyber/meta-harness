+# ---- evid2, 2026-09-25: roles from the protocol, never from the declared label's word order ------------------------
+def _codes(out):
+    return json.dumps(out["absent"])
+
+
+def test_a_declared_label_in_reversed_order_is_refused_not_restamped():
+    text = "Nausea occurred in 7 of 101 participants on treatment and 11 of 99 participants on placebo."
+    out = constructed(text, comparator_direction="placebo vs treatment")
+    assert not out["trials"] and "DECLARED_DIRECTION_REVERSED" in _codes(out)
+
+
+def test_names_the_protocol_cannot_place_get_no_role_from_their_position():
+    """'high dose vs standard dose': neither name is a configured term or control vocabulary. The old names() made the
+    first the intervention by position; now neither is placed, and the row cannot bind on the label alone."""
+    text = "Nausea occurred in 7 of 101 participants on high dose and 11 of 99 participants on standard dose."
+    out = constructed(text, comparator_direction="high dose vs standard dose")
+    assert not out["trials"]
+
