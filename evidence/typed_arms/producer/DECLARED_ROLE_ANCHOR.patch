+# control vocabulary: a name carrying it is the comparator whatever its position (placebo / sham / a named absence)
+CONTROL_WORDS = re.compile(r"\b(placebo|sham|dummy|vehicle|usual care|standard care|standard of care|control|controls)\b"
+                           r"|^\s*no[- ][a-z]|\bnon[- ][a-z]|\b[a-z]+-free\b|\bwithout\b", re.I)
