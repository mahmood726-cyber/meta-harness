+def test_the_protocol_order_still_binds():
+    text = "Nausea occurred in 7 of 101 participants on treatment and 11 of 99 participants on placebo."
+    out = constructed(text, comparator_direction="treatment vs placebo")
+    assert [(o["arm"]["role"], o["events"]) for o in out["trials"][0]["observations"]] == [("intervention", 7), ("comparator", 11)]
