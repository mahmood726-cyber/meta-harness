{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mahmood726-cyber/meta-harness/blob/main/schemas/verified-review-exchange.schema.json",
  "title": "Meta-Harness to RapidMeta evidence exchange (draft v0.1)",
  "description": "Interchange schema only; validation or signing is not yet implemented.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reviewId", "protocol", "studies", "analyses", "verification"],
  "properties": {
    "schemaVersion": {"const": "0.1"},
    "reviewId": {"type": "string", "minLength": 1},
    "protocol": {
      "type": "object",
      "required": ["sha256", "prospectivelyRegistered"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "prospectivelyRegistered": {"type": "boolean"},
        "registrationUrl": {"type": ["string", "null"], "format": "uri"}
      },
      "additionalProperties": true
    },
    "studies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["studyId", "eligibility", "sourceRefs"],
        "properties": {
          "studyId": {"type": "string", "minLength": 1},
          "eligibility": {"enum": ["INCLUDE", "EXCLUDE", "UNRESOLVED"]},
          "sourceRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "extractionReviewed": {"type": "boolean"}
        },
        "additionalProperties": true
      }
    },
    "analyses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["analysisId", "outcome", "estimand", "method", "studyIds", "decision"],
        "properties": {
          "analysisId": {"type": "string", "minLength": 1},
          "outcome": {"type": "string", "minLength": 1},
          "estimand": {"enum": ["OR", "RR", "HR", "IRR", "MD", "SMD", "OTHER"]},
          "method": {"type": "string", "minLength": 1},
          "studyIds": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "decision": {"enum": ["ALLOW", "ALLOW_WITH_LABEL", "ADJUST", "MANUAL_REVIEW", "REFUSE"]},
          "warnings": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "verification": {
      "type": "object",
      "required": ["offlineReplay", "externalAccuracy", "searchCompleteness", "robGrade"],
      "properties": {
        "offlineReplay": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
        "externalAccuracy": {"enum": ["PASS", "FAIL", "NOT_ASSESSED"]},
        "searchCompleteness": {"enum": ["PASS", "FAIL", "NOT_ASSESSED"]},
        "robGrade": {"enum": ["REVIEWED", "UNASSESSED"]}
      },
      "additionalProperties": false
    }
  }
}
